import WassersteinMixing.ActualMarkovNoise

/-! # The true Brownian future is independent of the actual filtration

The past uses the actual measurable `L²` representatives. Whole-process
almost-everywhere congruence transfers Brownian independence to this past;
there is no assumption of simultaneous representative agreement at all times.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 1000000
open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal
namespace WassersteinMixing

variable (P : Parameters) (V : E P.dimension → ℝ) (hV : PotentialAssumptions P V)

/-- The actual additive noise has the original Brownian representative. -/
theorem actualBrownianNoise_coe (t : ℝ) (ht : 0 ≤ t) :
    actualBrownianNoise P V hV t =ᵐ[actualProbability P V]
      fun ω ↦ Real.sqrt 2 • ULA.brownianCoordinates (CanonicalSemigroup.brownian P) ⟨t, ht⟩ ω := by
  simp only [actualBrownianNoise, ULA.brownianLangevinNoise, zero_add,
    ULA.brownianCoordinatesRealLp_zero, sub_zero]
  have he := ULA.brownianCoordinatesLp_coe (actualProbability P V)
    (CanonicalSemigroup.brownian P) (CanonicalSemigroup.brownian_preBrownian P V hV) ⟨t, ht⟩
  have ht' : t.toNNReal = (⟨t, ht⟩ : ℝ≥0) := Real.toNNReal_of_nonneg ht
  simp only [ULA.brownianCoordinatesRealLp, ht']
  exact (Lp.coeFn_smul (Real.sqrt 2) _).trans (he.fun_comp (fun z ↦ Real.sqrt 2 • z))

/-- The concrete raw future coordinate path. -/
def actualBrownianFuture (a : ℝ≥0) (ω : ActualSpace P) : Fin P.dimension → ℝ≥0 → ℝ :=
  fun i t ↦ CanonicalSemigroup.brownian P i (a + t) ω - CanonicalSemigroup.brownian P i a ω

theorem actualBrownianFuture_measurable (a : ℝ≥0) : Measurable (actualBrownianFuture P a) := by
  exact measurable_pi_iff.mpr (fun i ↦ measurable_pi_iff.mpr (fun t ↦
    ((ULA.CanonicalBrownian.process_measurable _).comp ((measurable_pi_apply i).comp measurable_snd)).sub
    ((ULA.CanonicalBrownian.process_measurable _).comp ((measurable_pi_apply i).comp measurable_snd))))

/-- Information generated by the whole future Brownian coordinate path. -/
@[instance_reducible] def actualFutureInformation (a : ℝ≥0) : MeasurableSpace (ActualSpace P) :=
  (inferInstance : MeasurableSpace (Fin P.dimension → ℝ≥0 → ℝ)).comap (actualBrownianFuture P a)

theorem actualFutureInformation_le (a : ℝ≥0) :
    actualFutureInformation P a ≤ (inferInstance : MeasurableSpace (ActualSpace P)) :=
  (actualBrownianFuture_measurable P a).comap_le

/-- The complete Brownian future is independent of the complete actual past.
The initial Gibbs sample is included in that past. -/
theorem actualBrownian_future_independent_pastAt (a : ℝ≥0) :
    Indep (actualFutureInformation P a)
      (ULA.lpLangevinPast (actualProbability P V) (CanonicalSemigroup.initial P V hV)
        (actualBrownianNoise P V hV) (a : ℝ)) (actualProbability P V) := by
  let J := Option (Icc (0 : ℝ) (a : ℝ))
  let Φ : ((E P.dimension × E P.dimension) × (Fin P.dimension → ℝ≥0 → ℝ)) → J → E P.dimension :=
    fun p j ↦ match j with
      | none => p.1.2
      | some t => Real.sqrt 2 • WithLp.toLp 2 (fun i ↦ p.2 i ⟨t, t.property.1⟩)
  have hΦ : Measurable Φ := by
    apply measurable_pi_iff.mpr
    intro j
    cases j with
    | none => exact measurable_snd.comp measurable_fst
    | some t =>
      have hm : Measurable (fun p : ((E P.dimension × E P.dimension) ×
          (Fin P.dimension → ℝ≥0 → ℝ)) ↦
          fun i ↦ p.2 i (⟨(t : ℝ), t.property.1⟩ : ℝ≥0)) := by
        fun_prop
      exact (((WithLp.measurable_toLp 2 _).comp hm).const_smul (Real.sqrt 2))
  have hind := (actualBrownian_raw_future_initial_past_independent P V hV a).comp
    (φ := id) (ψ := Φ) measurable_id hΦ
  let Y : J → ActualSpace P → E P.dimension := fun j ↦ match j with
    | none => CanonicalSemigroup.initial P V hV
    | some t => actualBrownianNoise P V hV t
  have he : ∀ j : J,
      (fun ω ↦ Φ (ω.1, fun i t ↦ CanonicalSemigroup.brownian P i (min t a) ω) j) =ᵐ[actualProbability P V]
        Y j := by
    intro j
    cases j with
    | none =>
      exact (ULA.initialExtension_memLp_reference (diagonalGibbsCoupling P V)
        (ULA.CanonicalBrownian.vectorProbability (Fin P.dimension)) (actualTarget_memLp P V hV)).coeFn_toLp.symm
    | some t =>
      have ht : min (⟨(t : ℝ), t.property.1⟩ : ℝ≥0) a = ⟨(t : ℝ), t.property.1⟩ :=
        min_eq_left (by exact_mod_cast t.property.2)
      simpa only [Φ, Y, ht, ULA.brownianCoordinates] using
        (actualBrownianNoise_coe P V hV t t.property.1).symm
  have hactual := hind.process_congr_right he
  change Indep (actualFutureInformation P a)
    ((inferInstance : MeasurableSpace (J → E P.dimension)).comap (fun ω j ↦ Y j ω)) _ at hactual
  change Indep (actualFutureInformation P a)
    ((⨆ j : J, (inferInstance : MeasurableSpace (E P.dimension)).comap
      (fun f : J → E P.dimension ↦ f j)).comap (fun ω j ↦ Y j ω)) _ at hactual
  rw [MeasurableSpace.comap_iSup, iSup_option] at hactual
  simp only [MeasurableSpace.comap_comp, Function.comp_def, Y] at hactual
  exact hactual

/-- The grid version used by the actual Poisson comparison filtration. -/
theorem actualBrownian_future_independent_past (n : ℕ) :
    Indep (actualFutureInformation P ⟨(n : ℝ) * P.step,
      mul_nonneg (Nat.cast_nonneg n) P.step_pos.le⟩)
      (actualPast P V hV n) (actualProbability P V) :=
  actualBrownian_future_independent_pastAt P V hV _

end WassersteinMixing
