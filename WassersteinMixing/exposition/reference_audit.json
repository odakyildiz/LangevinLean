  "results": [
    {
      "id": "ass:strong-log-conc-log-smooth",
      "kind": "assumption",
      "printed_label": "Assumption 1.1",
      "source_file": "papers/Wasserstein_mixing/main.tex",
      "source_start": 80,
      "source_end": 86,
      "source_statement_tex": "\\label{ass:strong-log-conc-log-smooth}\n\t\tThe potential $V\\in C^2\\tond*{\\R^d}$ satisfies \n\t\t\\[\n\t\t\\alpha I_d \\preccurlyeq \\hess V \\preccurlyeq \\beta I_d,\n\t\t\\]\n\t\tfor some $0<\\alpha \\leq\\beta$. We denote the condition number by $\\kappa \\coloneqq \\frac{\\beta}{\\alpha}$.",
      "status": "source-assumption",
      "proofs": []
    },
    {
      "id": "theorem:main",
      "kind": "theorem",
      "printed_label": "Theorem 1",
      "source_file": "papers/Wasserstein_mixing/main.tex",
      "source_start": 92,
      "source_end": 97,
      "source_statement_tex": "\\label{theorem:main}\n    Under Assumption \\ref{ass:strong-log-conc-log-smooth}, if  $h\\le \\frac1\\beta$, we have\n    \\begin{equation}\\label{eq:w2-bias}\n        W_2\\tond*{\\pi, \\hat\\pi} \\le  6 h \\sqrt{\\kappa \\beta  d}.\n    \\end{equation}",
      "status": "proved",
      "proofs": [
        {
          "file": "WassersteinMixing/Theorem.lean",
          "declaration": "bias_bound"
        }
      ]
    },
    {
      "id": "eq:w2-convergence",
      "kind": "corollary",
      "printed_label": "Corollary 1.1",
      "source_file": "papers/Wasserstein_mixing/main.tex",
      "source_start": 102,
      "source_end": 115,
      "source_statement_tex": "Under Assumption \\ref{ass:strong-log-conc-log-smooth}, if  $h\\le \\frac1\\beta$, we have\n    \\begin{equation}\\label{eq:w2-convergence}\n        W_2\\tond*{\\mu_k, \\pi} \\le \\left(1-\\alpha h\\right)^{k} W_2(\\mu,\\hat{\\pi}) + 6 h \\sqrt{\\kappa \\beta  d}.\n    \\end{equation}\n    In particular, for any $\\eps>0$, choosing \\[\n    h = \\frac{1}{\\beta}\\left(1 \\wedge \\frac{\\eps}{12\\sqrt{d}}\\right)\n    \\]\n    it suffices to take\n    \\begin{equation}\\label{eq:complexity_bound}\n    k \\geq \\kappa \\tond*{1 \\vee \\frac{12\\sqrt{d}}{\\epsilon}}\\log\\left(1 + \\frac{2\\sqrt{\\alpha}W_{2}(\\mu,\\hat{\\pi})}{\\epsilon}\\right)\n    \\end{equation}\n    iterations of ULA to ensure $\\sqrt{\\alpha}W_2(\\mu_k,\\pi) \\le \\eps$.",
      "status": "proved",
      "proofs": [
        {
          "file": "WassersteinMixing/Theorem.lean",
          "declaration": "convergence_bound"
        },
        {
          "file": "WassersteinMixing/Theorem.lean",
          "declaration": "accuracy_bound"
        }
      ]
    },
    {
      "id": "ass:extra-regularity",
      "kind": "assumption",
      "printed_label": "Assumption 2.1",
      "source_file": "papers/Wasserstein_mixing/main.tex",
      "source_start": 128,
      "source_end": 130,
      "source_statement_tex": "\\label{ass:extra-regularity}\n        The potential $V$ is smooth and all of its partial derivatives of all orders have at most polynomial growth.",
      "status": "source-assumption",
      "proofs": []
    }
