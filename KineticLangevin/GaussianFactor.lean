import KineticLangevin.Gaussian
import KineticLangevin.GramPositive
import Mathlib.Analysis.Matrix.LDL

noncomputable section
open MeasureTheory ProbabilityTheory Matrix
open scoped RealInnerProductSpace MatrixOrder Matrix.Norms.L2Operator
namespace KineticLangevin
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Multiplying independent standard Gaussian coordinates by any true covariance factor produces exactly the target Gaussian law. -/
theorem gaussian_factor_hasLaw (S A : Matrix ι ι ℝ) (hS : S.PosSemidef) (hA : A*Aᴴ=S) :
    HasLaw (toEuclideanCLM (𝕜:=ℝ) A) (multivariateGaussian 0 S)
      (stdGaussian (EuclideanSpace ℝ ι)) := by
  let L := toEuclideanCLM (𝕜:=ℝ) A
  refine ⟨(by fun_prop),?_⟩
  letI : IsGaussian ((stdGaussian (EuclideanSpace ℝ ι)).map L) := inferInstance
  apply IsGaussian.ext
  · rw [integral_map (by fun_prop) (by fun_prop)]
    simp only [id_eq,integral_id_multivariateGaussian]
    change (∫ x,L x ∂stdGaussian (EuclideanSpace ℝ ι))=0
    have hi := L.integral_comp_comm (μ:=stdGaussian (EuclideanSpace ℝ ι)) IsGaussian.integrable_id
    simpa only [id_eq,integral_id_stdGaussian,map_zero] using hi
  · ext x y
    change covarianceBilin ((stdGaussian (EuclideanSpace ℝ ι)).map L) x y=covarianceBilin (multivariateGaussian 0 S) x y
    rw [covarianceBilin_map IsGaussian.memLp_two_id,covarianceBilin_stdGaussian,innerSL_apply_apply,
      ContinuousLinearMap.adjoint_inner_left,covarianceBilin_multivariateGaussian hS]
    have hLL : L*L.adjoint=toEuclideanCLM (𝕜:=ℝ) S := by
      change toEuclideanCLM (𝕜:=ℝ) A*star (toEuclideanCLM (𝕜:=ℝ) A)=_
      rw [←map_star,←map_mul]
      exact congrArg (fun T => toEuclideanCLM (𝕜:=ℝ) T) hA
    rw [show L (L.adjoint y)=(L*L.adjoint) y by rfl,hLL,inner_toEuclideanCLM]

/-- The explicit positive-diagonal Cholesky factor of a two-by-two covariance matrix. -/
def choleskyTwo (S : Matrix (Fin 2) (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![Real.sqrt (S 0 0),0;S 1 0/Real.sqrt (S 0 0),Real.sqrt (S 1 1-(S 1 0)^2/S 0 0)]

/-- The Schur complement is strictly positive for the actual positive definite covariance. -/
theorem choleskyTwo_schur_pos (S : Matrix (Fin 2) (Fin 2) ℝ) (hS : S.PosDef) :
    0<S 1 1-(S 1 0)^2/S 0 0 := by
  have ha : 0<S 0 0 := hS.diag_pos
  have hd := hS.det_pos
  have hsym : S 0 1=S 1 0 := by simpa only [Matrix.IsHermitian,Matrix.conjTranspose_apply,star_trivial] using (congrFun (congrFun hS.isHermitian 0) 1).symm
  rw [Matrix.det_fin_two,hsym] at hd
  apply (mul_pos_iff_of_pos_right ha).mp
  field_simp
  nlinarith

/-- The factor is lower triangular with strictly positive diagonal. -/
theorem choleskyTwo_triangular (S : Matrix (Fin 2) (Fin 2) ℝ) (hS : S.PosDef) :
    (choleskyTwo S).IsLowerTriangular ∧ ∀ i,0<choleskyTwo S i i := by
  constructor
  · intro i j hij
    have hij' : i<j := hij
    fin_cases i <;> fin_cases j <;> norm_num [choleskyTwo] at *
  · intro i
    fin_cases i
    · exact Real.sqrt_pos.2 hS.diag_pos
    · exact Real.sqrt_pos.2 (choleskyTwo_schur_pos S hS)

/-- The actual explicit Cholesky factor reconstructs the covariance exactly. -/
theorem choleskyTwo_factor (S : Matrix (Fin 2) (Fin 2) ℝ) (hS : S.PosDef) :
    choleskyTwo S*(choleskyTwo S)ᴴ=S := by
  have ha : 0<S 0 0 := hS.diag_pos
  have hs : 0<Real.sqrt (S 0 0) := Real.sqrt_pos.2 ha
  have hq := choleskyTwo_schur_pos S hS
  have hsq := Real.sq_sqrt ha.le
  have hsq' := Real.sq_sqrt hq.le
  have hsym : S 0 1=S 1 0 := by simpa only [Matrix.IsHermitian,Matrix.conjTranspose_apply,star_trivial] using (congrFun (congrFun hS.isHermitian 0) 1).symm
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [choleskyTwo,Matrix.mul_apply,Fin.sum_univ_two]
  all_goals field_simp
  all_goals try nlinarith
  have he : (S 1 1*S 0 0-S 1 0^2)/S 0 0=S 1 1-S 1 0^2/S 0 0 := by field_simp
  rw [he]
  have hqeq : S 1 0^2+S 0 0*(S 1 1-S 1 0^2/S 0 0)=S 0 0*S 1 1 := by field_simp <;> ring
  rw [hsq,hsq']
  exact hqeq

/-- The paper's Cholesky sampling instruction is exactly the constructed Gaussian covariance law. -/
theorem choleskyTwo_hasLaw (S : Matrix (Fin 2) (Fin 2) ℝ) (hS : S.PosDef) :
    HasLaw (toEuclideanCLM (𝕜:=ℝ) (choleskyTwo S)) (multivariateGaussian 0 S)
      (stdGaussian (EuclideanSpace ℝ (Fin 2))) :=
  gaussian_factor_hasLaw S (choleskyTwo S) hS.posSemidef (choleskyTwo_factor S hS)

/-- The actual two-kernel exponential innovation is generated by the paper's explicit Cholesky factor. -/
theorem klmc_cholesky_hasLaw (γ h : ℝ) (hh : 0<h) :
    HasLaw (toEuclideanCLM (𝕜:=ℝ) (choleskyTwo (klmcCovariance γ h))) (klmcGaussian γ h)
      (stdGaussian (EuclideanSpace ℝ (Fin 2))) :=
  choleskyTwo_hasLaw (klmcCovariance γ h) (klmcCovariance_posDef γ h hh)

/-- The Cholesky implementation starts with two genuinely independent standard normal coordinates. -/
theorem klmc_cholesky_independent_normals (γ h : ℝ) (hh : 0<h) :
    HasLaw (fun z : Fin 2→ℝ => toEuclideanCLM (𝕜:=ℝ) (choleskyTwo (klmcCovariance γ h)) (WithLp.toLp 2 z))
      (klmcGaussian γ h) (Measure.pi (fun _ : Fin 2 => gaussianReal 0 1)) := by
  have hl : HasLaw (WithLp.toLp 2 : (Fin 2→ℝ)→EuclideanSpace ℝ (Fin 2))
      (stdGaussian (EuclideanSpace ℝ (Fin 2))) (Measure.pi (fun _ : Fin 2 => gaussianReal 0 1)) :=
    ⟨(by fun_prop),map_pi_eq_stdGaussian⟩
  exact (klmc_cholesky_hasLaw γ h hh).comp hl

end KineticLangevin
