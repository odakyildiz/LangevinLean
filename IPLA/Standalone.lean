section

set_option linter.style.header false

/-! # Finite-dimensional Prékopa--Leindler for Gaussian-tailed positive weights

Gaussian domination is preserved by integrating a coordinate. It supplies all
integrability and continuity needed to iterate the proved one-dimensional
transport inequality. Strongly convex Gibbs weights satisfy this domination.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory Filter Set
open scoped ENNReal Topology
namespace IPLA.Prekopa

abbrev Coordinates (n : ℕ) := Fin n → ℝ

/-- The class of positive continuous weights with a Gaussian upper bound. -/
structure GaussianWeight (n : ℕ) (f : Coordinates n → ℝ) : Prop where
  continuous : Continuous f
  positive : ∀ x, 0 < f x
  gaussian_bound : ∃ C a : ℝ, 0 < C ∧ 0 < a ∧
    ∀ x, f x ≤ C * Real.exp (-a * ∑ i, (x i) ^ 2)

namespace GaussianWeight
variable {n : ℕ} {f : Coordinates n → ℝ} (hf : GaussianWeight n f)
include hf

theorem integrable : Integrable f volume := by
  obtain ⟨C, a, hC, ha, hb⟩ := hf.gaussian_bound
  have hi := (PiLp.volume_preserving_toLp (Fin n)).integrable_comp_of_integrable
    (ULA.integrable_exp_neg_mul_norm_sq (H := EuclideanSpace ℝ (Fin n)) a ha)
  have hig : Integrable (fun x : Coordinates n ↦
      C * Real.exp (-a * ∑ i, (x i) ^ 2)) volume := by
    simpa only [Function.comp_apply, EuclideanSpace.real_norm_sq_eq, PiLp.toLp_apply]
      using hi.const_mul C
  apply hig.mono' hf.continuous.aestronglyMeasurable
  exact ae_of_all _ fun x ↦ by simpa [Real.norm_eq_abs, abs_of_pos (hf.positive x)] using hb x

theorem integral_pos : 0 < ∫ x, f x ∂volume :=
  integral_positive hf.positive hf.integrable

theorem const_mul (c : ℝ) (hc : 0 < c) : GaussianWeight n (fun x ↦ c * f x) := by
  obtain ⟨C, a, hC, ha, hb⟩ := hf.gaussian_bound
  refine ⟨continuous_const.mul hf.continuous, fun x ↦ mul_pos hc (hf.positive x),
    c * C, a, mul_pos hc hC, ha, ?_⟩
  intro x
  simpa only [mul_assoc] using mul_le_mul_of_nonneg_left (hb x) hc.le

end GaussianWeight

/-- Continuity of inserting the first real coordinate. -/
theorem continuous_cons {n : ℕ} :
    Continuous (fun p : ℝ × Coordinates n ↦ (Fin.cons p.1 p.2 : Coordinates (n + 1))) := by
  apply continuous_pi
  intro i
  refine Fin.cases ?_ (fun i ↦ ?_) i
  · simpa using (continuous_fst : Continuous (Prod.fst : ℝ × Coordinates n → ℝ))
  · change Continuous (fun p : ℝ × Coordinates n ↦ p.2 i)
    fun_prop

/-- Integrate out the first coordinate of a weight. -/
def firstMarginal {n : ℕ} (f : Coordinates (n + 1) → ℝ) (x : Coordinates n) : ℝ :=
  ∫ z : ℝ, f (Fin.cons z x) ∂volume

namespace GaussianWeight
variable {n : ℕ} {f : Coordinates (n + 1) → ℝ} (hf : GaussianWeight (n + 1) f)
include hf

theorem slice_integrable (x : Coordinates n) :
    Integrable (fun z : ℝ ↦ f (Fin.cons z x)) volume := by
  obtain ⟨C, a, hC, ha, hb⟩ := hf.gaussian_bound
  have hi : Integrable (fun z : ℝ ↦ C * Real.exp (-a * z ^ 2)) volume := by
    simpa only [Real.norm_eq_abs, sq_abs] using
      (ULA.integrable_exp_neg_mul_norm_sq (H := ℝ) a ha).const_mul C
  apply hi.mono'
  · exact (hf.continuous.comp
      (continuous_cons.comp (continuous_id.prodMk continuous_const))).aestronglyMeasurable
  · apply ae_of_all
    intro z
    rw [Real.norm_eq_abs, abs_of_pos (hf.positive _)]
    have hbz := hb (Fin.cons z x)
    simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ] at hbz
    apply hbz.trans
    apply mul_le_mul_of_nonneg_left _ hC.le
    apply Real.exp_le_exp.mpr
    have hs : 0 ≤ ∑ i : Fin n, (x i) ^ 2 := Finset.sum_nonneg fun _ _ ↦ sq_nonneg _
    nlinarith

theorem firstMarginal_continuous : Continuous (firstMarginal f) := by
  obtain ⟨C, a, hC, ha, hb⟩ := hf.gaussian_bound
  apply continuous_of_dominated (bound := fun z : ℝ ↦ C * Real.exp (-a * z ^ 2))
  · exact fun x ↦ (hf.slice_integrable x).aestronglyMeasurable
  · intro x
    apply ae_of_all
    intro z
    rw [Real.norm_eq_abs, abs_of_pos (hf.positive _)]
    apply (hb (Fin.cons z x)).trans
    apply mul_le_mul_of_nonneg_left _ hC.le
    apply Real.exp_le_exp.mpr
    simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
    have hs : 0 ≤ ∑ i : Fin n, (x i) ^ 2 := Finset.sum_nonneg fun _ _ ↦ sq_nonneg _
    nlinarith
  · simpa only [Real.norm_eq_abs, sq_abs] using
      (ULA.integrable_exp_neg_mul_norm_sq (H := ℝ) a ha).const_mul C
  · apply ae_of_all
    intro z
    exact hf.continuous.comp
      (continuous_cons.comp (continuous_const.prodMk continuous_id))

theorem firstMarginal_gaussian : GaussianWeight n (firstMarginal f) := by
  obtain ⟨C, a, hC, ha, hb⟩ := hf.gaussian_bound
  have hi : Integrable (fun z : ℝ ↦ Real.exp (-a * z ^ 2)) volume := by
    simpa only [Real.norm_eq_abs, sq_abs] using
      ULA.integrable_exp_neg_mul_norm_sq (H := ℝ) a ha
  refine ⟨hf.firstMarginal_continuous,
    fun x ↦ integral_positive (fun z ↦ hf.positive (Fin.cons z x)) (hf.slice_integrable x),
    C * (∫ z : ℝ, Real.exp (-a * z ^ 2)), a,
    mul_pos hC (integral_positive (fun z ↦ Real.exp_pos _) hi), ha, ?_⟩
  intro x
  have hb' (z : ℝ) : f (Fin.cons z x) ≤
      (C * Real.exp (-a * ∑ i, (x i) ^ 2)) * Real.exp (-a * z ^ 2) := by
    have h := hb (Fin.cons z x)
    simp only [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ] at h
    convert h using 1
    rw [mul_assoc, ← Real.exp_add]
    congr 2
    ring
  have h := integral_mono (hf.slice_integrable x)
    (hi.const_mul (C * Real.exp (-a * ∑ i, (x i) ^ 2))) hb'
  rw [integral_const_mul] at h
  change firstMarginal f x ≤ _ at h
  convert h using 1
  ring

theorem integral_firstMarginal : ∫ x, firstMarginal f x ∂volume = ∫ x, f x ∂volume := by
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (n + 1) ↦ ℝ) 0
  have hp := (volume_preserving_piFinSuccAbove (fun _ : Fin (n + 1) ↦ ℝ) 0).symm
  have he (p : ℝ × Coordinates n) : e.symm p = Fin.cons p.1 p.2 := by
    simp [e, MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv]
  have hi : Integrable (fun p : ℝ × Coordinates n ↦ f (Fin.cons p.1 p.2)) volume := by
    convert hp.integrable_comp_of_integrable hf.integrable using 1
    funext p
    exact congrArg f (he p).symm
  have h := hp.integral_comp' f
  have heq : (∫ p : ℝ × Coordinates n, f (Fin.cons p.1 p.2) ∂volume) =
      ∫ x, f x ∂volume := by
    convert h using 1
    apply integral_congr_ae
    apply ae_of_all
    intro p
    exact congrArg f (he p).symm
  change Integrable (fun p : ℝ × Coordinates n ↦ f (Fin.cons p.1 p.2))
    ((volume : Measure ℝ).prod (volume : Measure (Coordinates n))) at hi
  change (∫ p : ℝ × Coordinates n, f (Fin.cons p.1 p.2)
    ∂(volume : Measure ℝ).prod (volume : Measure (Coordinates n))) = _ at heq
  rw [integral_prod _ hi, integral_integral_swap hi] at heq
  exact heq

end GaussianWeight

/-- The finite-dimensional Prékopa--Leindler inequality. The induction uses
the proved real-line transport theorem and integrates one coordinate at a time. -/
theorem prekopa_leindler {n : ℕ} {f g h : Coordinates n → ℝ}
    (hf : GaussianWeight n f) (hg : GaussianWeight n g) (hh : GaussianWeight n h)
    (t : ℝ) (ht : 0 ≤ t) (ht1 : t ≤ 1)
    (hpoint : ∀ x y, Real.exp ((1 - t) * Real.log (f x) + t * Real.log (g y)) ≤
      h (fun i ↦ (1 - t) * x i + t * y i)) :
    Real.exp ((1 - t) * Real.log (∫ x, f x) + t * Real.log (∫ x, g x)) ≤ ∫ x, h x := by
  induction n with
  | zero =>
    let z : Coordinates 0 := fun i ↦ Fin.elim0 i
    have hi (u : Coordinates 0 → ℝ) : (∫ x, u x ∂volume) = u z := by
      have he : u = fun _ ↦ u z := by
        funext x
        congr 1
        funext i
        exact Fin.elim0 i
      rw [he, integral_const]
      simp [measureReal_def, volume_pi, Measure.pi_empty_univ]
    rw [hi f, hi g, hi h]
    convert hpoint z z using 1
    congr 1
    funext i
    exact Fin.elim0 i
  | succ n ih =>
    have hm : ∀ x y : Coordinates n,
        Real.exp ((1 - t) * Real.log (firstMarginal f x) +
          t * Real.log (firstMarginal g y)) ≤
        firstMarginal h (fun i ↦ (1 - t) * x i + t * y i) := by
      intro x y
      apply prekopa_leindler_real
        (hf.continuous.comp (continuous_cons.comp (continuous_id.prodMk continuous_const)))
        (fun s ↦ hf.positive (Fin.cons s x)) (hf.slice_integrable x)
        (hg.continuous.comp (continuous_cons.comp (continuous_id.prodMk continuous_const)))
        (fun s ↦ hg.positive (Fin.cons s y)) (hg.slice_integrable y)
        (hh.slice_integrable _) (fun s ↦ (hh.positive _).le) t ht ht1
      intro s r
      convert hpoint (Fin.cons s x) (Fin.cons r y) using 1
      · rfl
      · apply congrArg h
        funext i
        refine Fin.cases ?_ (fun i ↦ ?_) i <;> rfl
    have h := ih hf.firstMarginal_gaussian hg.firstMarginal_gaussian
      hh.firstMarginal_gaussian hm
    rwa [hf.integral_firstMarginal, hg.integral_firstMarginal,
      hh.integral_firstMarginal] at h

end IPLA.Prekopa


end
end


/-! ## Included source: IPLA/StrongLogConcavity.lean -/
section

set_option linter.style.header false

/-! # Strong log-concavity of the actual IPLA marginal

The proved Prékopa--Leindler inequality is applied to the latent slices of the
original jointly strongly convex potential. Marginal strong convexity is a
conclusion of the theorem, never an added input.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory Filter Set
open scoped ENNReal Topology
namespace IPLA

/-- The real latent partition. Positivity and finiteness were proved from the
joint assumptions in `MarginalConcentration.lean`. -/
def marginalIntegral {dθ dx : ℕ} (U : Joint dθ dx → ℝ) (θ : EuclideanSpace ℝ (Fin dθ)) : ℝ :=
  ∫ x, Real.exp (-U (pair θ x)) ∂volume

/-- The actual marginal negative log-likelihood, with the observations fixed. -/
def marginalPotential {dθ dx : ℕ} (U : Joint dθ dx → ℝ) (θ : EuclideanSpace ℝ (Fin dθ)) : ℝ :=
  -Real.log (marginalIntegral U θ)

theorem marginalIntegral_pos {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (θ : EuclideanSpace ℝ (Fin dθ)) :
    0 < marginalIntegral U θ :=
  integral_exp_pos (integrable_marginal_weight U m hm hdiff hsc θ)

theorem marginalPotential_continuous {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) : Continuous (marginalPotential U) := by
  exact ((continuous_marginal_integral U m hm hdiff hsc).log
    (fun θ ↦ (marginalIntegral_pos U m hm hdiff hsc θ).ne')).neg

/-- The statistical marginal maximizer minimizes the actual negative
log-likelihood. All real conversions use proved positive finite partitions. -/
theorem marginalMaximizer_minimizes_potential {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (θStar : EuclideanSpace ℝ (Fin dθ))
    (hmax : IsMarginalMaximizer U θStar) :
    ∀ θ, marginalPotential U θStar ≤ marginalPotential U θ := by
  intro θ
  have h := hmax θ
  rw [marginalDensity_eq_ofReal_integral U m hm hdiff hsc θ,
    marginalDensity_eq_ofReal_integral U m hm hdiff hsc θStar] at h
  have hr := (ENNReal.ofReal_le_ofReal_iff
    (marginalIntegral_pos U m hm hdiff hsc θStar).le).mp h
  exact neg_le_neg (Real.log_le_log (marginalIntegral_pos U m hm hdiff hsc θ) hr)

/-- A latent slice written in ordinary product coordinates for applying the
finite-dimensional Prékopa--Leindler theorem. -/
def latentWeight {dθ dx : ℕ} (U : Joint dθ dx → ℝ) (θ : EuclideanSpace ℝ (Fin dθ))
    (x : Prekopa.Coordinates dx) : ℝ :=
  Real.exp (-U (pair θ (WithLp.toLp 2 x)))

theorem latentWeight_gaussian {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (θ : EuclideanSpace ℝ (Fin dθ)) :
    Prekopa.GaussianWeight dx (latentWeight U θ) := by
  refine ⟨?_, fun _ ↦ Real.exp_pos _,
    Real.exp (‖gradient U 0‖ ^ 2 / m - U 0), m / 4, Real.exp_pos _, by positivity, ?_⟩
  · exact Real.continuous_exp.comp (hdiff.continuous.comp
      (continuous_pair.comp (continuous_const.prodMk (PiLp.continuous_toLp 2 _)))).neg
  · intro x
    have h := marginal_weight_uniform_bound U m hm hdiff hsc θ (WithLp.toLp 2 x)
    simpa only [latentWeight, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _),
      EuclideanSpace.real_norm_sq_eq, PiLp.toLp_apply] using h

theorem integral_latentWeight {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (θ : EuclideanSpace ℝ (Fin dθ)) :
    (∫ x, latentWeight U θ x ∂volume) = marginalIntegral U θ := by
  exact (PiLp.volume_preserving_toLp (Fin dx)).integral_comp
    (MeasurableEquiv.toLp 2 (Fin dx → ℝ)).measurableEmbedding
    (fun x ↦ Real.exp (-U (pair θ x)))

@[simp] theorem pair_sub {dθ dx : ℕ} (θ θ' : EuclideanSpace ℝ (Fin dθ))
    (x x' : EuclideanSpace ℝ (Fin dx)) :
    pair θ x - pair θ' x' = pair (θ - θ') (x - x') := by
  ext i
  cases i <;> simp [pair]

theorem pair_affine {dθ dx : ℕ} (θ θ' : EuclideanSpace ℝ (Fin dθ))
    (x x' : EuclideanSpace ℝ (Fin dx)) (a b : ℝ) :
    pair (a • θ + b • θ') (a • x + b • x') = a • pair θ x + b • pair θ' x' := by
  ext i
  cases i <;> simp [pair]

/-- Integrating out the latent variables preserves precisely the original
strong-convexity constant. This is the derived Prékopa theorem for IPLA. -/
theorem marginalPotential_strongConvex {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) :
    StrongConvexOn Set.univ m (marginalPotential U) := by
  refine ⟨convex_univ, ?_⟩
  intro θ hθ θ' hθ' a b ha hb hab
  have hb1 : b ≤ 1 := by linarith
  have haeq : 1 - b = a := by linarith
  let θr := a • θ + b • θ'
  let c := a * b * (m / 2 * ‖θ - θ'‖ ^ 2)
  have hf := latentWeight_gaussian U m hm hdiff hsc θ
  have hg := latentWeight_gaussian U m hm hdiff hsc θ'
  have hh := (latentWeight_gaussian U m hm hdiff hsc θr).const_mul
    (Real.exp (-c)) (Real.exp_pos _)
  have hpoint (x y : Prekopa.Coordinates dx) :
      Real.exp ((1 - b) * Real.log (latentWeight U θ x) +
        b * Real.log (latentWeight U θ' y)) ≤
      Real.exp (-c) * latentWeight U θr (fun i ↦ (1 - b) * x i + b * y i) := by
    simp only [latentWeight, Real.log_exp, haeq, ← Real.exp_add]
    apply Real.exp_le_exp.mpr
    let x' : EuclideanSpace ℝ (Fin dx) := WithLp.toLp 2 x
    let y' : EuclideanSpace ℝ (Fin dx) := WithLp.toLp 2 y
    have hs := hsc.2 (Set.mem_univ (pair θ x')) (Set.mem_univ (pair θ' y')) ha hb hab
    have he : (WithLp.toLp 2 (fun i ↦ a * x i + b * y i) : EuclideanSpace ℝ (Fin dx)) =
        a • x' + b • y' := by ext i; rfl
    rw [← pair_affine, pair_sub] at hs
    dsimp only at hs
    rw [norm_pair_sq] at hs
    have hnonneg : 0 ≤ a * b * (m / 2 * ‖x' - y'‖ ^ 2) := by positivity
    dsimp [c, θr, x', y'] at hs hnonneg ⊢
    rw [he]
    nlinarith
  have hpl := Prekopa.prekopa_leindler hf hg hh b hb hb1 hpoint
  rw [integral_const_mul, integral_latentWeight, integral_latentWeight,
    integral_latentWeight] at hpl
  have hz : 0 < marginalIntegral U θr := (latentWeight_gaussian U m hm hdiff hsc θr).integral_pos
    |>.trans_eq (integral_latentWeight U θr)
  have hlog := Real.log_le_log (Real.exp_pos _) hpl
  rw [Real.log_exp, Real.log_mul (Real.exp_ne_zero _) hz.ne', Real.log_exp, haeq] at hlog
  change -Real.log (marginalIntegral U θr) ≤
    a * (-Real.log (marginalIntegral U θ)) + b * (-Real.log (marginalIntegral U θ')) - _
  dsimp [c] at hlog
  linarith

/-- Joint strong convexity implies uniqueness of the marginal maximizer. -/
theorem marginalMaximizer_unique {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (θ θ' : EuclideanSpace ℝ (Fin dθ))
    (hθ : IsMarginalMaximizer U θ) (hθ' : IsMarginalMaximizer U θ') : θ = θ' := by
  have hs := (marginalPotential_strongConvex U m hm hdiff hsc).strictConvexOn hm
  exact hs.eq_of_isMinOn
    (fun x _ ↦ marginalMaximizer_minimizes_potential U m hm hdiff hsc θ hθ x)
    (fun x _ ↦ marginalMaximizer_minimizes_potential U m hm hdiff hsc θ' hθ' x)
    (Set.mem_univ _) (Set.mem_univ _)

/-- The marginal maximizer exists uniquely under exactly the original joint
potential assumptions. -/
theorem existsUnique_marginalMaximizer {dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) :
    ∃! θ : EuclideanSpace ℝ (Fin dθ), IsMarginalMaximizer U θ := by
  obtain ⟨θ, hθ⟩ := exists_marginalMaximizer U m hm hdiff hsc
  exact ⟨θ, hθ, fun θ' hθ' ↦ marginalMaximizer_unique U m hm hdiff hsc θ' θ hθ' hθ⟩

end IPLA


end
end


/-! ## Included source: UnadjustedLangevin/GibbsConcentration.lean -/
section

set_option linter.style.header false

/-! # Gibbs concentration around a minimizer from continuous strong convexity

A dilation of Lebesgue measure and the tangent limit at dilation factor one prove
the dimension-sharp `2 * dim / m` second-moment bound. The potential need only be
continuous and strongly convex: no gradient, Hessian, or second derivative is
assumed. Gaussian integrability and the second moment are derived in this file.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory Filter Set
open scoped ENNReal Topology
namespace ULA
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

omit [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H] in
/-- Midpoint strong convexity and minimality already give Gaussian tails. -/
theorem strongConvex_mode_quadratic_bound (F : H → ℝ) (q : ℝ)
    (hsc : StrongConvexOn Set.univ q F) (z : H) (hz : ∀ x, F z ≤ F x) (x : H) :
    F z + q / 4 * ‖x - z‖ ^ 2 ≤ F x := by
  have hs := hsc.2 (Set.mem_univ z) (Set.mem_univ x)
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num : (1 / 2 : ℝ) + 1 / 2 = 1)
  have hmin := hz ((1 / 2 : ℝ) • z + (1 / 2 : ℝ) • x)
  dsimp only at hs
  simp only [smul_eq_mul] at hs
  rw [norm_sub_rev z x] at hs
  nlinarith

theorem integrable_exp_neg_of_continuous_strongConvex_mode
    (F : H → ℝ) (q : ℝ) (hq : 0 < q) (hc : Continuous F)
    (hsc : StrongConvexOn Set.univ q F) (z : H) (hz : ∀ x, F z ≤ F x) :
    Integrable (fun x ↦ Real.exp (-F x)) volume := by
  have hg := (measurePreserving_sub_right (volume : Measure H) z).integrable_comp_of_integrable
    (integrable_exp_neg_mul_norm_sq (H := H) (q / 4) (by positivity))
  have hi := hg.const_mul (Real.exp (-F z))
  apply hi.mono' (Real.continuous_exp.comp hc.neg).aestronglyMeasurable
  apply ae_of_all
  intro x
  change ‖Real.exp (-F x)‖ ≤ Real.exp (-F z) * Real.exp (-(q / 4) * ‖x - z‖ ^ 2)
  rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
  rw [← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have h := strongConvex_mode_quadratic_bound F q hsc z hz x
  linarith

theorem integrable_sq_dist_mul_exp_neg_of_continuous_strongConvex_mode
    (F : H → ℝ) (q : ℝ) (hq : 0 < q) (hc : Continuous F)
    (hsc : StrongConvexOn Set.univ q F) (z : H) (hz : ∀ x, F z ≤ F x) :
    Integrable (fun x ↦ ‖x - z‖ ^ 2 * Real.exp (-F x)) volume := by
  have hg := (measurePreserving_sub_right (volume : Measure H) z).integrable_comp_of_integrable
      (integrable_norm_sq_mul_exp_neg_mul_norm_sq (H := H) (q / 4) (by positivity))
  have hi := hg.const_mul (Real.exp (-F z))
  apply hi.mono' (by fun_prop)
  apply ae_of_all
  intro x
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  change ‖x - z‖ ^ 2 * Real.exp (-F x) ≤
    Real.exp (-F z) * (‖x - z‖ ^ 2 * Real.exp (-(q / 4) * ‖x - z‖ ^ 2))
  have he : Real.exp (-F x) ≤ Real.exp (-F z) * Real.exp (-(q / 4) * ‖x - z‖ ^ 2) := by
    rw [← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have h := strongConvex_mode_quadratic_bound F q hsc z hz x
    linarith
  nlinarith [mul_le_mul_of_nonneg_left he (sq_nonneg ‖x - z‖)]

/-- The dilation inequality before taking the tangent limit. -/
theorem gibbs_mode_dilation_inequality
    (F : H → ℝ) (q : ℝ) (hq : 0 < q) (hc : Continuous F)
    (hsc : StrongConvexOn Set.univ q F) (z : H) (hz : ∀ x, F z ≤ F x)
    (r : ℝ) (hr : 0 < r) (hr1 : r < 1) :
    (∫ x, Real.exp (-F x) ∂volume) + q / 2 * r * (1 - r) *
      (∫ x, ‖x - z‖ ^ 2 * Real.exp (-F x) ∂volume) ≤
    (r ^ Module.finrank ℝ H)⁻¹ * ∫ x, Real.exp (-F x) ∂volume := by
  let w := fun x ↦ Real.exp (-F x)
  let C := q / 2 * r * (1 - r)
  have hi := integrable_exp_neg_of_continuous_strongConvex_mode F q hq hc hsc z hz
  have hmi := integrable_sq_dist_mul_exp_neg_of_continuous_strongConvex_mode F q hq hc hsc z hz
  have haff (x : H) : z + r • (x - z) = r • x + (1 - r) • z := by module
  have hip : Integrable (fun x ↦ w (z + r • (x - z))) volume := by
    have ht := (measurePreserving_add_right (volume : Measure H)
      ((1 - r) • z)).integrable_comp_of_integrable hi
    have hs := ht.comp_smul hr.ne'
    convert hs using 1
    funext x
    exact congrArg w (haff x)
  have htrans : (∫ x, w (z + r • (x - z)) ∂volume) =
      (r ^ Module.finrank ℝ H)⁻¹ * ∫ x, w x ∂volume := by
    have hs := Measure.integral_comp_smul_of_nonneg (volume : Measure H)
      (fun x ↦ w (x + (1 - r) • z)) r (hR := hr.le)
    rw [integral_add_right_eq_self] at hs
    convert hs using 1
    · apply integral_congr_ae
      exact ae_of_all _ fun x ↦ congrArg w (haff x)
  have hpoint (x : H) : w x + C * (‖x - z‖ ^ 2 * w x) ≤ w (z + r • (x - z)) := by
    have hs := hsc.2 (Set.mem_univ z) (Set.mem_univ x)
      (by linarith : 0 ≤ 1 - r) hr.le (by ring : 1 - r + r = 1)
    dsimp only at hs
    simp only [smul_eq_mul] at hs
    rw [norm_sub_rev z x] at hs
    have heq : (1 - r) • z + r • x = z + r • (x - z) := by module
    rw [heq] at hs
    have hb : F (z + r • (x - z)) ≤ F x - C * ‖x - z‖ ^ 2 := by
      have hmin := mul_le_mul_of_nonneg_left (hz x) (show 0 ≤ 1 - r by linarith)
      dsimp [C]
      nlinarith
    have he := Real.exp_le_exp.mpr (show -F x + C * ‖x - z‖ ^ 2 ≤
      -F (z + r • (x - z)) by linarith)
    rw [Real.exp_add] at he
    have hp := mul_le_mul_of_nonneg_left (Real.add_one_le_exp (C * ‖x - z‖ ^ 2))
      (Real.exp_nonneg (-F x))
    dsimp [w] at *
    nlinarith
  calc
    _ = ∫ x, (w x + C * (‖x - z‖ ^ 2 * w x)) ∂volume := by
      rw [integral_add hi (hmi.const_mul C), integral_const_mul]
    _ ≤ ∫ x, w (z + r • (x - z)) ∂volume := integral_mono (hi.add (hmi.const_mul C)) hip hpoint
    _ = _ := htrans

/-- Taking the tangent limit of the dilation inequality gives the exact
dimension dependence, without differentiating the potential. -/
theorem integral_sq_dist_mul_exp_neg_le_of_continuous_strongConvex_mode
    (F : H → ℝ) (q : ℝ) (hq : 0 < q) (hc : Continuous F)
    (hsc : StrongConvexOn Set.univ q F) (z : H) (hz : ∀ x, F z ≤ F x) :
    (∫ x, ‖x - z‖ ^ 2 * Real.exp (-F x) ∂volume) ≤
      (2 * (Module.finrank ℝ H : ℝ) / q) * ∫ x, Real.exp (-F x) ∂volume := by
  let d := Module.finrank ℝ H
  let Z := ∫ x, Real.exp (-F x) ∂volume
  let M := ∫ x, ‖x - z‖ ^ 2 * Real.exp (-F x) ∂volume
  let C := q / 2
  let Φ : ℝ → ℝ := fun r ↦ r ^ d * (Z + C * r * (1 - r) * M)
  have hΦ1 : Φ 1 = Z := by simp [Φ]
  have hΦ (r : ℝ) (hr : 0 < r) (hr1 : r < 1) : Φ r ≤ Z := by
    have h := gibbs_mode_dilation_inequality F q hq hc hsc z hz r hr hr1
    have hp : 0 < r ^ d := pow_pos hr d
    have hm := mul_le_mul_of_nonneg_left h hp.le
    change Φ r ≤ r ^ d * ((r ^ d)⁻¹ * Z) at hm
    rw [← mul_assoc, mul_inv_cancel₀ hp.ne', one_mul] at hm
    exact hm
  have hinner : HasDerivAt (fun r : ℝ ↦ Z + C * r * (1 - r) * M) (-C * M) 1 := by
    convert (hasDerivAt_const (1 : ℝ) Z).add
      ((((hasDerivAt_id (1 : ℝ)).const_mul C).mul
        ((hasDerivAt_const (1 : ℝ) 1).sub (hasDerivAt_id (1 : ℝ)))).mul_const M) using 1
    · rfl
    · simp only [Pi.sub_apply, id_eq]
      ring
  have hder : HasDerivAt Φ ((d : ℝ) * Z - C * M) 1 := by
    convert ((hasDerivAt_id (1 : ℝ)).pow d).mul hinner using 1
    · rfl
    · simp only [Pi.pow_apply, id_eq, one_pow, mul_one, sub_self, mul_zero, zero_mul, add_zero]
      ring
  have hnonneg : ∀ᶠ u : ℝ in 𝓝[<] 0,
      0 ≤ u⁻¹ * (Φ (1 + u) - Φ 1) := by
    have hnear : ∀ᶠ u : ℝ in 𝓝[<] 0, -1 < u :=
      mem_nhdsWithin_of_mem_nhds (Ioi_mem_nhds (by norm_num : (-1 : ℝ) < 0))
    filter_upwards [self_mem_nhdsWithin, hnear] with u hu hnear
    have hp := hΦ (1 + u) (by linarith) (by change u < 0 at hu; linarith)
    rw [← hΦ1] at hp
    exact mul_nonneg_of_nonpos_of_nonpos (inv_nonpos.mpr hu.le) (sub_nonpos.mpr hp)
  have hbound : 0 ≤ (d : ℝ) * Z - C * M := by
    have hs := hder.tendsto_slope_zero_left
    simp only [smul_eq_mul] at hs
    exact le_of_tendsto_of_tendsto tendsto_const_nhds hs hnonneg
  change M ≤ (2 * (d : ℝ) / q) * Z
  have hb : M ≤ 2 * (d : ℝ) * Z / q := by
    apply (le_div_iff₀ hq).mpr
    dsimp [C] at hbound
    nlinarith
  convert hb using 1
  ring

/-- The squared distance is integrable under the normalized Gibbs law, derived
from continuous strong convexity and the identified mode. -/
theorem integrable_sq_dist_gibbs_of_continuous_strongConvex_mode
    (F : H → ℝ) (q : ℝ) (hq : 0 < q) (hc : Continuous F)
    (hsc : StrongConvexOn Set.univ q F) (z : H) (hz : ∀ x, F z ≤ F x) :
    Integrable (fun x ↦ ‖x - z‖ ^ 2) (gibbsMeasure F) := by
  have hi := integrable_exp_neg_of_continuous_strongConvex_mode F q hq hc hsc z hz
  have hm := integrable_sq_dist_mul_exp_neg_of_continuous_strongConvex_mode F q hq hc hsc z hz
  have hw : Measurable (gibbsWeight F) :=
    (Real.continuous_exp.comp hc.neg).measurable.ennreal_ofReal
  have hZ : 0 < gibbsPartition F := by
    rw [show gibbsPartition F = ENNReal.ofReal (∫ x, Real.exp (-F x)) from
      (ofReal_integral_eq_lintegral_ofReal hi (ae_of_all _ fun _ ↦ Real.exp_nonneg _)).symm]
    exact ENNReal.ofReal_pos.mpr (integral_exp_pos hi)
  have hwd : Integrable (fun x ↦ ‖x - z‖ ^ 2) (volume.withDensity (gibbsWeight F)) := by
    apply (integrable_withDensity_iff_integrable_smul' hw
      (ae_of_all _ fun x ↦ ENNReal.ofReal_lt_top)).mpr
    simpa only [gibbsWeight, smul_eq_mul, ENNReal.toReal_ofReal (Real.exp_nonneg _),
      mul_comm] using hm
  exact hwd.smul_measure (ENNReal.inv_ne_top.mpr hZ.ne')

/-- A continuous `q`-strongly convex Gibbs potential concentrates around its
minimizer with second moment at most `2 * dim / q`. Every normalization and
integrability fact used in the conclusion is proved from the stated inputs. -/
theorem integral_sq_dist_gibbs_le_of_continuous_strongConvex_mode
    (F : H → ℝ) (q : ℝ) (hq : 0 < q) (hc : Continuous F)
    (hsc : StrongConvexOn Set.univ q F) (z : H) (hz : ∀ x, F z ≤ F x) :
    (∫ x, ‖x - z‖ ^ 2 ∂gibbsMeasure F) ≤ 2 * (Module.finrank ℝ H : ℝ) / q := by
  let Z := ∫ x, Real.exp (-F x) ∂volume
  have hi := integrable_exp_neg_of_continuous_strongConvex_mode F q hq hc hsc z hz
  have hZ : 0 < Z := integral_exp_pos hi
  have hpart : gibbsPartition F = ENNReal.ofReal Z :=
    (ofReal_integral_eq_lintegral_ofReal hi (ae_of_all _ fun _ ↦ Real.exp_nonneg _)).symm
  have hw : Measurable (gibbsWeight F) :=
    (Real.continuous_exp.comp hc.neg).measurable.ennreal_ofReal
  have heq : (∫ x, ‖x - z‖ ^ 2 ∂gibbsMeasure F) =
      Z⁻¹ * ∫ x, ‖x - z‖ ^ 2 * Real.exp (-F x) ∂volume := by
    rw [gibbsMeasure, hpart, integral_smul_measure,
      integral_withDensity_eq_integral_toReal_smul hw
        (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)]
    simp only [ENNReal.toReal_inv, ENNReal.toReal_ofReal hZ.le, smul_eq_mul,
      gibbsWeight, ENNReal.toReal_ofReal (Real.exp_nonneg _)]
    congr 1
    apply integral_congr_ae
    exact ae_of_all _ fun x ↦ mul_comm _ _
  rw [heq]
  have hb := integral_sq_dist_mul_exp_neg_le_of_continuous_strongConvex_mode F q hq hc hsc z hz
  calc
    _ ≤ Z⁻¹ * ((2 * (Module.finrank ℝ H : ℝ) / q) * Z) :=
      mul_le_mul_of_nonneg_left hb (inv_nonneg.mpr hZ.le)
    _ = _ := by rw [mul_left_comm, inv_mul_cancel₀ hZ.ne', mul_one]

end ULA


end
end


/-! ## Included source: IPLA/Concentration.lean -/
section

set_option linter.style.header false

/-! # The complete IPLA equilibrium concentration theorem

This module derives the exact `sqrt (2*dθ/(N*m))` radius from the original joint
potential assumptions. Marginal strong convexity is supplied by the proved
Prékopa theorem; the dimension-sharp moment estimate reuses the shared ULA
continuous-Gibbs dilation theorem. No marginal-concentration or reference-law
hypothesis is introduced.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory Filter Set
open scoped ENNReal Topology
namespace IPLA

/-- Multiplying the actual marginal potential by `N` multiplies its proved
strong-convexity constant by `N`. -/
theorem scaled_marginalPotential_strongConvex {N dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) :
    StrongConvexOn Set.univ ((N : ℝ) * m)
      (fun θ ↦ (N : ℝ) * marginalPotential U θ) := by
  refine ⟨convex_univ, ?_⟩
  intro θ hθ θ' hθ' a b ha hb hab
  have h := mul_le_mul_of_nonneg_left
    ((marginalPotential_strongConvex U m hm hdiff hsc).2 hθ hθ' ha hb hab)
    (Nat.cast_nonneg N : (0 : ℝ) ≤ N)
  dsimp only at h ⊢
  simp only [smul_eq_mul] at h ⊢
  convert h using 1
  ring

/-- The normalized powered marginal density is exactly the Gibbs law of the
proved `N`-scaled negative log marginal. -/
theorem marginalTarget_eq_gibbsMeasure {N dθ dx : ℕ} (U : Joint dθ dx → ℝ)
    (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) :
    marginalTarget N U = ULA.gibbsMeasure (fun θ ↦ (N : ℝ) * marginalPotential U θ) := by
  have hw : ULA.gibbsWeight (fun θ ↦ (N : ℝ) * marginalPotential U θ) =
      fun θ ↦ marginalDensity U θ ^ N := by
    funext θ
    have hz := marginalIntegral_pos U m hm hdiff hsc θ
    have he : Real.exp (-((N : ℝ) * marginalPotential U θ)) = marginalIntegral U θ ^ N := by
      dsimp [marginalPotential]
      rw [mul_neg, neg_neg, Real.exp_nat_mul, Real.exp_log hz]
    rw [ULA.gibbsWeight, he, ENNReal.ofReal_pow hz.le,
      marginalDensity_eq_ofReal_integral U m hm hdiff hsc θ]
    rfl
  rw [ULA.gibbsMeasure, ULA.gibbsPartition, hw]
  rfl

/-- Exact finite second-moment bound about any parameter maximizing the actual
latent marginal. Its existence and uniqueness were proved separately. -/
theorem marginalTarget_secondMoment_le {N dθ dx : ℕ} (hN : 0 < N)
    (U : Joint dθ dx → ℝ) (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (θStar : EuclideanSpace ℝ (Fin dθ))
    (hmax : IsMarginalMaximizer U θStar) :
    (∫ θ, ‖θ - θStar‖ ^ 2 ∂marginalTarget N U) ≤
      2 * (dθ : ℝ) / ((N : ℝ) * m) := by
  have hmode := marginalMaximizer_minimizes_potential U m hm hdiff hsc θStar hmax
  have h := ULA.integral_sq_dist_gibbs_le_of_continuous_strongConvex_mode
    (fun θ ↦ (N : ℝ) * marginalPotential U θ) ((N : ℝ) * m)
    (mul_pos (by exact_mod_cast hN) hm)
    (continuous_const.mul (marginalPotential_continuous U m hm hdiff hsc))
    (scaled_marginalPotential_strongConvex U m hm hdiff hsc) θStar
    (fun θ ↦ mul_le_mul_of_nonneg_left (hmode θ) (Nat.cast_nonneg N))
  rw [← marginalTarget_eq_gibbsMeasure U m hm hdiff hsc] at h
  simpa only [finrank_euclideanSpace, Fintype.card_fin] using h

/-- Transfer the proved marginal moment bound to the actual scaled IPLA Gibbs
measure using the exact parameter-marginal identity. -/
theorem gibbsTarget_parameter_secondMoment_le {N dθ dx : ℕ} (hN : 0 < N)
    (U : Joint dθ dx → ℝ) (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (θStar : EuclideanSpace ℝ (Fin dθ))
    (hmax : IsMarginalMaximizer U θStar) :
    (∫ z : State N dθ dx, ‖parameterCLM z - θStar‖ ^ 2 ∂gibbsTarget U) ≤
      2 * (dθ : ℝ) / ((N : ℝ) * m) := by
  have h := marginalTarget_secondMoment_le hN U m hm hdiff hsc θStar hmax
  rw [← gibbsTarget_parameter_marginal hN U m hm hdiff hsc,
    integral_map parameterCLM.continuous.measurable.aemeasurable (by fun_prop)] at h
  exact h

/-- The equilibrium concentration input in IPLA Theorem 1 is a proved theorem
of the original joint assumptions. No gradient-Lipschitz or marginal assumption
is needed for this statistical term. -/
theorem gibbsTarget_parameter_concentration {N dθ dx : ℕ} (hN : 0 < N)
    (U : Joint dθ dx → ℝ) (m : ℝ) (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (θStar : EuclideanSpace ℝ (Fin dθ))
    (hmax : IsMarginalMaximizer U θStar) :
    projectedRMS (@gibbsTarget N dθ dx U) parameterCLM θStar ≤
      ENNReal.ofReal (Real.sqrt (2 * (dθ : ℝ) / ((N : ℝ) * m))) := by
  have : IsProbabilityMeasure (ULA.gibbsMeasure (@potential N dθ dx U)) :=
    ULA.isProbabilityMeasure_gibbsMeasure (potential U) ((N : ℝ) * m)
      (mul_pos (by exact_mod_cast hN) hm)
      (potential_differentiable hdiff) (potential_strongConvex hsc)
  have hi := (ULA.memLp_id_gibbsMeasure (@potential N dθ dx U) ((N : ℝ) * m)
    (mul_pos (by exact_mod_cast hN) hm)
    (potential_differentiable hdiff) (potential_strongConvex hsc)).continuousLinearMap_comp
      (@parameterCLM N dθ dx)
  apply projectedRMS_le_of_secondMoment _ _ _ _ (Real.sqrt_nonneg _)
    (hi.sub (memLp_const θStar))
  rw [Real.sq_sqrt (by positivity : 0 ≤ 2 * (dθ : ℝ) / ((N : ℝ) * m))]
  exact gibbsTarget_parameter_secondMoment_le hN U m hm hdiff hsc θStar hmax

end IPLA


end
end


/-! ## Included source: UnadjustedLangevin/ChainLaw.lean -/
section

/-!
# The law of a recursion driven by independent noise

The law of the algorithm is defined on the canonical product of its initial
law and its noise-path law. Any independent realization has exactly this law.
In particular, changing a coupling of the initial state to a reference state
cannot change the algorithm's output law. All distribution equalities here are
proved pushforward equalities, rather than fields of a supplied structure.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace ULA

variable {H Z : Type*}

/-- A measurable update, driven by a sequence of noise vectors. -/
def noiseDrivenChain (F : H → Z → H) (initial : H) (noise : ℕ → Z) : ℕ → H
  | 0 => initial
  | n + 1 => F (noiseDrivenChain F initial noise n) (noise n)

@[simp] theorem noiseDrivenChain_zero (F : H → Z → H) (initial : H) (noise : ℕ → Z) :
    noiseDrivenChain F initial noise 0 = initial := rfl

@[simp] theorem noiseDrivenChain_succ (F : H → Z → H) (initial : H)
    (noise : ℕ → Z) (n : ℕ) :
    noiseDrivenChain F initial noise (n + 1) =
      F (noiseDrivenChain F initial noise n) (noise n) := rfl

variable [MeasurableSpace H] [MeasurableSpace Z]

/-- Every iterate is a measurable function of the initial state and noise path. -/
theorem noiseDrivenChain_measurable (F : H → Z → H)
    (hF : Measurable (Function.uncurry F)) (n : ℕ) :
    Measurable (fun p : H × (ℕ → Z) ↦ noiseDrivenChain F p.1 p.2 n) := by
  induction n with
  | zero => exact measurable_fst
  | succ n ih =>
      exact hF.comp (ih.prodMk ((measurable_pi_apply n).comp measurable_snd))

/-- The output law is specified only by the initial law and the noise-path law. -/
def chainLaw (F : H → Z → H) (μ : Measure H) (Q : Measure (ℕ → Z)) (n : ℕ) :
    Measure H :=
  (μ.prod Q).map (fun p ↦ noiseDrivenChain F p.1 p.2 n)

/-- The first law is exactly the initial law. -/
@[simp] theorem chainLaw_zero (F : H → Z → H) (μ : Measure H)
    (Q : Measure (ℕ → Z)) [IsProbabilityMeasure Q] : chainLaw F μ Q 0 = μ := by
  simp [chainLaw]

variable {Ω : Type*} [MeasurableSpace Ω]

/-- An independent implementation has the canonical output law. Independence
is requested for the initial state and the entire noise path, which is the
usual assumption that the initialization is independent of all algorithmic
randomness. -/
theorem noiseDrivenChain_law_of_indep (P : Measure Ω) [IsProbabilityMeasure P]
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (X : Ω → H) (W : Ω → ℕ → Z) (hX : AEMeasurable X P)
    (hW : AEMeasurable W P) (hind : IndepFun X W P) (n : ℕ) :
    P.map (fun ω ↦ noiseDrivenChain F (X ω) (W ω) n) =
      chainLaw F (P.map X) (P.map W) n := by
  rw [chainLaw, ← hind.map_prod_eq_prod_map_map hX hW,
    AEMeasurable.map_map_of_aemeasurable
      (noiseDrivenChain_measurable F hF n).aemeasurable (hX.prodMk hW)]
  rfl

/-- The iid hypothesis gives the canonical product path law. -/
theorem noiseDrivenChain_law_of_iid (P : Measure Ω) [IsProbabilityMeasure P]
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (X : Ω → H) (W : ℕ → Ω → Z) (hX : AEMeasurable X P)
    (hW : ∀ n, AEMeasurable (W n) P)
    (hind : IndepFun X (fun ω n ↦ W n ω) P) (hiid : iIndepFun W P)
    (η : Measure Z) (hlaw : ∀ n, P.map (W n) = η) (n : ℕ) :
    P.map (fun ω ↦ noiseDrivenChain F (X ω) (fun k ↦ W k ω) n) =
      chainLaw F (P.map X) (Measure.infinitePi (fun _ : ℕ ↦ η)) n := by
  have hp := hiid.map_fun_eq_infinitePi_map₀' hW
  simp_rw [hlaw] at hp
  rw [noiseDrivenChain_law_of_indep P F hF X (fun ω n ↦ W n ω) hX
    (aemeasurable_pi_iff.mpr hW) hind n, hp]

/-- Two independent implementations with the same initial and iid noise laws
have identical output laws, even on different probability spaces. -/
theorem noiseDrivenChain_law_unique
    {Ω' : Type*} [MeasurableSpace Ω']
    (P : Measure Ω) [IsProbabilityMeasure P]
    (P' : Measure Ω') [IsProbabilityMeasure P']
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (X : Ω → H) (X' : Ω' → H) (W : ℕ → Ω → Z) (W' : ℕ → Ω' → Z)
    (hX : AEMeasurable X P) (hX' : AEMeasurable X' P')
    (hW : ∀ n, AEMeasurable (W n) P) (hW' : ∀ n, AEMeasurable (W' n) P')
    (hind : IndepFun X (fun ω n ↦ W n ω) P)
    (hind' : IndepFun X' (fun ω n ↦ W' n ω) P')
    (hiid : iIndepFun W P) (hiid' : iIndepFun W' P')
    (hinitial : P.map X = P'.map X')
    (η : Measure Z) (hlaw : ∀ n, P.map (W n) = η)
    (hlaw' : ∀ n, P'.map (W' n) = η) (n : ℕ) :
    P.map (fun ω ↦ noiseDrivenChain F (X ω) (fun k ↦ W k ω) n) =
      P'.map (fun ω ↦ noiseDrivenChain F (X' ω) (fun k ↦ W' k ω) n) := by
  rw [noiseDrivenChain_law_of_iid P F hF X W hX hW hind hiid η hlaw n,
    noiseDrivenChain_law_of_iid P' F hF X' W' hX' hW' hind' hiid' η hlaw' n,
    hinitial]

/-- The generic noise-driven recursion is exactly the defined ULA algorithm. -/
theorem noiseDrivenChain_eq_ulaChain {d : ℕ} (U : E d → ℝ) (h : ℝ)
    (x : E d) (w : ℕ → E d) (n : ℕ) :
    noiseDrivenChain (ulaUpdate U h) x w n = ulaChain U h x w n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [noiseDrivenChain_succ, ulaChain_succ, ih]

/-- The ULA update is measurable under the sole Lipschitz-gradient regularity
already assumed by the convergence theorem. -/
theorem ulaUpdate_measurable {d : ℕ} (U : E d → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U)) :
    Measurable (Function.uncurry (ulaUpdate U h)) := by
  have hg : Measurable (gradient U) := hLip.continuous.measurable
  exact (measurable_fst.sub ((hg.comp measurable_fst).const_smul h)).add
    (measurable_snd.const_smul (Real.sqrt (2 * h)))

/-- The law of the actual ULA chain, from iid noise and independent initialization. -/
theorem ulaChain_law_of_iid {d : ℕ} (P : Measure Ω) [IsProbabilityMeasure P]
    (U : E d → ℝ) (h : ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (X : Ω → E d) (W : ℕ → Ω → E d) (hX : AEMeasurable X P)
    (hW : ∀ n, AEMeasurable (W n) P)
    (hind : IndepFun X (fun ω n ↦ W n ω) P) (hiid : iIndepFun W P)
    (η : Measure (E d)) (hlaw : ∀ n, P.map (W n) = η) (n : ℕ) :
    P.map (fun ω ↦ ulaChain U h (X ω) (fun k ↦ W k ω) n) =
      chainLaw (ulaUpdate U h) (P.map X) (Measure.infinitePi (fun _ : ℕ ↦ η)) n := by
  simpa only [noiseDrivenChain_eq_ulaChain] using
    noiseDrivenChain_law_of_iid P (ulaUpdate U h) (ulaUpdate_measurable U h L hLip)
      X W hX hW hind hiid η hlaw n

/-- The `L²` implementation has precisely the same canonical algorithm law.
The representative choice in the quotient space cannot alter this law. -/
theorem lpUlaChain_law_of_iid {d : ℕ} (P : Measure Ω) [IsProbabilityMeasure P]
    (U : E d → ℝ) (h : ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (X : Lp (E d) 2 P) (W : ℕ → Lp (E d) 2 P)
    (hind : IndepFun X (fun ω n ↦ W n ω) P)
    (hiid : iIndepFun (fun n ω ↦ W n ω) P)
    (η : Measure (E d)) (hlaw : ∀ n, P.map (W n) = η) (n : ℕ) :
    P.map (lpUlaChain P U h hLip X W n) =
      chainLaw (ulaUpdate U h) (P.map X) (Measure.infinitePi (fun _ : ℕ ↦ η)) n := by
  rw [Measure.map_congr (lpUlaChain_coe P U h hLip X W n)]
  exact ulaChain_law_of_iid P U h L hLip X (fun n ω ↦ W n ω)
    (Lp.aestronglyMeasurable X).aemeasurable
    (fun n ↦ (Lp.aestronglyMeasurable (W n)).aemeasurable) hind hiid η hlaw n

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/InitialExtension.lean -/
section

/-!
# A concrete independent-noise extension of every initial coupling

For an arbitrary coupling `c` of the algorithm's initialization `μ` and the
reference law `π`, take the product `c.joint.prod Q` with a noise space `Q`.
The two initial states retain exactly their coupled law and cost. The noise
is independent of both states. The output law depends only on `μ` and `Q`.
No optimal coupling, coupling-family axiom, or supplied equality of output
laws is used.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace ULA

variable {H S Z : Type*} [MeasurableSpace H] [MeasurableSpace S] [MeasurableSpace Z]

/-- A coupling of probability measures is a probability measure. -/
theorem Coupling.isProbabilityMeasure {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) : IsProbabilityMeasure c.joint := by
  have : IsProbabilityMeasure (c.joint.map Prod.fst) := by
    rw [c.fst]
    infer_instance
  exact Measure.isProbabilityMeasure_of_map measurable_fst.aemeasurable

/-- The probability space carrying an arbitrary initial coupling and fresh noise. -/
def initialExtension {μ π : Measure H} (c : Coupling μ π) (Q : Measure S) :
    Measure ((H × H) × S) := c.joint.prod Q

/-- Every probability noise space gives a probability extension. -/
theorem initialExtension_isProbabilityMeasure {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (Q : Measure S) [IsProbabilityMeasure Q] :
    IsProbabilityMeasure (initialExtension c Q) := by
  have := c.isProbabilityMeasure
  exact inferInstanceAs (IsProbabilityMeasure (c.joint.prod Q))

/-- The extension preserves the full initial joint distribution. -/
theorem initialExtension_joint {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] :
    (initialExtension c Q).map Prod.fst = c.joint := by
  simp [initialExtension]

/-- The algorithm starts with exactly its specified initial law. -/
theorem initialExtension_initial {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] :
    (initialExtension c Q).map (fun p ↦ p.1.1) = μ := by
  rw [← Function.comp_def, ← Measure.map_map measurable_fst measurable_fst,
    initialExtension_joint, c.fst]

/-- The reference starts with exactly its specified law. -/
theorem initialExtension_reference {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] :
    (initialExtension c Q).map (fun p ↦ p.1.2) = π := by
  rw [← Function.comp_def, ← Measure.map_map measurable_snd measurable_fst,
    initialExtension_joint, c.snd]

/-- The noise marginal is unchanged. -/
theorem initialExtension_noise {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (Q : Measure S) [SFinite Q] :
    (initialExtension c Q).map Prod.snd = Q := by
  have := c.isProbabilityMeasure
  simp [initialExtension]

/-- The fresh noise is independent of the full coupled initial state. -/
theorem initialExtension_independent {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (Q : Measure S) [IsProbabilityMeasure Q] :
    IndepFun Prod.fst Prod.snd (initialExtension c Q) := by
  have := c.isProbabilityMeasure
  exact indepFun_prod measurable_id measurable_id

/-- Projecting out the reference gives precisely the product of the algorithm's
initial law and the noise-space law. -/
theorem initialExtension_initial_noise {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (Q : Measure S) [SFinite Q] :
    (initialExtension c Q).map (fun p ↦ (p.1.1, p.2)) = μ.prod Q := by
  have := c.isProbabilityMeasure
  change (c.joint.prod Q).map (Prod.map Prod.fst id) = _
  simpa only [c.fst, Measure.map_id] using
    (Measure.map_prod_map c.joint Q measurable_fst measurable_id).symm

/-- Every measurable function of the algorithm's initial state and noise has a
law independent of which initial coupling was used. -/
theorem initialExtension_map {T : Type*} [MeasurableSpace T]
    {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (Q : Measure S) [SFinite Q]
    (f : H × S → T) (hf : Measurable f) :
    (initialExtension c Q).map (fun p ↦ f (p.1.1, p.2)) = (μ.prod Q).map f := by
  rw [← initialExtension_initial_noise c Q,
    Measure.map_map hf (measurable_fst.fst.prodMk measurable_snd)]
  rfl

/-- In particular, the output law of the recursive algorithm is the canonical
law for every initial coupling. The noise space may carry Brownian paths,
iid Gaussian sequences, or another explicitly specified noise source. -/
theorem initialExtension_chainLaw {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (Q : Measure (ℕ → Z)) [SFinite Q]
    (F : H → Z → H) (hF : Measurable (Function.uncurry F)) (n : ℕ) :
    (initialExtension c Q).map
      (fun p ↦ noiseDrivenChain F p.1.1 p.2 n) = chainLaw F μ Q n :=
  initialExtension_map c Q _ (noiseDrivenChain_measurable F hF n)

/-- The iid extension has exactly the requested noise marginal at every step. -/
theorem initialExtension_iid_noiseLaw {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (η : Measure Z) [IsProbabilityMeasure η] (n : ℕ) :
    (initialExtension c (Measure.infinitePi (fun _ : ℕ ↦ η))).map
      (fun p ↦ p.2 n) = η := by
  change (initialExtension c (Measure.infinitePi (fun _ : ℕ ↦ η))).map
    ((fun w : ℕ → Z ↦ w n) ∘ Prod.snd) = η
  rw [← Measure.map_map (measurable_pi_apply n) measurable_snd,
    initialExtension_noise, Measure.infinitePi_map_eval]

/-- The iid noise vectors on the extension are mutually independent. -/
theorem initialExtension_iid_independent {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (η : Measure Z) [IsProbabilityMeasure η] :
    iIndepFun (fun n (p : (H × H) × (ℕ → Z)) ↦ p.2 n)
      (initialExtension c (Measure.infinitePi (fun _ : ℕ ↦ η))) := by
  have := initialExtension_isProbabilityMeasure c (Measure.infinitePi (fun _ : ℕ ↦ η))
  apply (iIndepFun_iff_map_fun_eq_infinitePi_map (by fun_prop)).mpr
  simp only [initialExtension_iid_noiseLaw, initialExtension_noise]

/-- The initial state is independent of the complete iid noise sequence. -/
theorem initialExtension_initial_independent {μ π : Measure H} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (Q : Measure S) [IsProbabilityMeasure Q] :
    IndepFun (fun p : (H × H) × S ↦ p.1.1) Prod.snd (initialExtension c Q) :=
  (initialExtension_independent c Q).comp measurable_fst measurable_id

section Cost

variable [NormedAddCommGroup H] [BorelSpace H] [SecondCountableTopology H]

/-- The extension retains exactly the quadratic cost of the given coupling. -/
theorem initialExtension_cost {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] :
    eLpNorm (fun p : (H × H) × S ↦ p.1.1 - p.1.2) 2 (initialExtension c Q) =
      couplingCost c.joint := by
  exact eLpNorm_comp_measurePreserving
    (g := fun p : H × H ↦ p.1 - p.2) (p := 2) (by fun_prop)
    (measurePreserving_fst (μ := c.joint) (ν := Q))

/-- Finite cost gives an actual square-integrable difference on the extension. -/
theorem initialExtension_memLp_difference {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] (hc : couplingCost c.joint ≠ ⊤) :
    MemLp (fun p : (H × H) × S ↦ p.1.1 - p.1.2) 2 (initialExtension c Q) := by
  change eLpNorm _ 2 _ < ⊤
  rw [initialExtension_cost]
  exact lt_top_iff_ne_top.mpr hc

omit [BorelSpace H] [SecondCountableTopology H] in
/-- Square integrability of the reference law lifts to its coordinate. -/
theorem initialExtension_memLp_reference {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q]
    (hπ : MemLp (fun x : H ↦ x) 2 π) :
    MemLp (fun p : (H × H) × S ↦ p.1.2) 2 (initialExtension c Q) := by
  have hmap : MemLp (fun x : H ↦ x) 2
      ((initialExtension c Q).map (fun p ↦ p.1.2)) := by
    rw [initialExtension_reference]
    exact hπ
  exact hmap.comp_of_map (by fun_prop)

/-- Finite coupling cost and the reference's second moment give a square
integrable initialization on every extension; no extra moment assumption is
introduced for the initial law. -/
theorem initialExtension_memLp_initial {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : H ↦ x) 2 π) :
    MemLp (fun p : (H × H) × S ↦ p.1.1) 2 (initialExtension c Q) := by
  simpa only [Pi.add_def, sub_add_cancel] using
    (initialExtension_memLp_difference c Q hc).add
      (initialExtension_memLp_reference c Q hπ)

/-- An actual `L²` initialization realizing the first coupling coordinate. -/
def initialExtension_lpInitial {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : H ↦ x) 2 π) : Lp H 2 (initialExtension c Q) :=
  (initialExtension_memLp_initial c Q hc hπ).toLp (fun p ↦ p.1.1)

/-- An actual `L²` reference initialization realizing the second coordinate. -/
def initialExtension_lpReference {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q]
    (hπ : MemLp (fun x : H ↦ x) 2 π) : Lp H 2 (initialExtension c Q) :=
  (initialExtension_memLp_reference c Q hπ).toLp (fun p ↦ p.1.2)

/-- Taking an `L²` representative does not change the initial law. -/
theorem initialExtension_lpInitial_law {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : H ↦ x) 2 π) :
    (initialExtension c Q).map (initialExtension_lpInitial c Q hc hπ) = μ := by
  unfold initialExtension_lpInitial
  rw [Measure.map_congr (initialExtension_memLp_initial c Q hc hπ).coeFn_toLp]
  exact initialExtension_initial c Q

omit [BorelSpace H] [SecondCountableTopology H] in
/-- Taking an `L²` representative does not change the reference's initial law. -/
theorem initialExtension_lpReference_law {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q]
    (hπ : MemLp (fun x : H ↦ x) 2 π) :
    (initialExtension c Q).map (initialExtension_lpReference c Q hπ) = π := by
  unfold initialExtension_lpReference
  rw [Measure.map_congr (initialExtension_memLp_reference c Q hπ).coeFn_toLp]
  exact initialExtension_reference c Q

/-- The `L²` distance of the constructed initializations equals the exact
initial coupling cost. This discharges, rather than assumes, initialCost. -/
theorem initialExtension_lp_cost {μ π : Measure H} (c : Coupling μ π)
    (Q : Measure S) [IsProbabilityMeasure Q] (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : H ↦ x) 2 π) :
    ‖initialExtension_lpInitial c Q hc hπ - initialExtension_lpReference c Q hπ‖ =
      (couplingCost c.joint).toReal := by
  rw [Lp.norm_def]
  have hae : initialExtension_lpInitial c Q hc hπ - initialExtension_lpReference c Q hπ
      =ᵐ[initialExtension c Q] fun p ↦ p.1.1 - p.1.2 :=
    (Lp.coeFn_sub _ _).trans
      ((initialExtension_memLp_initial c Q hc hπ).coeFn_toLp.sub
        (initialExtension_memLp_reference c Q hπ).coeFn_toLp)
  rw [eLpNorm_congr_ae hae, initialExtension_cost]

end Cost
end ULA


end
end


/-! ## Included source: UnadjustedLangevin/ProductReference.lean -/
section

set_option linter.style.header false

/-!
# Dalalyan's initial Wasserstein term on concrete product extensions

The reference diffusion may be realized separately for each initial coupling.
The sample space is always `(H × H) × S`, with probability measure
`c.joint.prod Q`. The noise source `Q` and all noise functions are fixed.
Consequently the algorithm's law is proved to be the same for every `c`.

This analytic interface takes an explicit continuous reference construction.
`UnadjustedLangevin/CanonicalULA.lean` supplies that construction from the
potential assumptions. Initial-law realization, initial cost, square
integrability, output-law independence, and the transport infimum are proved here.
-/

noncomputable section
open MeasureTheory
open scoped NNReal ENNReal

namespace ULA.Hilbert
open ULA

variable {H S : Type*}
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H]
  [MeasurableSpace S]

/-- The ordinary ULA update in an arbitrary Euclidean presentation. -/
def pointwiseUpdate (U : H → ℝ) (h : ℝ) (x z : H) : H :=
  x - h • gradient U x + Real.sqrt (2 * h) • z

/-- Gradient Lipschitz regularity suffices for update measurability. -/
theorem pointwiseUpdate_measurable (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U)) :
    Measurable (Function.uncurry (pointwiseUpdate U h)) := by
  have hg : Measurable (gradient U) := hLip.continuous.measurable
  exact (measurable_fst.sub ((hg.comp measurable_fst).const_smul h)).add
    (measurable_snd.const_smul (Real.sqrt (2 * h)))

variable {μ π : Measure H} [IsProbabilityMeasure μ]
  (Q : Measure S) [IsProbabilityMeasure Q]

local instance productProbability (c : Coupling μ π) :
    IsProbabilityMeasure (initialExtension c Q) := initialExtension_isProbabilityMeasure c Q

omit [InnerProductSpace ℝ H] [CompleteSpace H] [BorelSpace H]
  [SecondCountableTopology H] in
/-- A square-integrable noise function lifts to every initial-coupling extension. -/
theorem productNoise_memLp (c : Coupling μ π) (W : ℕ → S → H)
    (hW : ∀ n, MemLp (W n) 2 Q) (n : ℕ) :
    MemLp (fun p : (H × H) × S ↦ W n p.2) 2 (initialExtension c Q) := by
  have := c.isProbabilityMeasure
  exact (hW n).comp_measurePreserving measurePreserving_snd

/-- The common noise, as an actual `L²` random variable on each product space. -/
def productNoise (c : Coupling μ π) (W : ℕ → S → H)
    (hW : ∀ n, MemLp (W n) 2 Q) (n : ℕ) : Lp H 2 (initialExtension c Q) :=
  (productNoise_memLp Q c W hW n).toLp (fun p ↦ W n p.2)

omit [InnerProductSpace ℝ H] [CompleteSpace H] [BorelSpace H]
  [SecondCountableTopology H] in
/-- The chosen `L²` representative agrees with the original noise. -/
theorem productNoise_coe (c : Coupling μ π) (W : ℕ → S → H)
    (hW : ∀ n, MemLp (W n) 2 Q) (n : ℕ) :
    productNoise Q c W hW n =ᵐ[initialExtension c Q] fun p ↦ W n p.2 :=
  (productNoise_memLp Q c W hW n).coeFn_toLp

/-- The algorithm law uses the initial law and the fixed noise source only. -/
def productOutputLaw (U : H → ℝ) (h : ℝ) (μ : Measure H)
    (W : ℕ → S → H) (n : ℕ) : Measure H :=
  (μ.prod Q).map (fun p ↦ noiseDrivenChain (pointwiseUpdate U h) p.1
    (fun k ↦ W k p.2) n)

/-- The `L²` recursion equals the original noise-driven algorithm almost
everywhere on every concrete initial-coupling extension. -/
theorem product_chain_coe (c : Coupling μ π) (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : H ↦ x) 2 π)
    (U : H → ℝ) (h : ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (W : ℕ → S → H) (hW : ∀ n, MemLp (W n) 2 Q) (n : ℕ) :
    lpChain (initialExtension c Q) U h hLip
      (initialExtension_lpInitial c Q hc hπ) (productNoise Q c W hW) n
      =ᵐ[initialExtension c Q] fun p ↦
        noiseDrivenChain (pointwiseUpdate U h) p.1.1 (fun k ↦ W k p.2) n := by
  induction n with
  | zero => exact (initialExtension_memLp_initial c Q hc hπ).coeFn_toLp
  | succ n ih =>
      filter_upwards [lpUlaUpdate_coe (initialExtension c Q) U h hLip
          (lpChain (initialExtension c Q) U h hLip
            (initialExtension_lpInitial c Q hc hπ) (productNoise Q c W hW) n)
          (productNoise Q c W hW n), ih, productNoise_coe Q c W hW n]
        with p hupdate hprev hnoise
      simpa only [lpChain_succ, noiseDrivenChain_succ, pointwiseUpdate, hprev, hnoise]
        using hupdate

/-- Equality of the output law is derived; it is never a supplied hypothesis. -/
theorem product_chain_outputLaw (c : Coupling μ π) (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : H ↦ x) 2 π)
    (U : H → ℝ) (h : ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (W : ℕ → S → H) (hW : ∀ n, MemLp (W n) 2 Q) (n : ℕ) :
    (initialExtension c Q).map (lpChain (initialExtension c Q) U h hLip
      (initialExtension_lpInitial c Q hc hπ) (productNoise Q c W hW) n) =
      productOutputLaw Q U h μ W n := by
  rw [Measure.map_congr (product_chain_coe Q c hc hπ U h L hLip W hW n)]
  have hpath : AEMeasurable (fun w k ↦ W k w) Q :=
    aemeasurable_pi_iff.mpr fun k ↦ (hW k).aestronglyMeasurable.aemeasurable
  let path : S → ℕ → H := hpath.mk (fun w k ↦ W k w)
  have hpath_eq : (fun w k ↦ W k w) =ᵐ[Q] path := hpath.ae_eq_mk
  have hleft : (fun p : (H × H) × S ↦
      noiseDrivenChain (pointwiseUpdate U h) p.1.1 (fun k ↦ W k p.2) n)
      =ᵐ[initialExtension c Q] fun p ↦
      noiseDrivenChain (pointwiseUpdate U h) p.1.1 (path p.2) n := by
    have := c.isProbabilityMeasure
    have heq := (measurePreserving_snd (μ := c.joint) (ν := Q)).quasiMeasurePreserving.ae_eq_comp
      hpath_eq
    filter_upwards [heq] with p hp
    simp only [Function.comp_apply] at hp
    rw [hp]
  have hright : (fun p : H × S ↦
      noiseDrivenChain (pointwiseUpdate U h) p.1 (fun k ↦ W k p.2) n)
      =ᵐ[μ.prod Q] fun p ↦
      noiseDrivenChain (pointwiseUpdate U h) p.1 (path p.2) n := by
    have heq := (measurePreserving_snd (μ := μ) (ν := Q)).quasiMeasurePreserving.ae_eq_comp hpath_eq
    filter_upwards [heq] with p hp
    simp only [Function.comp_apply] at hp
    rw [hp]
  rw [Measure.map_congr hleft, productOutputLaw, Measure.map_congr hright]
  exact initialExtension_map c Q
    (fun p : H × S ↦ noiseDrivenChain (pointwiseUpdate U h) p.1 (path p.2) n)
    ((noiseDrivenChain_measurable (pointwiseUpdate U h)
      (pointwiseUpdate_measurable U h L hLip) n).comp
        (measurable_fst.prodMk (hpath.measurable_mk.comp measurable_snd)))

/-- A concrete reference constructor for every finite-cost coupling. The
stationary diffusion construction supplies these values; no law-of-algorithm
or convergence estimate is a field of this interface. -/
structure ProductReference (d : ℕ) (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U)) (μ π : Measure H) [IsProbabilityMeasure μ]
    (hπ : MemLp (fun x : H ↦ x) 2 π)
    (W : ℕ → S → H) (hW : ∀ n, MemLp (W n) 2 Q) where
  reference : ∀ (c : Coupling μ π) (_ : couplingCost c.joint ≠ ⊤),
    L2Reference (initialExtension c Q) d U h L hLip (productNoise Q c W hW) π
  start : ∀ c hc, (reference c hc).segment 0 0 = initialExtension_lpReference c Q hπ

/-- Finiteness of the output transport distance follows from one finite-cost
initial coupling and its constructed reference. -/
theorem ProductReference.output_finite
    {d : ℕ} {U : H → ℝ} {h : ℝ} {L : ℝ≥0} {hLip : LipschitzWith L (gradient U)}
    {hπ : MemLp (fun x : H ↦ x) 2 π}
    {W : ℕ → S → H} {hW : ∀ n, MemLp (W n) 2 Q}
    (ref : ProductReference Q d U h L hLip μ π hπ W hW)
    (hfinite : wasserstein2 μ π ≠ ⊤) (n : ℕ) :
    wasserstein2 (productOutputLaw Q U h μ W n) π ≠ ⊤ := by
  obtain ⟨c, hc⟩ := exists_finiteCost_coupling μ π hfinite
  have hb := wasserstein2_le_Lp_cost (initialExtension c Q)
    (lpChain (initialExtension c Q) U h hLip
      (initialExtension_lpInitial c Q (ne_of_lt hc) hπ) (productNoise Q c W hW) n)
    ((ref.reference c (ne_of_lt hc)).segment n 0)
  rw [product_chain_outputLaw Q c (ne_of_lt hc) hπ U h L hLip W hW n,
    (ref.reference c (ne_of_lt hc)).stationary n] at hb
  exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top hb

/-- Dalalyan's bound with the genuine initial Wasserstein distance. Each
initial coupling uses its own explicitly defined product probability measure.
Its output law and initial coupling cost have already been proved above. -/
theorem dalalyan_small_step_of_product_reference
    (d : ℕ) (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (hm : 0 < m) (hmL : m ≤ (L : ℝ))
    (hh : 0 < h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (hπ : MemLp (fun x : H ↦ x) 2 π)
    (W : ℕ → S → H) (hW : ∀ n, MemLp (W n) 2 Q)
    (hfinite : wasserstein2 μ π ≠ ⊤)
    (ref : ProductReference Q d U h L hLip μ π hπ W hW) (n : ℕ) :
    wasserstein2Real (productOutputLaw Q U h μ W n) π ≤
      (1 - m * h) ^ n * wasserstein2Real μ π +
        (33 / 20 : ℝ) * ((L : ℝ) / m) * Real.sqrt (h * d) := by
  have hpos : 0 < m + (L : ℝ) := by positivity
  have hproduct := (le_div_iff₀ hpos).mp hsmall
  have hq : 0 ≤ 1 - m * h := by
    nlinarith [mul_nonneg hh.le (sub_nonneg.mpr hmL)]
  let a : ℝ≥0 := ⟨(1 - m * h) ^ n, pow_nonneg hq n⟩
  let b : ℝ≥0 := ⟨(33 / 20 : ℝ) * ((L : ℝ) / m) * Real.sqrt (h * d), by positivity⟩
  apply wasserstein2_affine_bound_real_of_finite_couplings μ π
    (productOutputLaw Q U h μ W n) π a b hfinite (ref.output_finite Q hfinite n)
  intro c hc
  have hb := dalalyan_small_step_of_integral_reference (initialExtension c Q) d
    U m h L hdiff hsc hLip hm hmL hh hsmall
      (initialExtension_lpInitial c Q hc hπ) (productNoise Q c W hW) π
      (ref.reference c hc) n
  rw [product_chain_outputLaw Q c hc hπ U h L hLip W hW n, ref.start c hc,
    initialExtension_lp_cost c Q hc hπ] at hb
  exact hb

/-- The large-step Dalalyan branch with the genuine initial Wasserstein
distance, using the same concrete product extensions as the small-step branch. -/
theorem dalalyan_large_step_of_product_reference
    (d : ℕ) (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (hm : 0 < m) (hmL : m ≤ (L : ℝ))
    (hh : 0 < h) (hlarge : 2 / (m + (L : ℝ)) ≤ h) (hstep : (L : ℝ) * h < 2)
    (hπ : MemLp (fun x : H ↦ x) 2 π)
    (W : ℕ → S → H) (hW : ∀ n, MemLp (W n) 2 Q)
    (hfinite : wasserstein2 μ π ≠ ⊤)
    (ref : ProductReference Q d U h L hLip μ π hπ W hW) (n : ℕ) :
    wasserstein2Real (productOutputLaw Q U h μ W n) π ≤
      ((L : ℝ) * h - 1) ^ n * wasserstein2Real μ π +
        ((33 / 20 : ℝ) * (L : ℝ) * h / (2 - (L : ℝ) * h)) * Real.sqrt (h * d) := by
  have hpos : 0 < m + (L : ℝ) := by positivity
  have hproduct := (div_le_iff₀ hpos).mp hlarge
  have hq : 0 ≤ (L : ℝ) * h - 1 := by
    nlinarith [mul_nonneg hh.le (sub_nonneg.mpr hmL)]
  let a : ℝ≥0 := ⟨((L : ℝ) * h - 1) ^ n, pow_nonneg hq n⟩
  let b : ℝ≥0 := ⟨((33 / 20 : ℝ) * (L : ℝ) * h / (2 - (L : ℝ) * h)) *
    Real.sqrt (h * d), by positivity⟩
  apply wasserstein2_affine_bound_real_of_finite_couplings μ π
    (productOutputLaw Q U h μ W n) π a b hfinite (ref.output_finite Q hfinite n)
  intro c hc
  have hb := dalalyan_large_step_of_integral_reference (initialExtension c Q) d
    U m h L hdiff hsc hLip hm hmL hh hlarge hstep
      (initialExtension_lpInitial c Q hc hπ) (productNoise Q c W hW) π
      (ref.reference c hc) n
  rw [product_chain_outputLaw Q c hc hπ U h L hLip W hW n, ref.start c hc,
    initialExtension_lp_cost c Q hc hπ] at hb
  exact hb

end ULA.Hilbert


end
end


/-! ## Included source: UnadjustedLangevin/GaussianMoments.lean -/
section

/-!
# Gaussian and Brownian noise moments in Euclidean space

The square-root noise estimate is proved from Gaussian coordinate laws.
Independence is unnecessary for this particular second-moment calculation:
the squared Euclidean norm is a sum of coordinate squares, with no cross terms.
The Brownian specialization uses mathlib's actual Brownian marginal-law theorem.
-/

noncomputable section

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace ULA

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {d : ℕ}

/-- The second moment of a centered real Gaussian is its variance parameter. -/
theorem centered_gaussian_second_moment (v : ℝ≥0) :
    (∫ x : ℝ, x ^ 2 ∂gaussianReal 0 v) = (v : ℝ) := by
  have hv := variance_fun_id_gaussianReal (μ := 0) (v := v)
  rw [variance_eq_integral measurable_id'.aemeasurable, integral_id_gaussianReal] at hv
  simpa only [sub_zero] using hv

/-- Gaussian coordinate laws imply genuine square integrability of a vector. -/
theorem gaussian_vector_memLp (X : Ω → E d) (v : ℝ≥0)
    (hlaw : ∀ i : Fin d, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    MemLp X 2 P := by
  apply memLp_piLp_iff.mpr
  intro i
  exact (hlaw i).memLp (memLp_id_gaussianReal (2 : ℝ≥0))

/-- Summing exact Gaussian coordinate moments gives the dimension factor. -/
theorem gaussian_vector_second_moment (X : Ω → E d) (v : ℝ≥0)
    (hlaw : ∀ i : Fin d, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    (∫ ω, ‖X ω‖ ^ 2 ∂P) = (d : ℝ) * (v : ℝ) := by
  have hmem (i : Fin d) : MemLp (fun ω ↦ X ω i) 2 P :=
    (hlaw i).memLp (memLp_id_gaussianReal (2 : ℝ≥0))
  have hmom (i : Fin d) : (∫ ω, (X ω i) ^ 2 ∂P) = (v : ℝ) := by
    exact (hlaw i).integral_comp (f := fun x : ℝ ↦ x ^ 2) (by fun_prop) |>.trans
      (centered_gaussian_second_moment v)
  simp_rw [EuclideanSpace.real_norm_sq_eq]
  rw [integral_finsetSum _ (fun i _ ↦ (hmem i).integrable_sq)]
  simp only [hmom, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

/-- Its L² representative has the same exact second moment. -/
theorem gaussian_vector_toLp_norm_sq (X : Ω → E d) (v : ℝ≥0)
    (hlaw : ∀ i : Fin d, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    ‖(gaussian_vector_memLp P X v hlaw).toLp X‖ ^ 2 = (d : ℝ) * (v : ℝ) := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  have hid : (∫ ω, inner ℝ
      ((gaussian_vector_memLp P X v hlaw).toLp X ω)
      ((gaussian_vector_memLp P X v hlaw).toLp X ω) ∂P) = ∫ ω, ‖X ω‖ ^ 2 ∂P := by
    apply integral_congr_ae
    filter_upwards [(gaussian_vector_memLp P X v hlaw).coeFn_toLp] with ω hω
    rw [hω, real_inner_self_eq_norm_sq]
  rw [hid, gaussian_vector_second_moment P X v hlaw]

/-- The exact square-root Gaussian L² norm, including zero dimension or variance. -/
theorem gaussian_vector_toLp_norm (X : Ω → E d) (v : ℝ≥0)
    (hlaw : ∀ i : Fin d, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    ‖(gaussian_vector_memLp P X v hlaw).toLp X‖ = Real.sqrt ((d : ℝ) * (v : ℝ)) := by
  rw [← gaussian_vector_toLp_norm_sq P X v hlaw, Real.sqrt_sq (norm_nonneg _)]

/-- The Langevin scaling `√2` gives precisely the noise moment `√(2dv)`. -/
theorem gaussian_vector_scaled_l2_norm (X : Ω → E d) (v : ℝ≥0)
    (hlaw : ∀ i : Fin d, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    ‖Real.sqrt 2 • (gaussian_vector_memLp P X v hlaw).toLp X‖ =
      Real.sqrt (2 * (d : ℝ)) * Real.sqrt (v : ℝ) := by
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _),
    gaussian_vector_toLp_norm P X v hlaw,
    Real.sqrt_mul (by positivity : (0 : ℝ) ≤ d),
    Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2)]
  ring

/-- Assemble scalar Brownian coordinates into the Euclidean noise vector. -/
def brownianVector (W : Fin d → ℝ≥0 → Ω → ℝ) (t : ℝ≥0) : Ω → E d :=
  fun ω ↦ WithLp.toLp 2 (fun i ↦ W i t ω)

/-- Mathlib's Brownian marginal laws supply the Gaussian hypotheses above. -/
theorem brownianVector_coordinate_law (W : Fin d → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t : ℝ≥0) (i : Fin d) :
    HasLaw (fun ω ↦ brownianVector W t ω i) (gaussianReal 0 t) P :=
  (hW i).hasLaw_eval t

/-- A Brownian vector at any nonnegative time has finite second moment. -/
theorem brownianVector_memLp (W : Fin d → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t : ℝ≥0) :
    MemLp (brownianVector W t) 2 P :=
  gaussian_vector_memLp P (brownianVector W t) t (brownianVector_coordinate_law P W hW t)

/-- The noise moment used by Dalalyan's proof follows from Brownian laws. -/
theorem brownianVector_scaled_l2_norm (W : Fin d → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t : ℝ≥0) :
    ‖Real.sqrt 2 • (brownianVector_memLp P W hW t).toLp (brownianVector W t)‖ =
      Real.sqrt (2 * (d : ℝ)) * Real.sqrt (t : ℝ) :=
  gaussian_vector_scaled_l2_norm P (brownianVector W t) t
    (brownianVector_coordinate_law P W hW t)

/-- The Brownian vector increment over the interval from `a` to `a+t`. -/
def brownianVectorIncrement (W : Fin d → ℝ≥0 → Ω → ℝ) (a t : ℝ≥0) : Ω → E d :=
  fun ω ↦ brownianVector W (a + t) ω - brownianVector W a ω

/-- Brownian increments have variance equal to the elapsed time, at every
starting time. This uses the actual Brownian marginal difference law. -/
theorem brownianVectorIncrement_coordinate_law (W : Fin d → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ≥0) (i : Fin d) :
    HasLaw (fun ω ↦ brownianVectorIncrement W a t ω i) (gaussianReal 0 t) P := by
  change HasLaw (fun ω ↦ W i (a + t) ω - W i a ω) (gaussianReal 0 t) P
  convert (hW i).hasLaw_sub (a + t) a using 1
  congr 1
  apply NNReal.eq
  simp only [coe_nndist, Real.dist_eq]
  change (t : ℝ) = |((a : ℝ) + (t : ℝ)) - (a : ℝ)|
  rw [add_sub_cancel_left, abs_of_nonneg t.coe_nonneg]

/-- The vector increment is a genuinely square-integrable random variable. -/
theorem brownianVectorIncrement_memLp (W : Fin d → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ≥0) :
    MemLp (brownianVectorIncrement W a t) 2 P :=
  gaussian_vector_memLp P (brownianVectorIncrement W a t) t
    (brownianVectorIncrement_coordinate_law P W hW a t)

/-- Every reference segment has the same exact Langevin noise L² norm,
`√(2d)√t`, regardless of its starting time. -/
theorem brownianVector_increment_scaled_l2_norm (W : Fin d → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ≥0) :
    ‖Real.sqrt 2 • (brownianVectorIncrement_memLp P W hW a t).toLp
      (brownianVectorIncrement W a t)‖ =
      Real.sqrt (2 * (d : ℝ)) * Real.sqrt (t : ℝ) :=
  gaussian_vector_scaled_l2_norm P (brownianVectorIncrement W a t) t
    (brownianVectorIncrement_coordinate_law P W hW a t)

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/GaussianCoordinates.lean -/
section

set_option linter.style.header false

/-!
# Gaussian and Brownian moments for arbitrary finite coordinate sets

The previous Gaussian moment lemmas use `Fin d`. IPLA uses the product set of
particle blocks and within-block coordinates. This module supplies the same
exact moment bounds for `EuclideanSpace ℝ ι`, for any finite coordinate set.
Only marginal coordinate laws are needed for second moments; independence is
not added as an unnecessary hypothesis.
-/

noncomputable section

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace ULA

variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
  (P : Measure Ω)

/-- Gaussian coordinate laws imply square integrability on any finite
Euclidean coordinate space. -/
theorem gaussian_coordinates_memLp (X : Ω → EuclideanSpace ℝ ι) (v : ℝ≥0)
    (hlaw : ∀ i : ι, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    MemLp X 2 P := by
  apply memLp_piLp_iff.mpr
  intro i
  exact (hlaw i).memLp (memLp_id_gaussianReal (2 : ℝ≥0))

/-- The dimension factor is the exact cardinality of the coordinate set. -/
theorem gaussian_coordinates_second_moment (X : Ω → EuclideanSpace ℝ ι) (v : ℝ≥0)
    (hlaw : ∀ i : ι, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    (∫ ω, ‖X ω‖ ^ 2 ∂P) = (Fintype.card ι : ℝ) * (v : ℝ) := by
  have hmem (i : ι) : MemLp (fun ω ↦ X ω i) 2 P :=
    (hlaw i).memLp (memLp_id_gaussianReal (2 : ℝ≥0))
  have hmom (i : ι) : (∫ ω, (X ω i) ^ 2 ∂P) = (v : ℝ) := by
    exact (hlaw i).integral_comp (f := fun x : ℝ ↦ x ^ 2) (by fun_prop) |>.trans
      (centered_gaussian_second_moment v)
  simp_rw [EuclideanSpace.real_norm_sq_eq]
  rw [integral_finsetSum _ (fun i _ ↦ (hmem i).integrable_sq)]
  simp only [hmom, Finset.sum_const, Finset.card_univ, nsmul_eq_mul]

/-- Exact norm identity for an existing `L²` Gaussian vector. -/
theorem gaussian_coordinates_Lp_norm_sq (X : Lp (EuclideanSpace ℝ ι) 2 P) (v : ℝ≥0)
    (hlaw : ∀ i : ι, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    ‖X‖ ^ 2 = (Fintype.card ι : ℝ) * (v : ℝ) := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  simpa only [real_inner_self_eq_norm_sq] using
    gaussian_coordinates_second_moment P X v hlaw

/-- Exact square-root norm identity for an existing `L²` Gaussian vector. -/
theorem gaussian_coordinates_Lp_norm (X : Lp (EuclideanSpace ℝ ι) 2 P) (v : ℝ≥0)
    (hlaw : ∀ i : ι, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    ‖X‖ = Real.sqrt ((Fintype.card ι : ℝ) * (v : ℝ)) := by
  rw [← gaussian_coordinates_Lp_norm_sq P X v hlaw,
    Real.sqrt_sq (norm_nonneg _)]

/-- Its `L²` representative has the original Gaussian coordinate laws. -/
theorem gaussian_coordinates_toLp_coordinateLaw
    (X : Ω → EuclideanSpace ℝ ι) (v : ℝ≥0)
    (hlaw : ∀ i : ι, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) (i : ι) :
    HasLaw (fun ω ↦ (gaussian_coordinates_memLp P X v hlaw).toLp X ω i)
      (gaussianReal 0 v) P := by
  exact (hlaw i).congr
    ((gaussian_coordinates_memLp P X v hlaw).coeFn_toLp.fun_comp (fun z ↦ z i))

/-- Exact square-root norm of the canonical `L²` representative. -/
theorem gaussian_coordinates_toLp_norm (X : Ω → EuclideanSpace ℝ ι) (v : ℝ≥0)
    (hlaw : ∀ i : ι, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    ‖(gaussian_coordinates_memLp P X v hlaw).toLp X‖ =
      Real.sqrt ((Fintype.card ι : ℝ) * (v : ℝ)) :=
  gaussian_coordinates_Lp_norm P _ v
    (gaussian_coordinates_toLp_coordinateLaw P X v hlaw)

/-- The `√2` Langevin scaling gives exactly the required local-noise radius. -/
theorem gaussian_coordinates_scaled_l2_norm (X : Ω → EuclideanSpace ℝ ι) (v : ℝ≥0)
    (hlaw : ∀ i : ι, HasLaw (fun ω ↦ X ω i) (gaussianReal 0 v) P) :
    ‖Real.sqrt 2 • (gaussian_coordinates_memLp P X v hlaw).toLp X‖ =
      Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt (v : ℝ) := by
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _),
    gaussian_coordinates_toLp_norm P X v hlaw,
    Real.sqrt_mul (by positivity : (0 : ℝ) ≤ Fintype.card ι),
    Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2)]
  ring

/-- Assemble scalar Brownian coordinates in any finite Euclidean space. -/
def brownianCoordinates (W : ι → ℝ≥0 → Ω → ℝ) (t : ℝ≥0) :
    Ω → EuclideanSpace ℝ ι :=
  fun ω ↦ WithLp.toLp 2 (fun i ↦ W i t ω)

omit [Fintype ι] in
/-- Actual scalar Brownian laws give the vector's coordinate laws. -/
theorem brownianCoordinates_coordinateLaw (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t : ℝ≥0) (i : ι) :
    HasLaw (fun ω ↦ brownianCoordinates W t ω i) (gaussianReal 0 t) P :=
  (hW i).hasLaw_eval t

/-- A Brownian vector increment over an arbitrary starting time. -/
def brownianCoordinatesIncrement (W : ι → ℝ≥0 → Ω → ℝ) (a t : ℝ≥0) :
    Ω → EuclideanSpace ℝ ι :=
  fun ω ↦ brownianCoordinates W (a + t) ω - brownianCoordinates W a ω

omit [Fintype ι] in
/-- Every coordinate increment has Gaussian variance equal to elapsed time. -/
theorem brownianCoordinatesIncrement_coordinateLaw (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ≥0) (i : ι) :
    HasLaw (fun ω ↦ brownianCoordinatesIncrement W a t ω i) (gaussianReal 0 t) P := by
  change HasLaw (fun ω ↦ W i (a + t) ω - W i a ω) (gaussianReal 0 t) P
  convert (hW i).hasLaw_sub (a + t) a using 1
  congr 1
  apply NNReal.eq
  simp only [coe_nndist, Real.dist_eq]
  change (t : ℝ) = |((a : ℝ) + (t : ℝ)) - (a : ℝ)|
  rw [add_sub_cancel_left, abs_of_nonneg t.coe_nonneg]

/-- Brownian increments are square integrable in the full vector space. -/
theorem brownianCoordinatesIncrement_memLp (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ≥0) :
    MemLp (brownianCoordinatesIncrement W a t) 2 P :=
  gaussian_coordinates_memLp P _ t
    (brownianCoordinatesIncrement_coordinateLaw P W hW a t)

/-- The exact Langevin noise moment is derived from Brownian laws; no supplied
moment inequality or independence premise is required. -/
theorem brownianCoordinatesIncrement_scaled_l2_norm (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ≥0) :
    ‖Real.sqrt 2 • (brownianCoordinatesIncrement_memLp P W hW a t).toLp
      (brownianCoordinatesIncrement W a t)‖ =
      Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt (t : ℝ) :=
  gaussian_coordinates_scaled_l2_norm P _ t
    (brownianCoordinatesIncrement_coordinateLaw P W hW a t)

/-- Brownian coordinates as canonical square-integrable random variables. -/
def brownianCoordinatesLp (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t : ℝ≥0) :
    Lp (EuclideanSpace ℝ ι) 2 P :=
  (gaussian_coordinates_memLp P (brownianCoordinates W t) t
    (brownianCoordinates_coordinateLaw P W hW t)).toLp (brownianCoordinates W t)

/-- The canonical `L²` Brownian vector agrees with the coordinate process. -/
theorem brownianCoordinatesLp_coe (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t : ℝ≥0) :
    brownianCoordinatesLp P W hW t =ᵐ[P] brownianCoordinates W t :=
  (gaussian_coordinates_memLp P (brownianCoordinates W t) t
    (brownianCoordinates_coordinateLaw P W hW t)).coeFn_toLp

/-- Canonical `L²` Brownian differences have the actual Gaussian increment law
in every coordinate, including differences with reversed time order. -/
theorem brownianCoordinatesLp_sub_coordinateLaw (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t s : ℝ≥0) (i : ι) :
    HasLaw (fun ω ↦ (brownianCoordinatesLp P W hW t -
      brownianCoordinatesLp P W hW s) ω i)
      (gaussianReal 0 (nndist (t : ℝ) (s : ℝ))) P := by
  apply (hW i).hasLaw_sub t s |>.congr
  filter_upwards [Lp.coeFn_sub (brownianCoordinatesLp P W hW t)
      (brownianCoordinatesLp P W hW s),
    brownianCoordinatesLp_coe P W hW t, brownianCoordinatesLp_coe P W hW s]
    with ω hsub ht hs
  simp only [hsub, ht, hs, brownianCoordinates, Pi.sub_apply, PiLp.sub_apply]

/-- The exact `L²` norm of an arbitrary Brownian difference. -/
theorem brownianCoordinatesLp_norm_sub (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t s : ℝ≥0) :
    ‖brownianCoordinatesLp P W hW t - brownianCoordinatesLp P W hW s‖ =
      Real.sqrt ((Fintype.card ι : ℝ) * dist (t : ℝ) (s : ℝ)) := by
  simpa only [coe_nndist] using gaussian_coordinates_Lp_norm P
    (brownianCoordinatesLp P W hW t - brownianCoordinatesLp P W hW s)
    (nndist (t : ℝ) (s : ℝ)) (brownianCoordinatesLp_sub_coordinateLaw P W hW t s)

/-- Brownian coordinates are continuous as a map into `L²`. The proof derives
continuity from Gaussian increment moments and needs no path-continuity input. -/
theorem brownianCoordinatesLp_continuous (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) :
    Continuous (brownianCoordinatesLp P W hW) := by
  apply continuous_iff_continuousAt.mpr
  intro s
  apply tendsto_iff_norm_sub_tendsto_zero.mpr
  simp_rw [brownianCoordinatesLp_norm_sub P W hW]
  have hc : Continuous (fun t : ℝ≥0 ↦
      Real.sqrt ((Fintype.card ι : ℝ) * dist (t : ℝ) (s : ℝ))) := by fun_prop
  simpa only [dist_self, mul_zero, Real.sqrt_zero] using hc.tendsto s

/-- The exact `L²` Brownian increment bound in the additive Langevin equation. -/
theorem brownianCoordinatesLp_increment_scaled_norm (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ≥0) :
    ‖Real.sqrt 2 • (brownianCoordinatesLp P W hW (a + t) -
      brownianCoordinatesLp P W hW a)‖ =
      Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt (t : ℝ) := by
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _),
    brownianCoordinatesLp_norm_sub]
  simp only [NNReal.coe_add, Real.dist_eq, add_sub_cancel_left,
    abs_of_nonneg t.coe_nonneg]
  rw [Real.sqrt_mul (by positivity : (0 : ℝ) ≤ Fintype.card ι),
    Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2)]
  ring

/-- The canonical Brownian vector starts at zero in `L²`. -/
@[simp] theorem brownianCoordinatesLp_zero (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) :
    brownianCoordinatesLp P W hW 0 = 0 := by
  apply norm_eq_zero.mp
  simpa only [brownianCoordinatesLp, NNReal.coe_zero, mul_zero, Real.sqrt_zero] using
    gaussian_coordinates_toLp_norm P (brownianCoordinates W 0) 0
      (brownianCoordinates_coordinateLaw P W hW 0)

/-- A real-time presentation, constant at zero on negative times, for use with
ordinary real interval integrals and deterministic Banach-space ODEs. -/
def brownianCoordinatesRealLp (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (t : ℝ) :
    Lp (EuclideanSpace ℝ ι) 2 P :=
  brownianCoordinatesLp P W hW t.toNNReal

/-- The real-time Brownian presentation is continuous in `L²`. -/
theorem brownianCoordinatesRealLp_continuous (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) :
    Continuous (brownianCoordinatesRealLp P W hW) :=
  (brownianCoordinatesLp_continuous P W hW).comp continuous_real_toNNReal

@[simp] theorem brownianCoordinatesRealLp_zero (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) :
    brownianCoordinatesRealLp P W hW 0 = 0 := by
  simp only [brownianCoordinatesRealLp, Real.toNNReal_zero, brownianCoordinatesLp_zero]

/-- The real-time additive noise has the exact local moment required in the
Langevin error bound, for every nonnegative starting time and elapsed time. -/
theorem brownianCoordinatesRealLp_increment_scaled_norm (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ)
    (ha : 0 ≤ a) (ht : 0 ≤ t) :
    ‖Real.sqrt 2 • (brownianCoordinatesRealLp P W hW (a + t) -
      brownianCoordinatesRealLp P W hW a)‖ =
      Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt t := by
  simpa only [brownianCoordinatesRealLp, Real.toNNReal_add ha ht,
    Real.coe_toNNReal t ht] using
    brownianCoordinatesLp_increment_scaled_norm P W hW a.toNNReal t.toNNReal

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/LangevinIntegral.lean -/
section

set_option linter.style.header false

/-! # Constructing an additive-noise Langevin integral solution

For a globally Lipschitz drift and a continuous additive input, Picard iteration
constructs the solution in the Banach space itself. In particular the Banach
space may be L², so existence of the integral equation is proved rather than
postulated. This file does not establish Gibbs invariance of that solution.
-/

noncomputable section
open MeasureTheory Set Metric
open scoped NNReal
namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]

/-- Picard constructs the continuous solution of `Y = x + B - ∫g(Y)` on a
short interval. The noise need only be continuous in the Banach norm. The
condition `L*h ≤ 1/2` is a local construction condition, not an assumption on
the final Langevin diffusion; longer intervals require concatenation. -/
theorem exists_langevin_integral_small
    (g : H → H) (L : ℝ≥0) (hLip : LipschitzWith L g)
    (x : H) (B : ℝ → H) (hB : Continuous B) (hB0 : B 0 = 0)
    (h : ℝ) (hh : 0 ≤ h) (hsmall : (L : ℝ) * h ≤ 1 / 2) :
    ∃ Y : ℝ → H, Continuous Y ∧ Y 0 = x ∧
      ∀ t ∈ Icc 0 h,
        Y t - x = -(∫ s in 0..t, g (Y s)) + B t := by
  have hbound := ((isCompact_Icc : IsCompact (Icc (0 : ℝ) h)).image hB).isBounded.exists_norm_le
  obtain ⟨C, hC⟩ := hbound
  let C' : ℝ := max C 0
  have hC' : 0 ≤ C' := le_max_right _ _
  have hBC (t : ℝ) (ht : t ∈ Icc 0 h) : ‖B t‖ ≤ C' :=
    (hC _ (mem_image_of_mem B ht)).trans (le_max_left _ _)
  let G : ℝ := ‖g x‖ + (L : ℝ) * C'
  have hG : 0 ≤ G := by dsimp [G]; positivity
  let a : ℝ≥0 := ⟨2 * h * G, by positivity⟩
  let M : ℝ≥0 := ⟨G + (L : ℝ) * a, by positivity⟩
  let f : ℝ → H → H := fun t z ↦ -g (z + B t)
  let t₀ : Icc 0 h := ⟨0, by simp [hh]⟩
  have hpicard : IsPicardLindelof f t₀ x a 0 M L := by
    constructor
    · intro t ht
      apply LipschitzOnWith.of_dist_le_mul
      intro z hz w hw
      dsimp [f]
      simpa only [dist_neg_neg, dist_add_right] using hLip.dist_le_mul (z + B t) (w + B t)
    · intro z hz
      exact (hLip.continuous.comp (continuous_const.add hB)).neg.continuousOn
    · intro t ht z hz
      have hz' : ‖z - x‖ ≤ (a : ℝ) := by simpa only [mem_closedBall, dist_eq_norm] using hz
      have hnorm : ‖z + B t - x‖ ≤ (a : ℝ) + C' := by
        have hid : z + B t - x = (z - x) + B t := by abel
        rw [hid]
        exact (norm_add_le _ _).trans (add_le_add hz' (hBC t ht))
      have hg : ‖g (z + B t) - g x‖ ≤ (L : ℝ) * ((a : ℝ) + C') := by
        exact (hLip.norm_sub_le (z + B t) x).trans
          (mul_le_mul_of_nonneg_left hnorm L.coe_nonneg)
      change ‖-g (z + B t)‖ ≤ (M : ℝ)
      rw [norm_neg]
      have hu : ‖g (z + B t)‖ ≤ ‖g x‖ + ‖g (z + B t) - g x‖ := by
        simpa only [norm_sub_rev] using norm_le_norm_add_norm_sub (g x) (g (z + B t))
      change ‖g (z + B t)‖ ≤ G + (L : ℝ) * (a : ℝ)
      dsimp [G]
      nlinarith
    · change (M : ℝ) * max (h - 0) (0 - 0) ≤ (a : ℝ) - 0
      rw [sub_zero, sub_self, max_eq_left hh, sub_zero]
      change (G + (L : ℝ) * (2 * h * G)) * h ≤ 2 * h * G
      have hm := mul_le_mul_of_nonneg_right hsmall
        (by positivity : 0 ≤ 2 * h * G)
      nlinarith
  have hx : x ∈ closedBall x (0 : ℝ≥0) := by simp
  obtain ⟨α, hα⟩ := ODE.FunSpace.exists_isFixedPt_next hpicard hx
  let Z : ℝ → H := α.compProj
  have hZ : Continuous Z := α.continuous_compProj
  have hZeq (t : ℝ) (ht : t ∈ Icc 0 h) :
      Z t = x + ∫ s in 0..t, f s (Z s) := by
    change α.compProj t = x + ∫ s in 0..t, f s (α.compProj s)
    nth_rw 1 [← hα]
    rw [ODE.FunSpace.compProj_of_mem ht, ODE.FunSpace.next_apply]
    rfl
  have hZ0 : Z 0 = x := by simpa using hZeq 0 ⟨le_rfl, hh⟩
  refine ⟨fun t ↦ Z t + B t, hZ.add hB, by simp [hZ0, hB0], ?_⟩
  intro t ht
  change (Z t + B t) - x = -(∫ s in 0..t, g (Z s + B s)) + B t
  rw [hZeq t ht]
  dsimp [f]
  rw [intervalIntegral.integral_neg]
  abel


omit [CompleteSpace H] in
/-- Two consecutive solutions splice into one continuous integral solution.
This is the finite-horizon extension step, with no new drift hypotheses. -/
lemma splice_langevin_integral
    (g : H → H) (L : ℝ≥0) (hLip : LipschitzWith L g)
    (x : H) (B Y Z : ℝ → H) (hY : Continuous Y) (hZ : Continuous Z)
    (a b : ℝ) (ha : 0 ≤ a) (_hb : 0 ≤ b)
    (hY0 : Y 0 = x) (hZ0 : Z 0 = Y a)
    (hYe : ∀ t ∈ Icc 0 a, Y t - x = -(∫ s in 0..t, g (Y s)) + B t)
    (hZe : ∀ t ∈ Icc 0 b, Z t - Y a =
      -(∫ s in 0..t, g (Z s)) + (B (a + t) - B a)) :
    ∃ S : ℝ → H, Continuous S ∧ S 0 = x ∧
      ∀ t ∈ Icc 0 (a + b), S t - x = -(∫ s in 0..t, g (S s)) + B t := by
  classical
  let S : ℝ → H := fun t ↦ if t ≤ a then Y t else Z (t - a)
  have hSl (t : ℝ) (ht : t ≤ a) : S t = Y t := by simp [S, ht]
  have hSr (t : ℝ) (ht : a ≤ t) : S t = Z (t - a) := by
    by_cases hl : t ≤ a
    · have he : t = a := le_antisymm hl ht
      simp [S, he, hZ0]
    · simp [S, hl]
  have hS : Continuous S := hY.if_le (hZ.comp (continuous_id.sub continuous_const))
    continuous_id continuous_const (fun t ht ↦ by simp only [ht, sub_self, hZ0])
  have hSlint (t : ℝ) (ht : t ∈ Icc 0 a) :
      (∫ s in 0..t, g (S s)) = ∫ s in 0..t, g (Y s) := by
    apply intervalIntegral.integral_congr
    intro s hs
    rw [uIcc_of_le ht.1] at hs
    change g (S s) = g (Y s)
    rw [hSl s (hs.2.trans ht.2)]
  refine ⟨S, hS, by rw [hSl 0 ha, hY0], ?_⟩
  intro t ht
  by_cases hta : t ≤ a
  · rw [hSl t hta, hSlint t ⟨ht.1, hta⟩]
    exact hYe t ⟨ht.1, hta⟩
  · have hat : a ≤ t := le_of_lt (lt_of_not_ge hta)
    have hz := hZe (t - a) ⟨sub_nonneg.mpr hat, by linarith [ht.2]⟩
    have hy := hYe a ⟨ha, le_rfl⟩
    have hright : (∫ s in a..t, g (S s)) = ∫ s in 0..(t - a), g (Z s) := by
      calc
        _ = ∫ s in a..t, g (Z (s - a)) := by
          apply intervalIntegral.integral_congr
          intro s hs
          rw [uIcc_of_le hat] at hs
          change g (S s) = g (Z (s - a))
          rw [hSr s hs.1]
        _ = _ := by
          simpa only [sub_self] using
            (intervalIntegral.integral_comp_sub_right (f := fun s ↦ g (Z s))
              (a := a) (b := t) a)
    have hint : (∫ s in 0..t, g (S s)) =
        (∫ s in 0..a, g (Y s)) + ∫ s in 0..(t - a), g (Z s) := by
      calc
        _ = (∫ s in 0..a, g (S s)) + ∫ s in a..t, g (S s) :=
          (intervalIntegral.integral_add_adjacent_intervals
            (show IntervalIntegrable (fun s ↦ g (S s)) volume 0 a from
              (hLip.continuous.comp hS).intervalIntegrable 0 a)
            (show IntervalIntegrable (fun s ↦ g (S s)) volume a t from
              (hLip.continuous.comp hS).intervalIntegrable a t)).symm
        _ = _ := by rw [hSlint a ⟨ha, le_rfl⟩, hright]
    have hyval : Y a = x - (∫ s in 0..a, g (Y s)) + B a := by
      rw [sub_eq_iff_eq_add] at hy
      rw [hy]
      abel
    have hzval : Z (t - a) = Y a - (∫ s in 0..(t - a), g (Z s)) + B t - B a := by
      rw [show a + (t - a) = t by ring, sub_eq_iff_eq_add] at hz
      rw [hz]
      abel
    rw [hSr t hat, hzval, hyval, hint]
    abel

/-- A globally Lipschitz drift admits an additive-noise integral solution on
any finite nonnegative horizon. The proof constructs short Picard segments and
splices them; no small-step restriction or reference process is assumed. -/
theorem exists_langevin_integral
    (g : H → H) (L : ℝ≥0) (hLip : LipschitzWith L g)
    (x : H) (B : ℝ → H) (hB : Continuous B) (hB0 : B 0 = 0)
    (h : ℝ) (_hh : 0 ≤ h) :
    ∃ Y : ℝ → H, Continuous Y ∧ Y 0 = x ∧
      ∀ t ∈ Icc 0 h, Y t - x = -(∫ s in 0..t, g (Y s)) + B t := by
  let δ : ℝ := 1 / (2 * ((L : ℝ) + 1))
  have hδ : 0 < δ := by dsimp [δ]; positivity
  have hδsmall : (L : ℝ) * δ ≤ 1 / 2 := by
    dsimp [δ]
    rw [mul_one_div]
    apply (div_le_iff₀ (by positivity : 0 < 2 * ((L : ℝ) + 1))).mpr
    linarith
  have hex (n : ℕ) : ∃ Y : ℝ → H, Continuous Y ∧ Y 0 = x ∧
      ∀ t ∈ Icc 0 ((n : ℝ) * δ),
        Y t - x = -(∫ s in 0..t, g (Y s)) + B t := by
    induction n with
    | zero =>
        refine ⟨fun _ ↦ x, continuous_const, rfl, ?_⟩
        intro t ht
        simp only [Nat.cast_zero, zero_mul] at ht
        have ht0 : t = 0 := le_antisymm ht.2 ht.1
        simp [ht0, hB0]
    | succ n ih =>
        obtain ⟨Y, hY, hY0, hYe⟩ := ih
        let a : ℝ := (n : ℝ) * δ
        have ha : 0 ≤ a := by dsimp [a]; positivity
        obtain ⟨Z, hZ, hZ0, hZe⟩ := exists_langevin_integral_small g L hLip (Y a)
          (fun t ↦ B (a + t) - B a)
          ((hB.comp (continuous_const.add continuous_id)).sub continuous_const)
          (by simp) δ hδ.le hδsmall
        have hs := splice_langevin_integral g L hLip x B Y Z hY hZ a δ ha hδ.le hY0 hZ0 hYe hZe
        convert hs using 1
        simp only [Nat.cast_add, Nat.cast_one, add_mul, one_mul, a]
  obtain ⟨n, hn⟩ := exists_nat_ge (h / δ)
  obtain ⟨Y, hY, hY0, hYe⟩ := hex n
  refine ⟨Y, hY, hY0, fun t ht ↦ hYe t ⟨ht.1, ht.2.trans ?_⟩⟩
  exact (div_le_iff₀ hδ).mp hn

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
  {K : Type*} [NormedAddCommGroup K] [InnerProductSpace ℝ K] [CompleteSpace K]

/-- The actual gradient has an L² integral solution from its Lipschitz
hypothesis and a continuous L² additive noise path. No reference solution or
integral identity is assumed in this construction. -/
theorem exists_lp_langevin_integral_small
    (U : K → ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (initial : Lp K 2 P) (B : ℝ → Lp K 2 P)
    (hB : Continuous B) (hB0 : B 0 = 0)
    (h : ℝ) (hh : 0 ≤ h) (hsmall : (L : ℝ) * h ≤ 1 / 2) :
    ∃ Y : ℝ → Lp K 2 P, Continuous Y ∧ Y 0 = initial ∧
      ∀ t ∈ Icc 0 h, Y t - initial =
        -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) + B t :=
  exists_langevin_integral_small (lpDrift P (gradient U) hLip) L
    (lpDrift_lipschitz P (gradient U) hLip) initial B hB hB0 h hh hsmall

/-- Finite-horizon existence of the actual L² Langevin integral equation from
only Lipschitz gradient and continuous additive noise, with no step restriction. -/
theorem exists_lp_langevin_integral
    (U : K → ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (initial : Lp K 2 P) (B : ℝ → Lp K 2 P)
    (hB : Continuous B) (hB0 : B 0 = 0) (h : ℝ) (hh : 0 ≤ h) :
    ∃ Y : ℝ → Lp K 2 P, Continuous Y ∧ Y 0 = initial ∧
      ∀ t ∈ Icc 0 h, Y t - initial =
        -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) + B t :=
  exists_langevin_integral (lpDrift P (gradient U) hLip) L
    (lpDrift_lipschitz P (gradient U) hLip) initial B hB hB0 h hh


end ULA


end
end


/-! ## Included source: UnadjustedLangevin/BrownianLangevin.lean -/
section

set_option linter.style.header false

/-!
# Constructing the `L²` Langevin equation from Brownian coordinates

Actual Brownian coordinate laws construct a continuous `L²` additive noise path
and its exact square-root increment moment. Picard then constructs the integral
solution for the actual gradient. No integral equation, noise continuity, or
noise moment bound is supplied as an assumption.

This construction does not establish the stationary Gibbs law, a score moment
bound, or independence/adaptedness of the initial state and Brownian input.
Those are distinct probabilistic claims.
-/

noncomputable section

open MeasureTheory ProbabilityTheory Set
open scoped NNReal

namespace ULA

variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
  (P : Measure Ω)

/-- The additive Langevin noise over a segment starting at real time `a`.
The real-time Brownian presentation is constant at zero at negative times. -/
def brownianLangevinNoise (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ) :
    Lp (EuclideanSpace ℝ ι) 2 P :=
  Real.sqrt 2 • (brownianCoordinatesRealLp P W hW (a + t) -
    brownianCoordinatesRealLp P W hW a)

/-- Noise continuity follows from Gaussian increment moments in `L²`. -/
theorem brownianLangevinNoise_continuous (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a : ℝ) :
    Continuous (brownianLangevinNoise P W hW a) := by
  exact (((brownianCoordinatesRealLp_continuous P W hW).comp
    (continuous_const.add continuous_id)).sub continuous_const).const_smul (Real.sqrt 2)

@[simp] theorem brownianLangevinNoise_zero (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a : ℝ) :
    brownianLangevinNoise P W hW a 0 = 0 := by
  simp only [brownianLangevinNoise, add_zero, sub_self, smul_zero]

/-- The exact segment noise moment is a theorem about the Brownian input. -/
theorem brownianLangevinNoise_norm (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ)
    (ha : 0 ≤ a) (ht : 0 ≤ t) :
    ‖brownianLangevinNoise P W hW a t‖ =
      Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt t :=
  brownianCoordinatesRealLp_increment_scaled_norm P W hW a t ha ht

variable [IsProbabilityMeasure P]

/-- Actual Brownian coordinates and a Lipschitz gradient construct a continuous
short-time `L²` Langevin solution. The local step restriction belongs to the
Picard construction and may be removed by concatenation. No score bound or
stationary-law assertion is made. -/
theorem exists_lp_langevin_integral_of_brownian_small
    (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (a h : ℝ) (ha : 0 ≤ a) (hh : 0 ≤ h) (hsmall : (L : ℝ) * h ≤ 1 / 2) :
    ∃ Y : ℝ → Lp (EuclideanSpace ℝ ι) 2 P,
      Continuous Y ∧ Y 0 = initial ∧
      (∀ t ∈ Icc 0 h, Y t - initial =
        -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) +
          brownianLangevinNoise P W hW a t) ∧
      (∀ t ∈ Icc 0 h, ‖brownianLangevinNoise P W hW a t‖ =
        Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt t) := by
  obtain ⟨Y, hY, hY0, hYeq⟩ := exists_lp_langevin_integral_small P U L hLip initial
    (brownianLangevinNoise P W hW a) (brownianLangevinNoise_continuous P W hW a)
    (brownianLangevinNoise_zero P W hW a) h hh hsmall
  exact ⟨Y, hY, hY0, hYeq,
    fun t ht ↦ brownianLangevinNoise_norm P W hW a t ha ht.1⟩

/-- Actual Brownian coordinates construct a finite-horizon `L²` Langevin
solution from the Lipschitz gradient, without a small-time restriction. Both
the integral equation and exact noise moment are conclusions. -/
theorem exists_lp_langevin_integral_of_brownian
    (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (a h : ℝ) (ha : 0 ≤ a) (hh : 0 ≤ h) :
    ∃ Y : ℝ → Lp (EuclideanSpace ℝ ι) 2 P,
      Continuous Y ∧ Y 0 = initial ∧
      (∀ t ∈ Icc 0 h, Y t - initial =
        -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) +
          brownianLangevinNoise P W hW a t) ∧
      (∀ t ∈ Icc 0 h, ‖brownianLangevinNoise P W hW a t‖ =
        Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt t) := by
  obtain ⟨Y, hY, hY0, hYeq⟩ := exists_lp_langevin_integral P U L hLip initial
    (brownianLangevinNoise P W hW a) (brownianLangevinNoise_continuous P W hW a)
    (brownianLangevinNoise_zero P W hW a) h hh
  exact ⟨Y, hY, hY0, hYeq,
    fun t ht ↦ brownianLangevinNoise_norm P W hW a t ha ht.1⟩

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/StationaryMoments.lean -/
section

set_option linter.style.header false

/-! # The reference score bound is derived from its Gibbs law

A random variable with Gibbs law inherits the sharp score moment proved from
the potential assumptions. Stationarity itself is not established by this
moment-transfer lemma.
-/

noncomputable section
open MeasureTheory
open scoped NNReal ENNReal
namespace ULA

variable {Ω H : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [FiniteDimensional ℝ H]
  [MeasurableSpace H] [BorelSpace H]
  (P : Measure Ω) [IsProbabilityMeasure P]

/-- The exact score norm used in Dalalyan's reference argument follows from
first-order smoothness and the stated Gibbs law, without a moment hypothesis. -/
theorem lpDrift_norm_le_of_gibbs_law
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (hZ : gibbsPartition U ≠ ⊤)
    (Y : Lp H 2 P) (hlaw : P.map Y = gibbsMeasure U) :
    ‖lpDrift P (gradient U) hLip Y‖ ≤
      Real.sqrt ((L : ℝ) * (Module.finrank ℝ H : ℝ)) := by
  have he : (∫ x, ‖gradient U x‖ ^ 2 ∂P.map Y) =
      ∫ ω, ‖gradient U (Y ω)‖ ^ 2 ∂P := by
    exact integral_map (Lp.aestronglyMeasurable Y).aemeasurable
      ((hLip.continuous.norm.pow 2).aestronglyMeasurable)
  rw [hlaw] at he
  apply lpDrift_norm_le_sqrt P (gradient U) hLip Y
  rw [← he]
  exact integral_norm_sq_gradient_gibbs_le U L hdiff hLip hZ

/-- The strong-convexity form also discharges finite normalization internally. -/
theorem lpDrift_norm_le_of_strongConvex_gibbs_law
    (U : H → ℝ) (m : ℝ) (L : ℝ≥0) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U))
    (Y : Lp H 2 P) (hlaw : P.map Y = gibbsMeasure U) :
    ‖lpDrift P (gradient U) hLip Y‖ ≤
      Real.sqrt ((L : ℝ) * (Module.finrank ℝ H : ℝ)) :=
  lpDrift_norm_le_of_gibbs_law P U L hdiff hLip
    (gibbsPartition_ne_top U m hm hdiff hsc) Y hlaw

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/BrownianReference.lean -/
section

set_option linter.style.header false

/-! # An actual Brownian Langevin reference, conditional on Gibbs invariance

The integral equation, continuity, matching Euler noise, and both moment bounds
are constructed or proved here. The only remaining process-law input is the
explicit assertion that the constructed segments have the Gibbs law at every
time. This file does not claim to prove that invariance assertion.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped NNReal
namespace ULA.Hilbert
open ULA

variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
  (P : Measure Ω) [IsProbabilityMeasure P]

/-- The canonical choice of the constructed solution over the `n`th time
segment, starting from the supplied knot. -/
def brownianSegmentFrom (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 ≤ h) (n : ℕ) (initial : Lp (EuclideanSpace ℝ ι) 2 P) :
    ℝ → Lp (EuclideanSpace ℝ ι) 2 P :=
  Classical.choose (exists_lp_langevin_integral_of_brownian P U L hLip initial W hW
    ((n : ℝ) * h) h (mul_nonneg (Nat.cast_nonneg n) hh) hh)

/-- The properties of the actual integral solution used to define a segment. -/
theorem brownianSegmentFrom_spec (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 ≤ h) (n : ℕ) (initial : Lp (EuclideanSpace ℝ ι) 2 P) :
    Continuous (brownianSegmentFrom P U L hLip W hW h hh n initial) ∧
      brownianSegmentFrom P U L hLip W hW h hh n initial 0 = initial ∧
      (∀ t ∈ Icc 0 h,
        brownianSegmentFrom P U L hLip W hW h hh n initial t - initial =
          -(∫ s in 0..t, lpDrift P (gradient U) hLip
            (brownianSegmentFrom P U L hLip W hW h hh n initial s)) +
            brownianLangevinNoise P W hW ((n : ℝ) * h) t) ∧
      (∀ t ∈ Icc 0 h, ‖brownianLangevinNoise P W hW ((n : ℝ) * h) t‖ =
        Real.sqrt (2 * (Fintype.card ι : ℝ)) * Real.sqrt t) :=
  Classical.choose_spec (exists_lp_langevin_integral_of_brownian P U L hLip initial W hW
    ((n : ℝ) * h) h (mul_nonneg (Nat.cast_nonneg n) hh) hh)

/-- Successive knots are the endpoints of the constructed integral solutions. -/
def brownianKnots (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 ≤ h) (initial : Lp (EuclideanSpace ℝ ι) 2 P) :
    ℕ → Lp (EuclideanSpace ℝ ι) 2 P
  | 0 => initial
  | n + 1 => brownianSegmentFrom P U L hLip W hW h hh n
      (brownianKnots U L hLip W hW h hh initial n) h

/-- The reference segments use the recursively constructed endpoints. -/
def brownianSegments (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 ≤ h) (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (n : ℕ) : ℝ → Lp (EuclideanSpace ℝ ι) 2 P :=
  brownianSegmentFrom P U L hLip W hW h hh n
    (brownianKnots P U L hLip W hW h hh initial n)

/-- Each segment starts exactly at its recursively constructed knot. -/
@[simp] theorem brownianSegments_start (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 ≤ h) (initial : Lp (EuclideanSpace ℝ ι) 2 P) (n : ℕ) :
    brownianSegments P U L hLip W hW h hh initial n 0 =
      brownianKnots P U L hLip W hW h hh initial n :=
  (brownianSegmentFrom_spec P U L hLip W hW h hh n _).2.1

/-- The constructed process starts from precisely the prescribed random
variable, including its chosen joint realization with the Euler initialization. -/
@[simp] theorem brownianSegments_initial (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 ≤ h) (initial : Lp (EuclideanSpace ℝ ι) 2 P) :
    brownianSegments P U L hLip W hW h hh initial 0 0 = initial := by
  rw [brownianSegments_start]
  rfl

/-- Normalize each actual Brownian endpoint to the Euler innovation. -/
def brownianEulerNoise (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (h : ℝ) (n : ℕ) :
    Lp (EuclideanSpace ℝ ι) 2 P :=
  (Real.sqrt (2 * h))⁻¹ • brownianLangevinNoise P W hW ((n : ℝ) * h) h

omit [IsProbabilityMeasure P] in
/-- The normalized endpoint matches the same additive noise used by the
integral equation exactly, without a supplied endpoint hypothesis. -/
theorem brownianEulerNoise_endpoint (W : ι → ℝ≥0 → Ω → ℝ)
    (hW : ∀ i, IsPreBrownianReal (W i) P) (h : ℝ) (hh : 0 < h) (n : ℕ) :
    brownianLangevinNoise P W hW ((n : ℝ) * h) h =
      Real.sqrt (2 * h) • brownianEulerNoise P W hW h n := by
  have hs : Real.sqrt (2 * h) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by positivity))
  simp only [brownianEulerNoise, smul_smul, mul_inv_cancel₀ hs, one_smul]

/-- All analytic and noise fields of `L2Reference` follow from the constructed
Brownian integral solutions and the sharp Gibbs score theorem. The all-time
Gibbs-law premise is the single remaining process-law obligation. -/
def brownianReference (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (hZ : gibbsPartition U ≠ ⊤)
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 < h) (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (hstationary : ∀ n t, t ∈ Icc 0 h →
      P.map (brownianSegments P U L hLip W hW h hh.le initial n t) = gibbsMeasure U) :
    L2Reference P (Fintype.card ι) U h L hLip
      (brownianEulerNoise P W hW h) (gibbsMeasure U) where
  segment := brownianSegments P U L hLip W hW h hh.le initial
  increment := fun n ↦ brownianLangevinNoise P W hW ((n : ℝ) * h)
  continuous n := (brownianSegmentFrom_spec P U L hLip W hW h hh.le n _).1
  join n := by
    change brownianSegments P U L hLip W hW h hh.le initial n h =
      brownianSegmentFrom P U L hLip W hW h hh.le (n + 1)
        (brownianKnots P U L hLip W hW h hh.le initial (n + 1)) 0
    rw [(brownianSegmentFrom_spec P U L hLip W hW h hh.le (n + 1) _).2.1]
    rfl
  noiseEndpoint := brownianEulerNoise_endpoint P W hW h hh
  stationary n := hstationary n 0 ⟨le_rfl, hh.le⟩
  integralEquation n t ht := by
    change brownianSegmentFrom P U L hLip W hW h hh.le n _ t -
      brownianSegmentFrom P U L hLip W hW h hh.le n _ 0 = _
    rw [(brownianSegmentFrom_spec P U L hLip W hW h hh.le n _).2.1]
    exact (brownianSegmentFrom_spec P U L hLip W hW h hh.le n _).2.2.1 t ht
  scoreBound n t ht := by
    simpa using lpDrift_norm_le_of_gibbs_law P U L hdiff hLip hZ
      (brownianSegments P U L hLip W hW h hh.le initial n t) (hstationary n t ht)
  noiseBound n t ht :=
    (brownianLangevinNoise_norm P W hW ((n : ℝ) * h) t
      (mul_nonneg (Nat.cast_nonneg n) hh.le) ht.1).le

/-- The strong-convexity version has no separate normalization or moment
hypothesis: only Gibbs invariance of the actual constructed segments remains. -/
def brownianReference_of_strongConvex
    (U : EuclideanSpace ℝ ι → ℝ) (m : ℝ) (L : ℝ≥0) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U))
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (h : ℝ) (hh : 0 < h) (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (hstationary : ∀ n t, t ∈ Icc 0 h →
      P.map (brownianSegments P U L hLip W hW h hh.le initial n t) = gibbsMeasure U) :
    L2Reference P (Fintype.card ι) U h L hLip
      (brownianEulerNoise P W hW h) (gibbsMeasure U) :=
  brownianReference P U L hdiff hLip (gibbsPartition_ne_top U m hm hdiff hsc)
    W hW h hh initial hstationary

end ULA.Hilbert


end
end


/-! ## Included source: UnadjustedLangevin/PotentialAssumptions.lean -/
section

set_option linter.style.header false

/-!
# Compatibility of strong convexity and a Lipschitz gradient

On a nontrivial Hilbert space the inequality `m ≤ L` is a consequence of the
potential assumptions, and does not need to be an independent numerical input.
The gradient is that of the same differentiable function in both hypotheses.
-/

noncomputable section

open scoped NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [CompleteSpace H] [Nontrivial H]

/-- The strong-convexity constant cannot exceed the gradient Lipschitz constant
on a nontrivial Hilbert space. Neither constant needs to be positive here. -/
theorem strongConvex_le_lipschitz {U : H → ℝ} {m : ℝ} {L : ℝ≥0}
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) : m ≤ (L : ℝ) := by
  obtain ⟨x, hx⟩ := exists_ne (0 : H)
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hmono : m * ‖x‖ ^ 2 ≤ inner ℝ (gradient U x - gradient U 0) x := by
    simpa only [sub_zero] using strong_gradient_monotone hdiff hsc x 0
  have hbound : inner ℝ (gradient U x - gradient U 0) x ≤ (L : ℝ) * ‖x‖ ^ 2 := by
    calc
      _ ≤ ‖gradient U x - gradient U 0‖ * ‖x‖ := real_inner_le_norm _ _
      _ ≤ ((L : ℝ) * ‖x‖) * ‖x‖ :=
        mul_le_mul_of_nonneg_right (by simpa only [sub_zero] using hLip.norm_sub_le x 0)
          (norm_nonneg x)
      _ = _ := by ring
  exact (mul_le_mul_iff_right₀ (sq_pos_of_pos hxpos)).mp
    (by simpa only [mul_comm] using hmono.trans hbound)

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/BrownianInnovations.lean -/
section

set_option linter.style.header false

/-! # Independent standard Gaussian innovations from Brownian coordinates

Each scalar Brownian coordinate has independent increments on the regular time
grid. Independence of the coordinate grid paths combines with this within-path
independence to give independence across every time-coordinate pair. All laws
and independence facts are proved from Brownian laws; no potential regularity
or stationary diffusion is involved.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace ULA

variable {Ω ι : Type*} [MeasurableSpace Ω] (P : Measure Ω)

/-- The standard normalized increment of a scalar Brownian coordinate. -/
def normalizedBrownianIncrement (B : ℝ≥0 → Ω → ℝ) (h : ℝ≥0)
    (n : ℕ) (ω : Ω) : ℝ :=
  (B (((n + 1 : ℕ) : ℝ≥0) * h) ω - B ((n : ℝ≥0) * h) ω) /
    Real.sqrt (h : ℝ)

/-- Its distribution is standard Gaussian at every iteration. -/
theorem normalizedBrownianIncrement_hasLaw
    (B : ℝ≥0 → Ω → ℝ) (hB : IsPreBrownianReal B P)
    (h : ℝ≥0) (hh : 0 < h) (n : ℕ) :
    HasLaw (normalizedBrownianIncrement B h n) (gaussianReal 0 1) P := by
  have hv : nndist (((((n + 1 : ℕ) : ℝ≥0) * h) : ℝ≥0) : ℝ)
      ((((n : ℝ≥0) * h) : ℝ≥0) : ℝ) = h := by
    apply NNReal.eq
    simp only [coe_nndist, Real.dist_eq, NNReal.coe_mul, NNReal.coe_natCast,
      Nat.cast_add, Nat.cast_one, NNReal.coe_add, NNReal.coe_one]
    rw [show ((n : ℝ) + 1) * (h : ℝ) - (n : ℝ) * (h : ℝ) = (h : ℝ) by ring,
      abs_of_nonneg h.coe_nonneg]
  have hraw := hB.hasLaw_sub (((n + 1 : ℕ) : ℝ≥0) * h) ((n : ℝ≥0) * h)
  simp only [NNReal.val_eq_coe] at hraw
  rw [hv] at hraw
  have hn := gaussianReal_div_const hraw (Real.sqrt (h : ℝ))
  have hs : NNReal.mk (Real.sqrt (h : ℝ) ^ 2) (sq_nonneg _) = h := by
    apply NNReal.eq
    exact Real.sq_sqrt h.coe_nonneg
  rw [hs, div_self hh.ne', zero_div] at hn
  exact hn

/-- Square integrability follows from the actual standard Gaussian law. -/
theorem normalizedBrownianIncrement_memLp
    (B : ℝ≥0 → Ω → ℝ) (hB : IsPreBrownianReal B P)
    (h : ℝ≥0) (hh : 0 < h) (n : ℕ) :
    MemLp (normalizedBrownianIncrement B h n) 2 P :=
  (normalizedBrownianIncrement_hasLaw P B hB h hh n).memLp
    (memLp_id_gaussianReal (2 : ℝ≥0))

/-- The normalized scalar innovation has exactly unit second moment. -/
theorem normalizedBrownianIncrement_second_moment
    (B : ℝ≥0 → Ω → ℝ) (hB : IsPreBrownianReal B P)
    (h : ℝ≥0) (hh : 0 < h) (n : ℕ) :
    (∫ ω, normalizedBrownianIncrement B h n ω ^ 2 ∂P) = 1 := by
  exact (normalizedBrownianIncrement_hasLaw P B hB h hh n).integral_comp
    (f := fun x : ℝ ↦ x ^ 2) (by fun_prop) |>.trans (centered_gaussian_second_moment 1)

/-- Within one Brownian coordinate, the whole sequence of normalized grid
increments is independent. -/
theorem normalizedBrownianIncrement_independent
    (B : ℝ≥0 → Ω → ℝ) (hB : IsPreBrownianReal B P) (h : ℝ≥0) :
    iIndepFun (normalizedBrownianIncrement B h) P := by
  have ht : Monotone (fun n : ℕ ↦ (n : ℝ≥0) * h) := by
    intro a b hab
    exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hab) h.coe_nonneg
  exact (hB.hasIndepIncrements.nat ht).comp
    (fun _ x ↦ x / Real.sqrt (h : ℝ)) (by fun_prop)

/-- An a.e.-measurable version of the independence-of-independent-families
criterion. Countability of each row permits using measurable representatives
without strengthening any hypotheses on the original random variables. -/
theorem iIndepFun_uncurry_nat_of_aemeasurable
    (X : ι → ℕ → Ω → ℝ) (hX : ∀ i n, AEMeasurable (X i n) P)
    (hrows : iIndepFun (fun i ω n ↦ X i n ω) P)
    (hwithin : ∀ i, iIndepFun (X i) P) :
    iIndepFun (fun p : ι × ℕ ↦ X p.1 p.2) P := by
  have hp (i : ι) : AEMeasurable (fun ω n ↦ X i n ω) P :=
    aemeasurable_pi_iff.mpr (hX i)
  let G : ι → Ω → ℕ → ℝ := fun i ↦ (hp i).mk (fun ω n ↦ X i n ω)
  have hG (i : ι) : Measurable (G i) := (hp i).measurable_mk
  have heq (i : ι) : (fun ω n ↦ X i n ω) =ᵐ[P] G i := (hp i).ae_eq_mk
  have hr : iIndepFun G P := hrows.congr heq
  have hw (i : ι) : iIndepFun (fun n ω ↦ G i ω n) P :=
    (hwithin i).congr (fun n ↦ (heq i).fun_comp (fun w ↦ w n))
  have hall : iIndepFun (fun p : ι × ℕ ↦ fun ω ↦ G p.1 ω p.2) P :=
    iIndepFun_uncurry' (fun i n ↦ (measurable_pi_apply n).comp (hG i)) hr hw
  exact hall.congr (fun p ↦ ((heq p.1).fun_comp (fun w ↦ w p.2)).symm)

/-- Independence of the coordinate grid paths and Brownian independent
increments imply independence across all coordinate-time pairs. -/
theorem normalizedBrownianIncrements_independent
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (h : ℝ≥0) (hh : 0 < h)
    (hpaths : iIndepFun (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * h) ω) P) :
    iIndepFun (fun p : ι × ℕ ↦ normalizedBrownianIncrement (B p.1) h p.2) P := by
  have hrows : iIndepFun (fun i ω n ↦ normalizedBrownianIncrement (B i) h n ω) P :=
    hpaths.comp
      (fun _ w n ↦ (w (n + 1) - w n) / Real.sqrt (h : ℝ))
      (by intro i; exact measurable_pi_iff.mpr fun n ↦ by fun_prop)
  exact iIndepFun_uncurry_nat_of_aemeasurable P _
    (fun i n ↦ (normalizedBrownianIncrement_hasLaw P (B i) (hB i) h hh n).aemeasurable)
    hrows (fun i ↦ normalizedBrownianIncrement_independent P (B i) (hB i) h)

/-- Independence of the entire scalar coordinate processes implies the grid
path hypothesis; no measurability of an uncountable path-valued map is added. -/
theorem normalizedBrownianIncrements_independent_of_paths
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (h : ℝ≥0) (hh : 0 < h)
    (hpaths : iIndepFun (fun i ω t ↦ B i t ω) P) :
    iIndepFun (fun p : ι × ℕ ↦ normalizedBrownianIncrement (B p.1) h p.2) P := by
  apply normalizedBrownianIncrements_independent P B hB h hh
  exact hpaths.comp (fun _ w (n : ℕ) ↦ w ((n : ℝ≥0) * h))
    (by intro i; exact measurable_pi_iff.mpr fun n ↦ measurable_pi_apply _)

/-- The complete scalar innovation path has the canonical product law. -/
theorem normalizedBrownianIncrements_hasLaw [Countable ι]
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (h : ℝ≥0) (hh : 0 < h)
    (hpaths : iIndepFun (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * h) ω) P) :
    HasLaw (fun ω (p : ι × ℕ) ↦ normalizedBrownianIncrement (B p.1) h p.2 ω)
      (Measure.infinitePi (fun _ : ι × ℕ ↦ gaussianReal 0 1)) P := by
  have hcoord (p : ι × ℕ) : HasLaw (normalizedBrownianIncrement (B p.1) h p.2)
      (gaussianReal 0 1) P := normalizedBrownianIncrement_hasLaw P _ (hB p.1) h hh p.2
  exact (normalizedBrownianIncrements_independent P B hB h hh hpaths).hasLaw_infinitePi
    hcoord (aemeasurable_pi_iff.mpr fun p ↦ (hcoord p).aemeasurable)

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/ProductBrownian.lean -/
section

set_option linter.style.header false

/-!
# Brownian references on every concrete initial-coupling extension

Brownian finite-dimensional laws pull back along measure-preserving maps.
The Brownian noise constructed on a coupling extension is proved equal to
the lifted source noise. The earlier actual integral-solution construction
therefore supplies `ProductReference` from just its explicit stationarity
obligation. No output-law equality or initial-cost bound is assumed.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped NNReal

namespace ULA.Hilbert
open ULA

section Pullback

variable {Ω Ω' ι : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] [Fintype ι]
  {P : Measure Ω} {P' : Measure Ω'} {f : Ω' → Ω}

/-- Brownian finite-dimensional distributions are preserved by a
measure-preserving change of sample space. -/
theorem preBrownian_comp_measurePreserving (hf : MeasurePreserving f P' P)
    (B : ℝ≥0 → Ω → ℝ) (hB : IsPreBrownianReal B P) :
    IsPreBrownianReal (fun t ω ↦ B t (f ω)) P' where
  hasLaw I := (hB.hasLaw I).comp hf.hasLaw

/-- The canonical `L²` Brownian vectors commute with pullback. -/
theorem brownianCoordinatesLp_pullback (hf : MeasurePreserving f P' P)
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P) (t : ℝ≥0) :
    Lp.compMeasurePreserving f hf (brownianCoordinatesLp P B hB t) =
      brownianCoordinatesLp P' (fun i t ω ↦ B i t (f ω))
        (fun i ↦ preBrownian_comp_measurePreserving hf (B i) (hB i)) t := by
  apply Lp.ext
  have hs := hf.quasiMeasurePreserving.ae_eq_comp (brownianCoordinatesLp_coe P B hB t)
  filter_upwards [Lp.coeFn_compMeasurePreserving (brownianCoordinatesLp P B hB t) hf,
    hs, brownianCoordinatesLp_coe P' (fun i t ω ↦ B i t (f ω))
      (fun i ↦ preBrownian_comp_measurePreserving hf (B i) (hB i)) t]
    with ω hcomp hsource htarget
  exact hcomp.trans (hsource.trans htarget.symm)

/-- The normalized Brownian Euler noise also commutes with pullback. -/
theorem brownianEulerNoise_pullback (hf : MeasurePreserving f P' P)
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (h : ℝ) (n : ℕ) :
    Lp.compMeasurePreserving f hf (brownianEulerNoise P B hB h n) =
      brownianEulerNoise P' (fun i t ω ↦ B i t (f ω))
        (fun i ↦ preBrownian_comp_measurePreserving hf (B i) (hB i)) h n := by
  let T : Lp (EuclideanSpace ℝ ι) 2 P →ₗ[ℝ] Lp (EuclideanSpace ℝ ι) 2 P' :=
    Lp.compMeasurePreservingₗ ℝ f hf
  have hT (t : ℝ≥0) : T (brownianCoordinatesLp P B hB t) =
      brownianCoordinatesLp P' (fun i t ω ↦ B i t (f ω))
        (fun i ↦ preBrownian_comp_measurePreserving hf (B i) (hB i)) t :=
    brownianCoordinatesLp_pullback hf B hB t
  change T (brownianEulerNoise P B hB h n) = _
  simp only [brownianEulerNoise, brownianLangevinNoise, brownianCoordinatesRealLp,
    map_smul, map_sub, hT]

end Pullback

section Product

variable {S ι : Type*} [MeasurableSpace S] [Fintype ι]
  (Q : Measure S) [IsProbabilityMeasure Q]
  {μ : Measure (EuclideanSpace ℝ ι)} [IsProbabilityMeasure μ]

local instance brownianProductProbability {π : Measure (EuclideanSpace ℝ ι)} (c : Coupling μ π) :
    IsProbabilityMeasure (initialExtension c Q) := initialExtension_isProbabilityMeasure c Q

/-- The source noise for the canonical product algorithm is the actual Euler
noise already constructed from the given Brownian coordinates. -/
def sourceEulerNoise (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (n : ℕ) : S → EuclideanSpace ℝ ι :=
  brownianEulerNoise Q B hB h n

omit [IsProbabilityMeasure Q] in
/-- Its square integrability follows from its construction as an `L²` vector. -/
theorem sourceEulerNoise_memLp (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (n : ℕ) :
    MemLp (sourceEulerNoise Q B hB h n) 2 Q := Lp.memLp _

omit [IsProbabilityMeasure Q] in
/-- The source Euler vector is the normalized raw Brownian increment almost
everywhere; all choices of `L²` representatives disappear from this formula. -/
theorem sourceEulerNoise_coe (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (n : ℕ) :
    sourceEulerNoise Q B hB h n =ᵐ[Q] fun ω ↦
      (Real.sqrt (2 * h))⁻¹ • (Real.sqrt 2 •
        (brownianCoordinates B (((n : ℝ) * h + h).toNNReal) ω -
          brownianCoordinates B (((n : ℝ) * h).toNNReal) ω)) := by
  unfold sourceEulerNoise brownianEulerNoise brownianLangevinNoise brownianCoordinatesRealLp
  filter_upwards [Lp.coeFn_smul (Real.sqrt (2 * h))⁻¹
      (Real.sqrt 2 • (brownianCoordinatesLp Q B hB (((n : ℝ) * h + h).toNNReal) -
        brownianCoordinatesLp Q B hB (((n : ℝ) * h).toNNReal))),
    Lp.coeFn_smul (Real.sqrt 2)
      (brownianCoordinatesLp Q B hB (((n : ℝ) * h + h).toNNReal) -
        brownianCoordinatesLp Q B hB (((n : ℝ) * h).toNNReal)),
    Lp.coeFn_sub (brownianCoordinatesLp Q B hB (((n : ℝ) * h + h).toNNReal))
      (brownianCoordinatesLp Q B hB (((n : ℝ) * h).toNNReal)),
    brownianCoordinatesLp_coe Q B hB (((n : ℝ) * h + h).toNNReal),
    brownianCoordinatesLp_coe Q B hB (((n : ℝ) * h).toNNReal)]
    with ω houter hinner hsub hnext hprev
  simp only [houter, hinner, hsub, hnext, hprev, Pi.smul_apply, Pi.sub_apply]

omit [IsProbabilityMeasure Q] in
/-- Each Euler innovation coordinate is the usual Brownian increment divided
by the square root of the time step. -/
theorem sourceEulerNoise_coordinate_coe (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (hh : 0 < h) (n : ℕ) (i : ι) :
    (fun ω ↦ sourceEulerNoise Q B hB h n ω i) =ᵐ[Q] fun ω ↦
      (B i ((((n : ℝ) + 1) * h).toNNReal) ω -
        B i (((n : ℝ) * h).toNNReal) ω) / Real.sqrt h := by
  have hs2 : Real.sqrt 2 ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by norm_num))
  have hsh : Real.sqrt h ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hh)
  filter_upwards [sourceEulerNoise_coe Q B hB h n] with ω hω
  have hi := congrArg (fun z : EuclideanSpace ℝ ι ↦ z i) hω
  change sourceEulerNoise Q B hB h n ω i = (Real.sqrt (2 * h))⁻¹ * (Real.sqrt 2 *
    (B i (((n : ℝ) * h + h).toNNReal) ω - B i (((n : ℝ) * h).toNNReal) ω)) at hi
  rw [hi, show (n : ℝ) * h + h = ((n : ℝ) + 1) * h by ring,
    Real.sqrt_mul (by norm_num : 0 ≤ (2 : ℝ))]
  field_simp

omit [IsProbabilityMeasure Q] in
/-- The same normalized-coordinate formula on the nonnegative Brownian time grid. -/
theorem sourceEulerNoise_coordinate_coe_nnreal (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ≥0) (hh : 0 < h) (n : ℕ) (i : ι) :
    (fun ω ↦ sourceEulerNoise Q B hB (h : ℝ) n ω i) =ᵐ[Q] fun ω ↦
      (B i (((n + 1 : ℕ) : ℝ≥0) * h) ω - B i ((n : ℝ≥0) * h) ω) /
        Real.sqrt (h : ℝ) := by
  have ht (k : ℕ) : ((k : ℝ) * (h : ℝ)).toNNReal = (k : ℝ≥0) * h := by
    apply NNReal.eq
    rw [Real.coe_toNNReal _ (mul_nonneg (Nat.cast_nonneg k) h.coe_nonneg)]
    simp
  have hn : (((n : ℝ) + 1) * (h : ℝ)).toNNReal = ((n + 1 : ℕ) : ℝ≥0) * h := by
    simpa only [Nat.cast_add, Nat.cast_one] using ht (n + 1)
  simpa only [hn, ht n] using
    sourceEulerNoise_coordinate_coe Q B hB (h : ℝ) (by exact_mod_cast hh) n i

omit [IsProbabilityMeasure Q] in
/-- Identification with the standard normalized Brownian-increment definition. -/
theorem sourceEulerNoise_normalized_coordinate (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (hh : 0 < h) (n : ℕ) (i : ι) :
    (fun ω ↦ sourceEulerNoise Q B hB h n ω i) =ᵐ[Q]
      normalizedBrownianIncrement (B i) h.toNNReal n := by
  have hn := sourceEulerNoise_coordinate_coe_nnreal Q B hB h.toNNReal
    (Real.toNNReal_pos.mpr hh) n i
  unfold normalizedBrownianIncrement
  simpa only [Real.coe_toNNReal h hh.le] using hn

omit [IsProbabilityMeasure Q] in
/-- Each source innovation coordinate has the standard real Gaussian law. -/
theorem sourceEulerNoise_coordinateLaw (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (hh : 0 < h) (n : ℕ) (i : ι) :
    HasLaw (fun ω ↦ sourceEulerNoise Q B hB h n ω i) (gaussianReal 0 1) Q :=
  (normalizedBrownianIncrement_hasLaw Q (B i) (hB i) h.toNNReal
    (Real.toNNReal_pos.mpr hh) n).congr
      (sourceEulerNoise_normalized_coordinate Q B hB h hh n i)

omit [IsProbabilityMeasure Q] in
/-- Independent Brownian coordinate grid paths give independent innovations
across every iteration-coordinate pair. -/
theorem sourceEulerNoise_independent (B : ι → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (hh : 0 < h)
    (hpaths : iIndepFun (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * h.toNNReal) ω) Q) :
    iIndepFun (fun p : ℕ × ι ↦ fun ω ↦ sourceEulerNoise Q B hB h p.1 ω p.2) Q := by
  have hind := normalizedBrownianIncrements_independent Q B hB h.toNNReal
    (Real.toNNReal_pos.mpr hh) hpaths
  have hswap := hind.precomp (g := fun p : ℕ × ι ↦ (p.2, p.1)) (by
    intro a b hab
    exact Prod.ext (congrArg Prod.snd hab) (congrArg Prod.fst hab))
  exact hswap.congr (fun p ↦ (sourceEulerNoise_normalized_coordinate Q B hB h hh p.1 p.2).symm)

omit [Fintype ι] in
/-- The source Brownian coordinates remain Brownian on every coupling extension. -/
theorem productPreBrownian {π : Measure (EuclideanSpace ℝ ι)} (c : Coupling μ π)
    (B : ι → ℝ≥0 → S → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) Q) (i : ι) :
    IsPreBrownianReal (fun t (p : (EuclideanSpace ℝ ι × EuclideanSpace ℝ ι) × S) ↦ B i t p.2)
      (initialExtension c Q) := by
  have := c.isProbabilityMeasure
  exact preBrownian_comp_measurePreserving measurePreserving_snd (B i) (hB i)

/-- The common lifted source noise is exactly the Euler noise used by the
Brownian reference on the coupling extension. This equality is proved from
the actual coordinate construction. -/
theorem productNoise_eq_brownianEulerNoise
    {π : Measure (EuclideanSpace ℝ ι)} (c : Coupling μ π)
    (B : ι → ℝ≥0 → S → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) Q)
    (h : ℝ) (n : ℕ) :
    productNoise Q c (sourceEulerNoise Q B hB h) (sourceEulerNoise_memLp Q B hB h) n =
      brownianEulerNoise (initialExtension c Q) (fun i t p ↦ B i t p.2)
        (productPreBrownian Q c B hB) h n := by
  have := c.isProbabilityMeasure
  calc
    _ = Lp.compMeasurePreserving Prod.snd
        (measurePreserving_snd (μ := c.joint) (ν := Q)) (brownianEulerNoise Q B hB h n) := by
      apply Lp.ext
      exact (productNoise_coe Q c (sourceEulerNoise Q B hB h)
        (sourceEulerNoise_memLp Q B hB h) n).trans
          (Lp.coeFn_compMeasurePreserving (brownianEulerNoise Q B hB h n)
            (measurePreserving_snd (μ := c.joint) (ν := Q))).symm
    _ = _ := brownianEulerNoise_pullback measurePreserving_snd B hB h n

/-- The lifted Brownian noise has the actual standard Gaussian coordinate law. -/
theorem productEulerNoise_coordinateLaw
    {π : Measure (EuclideanSpace ℝ ι)} (c : Coupling μ π)
    (B : ι → ℝ≥0 → S → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) Q)
    (h : ℝ) (hh : 0 < h) (n : ℕ) (i : ι) :
    HasLaw (fun p ↦ productNoise Q c (sourceEulerNoise Q B hB h)
      (sourceEulerNoise_memLp Q B hB h) n p i) (gaussianReal 0 1)
        (initialExtension c Q) := by
  have := c.isProbabilityMeasure
  exact ((sourceEulerNoise_coordinateLaw Q B hB h hh n i).comp
    (measurePreserving_snd (μ := c.joint) (ν := Q)).hasLaw).congr
      ((productNoise_coe Q c (sourceEulerNoise Q B hB h)
        (sourceEulerNoise_memLp Q B hB h) n).fun_comp (fun z ↦ z i))

/-- Independence across all innovation coordinates and times is preserved
on the concrete product extension. -/
theorem productEulerNoise_independent
    {π : Measure (EuclideanSpace ℝ ι)} (c : Coupling μ π)
    (B : ι → ℝ≥0 → S → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) Q)
    (h : ℝ) (hh : 0 < h)
    (hpaths : iIndepFun (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * h.toNNReal) ω) Q) :
    iIndepFun (fun j : ℕ × ι ↦ fun p ↦
      productNoise Q c (sourceEulerNoise Q B hB h)
        (sourceEulerNoise_memLp Q B hB h) j.1 p j.2) (initialExtension c Q) := by
  have := c.isProbabilityMeasure
  have hsource : HasLaw
      (fun s (j : ℕ × ι) ↦ sourceEulerNoise Q B hB h j.1 s j.2)
      (Measure.infinitePi (fun _ : ℕ × ι ↦ gaussianReal 0 1)) Q :=
    (sourceEulerNoise_independent Q B hB h hh hpaths).hasLaw_infinitePi
    (fun j : ℕ × ι ↦ sourceEulerNoise_coordinateLaw Q B hB h hh j.1 j.2)
