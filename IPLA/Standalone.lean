/-! ## Included source: UnadjustedLangevin/MarkovLaw.lean -/
section

set_option linter.style.header false

/-! # Markov update laws of the actual iid recursion

The finite prefix of the canonical noise path is independent of the next noise.
Measurable finite-prefix recursion therefore proves, rather than assumes, that
the actual chain laws iterate the one-step product-noise transition.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory ProbabilityTheory
open scoped ENNReal
namespace ULA

variable {H Z : Type*}

/-- The same recursion evaluated using precisely its finite noise prefix. -/
def finiteNoiseChain (F : H → Z → H) (x : H) : {n : ℕ} → (Fin n → Z) → H
  | 0, _ => x
  | n + 1, w => F (finiteNoiseChain F x (fun i : Fin n ↦ w i.castSucc)) (w (Fin.last n))

/-- Finite-prefix and infinite-path implementations agree pointwise. -/
theorem finiteNoiseChain_eq (F : H → Z → H) (x : H) (w : ℕ → Z) (n : ℕ) :
    finiteNoiseChain F x (fun i : Fin n ↦ w i) = noiseDrivenChain F x w n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    simpa only [finiteNoiseChain, noiseDrivenChain_succ, Fin.val_castSucc, Fin.val_last] using
      congrArg (fun y ↦ F y (w n)) ih

variable [MeasurableSpace H] [MeasurableSpace Z]

/-- The finite-prefix recursion is a measurable function of its inputs. -/
theorem finiteNoiseChain_measurable (F : H → Z → H)
    (hF : Measurable (Function.uncurry F)) (n : ℕ) :
    Measurable (fun p : H × (Fin n → Z) ↦ finiteNoiseChain F p.1 p.2) := by
  induction n with
  | zero => exact measurable_fst
  | succ n ih =>
    exact hF.comp ((ih.comp (measurable_fst.prodMk (by fun_prop))).prodMk (by fun_prop))

/-- The canonical iid path prefix and next coordinate are independent. -/
theorem iid_prefix_independent_fresh (η : Measure Z) [IsProbabilityMeasure η] (n : ℕ) :
    IndepFun (fun w : ℕ → Z ↦ fun i : Fin n ↦ w i) (fun w ↦ w n)
      (Measure.infinitePi (fun _ : ℕ ↦ η)) := by
  have hind : iIndepFun (fun k (w : ℕ → Z) ↦ w k)
      (Measure.infinitePi (fun _ : ℕ ↦ η)) :=
    iIndepFun_infinitePi (X := fun _ x ↦ x) (by fun_prop)
  have hdis : Disjoint (Finset.range n) ({n} : Finset ℕ) := by simp
  have hp := hind.indepFun_finset (Finset.range n) {n} hdis (by fun_prop)
  exact hp.comp
    (φ := fun w : (k : (Finset.range n : Finset ℕ)) → Z ↦
      fun i : Fin n ↦ w ⟨i.val, Finset.mem_range.mpr i.isLt⟩)
    (ψ := fun w : (k : ({n} : Finset ℕ)) → Z ↦ w ⟨n, by simp⟩)
    (by fun_prop) (by fun_prop)

/-- One Markov step driven by an independent noise variable. -/
def markovStep (F : H → Z → H) (η : Measure Z) (μ : Measure H) : Measure H :=
  (μ.prod η).map (Function.uncurry F)

/-- Iterated Markov-step laws, starting from `μ`. -/
def markovLaws (F : H → Z → H) (η : Measure Z) (μ : Measure H) : ℕ → Measure H
  | 0 => μ
  | n + 1 => markovStep F η (markovLaws F η μ n)

/-- The joint law of the actual current state and its next iid innovation is
the product of the actual state law and the specified innovation law. -/
theorem chainLaw_joint_fresh
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (μ : Measure H) [IsProbabilityMeasure μ] (η : Measure Z) [IsProbabilityMeasure η]
    (n : ℕ) :
    (μ.prod (Measure.infinitePi (fun _ : ℕ ↦ η))).map
      (fun p ↦ (noiseDrivenChain F p.1 p.2 n, p.2 n)) =
    (chainLaw F μ (Measure.infinitePi (fun _ : ℕ ↦ η)) n).prod η := by
  let Q := Measure.infinitePi (fun _ : ℕ ↦ η)
  let pref : (ℕ → Z) → (Fin n → Z) := fun w i ↦ w i
  let ρ := Q.map pref
  let ν := μ.prod ρ
  let C : H × (Fin n → Z) → H := fun p ↦ finiteNoiseChain F p.1 p.2
  have hprefix : Measurable pref := by fun_prop
  have hC : Measurable C := finiteNoiseChain_measurable F hF n
  have hρ : IsProbabilityMeasure ρ := by
    constructor
    dsimp only [ρ]
    rw [Measure.map_apply hprefix MeasurableSet.univ, Set.preimage_univ, measure_univ]
  have hp : Q.map (fun w ↦ (pref w, w n)) = ρ.prod η := by
    rw [(iid_prefix_independent_fresh η n).map_prod_eq_prod_map_map
      hprefix.aemeasurable (measurable_pi_apply n).aemeasurable,
      Measure.infinitePi_map_eval]
  have hgroup : (μ.prod Q).map (fun p ↦ (p.1, (pref p.2, p.2 n))) =
      μ.prod (ρ.prod η) := by
    have h := Measure.map_prod_map μ Q measurable_id
      (hprefix.prodMk (measurable_pi_apply n))
    rw [Measure.map_id, hp] at h
    convert h.symm using 1
    apply Measure.map_congr
    exact ae_of_all _ fun _ ↦ rfl
  have hassoc : (μ.prod Q).map (fun p ↦ ((p.1, pref p.2), p.2 n)) = ν.prod η := by
    have h := congrArg (fun κ : Measure (H × ((Fin n → Z) × Z)) ↦
      κ.map (MeasurableEquiv.prodAssoc.symm : H × ((Fin n → Z) × Z) →
        (H × (Fin n → Z)) × Z)) hgroup
    rw [Measure.map_map (MeasurableEquiv.prodAssoc.symm.measurable) (by fun_prop),
      (measurePreserving_prodAssoc μ ρ η).symm.map_eq] at h
    exact h
  have hjoint : (μ.prod Q).map
      (fun p ↦ (C (p.1, pref p.2), p.2 n)) = (ν.map C).prod η := by
    have h := congrArg (fun κ : Measure ((H × (Fin n → Z)) × Z) ↦
      κ.map (Prod.map C id)) hassoc
    rw [Measure.map_map (hC.prodMap measurable_id) (by fun_prop),
      ← Measure.map_prod_map ν η hC measurable_id, Measure.map_id] at h
    exact h
  have hstate : ν.map C = chainLaw F μ Q n := by
    have h := congrArg (fun κ : Measure (H × Z) ↦ κ.map Prod.fst) hjoint
    rw [Measure.map_map measurable_fst (by fun_prop)] at h
    simp only [Measure.map_fst_prod, measure_univ, one_smul] at h
    rw [← h]
    apply Measure.map_congr
    exact ae_of_all _ fun p ↦ finiteNoiseChain_eq F p.1 p.2 n
  rw [hstate] at hjoint
  convert hjoint using 1
  apply Measure.map_congr
  exact ae_of_all _ fun p ↦ (congrArg (fun x ↦ (x, p.2 n)) (finiteNoiseChain_eq F p.1 p.2 n)).symm

/-- The actual canonical iid recursion satisfies the Markov law update. -/
theorem chainLaw_succ_iid
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (μ : Measure H) [IsProbabilityMeasure μ] (η : Measure Z) [IsProbabilityMeasure η]
    (n : ℕ) :
    chainLaw F μ (Measure.infinitePi (fun _ : ℕ ↦ η)) (n + 1) =
      markovStep F η (chainLaw F μ (Measure.infinitePi (fun _ : ℕ ↦ η)) n) := by
  have hm : Measurable (fun p : H × (ℕ → Z) ↦
      (noiseDrivenChain F p.1 p.2 n, p.2 n)) :=
    (noiseDrivenChain_measurable F hF n).prodMk ((measurable_pi_apply n).comp measurable_snd)
  rw [markovStep, ← chainLaw_joint_fresh F hF μ η n,
    Measure.map_map hF hm]
  rfl

/-- The canonical recursion laws are precisely the iterated independent-noise
Markov-step laws. No state/noise independence premise is assumed at later times. -/
theorem chainLaw_eq_markovLaws
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (μ : Measure H) [IsProbabilityMeasure μ] (η : Measure Z) [IsProbabilityMeasure η]
    (n : ℕ) :
    chainLaw F μ (Measure.infinitePi (fun _ : ℕ ↦ η)) n = markovLaws F η μ n := by
  induction n with
  | zero => exact chainLaw_zero F μ _
  | succ n ih => rw [chainLaw_succ_iid F hF μ η n, markovLaws, ih]

/-- Measurable independent-noise transitions preserve probability mass. -/
theorem markovStep_isProbability
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (μ : Measure H) [IsProbabilityMeasure μ] (η : Measure Z) [IsProbabilityMeasure η] :
    IsProbabilityMeasure (markovStep F η μ) := by
  constructor
  rw [markovStep, Measure.map_apply hF MeasurableSet.univ, Set.preimage_univ, measure_univ]

/-- Every iterated Markov law is a probability measure. -/
theorem markovLaws_isProbability
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (μ : Measure H) [IsProbabilityMeasure μ] (η : Measure Z) [IsProbabilityMeasure η]
    (n : ℕ) : IsProbabilityMeasure (markovLaws F η μ n) := by
  induction n with
  | zero => exact inferInstanceAs (IsProbabilityMeasure μ)
  | succ n ih =>
    have := ih
    exact markovStep_isProbability F hF _ η

variable {Ω : Type*} [MeasurableSpace Ω]

/-- Any independent iid realization of the recursion has the proved Markov
iterate law, regardless of its probability-space realization. -/
theorem noiseDrivenChain_law_eq_markovLaws (P : Measure Ω) [IsProbabilityMeasure P]
    (F : H → Z → H) (hF : Measurable (Function.uncurry F))
    (X : Ω → H) (W : ℕ → Ω → Z) (hX : AEMeasurable X P)
    (hW : ∀ n, AEMeasurable (W n) P)
    (hind : IndepFun X (fun ω n ↦ W n ω) P) (hiid : iIndepFun W P)
    (η : Measure Z) [IsProbabilityMeasure η] (hlaw : ∀ n, P.map (W n) = η) (n : ℕ) :
    P.map (fun ω ↦ noiseDrivenChain F (X ω) (fun k ↦ W k ω) n) =
      markovLaws F η (P.map X) n := by
  have : IsProbabilityMeasure (P.map X) := by
    constructor
    rw [Measure.map_apply_of_aemeasurable hX MeasurableSet.univ, Set.preimage_univ, measure_univ]
  rw [noiseDrivenChain_law_of_iid P F hF X W hX hW hind hiid η hlaw,
    chainLaw_eq_markovLaws F hF (P.map X) η n]

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/MALAError.lean -/
section

set_option linter.style.header false

/-! # The local rejection error of Metropolis-adjusted Langevin

The log acceptance ratio and its rejection displacement are estimated using
only a differentiable potential and its Lipschitz gradient. Gaussian tail
domination supplies the Gibbs moments used by the integrated estimate.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The ULA proposal used by MALA. -/
def malaProposal (U : H → ℝ) (h : ℝ) (x ξ : H) : H :=
  x - h • gradient U x + Real.sqrt (2 * h) • ξ

/-- Logarithm of the target-density ratio times the reverse/forward Gaussian
proposal-density ratio. The common Gaussian normalization cancels. -/
def malaLogRatio (U : H → ℝ) (h : ℝ) (x y : H) : ℝ :=
  U x - U y -
    (‖x - y + h • gradient U y‖ ^ 2 - ‖y - x + h • gradient U x‖ ^ 2) / (4 * h)

/-- Exact acceptance-ratio algebra, valid for every pair of states. -/
theorem malaLogRatio_expansion (U : H → ℝ) (h : ℝ) (hh : h ≠ 0) (x y : H) :
    malaLogRatio U h x y = U x - U y +
      (1 / 2 : ℝ) * inner ℝ (gradient U x + gradient U y) (y - x) -
        h / 4 * (‖gradient U y‖ ^ 2 - ‖gradient U x‖ ^ 2) := by
  have hsub : x - y = -(y - x) := by abel
  simp only [malaLogRatio, hsub, norm_add_sq_real, norm_neg, norm_smul,
    real_inner_smul_right, inner_neg_left, Real.norm_eq_abs, mul_pow, sq_abs,
    inner_add_left]
  rw [real_inner_comm (y - x) (gradient U x), real_inner_comm (y - x) (gradient U y)]
  field_simp
  ring

/-- The difference of gradient squared norms is controlled by gradient
Lipschitzness and the two endpoint score norms. -/
theorem gradient_norm_sq_difference_bound (U : H → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U)) (x y : H) :
    |‖gradient U y‖ ^ 2 - ‖gradient U x‖ ^ 2| ≤
      (L : ℝ) * ‖y - x‖ * (‖gradient U x‖ + ‖gradient U y‖) := by
  have hn : |‖gradient U y‖ - ‖gradient U x‖| ≤ (L : ℝ) * ‖y - x‖ :=
    (abs_norm_sub_norm_le _ _).trans (by simpa only [dist_eq_norm] using hLip.dist_le_mul y x)
  rw [show ‖gradient U y‖ ^ 2 - ‖gradient U x‖ ^ 2 =
    (‖gradient U y‖ - ‖gradient U x‖) * (‖gradient U x‖ + ‖gradient U y‖) by ring,
    abs_mul, abs_of_nonneg (add_nonneg (norm_nonneg _) (norm_nonneg _))]
  exact mul_le_mul_of_nonneg_right hn (by positivity)

/-- The trapezoidal potential increment has a quadratic Lipschitz bound.
No Hessian or derivative of the gradient is assumed. -/
theorem potential_trapezoid_bound (U : H → ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U)) (x y : H) :
    |U x - U y + (1 / 2 : ℝ) * inner ℝ (gradient U x + gradient U y) (y - x)| ≤
      (L : ℝ) * ‖y - x‖ ^ 2 := by
  have hxy := Analysis.smooth_upper_bound U L hdiff hLip x y
  have hyx := Analysis.smooth_upper_bound U L hdiff hLip y x
  have hsub : x - y = -(y - x) := by abel
  rw [hsub, inner_neg_right, norm_neg] at hyx
  have hgrad : |inner ℝ (gradient U y - gradient U x) (y - x)| ≤
      (L : ℝ) * ‖y - x‖ ^ 2 := by
    have hl : ‖gradient U y - gradient U x‖ ≤ (L : ℝ) * ‖y - x‖ := by
      simpa only [dist_eq_norm] using hLip.dist_le_mul y x
    exact (abs_real_inner_le_norm _ _).trans (by nlinarith [norm_nonneg (y - x)])
  rw [inner_sub_left, abs_le] at hgrad
  rw [inner_add_left, abs_le]
  constructor <;> nlinarith [hgrad.1, hgrad.2]

/-- The complete local log-ratio bound under the stated C¹/smoothness
assumptions. -/
theorem malaLogRatio_abs_bound (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hh : 0 < h) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (x y : H) :
    |malaLogRatio U h x y| ≤ (L : ℝ) * ‖y - x‖ ^ 2 +
      h * (L : ℝ) / 4 * ‖y - x‖ * (‖gradient U x‖ + ‖gradient U y‖) := by
  rw [malaLogRatio_expansion U h hh.ne']
  have ht := potential_trapezoid_bound U L hdiff hLip x y
  have hg := mul_le_mul_of_nonneg_left (gradient_norm_sq_difference_bound U L hLip x y)
    (by positivity : 0 ≤ h / 4)
  have hb := abs_sub (U x - U y + (1 / 2 : ℝ) *
    inner ℝ (gradient U x + gradient U y) (y - x))
      (h / 4 * (‖gradient U y‖ ^ 2 - ‖gradient U x‖ ^ 2))
  rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ h / 4)] at hb
  nlinarith

/-- The Metropolis rejection probability is bounded by the absolute log ratio. -/
theorem metropolis_rejection_le_abs (r : ℝ) :
    0 ≤ 1 - min 1 (Real.exp r) ∧ 1 - min 1 (Real.exp r) ≤ |r| := by
  have hlo : 1 - |r| ≤ min 1 (Real.exp r) :=
    le_min (by linarith [abs_nonneg r]) (by linarith [Real.add_one_le_exp r, neg_abs_le r])
  exact ⟨sub_nonneg.mpr (min_le_left _ _), by linarith⟩

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- A rejected move contributes at most displacement times absolute log ratio
to the expected coupling error. -/
theorem rejected_displacement_le (r : ℝ) (x y : H) :
    ‖y - x‖ * (1 - min 1 (Real.exp r)) ≤ ‖y - x‖ * |r| :=
  mul_le_mul_of_nonneg_left (metropolis_rejection_le_abs r).2 (norm_nonneg _)

/-- A step-size-independent envelope for the proposal displacement. -/
def malaAmplitude (U : H → ℝ) (x ξ : H) : ℝ :=
  ‖gradient U x‖ + Real.sqrt 2 * ‖ξ‖

/-- The conditional expected displacement lost when the proposal is rejected. -/
def malaRejectionDisplacement (U : H → ℝ) (h : ℝ) (x ξ : H) : ℝ :=
  let y := malaProposal U h x ξ
  ‖y - x‖ * (1 - min 1 (Real.exp (malaLogRatio U h x y)))

theorem malaAmplitude_nonneg (U : H → ℝ) (x ξ : H) : 0 ≤ malaAmplitude U x ξ := by
  unfold malaAmplitude
  positivity

theorem malaRejectionDisplacement_nonneg (U : H → ℝ) (h : ℝ) (x ξ : H) :
    0 ≤ malaRejectionDisplacement U h x ξ :=
  mul_nonneg (norm_nonneg _) (metropolis_rejection_le_abs _).1

/-- On a step of length at most one, the proposal displacement is bounded by
the square root of the step length times the fixed amplitude. -/
theorem malaProposal_displacement_le (U : H → ℝ) (h : ℝ) (hh : 0 ≤ h) (h1 : h ≤ 1)
    (x ξ : H) :
    ‖malaProposal U h x ξ - x‖ ≤ Real.sqrt h * malaAmplitude U x ξ := by
  have hsq := Real.sq_sqrt hh
  have hs1 : Real.sqrt h ≤ 1 := Real.sqrt_le_one.mpr h1
  have hhs : h ≤ Real.sqrt h := by nlinarith [Real.sqrt_nonneg h]
  have heq : malaProposal U h x ξ - x =
      -(h • gradient U x) + Real.sqrt (2 * h) • ξ := by
    unfold malaProposal
    module
  rw [heq]
  calc
    _ ≤ ‖-(h • gradient U x)‖ + ‖Real.sqrt (2 * h) • ξ‖ := norm_add_le _ _
    _ = h * ‖gradient U x‖ + Real.sqrt 2 * Real.sqrt h * ‖ξ‖ := by
      simp only [norm_neg, norm_smul, Real.norm_eq_abs, abs_of_nonneg hh,
        Real.sqrt_mul (by norm_num : 0 ≤ (2 : ℝ)), abs_mul,
        abs_of_nonneg (Real.sqrt_nonneg 2), abs_of_nonneg (Real.sqrt_nonneg h)]
    _ ≤ Real.sqrt h * malaAmplitude U x ξ := by
      unfold malaAmplitude
      nlinarith [mul_le_mul_of_nonneg_right hhs (norm_nonneg (gradient U x))]

/-- A Lipschitz gradient gives a local rejection error of order `h^(3/2)`.
The envelope is cubic and contains no step size. -/
theorem malaRejectionDisplacement_pointwise (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hh : 0 < h) (h1 : h ≤ 1) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (x ξ : H) :
    malaRejectionDisplacement U h x ξ ≤ h * Real.sqrt h *
      ((L : ℝ) * (2 + (L : ℝ)) * malaAmplitude U x ξ ^ 3) := by
  let y := malaProposal U h x ξ
  let r := ‖y - x‖
  let a := malaAmplitude U x ξ
  let s := Real.sqrt h
  have hr : 0 ≤ r := norm_nonneg _
  have ha : 0 ≤ a := malaAmplitude_nonneg U x ξ
  have hs : 0 ≤ s := Real.sqrt_nonneg _
  have hs1 : s ≤ 1 := Real.sqrt_le_one.mpr h1
  have hs2 : s ^ 2 = h := Real.sq_sqrt hh.le
  have hhs : h ≤ s := by nlinarith
  have hstep : r ≤ s * a := malaProposal_displacement_le U h hh.le h1 x ξ
  have hra : r ≤ a := hstep.trans (by nlinarith)
  have hgxa : ‖gradient U x‖ ≤ a := by
    dsimp [a, malaAmplitude]
    exact le_add_of_nonneg_right (by positivity)
  have hgy : ‖gradient U y‖ ≤ ‖gradient U x‖ + (L : ℝ) * r := by
    have ht := norm_sub_le (gradient U y) (gradient U x)
    have hl : ‖gradient U y - gradient U x‖ ≤ (L : ℝ) * r := by
      simpa only [dist_eq_norm] using hLip.dist_le_mul y x
    have ht' := norm_add_le (gradient U y - gradient U x) (gradient U x)
    simpa only [sub_add_cancel] using ht'.trans (by nlinarith)
  have hscore : ‖gradient U x‖ + ‖gradient U y‖ ≤ (2 + (L : ℝ)) * a := by
    nlinarith [mul_le_mul_of_nonneg_left hra L.coe_nonneg]
  have hlog := malaLogRatio_abs_bound U h L hh hdiff hLip x y
  have hrej : malaRejectionDisplacement U h x ξ ≤
      (L : ℝ) * r ^ 3 + h * (L : ℝ) / 4 * r ^ 2 *
        (‖gradient U x‖ + ‖gradient U y‖) := by
    have h := (rejected_displacement_le (malaLogRatio U h x y) x y).trans
      (mul_le_mul_of_nonneg_left hlog hr)
    dsimp [malaRejectionDisplacement, y, r] at *
    nlinarith [h]
  have hhh : h ^ 2 ≤ h * s := by
    simpa only [pow_two] using mul_le_mul_of_nonneg_left hhs hh.le
  have hcoef : (L : ℝ) + (L : ℝ) / 4 * (2 + (L : ℝ)) ≤ (L : ℝ) * (2 + (L : ℝ)) := by
    nlinarith [L.coe_nonneg, sq_nonneg (L : ℝ)]
  calc
    malaRejectionDisplacement U h x ξ ≤
        (L : ℝ) * r ^ 3 + h * (L : ℝ) / 4 * r ^ 2 *
          (‖gradient U x‖ + ‖gradient U y‖) := hrej
    _ ≤ (L : ℝ) * (s * a) ^ 3 + h * (L : ℝ) / 4 * (s * a) ^ 2 *
        ((2 + (L : ℝ)) * a) := by gcongr
    _ = (L : ℝ) * h * s * a ^ 3 + (L : ℝ) / 4 * (2 + (L : ℝ)) * h ^ 2 * a ^ 3 := by
      rw [mul_pow, pow_succ s 2, hs2, mul_pow, hs2]
      ring
    _ ≤ (L : ℝ) * h * s * a ^ 3 + (L : ℝ) / 4 * (2 + (L : ℝ)) * (h * s) * a ^ 3 := by
      gcongr
    _ ≤ h * Real.sqrt h * ((L : ℝ) * (2 + (L : ℝ)) * malaAmplitude U x ξ ^ 3) := by
      have hc := mul_le_mul_of_nonneg_right hcoef (by positivity : 0 ≤ h * s * a ^ 3)
      dsimp [s, a] at *
      nlinarith [hc]

section Moments

variable [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

omit [CompleteSpace H] in
/-- A fourth-degree polynomial is integrable against every radial Gaussian. -/
theorem integrable_norm_fourth_mul_exp_neg_mul_norm_sq (a : ℝ) (ha : 0 < a) :
    Integrable (fun x : H ↦ ‖x‖ ^ 4 * Real.exp (-a * ‖x‖ ^ 2)) volume := by
  let b := a / 2
  have hb : 0 < b := by dsimp [b]; positivity
  have hi := (integrable_exp_neg_mul_norm_sq (H := H) b hb).const_mul (2 / b ^ 2)
  refine hi.mono' (by fun_prop) (Filter.Eventually.of_forall fun x ↦ ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  have hp : (b * ‖x‖ ^ 2) ^ 2 / 2 ≤ Real.exp (b * ‖x‖ ^ 2) := by
    simpa using Real.pow_div_factorial_le_exp (b * ‖x‖ ^ 2)
      (by positivity : 0 ≤ b * ‖x‖ ^ 2) 2
  have he : Real.exp (b * ‖x‖ ^ 2) * Real.exp (-a * ‖x‖ ^ 2) =
      Real.exp (-b * ‖x‖ ^ 2) := by
    rw [← Real.exp_add]
    congr 1
    dsimp [b]
    ring
  have hp' : b ^ 2 * ‖x‖ ^ 4 * Real.exp (-a * ‖x‖ ^ 2) ≤
      2 * Real.exp (-b * ‖x‖ ^ 2) := by
    calc
      _ = (2 * ((b * ‖x‖ ^ 2) ^ 2 / 2)) * Real.exp (-a * ‖x‖ ^ 2) := by ring
      _ ≤ (2 * Real.exp (b * ‖x‖ ^ 2)) * Real.exp (-a * ‖x‖ ^ 2) := by gcongr
      _ = _ := by rw [mul_assoc, he]
  apply (mul_le_mul_iff_right₀ (sq_pos_of_pos hb)).mp
  calc
    b ^ 2 * (‖x‖ ^ 4 * Real.exp (-a * ‖x‖ ^ 2)) =
        b ^ 2 * ‖x‖ ^ 4 * Real.exp (-a * ‖x‖ ^ 2) := by ring
    _ ≤ 2 * Real.exp (-b * ‖x‖ ^ 2) := hp'
    _ = b ^ 2 * (2 / b ^ 2 * Real.exp (-b * ‖x‖ ^ 2)) := by field_simp

/-- Strong convexity gives a finite fourth unnormalized Gibbs moment. -/
theorem integrable_norm_fourth_mul_exp_neg_of_strongConvex
    (U : H → ℝ) (m : ℝ) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U) :
    Integrable (fun x : H ↦ ‖x‖ ^ 4 * Real.exp (-U x)) volume := by
  let C := ‖gradient U 0‖ ^ 2 / m - U 0
  have hi := (integrable_norm_fourth_mul_exp_neg_mul_norm_sq (H := H) (m / 4)
    (by positivity)).const_mul (Real.exp C)
  refine hi.mono'
    (((continuous_norm.pow 4).mul
      (Real.continuous_exp.comp hdiff.continuous.neg)).aestronglyMeasurable)
    (Filter.Eventually.of_forall fun x ↦ ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
  calc
    ‖x‖ ^ 4 * Real.exp (-U x) ≤
        ‖x‖ ^ 4 * Real.exp (C + -(m / 4) * ‖x‖ ^ 2) := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply Real.exp_le_exp.mpr
      have hs := strongConvex_quadratic_lower_bound U m hm hdiff hsc x
      dsimp [C]
      linarith
    _ = Real.exp C * (‖x‖ ^ 4 * Real.exp (-(m / 4) * ‖x‖ ^ 2)) := by
      rw [Real.exp_add]
      ring

/-- The fourth Gibbs moment is derived, never assumed. -/
theorem integrable_norm_fourth_gibbsMeasure
    (U : H → ℝ) (m : ℝ) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U) :
    Integrable (fun x : H ↦ ‖x‖ ^ 4) (gibbsMeasure U) := by
  have hi : Integrable (fun x : H ↦ ‖x‖ ^ 4) (volume.withDensity (gibbsWeight U)) := by
    change Integrable (fun x : H ↦ ‖x‖ ^ 4)
      (volume.withDensity (fun x ↦ ENNReal.ofReal (Real.exp (-U x))))
    apply (integrable_withDensity_iff_integrable_smul' (μ := (volume : Measure H))
      (f := fun x ↦ ENNReal.ofReal (Real.exp (-U x)))
      (Real.continuous_exp.comp hdiff.continuous.neg).measurable.ennreal_ofReal
      (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)).mpr
    simpa only [smul_eq_mul, mul_comm,
      ENNReal.toReal_ofReal (Real.exp_nonneg _)] using
      integrable_norm_fourth_mul_exp_neg_of_strongConvex U m hm hdiff hsc
  exact hi.smul_measure (ENNReal.inv_ne_top.mpr (ne_of_gt (gibbsPartition_pos U hdiff)))

/-- The cubic moment required by the rejection envelope follows from the
proved fourth Gibbs moment. -/
theorem memLp_three_id_gibbsMeasure
    (U : H → ℝ) (m : ℝ) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U) :
    MemLp (fun x : H ↦ x) 3 (gibbsMeasure U) := by
  have := isProbabilityMeasure_gibbsMeasure U m hm hdiff hsc
  have h3 := integrable_norm_pow_of_le (f := fun x : H ↦ x) (by fun_prop)
    (by norm_num : (3 : ℕ) ≤ 4) (integrable_norm_fourth_gibbsMeasure U m hm hdiff hsc)
  apply (integrable_norm_rpow_iff (p := 3) (by fun_prop) (by norm_num) (by norm_num)).mp
  simpa using h3

/-- The joint law used to average the local rejection error: a Gibbs state
and an independent standard Gaussian proposal innovation. -/
def malaPairMeasure (U : H → ℝ) : Measure (H × H) :=
  (gibbsMeasure U).prod (stdGaussian H)

/-- The cubic amplitude envelope is squarely a consequence of the original
potential assumptions and the standard Gaussian law. -/
theorem malaAmplitude_memLp_three (U : H → ℝ) (m : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) :
    MemLp (fun p : H × H ↦ malaAmplitude U p.1 p.2) 3 (malaPairMeasure U) := by
  have := isProbabilityMeasure_gibbsMeasure U m hm hdiff hsc
  have hx := memLp_three_id_gibbsMeasure U m hm hdiff hsc
  have hcenter : MemLp (fun x ↦ gradient U x - gradient U 0) 3 (gibbsMeasure U) :=
    (centered_lipschitz hLip).comp_memLp (by simp) hx
  have hg : MemLp (gradient U) 3 (gibbsMeasure U) := by
    simpa only [Pi.add_def, sub_add_cancel] using
      hcenter.add (memLp_const (gradient U 0))
  have hg' := hg.comp_measurePreserving
    (measurePreserving_fst (μ := gibbsMeasure U) (ν := stdGaussian H))
  have hz : MemLp (fun ξ : H ↦ ξ) 3 (stdGaussian H) :=
    IsGaussian.memLp_id (stdGaussian H) 3 (by norm_num)
  have hz' := hz.comp_measurePreserving
    (measurePreserving_snd (μ := gibbsMeasure U) (ν := stdGaussian H))
  exact hg'.norm.add (hz'.norm.const_mul (Real.sqrt 2))

/-- The cubic rejection envelope has a finite ordinary integral. -/
theorem malaAmplitude_cube_integrable (U : H → ℝ) (m : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) :
    Integrable (fun p : H × H ↦ malaAmplitude U p.1 p.2 ^ 3) (malaPairMeasure U) := by
  have hi := (malaAmplitude_memLp_three U m L hm hdiff hsc hLip).integrable_norm_pow
    (by norm_num : (3 : ℕ) ≠ 0)
  simpa only [Real.norm_eq_abs, abs_of_nonneg (malaAmplitude_nonneg U _ _)] using hi

/-- An explicit finite local-error constant, independent of the step length.
Its integrability is established by `malaAmplitude_cube_integrable`. -/
def malaRejectionConstant (U : H → ℝ) (L : ℝ≥0) : ℝ :=
  (L : ℝ) * (2 + (L : ℝ)) *
    ∫ p : H × H, malaAmplitude U p.1 p.2 ^ 3 ∂malaPairMeasure U

theorem malaRejectionConstant_nonneg (U : H → ℝ) (L : ℝ≥0) :
    0 ≤ malaRejectionConstant U L := by
  unfold malaRejectionConstant
  apply mul_nonneg (by positivity)
  exact integral_nonneg fun p ↦ pow_nonneg (malaAmplitude_nonneg U p.1 p.2) 3

/-- The actual expected rejected displacement is integrable for every
positive step of length at most one. -/
theorem malaRejectionDisplacement_integrable (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 < h) (h1 : h ≤ 1)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) :
    Integrable (fun p : H × H ↦ malaRejectionDisplacement U h p.1 p.2)
      (malaPairMeasure U) := by
  have henv := ((malaAmplitude_cube_integrable U m L hm hdiff hsc hLip).const_mul
    ((L : ℝ) * (2 + (L : ℝ)))).const_mul (h * Real.sqrt h)
  have hU : Continuous U := hdiff.continuous
  have hg : Continuous (gradient U) := hLip.continuous
  have hmeas : Continuous (fun p : H × H ↦ malaRejectionDisplacement U h p.1 p.2) := by
    unfold malaRejectionDisplacement malaLogRatio malaProposal
    fun_prop
  refine henv.mono' hmeas.aestronglyMeasurable (Filter.Eventually.of_forall fun p ↦ ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (malaRejectionDisplacement_nonneg U h p.1 p.2)]
  exact malaRejectionDisplacement_pointwise U h L hh h1 hdiff hLip p.1 p.2

/-- The integrated MALA rejection error is `O(h^(3/2))` from the original
strong-convexity and Lipschitz-gradient assumptions. The constant is finite
and independent of the positive step length `h ≤ 1`. -/
theorem malaRejectionDisplacement_integral_bound (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 < h) (h1 : h ≤ 1)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) :
    (∫ p : H × H, malaRejectionDisplacement U h p.1 p.2 ∂malaPairMeasure U) ≤
      malaRejectionConstant U L * h * Real.sqrt h := by
  have henv := ((malaAmplitude_cube_integrable U m L hm hdiff hsc hLip).const_mul
    ((L : ℝ) * (2 + (L : ℝ)))).const_mul (h * Real.sqrt h)
  have hb := integral_mono
    (malaRejectionDisplacement_integrable U m h L hm hh h1 hdiff hsc hLip) henv
    (fun p ↦ malaRejectionDisplacement_pointwise U h L hh h1 hdiff hLip p.1 p.2)
  simp only [integral_const_mul] at hb
  unfold malaRejectionConstant
  nlinarith [hb]

/-- A step-independent finite real constant controls all sufficiently small
MALA rejection errors. No moment or differentiability-of-gradient premise is
introduced beyond the displayed potential assumptions. -/
theorem exists_malaRejectionConstant (U : H → ℝ) (m : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ h : ℝ, 0 < h → h ≤ 1 →
      (∫ p : H × H, malaRejectionDisplacement U h p.1 p.2 ∂malaPairMeasure U) ≤
        C * h * Real.sqrt h :=
  ⟨malaRejectionConstant U L, malaRejectionConstant_nonneg U L,
    fun h hh h1 ↦ malaRejectionDisplacement_integral_bound U m h L hm hh h1 hdiff hsc hLip⟩

end Moments

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/Metropolis.lean -/
section

set_option linter.style.header false

/-! # Metropolis invariance by accepted-flow symmetry

The accepted joint measure has equal first and second marginals by detailed
balance. The rejected measure stays at its first coordinate. Their sum
therefore preserves the initial marginal. This is a measure identity, with
no infinitesimal-invariance or forward-equation uniqueness premise.
-/

noncomputable section
open MeasureTheory
open scoped ENNReal

namespace ULA

variable {H : Type*} [MeasurableSpace H]

def acceptedFlow (ν : Measure (H × H)) (a : H × H → ℝ) : Measure (H × H) :=
  ν.withDensity (fun p ↦ ENNReal.ofReal (a p))

def rejectedFlow (ν : Measure (H × H)) (a : H × H → ℝ) : Measure (H × H) :=
  ν.withDensity (fun p ↦ ENNReal.ofReal (1 - a p))

def metropolisOutput (ν : Measure (H × H)) (a : H × H → ℝ) : Measure H :=
  (acceptedFlow ν a).map Prod.snd + (rejectedFlow ν a).map Prod.fst

theorem acceptedFlow_add_rejectedFlow (ν : Measure (H × H)) (a : H × H → ℝ)
    (ha : Measurable a) (ha0 : ∀ p, 0 ≤ a p) (ha1 : ∀ p, a p ≤ 1) :
    acceptedFlow ν a + rejectedFlow ν a = ν := by
  unfold acceptedFlow rejectedFlow
  rw [← withDensity_add_left ha.ennreal_ofReal]
  have hw : (fun p ↦ ENNReal.ofReal (a p) + ENNReal.ofReal (1 - a p)) = 1 := by
    funext p
    rw [← ENNReal.ofReal_add (ha0 p) (sub_nonneg.mpr (ha1 p))]
    simp
  change ν.withDensity (fun p ↦ ENNReal.ofReal (a p) + ENNReal.ofReal (1 - a p)) = ν
  rw [hw, withDensity_one]

theorem marginals_eq_of_swap_invariant (ν : Measure (H × H))
    (hsym : ν.map Prod.swap = ν) : ν.map Prod.snd = ν.map Prod.fst := by
  calc
    ν.map Prod.snd = (ν.map Prod.swap).map Prod.fst := by
      rw [Measure.map_map measurable_fst measurable_swap]
      rfl
    _ = ν.map Prod.fst := by rw [hsym]

/-- Detailed balance of the accepted flow implies exact invariance of the
Metropolis step, with all rejection mass retained at the current state. -/
theorem metropolisOutput_eq_initial (ν : Measure (H × H)) (a : H × H → ℝ)
    (ha : Measurable a) (ha0 : ∀ p, 0 ≤ a p) (ha1 : ∀ p, a p ≤ 1)
    (hbalance : (acceptedFlow ν a).map Prod.swap = acceptedFlow ν a) :
    metropolisOutput ν a = ν.map Prod.fst := by
  rw [metropolisOutput, marginals_eq_of_swap_invariant _ hbalance,
    ← Measure.map_add _ _ measurable_fst,
    acceptedFlow_add_rejectedFlow ν a ha ha0 ha1]

/-- A weight depending only on a measurable image commutes with pushforward. -/
theorem map_weighted_comp {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (μ : Measure A) (f : A → B) (hf : Measurable f)
    (w : B → ℝ≥0∞) (hw : Measurable w) :
    (μ.withDensity (w ∘ f)).map f = (μ.map f).withDensity w := by
  ext s hs
  rw [Measure.map_apply hf hs, withDensity_apply _ (hf hs),
    withDensity_apply _ hs, ← lintegral_indicator (hf hs),
    ← lintegral_indicator hs, lintegral_map (hw.indicator hs) hf]
  apply lintegral_congr
  intro a
  rfl

/-- Densities commute with an explicit measurable change of coordinates. -/
theorem map_weighted_comp_equiv {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (μ : Measure A) (e : A ≃ᵐ B) (w : B → ℝ≥0∞) (hw : Measurable w) :
    (μ.withDensity (w ∘ e)).map e = (μ.map e).withDensity w :=
  map_weighted_comp μ e e.measurable w hw

def metropolisAcceptance (w : H × H → ℝ) (p : H × H) : ℝ :=
  min 1 (w p.swap / w p)

theorem weight_mul_metropolisAcceptance (w : H × H → ℝ) (hw : ∀ p, 0 < w p)
    (p : H × H) : w p * metropolisAcceptance w p = min (w p) (w p.swap) := by
  rw [metropolisAcceptance, mul_min_of_nonneg 1 (w p.swap / w p) (hw p).le, mul_one]
  congr 1
  field_simp [(hw p).ne']

/-- The accepted flow has the symmetric density min(w(x,y),w(y,x)). -/
theorem acceptedFlow_density (base : Measure (H × H)) (w : H × H → ℝ)
    (hw : Measurable w) (hw0 : ∀ p, 0 < w p) :
    acceptedFlow (base.withDensity (fun p ↦ ENNReal.ofReal (w p)))
        (metropolisAcceptance w) =
      base.withDensity (fun p ↦ ENNReal.ofReal (min (w p) (w p.swap))) := by
  have ha : Measurable (metropolisAcceptance w) := by
    exact measurable_const.min ((hw.comp measurable_swap).div hw)
  unfold acceptedFlow
  rw [← withDensity_mul base hw.ennreal_ofReal ha.ennreal_ofReal]
  congr 1
  funext p
  change ENNReal.ofReal (w p) * ENNReal.ofReal (metropolisAcceptance w p) = _
  rw [← ENNReal.ofReal_mul (hw0 p).le, weight_mul_metropolisAcceptance w hw0 p]

/-- For a symmetric base measure and positive proposal-joint density, the
ordinary Metropolis ratio proves detailed balance and exact invariance. -/
theorem metropolisOutput_density_eq_initial
    (base : Measure (H × H)) (hbase : base.map Prod.swap = base)
    (w : H × H → ℝ) (hw : Measurable w) (hw0 : ∀ p, 0 < w p) :
    metropolisOutput (base.withDensity (fun p ↦ ENNReal.ofReal (w p)))
      (metropolisAcceptance w) =
        (base.withDensity (fun p ↦ ENNReal.ofReal (w p))).map Prod.fst := by
  have ha : Measurable (metropolisAcceptance w) :=
    measurable_const.min ((hw.comp measurable_swap).div hw)
  apply metropolisOutput_eq_initial _ _ ha
    (fun p ↦ le_min (by norm_num) (div_pos (hw0 p.swap) (hw0 p)).le)
    (fun _ ↦ min_le_left _ _)
  rw [acceptedFlow_density base w hw hw0]
  let v : H × H → ℝ≥0∞ := fun p ↦ ENNReal.ofReal (min (w p) (w p.swap))
  have hv : Measurable v := (hw.min (hw.comp measurable_swap)).ennreal_ofReal
  have hs : v ∘ (MeasurableEquiv.prodComm : (H × H) ≃ᵐ (H × H)) = v := by
    funext p
    change ENNReal.ofReal (min (w p.swap) (w p.swap.swap)) =
      ENNReal.ofReal (min (w p) (w p.swap))
    rw [Prod.swap_swap, min_comm]
  have hm := map_weighted_comp_equiv base
    (MeasurableEquiv.prodComm : (H × H) ≃ᵐ (H × H)) v hv
  change (base.withDensity (v ∘ (MeasurableEquiv.prodComm : (H × H) ≃ᵐ (H × H)))).map Prod.swap =
    (base.map Prod.swap).withDensity v at hm
  rw [hs, hbase] at hm
  exact hm

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/MALACoupling.lean -/
section

set_option linter.style.header false

/-! # Synchronous coupling of ULA and stationary MALA

The joint step uses one Gaussian innovation for both proposals. Acceptance
moves both coordinates to their proposals; rejection leaves the MALA
coordinate fixed. All acceptance and rejection mass is retained explicitly.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

/-- The standard MALA acceptance probability between two states. -/
def malaAcceptance (U : H → ℝ) (h : ℝ) (x y : H) : ℝ :=
  min 1 (Real.exp (malaLogRatio U h x y))

/-- Acceptance probability as a function of a state and its innovation. -/
def malaProposalAcceptance (U : H → ℝ) (h : ℝ) (p : H × H) : ℝ :=
  malaAcceptance U h p.1 (malaProposal U h p.1 p.2)

theorem malaAcceptance_nonneg (U : H → ℝ) (h : ℝ) (x y : H) :
    0 ≤ malaAcceptance U h x y := le_min (by norm_num) (Real.exp_nonneg _)

theorem malaAcceptance_le_one (U : H → ℝ) (h : ℝ) (x y : H) :
    malaAcceptance U h x y ≤ 1 := min_le_left _ _

theorem malaProposal_measurable (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U)) :
    Measurable (fun p : H × H ↦ malaProposal U h p.1 p.2) := by
  have hg : Measurable (gradient U) := hLip.continuous.measurable
  exact (measurable_fst.sub ((hg.comp measurable_fst).const_smul h)).add
    (measurable_snd.const_smul (Real.sqrt (2 * h)))

theorem malaProposalAcceptance_measurable (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U)) :
    Measurable (malaProposalAcceptance U h) := by
  have hU : Continuous U := hdiff.continuous
  have hg : Continuous (gradient U) := hLip.continuous
  have hc : Continuous (malaProposalAcceptance U h) := by
    unfold malaProposalAcceptance malaAcceptance malaLogRatio malaProposal
    fun_prop
  exact hc.measurable

/-- One ordinary ULA transition on laws. -/
def ulaLawStep (U : H → ℝ) (h : ℝ) (μ : Measure H) : Measure H :=
  (μ.prod (stdGaussian H)).map (fun p ↦ malaProposal U h p.1 p.2)

/-- One MALA transition, including the rejection probability at its current state. -/
def malaOneStep (U : H → ℝ) (h : ℝ) (μ : Measure H) : Measure H :=
  ((μ.prod (stdGaussian H)).withDensity
      (fun p ↦ ENNReal.ofReal (malaProposalAcceptance U h p))).map
        (fun p ↦ malaProposal U h p.1 p.2) +
    ((μ.prod (stdGaussian H)).withDensity
      (fun p ↦ ENNReal.ofReal (1 - malaProposalAcceptance U h p))).map Prod.fst

/-- The synchronous coupling step: both proposals use exactly the same Gaussian vector. -/
def malaCoupledStep (U : H → ℝ) (h : ℝ) (ρ : Measure (H × H)) : Measure (H × H) :=
  let base := ρ.prod (stdGaussian H)
  let a := fun p : (H × H) × H ↦ malaProposalAcceptance U h (p.1.2, p.2)
  (base.withDensity (fun p ↦ ENNReal.ofReal (a p))).map
      (fun p ↦ (malaProposal U h p.1.1 p.2, malaProposal U h p.1.2 p.2)) +
    (base.withDensity (fun p ↦ ENNReal.ofReal (1 - a p))).map
      (fun p ↦ (malaProposal U h p.1.1 p.2, p.1.2))

private theorem weighted_accept_reject_add {A : Type*} [MeasurableSpace A]
    (μ : Measure A) (a : A → ℝ) (ha : Measurable a)
    (ha0 : ∀ p, 0 ≤ a p) (ha1 : ∀ p, a p ≤ 1) :
    μ.withDensity (fun p ↦ ENNReal.ofReal (a p)) +
      μ.withDensity (fun p ↦ ENNReal.ofReal (1 - a p)) = μ := by
  rw [← withDensity_add_left ha.ennreal_ofReal]
  have hw : (fun p ↦ ENNReal.ofReal (a p) + ENNReal.ofReal (1 - a p)) = 1 := by
    funext p
    rw [← ENNReal.ofReal_add (ha0 p) (sub_nonneg.mpr (ha1 p))]
    simp
  change μ.withDensity (fun p ↦ ENNReal.ofReal (a p) + ENNReal.ofReal (1 - a p)) = μ
  rw [hw, withDensity_one]

/-- The first coordinate always performs the ordinary ULA transition. -/
theorem malaCoupledStep_fst (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (ρ : Measure (H × H)) [SFinite ρ] :
    (malaCoupledStep U h ρ).map Prod.fst = ulaLawStep U h (ρ.map Prod.fst) := by
  let F : (H × H) × H → H × H := fun p ↦ (p.1.1, p.2)
  let G : (H × H) × H → H × H := fun p ↦ (p.1.2, p.2)
  have hF : Measurable F := measurable_fst.fst.prodMk measurable_snd
  have hG : Measurable G := measurable_fst.snd.prodMk measurable_snd
  have hp := malaProposal_measurable U h L hLip
  have hpx : Measurable (fun p : (H × H) × H ↦ malaProposal U h p.1.1 p.2) := hp.comp hF
  have hpy : Measurable (fun p : (H × H) × H ↦ malaProposal U h p.1.2 p.2) := hp.comp hG
  have haccmap : Measurable (fun p : (H × H) × H ↦
      (malaProposal U h p.1.1 p.2, malaProposal U h p.1.2 p.2)) := hpx.prodMk hpy
  have hrejmap : Measurable (fun p : (H × H) × H ↦
      (malaProposal U h p.1.1 p.2, p.1.2)) := hpx.prodMk measurable_fst.snd
  have ha : Measurable (fun p ↦ malaProposalAcceptance U h (G p)) :=
    (malaProposalAcceptance_measurable U h L hdiff hLip).comp hG
  have hmap : (ρ.prod (stdGaussian H)).map F = (ρ.map Prod.fst).prod (stdGaussian H) := by
    change (ρ.prod (stdGaussian H)).map (Prod.map Prod.fst id) = _
    simpa only [Measure.map_id] using
      (Measure.map_prod_map ρ (stdGaussian H) measurable_fst measurable_id).symm
  unfold malaCoupledStep
  rw [Measure.map_add _ _ measurable_fst,
    Measure.map_map measurable_fst haccmap, Measure.map_map measurable_fst hrejmap]
  change ((ρ.prod (stdGaussian H)).withDensity
      (fun p ↦ ENNReal.ofReal (malaProposalAcceptance U h (G p)))).map
        (fun p ↦ malaProposal U h p.1.1 p.2) +
    ((ρ.prod (stdGaussian H)).withDensity
      (fun p ↦ ENNReal.ofReal (1 - malaProposalAcceptance U h (G p)))).map
        (fun p ↦ malaProposal U h p.1.1 p.2) = _
  rw [← Measure.map_add _ _ hpx, weighted_accept_reject_add _ _ ha
    (fun p ↦ malaAcceptance_nonneg U h _ _) (fun p ↦ malaAcceptance_le_one U h _ _)]
  rw [ulaLawStep, ← hmap, Measure.map_map hp hF]
  rfl

/-- The second coordinate performs exactly one MALA transition. -/
theorem malaCoupledStep_snd (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (ρ : Measure (H × H)) [SFinite ρ] :
    (malaCoupledStep U h ρ).map Prod.snd = malaOneStep U h (ρ.map Prod.snd) := by
  let F : (H × H) × H → H × H := fun p ↦ (p.1.1, p.2)
  let G : (H × H) × H → H × H := fun p ↦ (p.1.2, p.2)
  have hF : Measurable F := measurable_fst.fst.prodMk measurable_snd
  have hG : Measurable G := measurable_fst.snd.prodMk measurable_snd
  have hp := malaProposal_measurable U h L hLip
  have hpx : Measurable (fun p : (H × H) × H ↦ malaProposal U h p.1.1 p.2) := hp.comp hF
  have hpy : Measurable (fun p : (H × H) × H ↦ malaProposal U h p.1.2 p.2) := hp.comp hG
  have haccmap : Measurable (fun p : (H × H) × H ↦
      (malaProposal U h p.1.1 p.2, malaProposal U h p.1.2 p.2)) := hpx.prodMk hpy
  have hrejmap : Measurable (fun p : (H × H) × H ↦
      (malaProposal U h p.1.1 p.2, p.1.2)) := hpx.prodMk measurable_fst.snd
  have ha := malaProposalAcceptance_measurable U h L hdiff hLip
  have hmap : (ρ.prod (stdGaussian H)).map G = (ρ.map Prod.snd).prod (stdGaussian H) := by
    change (ρ.prod (stdGaussian H)).map (Prod.map Prod.snd id) = _
    simpa only [Measure.map_id] using
      (Measure.map_prod_map ρ (stdGaussian H) measurable_snd measurable_id).symm
  have hacc := map_weighted_comp (ρ.prod (stdGaussian H)) G hG
    (fun p ↦ ENNReal.ofReal (malaProposalAcceptance U h p)) ha.ennreal_ofReal
  have hrej := map_weighted_comp (ρ.prod (stdGaussian H)) G hG
    (fun p ↦ ENNReal.ofReal (1 - malaProposalAcceptance U h p))
    (measurable_const.sub ha).ennreal_ofReal
  unfold malaCoupledStep
  rw [Measure.map_add _ _ measurable_snd,
    Measure.map_map measurable_snd haccmap, Measure.map_map measurable_snd hrejmap]
  change ((ρ.prod (stdGaussian H)).withDensity
      ((fun p ↦ ENNReal.ofReal (malaProposalAcceptance U h p)) ∘ G)).map
        ((fun p ↦ malaProposal U h p.1 p.2) ∘ G) +
    ((ρ.prod (stdGaussian H)).withDensity
      ((fun p ↦ ENNReal.ofReal (1 - malaProposalAcceptance U h p)) ∘ G)).map
        (Prod.fst ∘ G) = _
  rw [← Measure.map_map hp hG, ← Measure.map_map measurable_fst hG,
    hacc, hrej, hmap]
  rfl

/-- The coupling step preserves total probability. -/
theorem malaCoupledStep_isProbability (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (ρ : Measure (H × H)) [IsProbabilityMeasure ρ] :
    IsProbabilityMeasure (malaCoupledStep U h ρ) := by
  have : IsProbabilityMeasure ((malaCoupledStep U h ρ).map Prod.fst) := by
    rw [malaCoupledStep_fst U h L hdiff hLip ρ]
    unfold ulaLawStep
    infer_instance
  exact Measure.isProbabilityMeasure_of_map measurable_fst.aemeasurable

/-- Start both algorithms at the same state and iterate the explicit coupled step. -/
def malaCoupledChain (U : H → ℝ) (h : ℝ) (μ : Measure H) : ℕ → Measure (H × H)
  | 0 => μ.map (fun x ↦ (x, x))
  | n + 1 => malaCoupledStep U h (malaCoupledChain U h μ n)

theorem malaCoupledChain_isProbability (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (μ : Measure H) [IsProbabilityMeasure μ] (n : ℕ) :
    IsProbabilityMeasure (malaCoupledChain U h μ n) := by
  induction n with
  | zero => exact inferInstanceAs (IsProbabilityMeasure (μ.map (fun x ↦ (x, x))))
  | succ n ih =>
      have := ih
      exact malaCoupledStep_isProbability U h L hdiff hLip _

/-- The first marginal is precisely the iterated ULA law transition. -/
theorem malaCoupledChain_fst (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (μ : Measure H) [IsProbabilityMeasure μ] (n : ℕ) :
    (malaCoupledChain U h μ n).map Prod.fst = (ulaLawStep U h)^[n] μ := by
  induction n with
  | zero =>
      change (μ.map (fun x ↦ (x, x))).map Prod.fst = μ
      have hdiag : Measurable (fun x : H ↦ (x, x)) := measurable_id.prodMk measurable_id
      rw [Measure.map_map measurable_fst hdiag]
      exact Measure.map_id
  | succ n ih =>
      have := malaCoupledChain_isProbability U h L hdiff hLip μ n
      rw [malaCoupledChain, malaCoupledStep_fst U h L hdiff hLip, ih,
        Function.iterate_succ_apply']

/-- Exact one-step invariance implies that the second marginal is stationary
at every coupling step. The separate density/detailed-balance theorem
discharges the displayed one-step equality. -/
theorem malaCoupledChain_snd (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (π : Measure H) [IsProbabilityMeasure π]
    (hstationary : malaOneStep U h π = π) (n : ℕ) :
    (malaCoupledChain U h π n).map Prod.snd = π := by
  induction n with
  | zero =>
      change (π.map (fun x ↦ (x, x))).map Prod.snd = π
      have hdiag : Measurable (fun x : H ↦ (x, x)) := measurable_id.prodMk measurable_id
      rw [Measure.map_map measurable_snd hdiag]
      exact Measure.map_id
  | succ n ih =>
      have := malaCoupledChain_isProbability U h L hdiff hLip π n
      rw [malaCoupledChain, malaCoupledStep_snd U h L hdiff hLip, ih, hstationary]

/-- Shared Gaussian noise cancels, so a sufficiently small proposal is nonexpansive. -/
theorem malaProposal_nonexpansive (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 ≤ h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (x y ξ : H) :
    ‖malaProposal U h x ξ - malaProposal U h y ξ‖ ≤ ‖x - y‖ := by
  rcases subsingleton_or_nontrivial H with hs | hn
  · simp [Subsingleton.elim x y]
  · have hc := strong_smooth_gradient_step_contract U m h L hdiff hsc hLip
      (strongConvex_le_lipschitz hdiff hsc hLip) (by positivity) hh hsmall x y
    have heq : malaProposal U h x ξ - malaProposal U h y ξ =
        (x - h • gradient U x) - (y - h • gradient U y) := by
      simp only [malaProposal]; abel
    rw [heq]
    exact hc.trans (by nlinarith [mul_nonneg (mul_nonneg hm.le hh) (norm_nonneg (x-y))])

/-- The expected distance after choosing acceptance or rejection is bounded
by the old distance plus the rejected proposal displacement. -/
theorem malaCoupledStep_pointwise (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 ≤ h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (x y ξ : H) :
    malaProposalAcceptance U h (y,ξ) *
        ‖malaProposal U h x ξ - malaProposal U h y ξ‖ +
      (1 - malaProposalAcceptance U h (y,ξ)) * ‖malaProposal U h x ξ - y‖ ≤
      ‖x-y‖ + malaRejectionDisplacement U h y ξ := by
  have ha0 := malaAcceptance_nonneg U h y (malaProposal U h y ξ)
  have ha1 := malaAcceptance_le_one U h y (malaProposal U h y ξ)
  change 0 ≤ malaProposalAcceptance U h (y,ξ) at ha0
  change malaProposalAcceptance U h (y,ξ) ≤ 1 at ha1
  have ht : ‖malaProposal U h x ξ-y‖ ≤
      ‖malaProposal U h x ξ-malaProposal U h y ξ‖ + ‖malaProposal U h y ξ-y‖ := by
    simpa only [sub_add_sub_cancel] using norm_add_le
      (malaProposal U h x ξ-malaProposal U h y ξ) (malaProposal U h y ξ-y)
  have ht' := mul_le_mul_of_nonneg_left ht (sub_nonneg.mpr ha1)
  have hc := malaProposal_nonexpansive U m h L hm hh hsmall hdiff hsc hLip x y ξ
  unfold malaRejectionDisplacement malaProposalAcceptance malaAcceptance at *
  nlinarith

/-- Extended first-moment transport cost; finiteness is proved below. -/
def malaL1Cost (ρ : Measure (H × H)) : ℝ≥0∞ :=
  ∫⁻ p, ENNReal.ofReal ‖p.1-p.2‖ ∂ρ

private theorem lintegral_weighted_map {A B : Type*} [MeasurableSpace A] [MeasurableSpace B]
    (μ : Measure A) (f : A → B) (hf : Measurable f) (a : A → ℝ)
    (ha : Measurable a) (ha0 : ∀ x, 0 ≤ a x) (b : B → ℝ) (hb : Measurable b) :
    (∫⁻ z, ENNReal.ofReal (b z) ∂(μ.withDensity (fun x ↦ ENNReal.ofReal (a x))).map f) =
      ∫⁻ x, ENNReal.ofReal (a x * b (f x)) ∂μ := by
  have hbf : Measurable (fun x ↦ b (f x)) := hb.comp hf
  rw [lintegral_map hb.ennreal_ofReal hf,
    lintegral_withDensity_eq_lintegral_mul μ ha.ennreal_ofReal hbf.ennreal_ofReal]
  apply lintegral_congr
  intro x
  exact (ENNReal.ofReal_mul (ha0 x)).symm

private theorem malaCoupledStep_cost_formula (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (ρ : Measure (H × H)) :
    malaL1Cost (malaCoupledStep U h ρ) =
      ∫⁻ p : (H × H) × H, ENNReal.ofReal
        (malaProposalAcceptance U h (p.1.2,p.2) *
          ‖malaProposal U h p.1.1 p.2 - malaProposal U h p.1.2 p.2‖ +
          (1-malaProposalAcceptance U h (p.1.2,p.2)) *
          ‖malaProposal U h p.1.1 p.2-p.1.2‖) ∂ρ.prod (stdGaussian H) := by
  have hp := malaProposal_measurable U h L hLip
  have hF : Measurable (fun p : (H × H) × H ↦ (p.1.1,p.2)) :=
    measurable_fst.fst.prodMk measurable_snd
  have hG : Measurable (fun p : (H × H) × H ↦ (p.1.2,p.2)) :=
    measurable_fst.snd.prodMk measurable_snd
  have ha : Measurable (fun p : (H × H) × H ↦ malaProposalAcceptance U h (p.1.2,p.2)) :=
    (malaProposalAcceptance_measurable U h L hdiff hLip).comp hG
  have hr : Measurable (fun p : (H × H) × H ↦ 1-malaProposalAcceptance U h (p.1.2,p.2)) :=
    measurable_const.sub ha
  have hd : Measurable (fun p : H × H ↦ ‖p.1-p.2‖) :=
    (measurable_fst.sub measurable_snd).norm
  have hpx : Measurable (fun p : (H × H) × H ↦ malaProposal U h p.1.1 p.2) := hp.comp hF
  have hpy : Measurable (fun p : (H × H) × H ↦ malaProposal U h p.1.2 p.2) := hp.comp hG
  unfold malaL1Cost malaCoupledStep
  rw [lintegral_add_measure,
    lintegral_weighted_map _ _ (hpx.prodMk hpy) _ ha
      (fun p ↦ malaAcceptance_nonneg U h _ _) _ hd,
    lintegral_weighted_map _ _ (hpx.prodMk measurable_fst.snd) _ hr
      (fun p ↦ sub_nonneg.mpr (malaAcceptance_le_one U h _ _)) _ hd]
  rw [← lintegral_add_left]
  · apply lintegral_congr
    intro p
    exact (ENNReal.ofReal_add (mul_nonneg (malaAcceptance_nonneg U h _ _) (norm_nonneg _))
      (mul_nonneg (sub_nonneg.mpr (malaAcceptance_le_one U h _ _)) (norm_nonneg _))).symm
  · exact (ha.mul ((hpx.sub hpy).norm)).ennreal_ofReal

/-- A single coupled step adds at most the proved Gibbs-averaged rejection error. -/
theorem malaCoupledStep_cost_le (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 < h) (h1 : h ≤ 1)
    (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U))
    (ρ : Measure (H × H)) [IsProbabilityMeasure ρ]
    (hsnd : ρ.map Prod.snd = gibbsMeasure U) :
    malaL1Cost (malaCoupledStep U h ρ) ≤ malaL1Cost ρ +
      ENNReal.ofReal (malaRejectionConstant U L * h * Real.sqrt h) := by
  have hd : Measurable (fun p : H × H ↦ ENNReal.ofReal ‖p.1-p.2‖) :=
    (measurable_fst.sub measurable_snd).norm.ennreal_ofReal
  have hU := hdiff.continuous
  have hg := hLip.continuous
  have hr : Measurable (fun p : H × H ↦ malaRejectionDisplacement U h p.1 p.2) := by
    have hc : Continuous (fun p : H × H ↦ malaRejectionDisplacement U h p.1 p.2) := by
      unfold malaRejectionDisplacement malaLogRatio malaProposal
      fun_prop
    exact hc.measurable
  let G : (H × H) × H → H × H := fun p ↦ (p.1.2,p.2)
  have hG : Measurable G := measurable_fst.snd.prodMk measurable_snd
  have hmap : (ρ.prod (stdGaussian H)).map G = malaPairMeasure U := by
    change (ρ.prod (stdGaussian H)).map (Prod.map Prod.snd id) = _
    rw [← Measure.map_prod_map ρ (stdGaussian H) measurable_snd measurable_id,
      Measure.map_id, hsnd]
    rfl
  have hold : (∫⁻ p : (H × H) × H, ENNReal.ofReal ‖p.1.1-p.1.2‖
      ∂ρ.prod (stdGaussian H)) = malaL1Cost ρ := by
    rw [← lintegral_map hd measurable_fst, Measure.map_fst_prod, measure_univ, one_smul]
    rfl
  have hrej : (∫⁻ p : (H × H) × H, ENNReal.ofReal
      (malaRejectionDisplacement U h p.1.2 p.2) ∂ρ.prod (stdGaussian H)) ≤
      ENNReal.ofReal (malaRejectionConstant U L*h*Real.sqrt h) := by
    change (∫⁻ p, ENNReal.ofReal
      (malaRejectionDisplacement U h (G p).1 (G p).2) ∂ρ.prod (stdGaussian H)) ≤ _
    rw [← lintegral_map hr.ennreal_ofReal hG, hmap,
      ← ofReal_integral_eq_lintegral_ofReal
        (malaRejectionDisplacement_integrable U m h L hm hh h1 hdiff hsc hLip)
        (Filter.Eventually.of_forall fun p ↦ malaRejectionDisplacement_nonneg U h p.1 p.2)]
    exact ENNReal.ofReal_le_ofReal
      (malaRejectionDisplacement_integral_bound U m h L hm hh h1 hdiff hsc hLip)
  rw [malaCoupledStep_cost_formula U h L hdiff hLip]
  calc
    _ ≤ ∫⁻ p : (H × H) × H, ENNReal.ofReal
        (‖p.1.1-p.1.2‖ + malaRejectionDisplacement U h p.1.2 p.2)
        ∂ρ.prod (stdGaussian H) :=
      lintegral_mono fun p ↦ ENNReal.ofReal_le_ofReal
        (malaCoupledStep_pointwise U m h L hm hh.le hsmall hdiff hsc hLip _ _ _)
    _ = malaL1Cost ρ + (∫⁻ p : (H × H) × H,
        ENNReal.ofReal (malaRejectionDisplacement U h p.1.2 p.2) ∂ρ.prod (stdGaussian H)) := by
      simp_rw [ENNReal.ofReal_add (norm_nonneg _) (malaRejectionDisplacement_nonneg U h _ _)]
      have hd' : Measurable (fun p : (H × H) × H ↦ ENNReal.ofReal ‖p.1.1-p.1.2‖) :=
        hd.comp measurable_fst
      rw [lintegral_add_left hd', hold]
    _ ≤ _ := add_le_add le_rfl hrej

/-- The explicit synchronous coupling has first-moment cost at most the
number of steps times the local rejection error. -/
theorem malaCoupledChain_cost_le (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 < h) (h1 : h ≤ 1)
    (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U))
    (hstationary : malaOneStep U h (gibbsMeasure U) = gibbsMeasure U) (n : ℕ) :
    malaL1Cost (malaCoupledChain U h (gibbsMeasure U) n) ≤
      (n : ℝ≥0∞) * ENNReal.ofReal (malaRejectionConstant U L*h*Real.sqrt h) := by
  haveI := isProbabilityMeasure_gibbsMeasure U m hm hdiff hsc
  induction n with
  | zero =>
      have hdiag : Measurable (fun x : H ↦ (x,x)) := measurable_id.prodMk measurable_id
      have hd : Measurable (fun p : H × H ↦ ENNReal.ofReal ‖p.1-p.2‖) :=
        (measurable_fst.sub measurable_snd).norm.ennreal_ofReal
      change (∫⁻ p : H × H, ENNReal.ofReal ‖p.1-p.2‖
        ∂(gibbsMeasure U).map (fun x ↦ (x,x))) ≤ _
      rw [lintegral_map hd hdiag]
      simp
  | succ n ih =>
      haveI := malaCoupledChain_isProbability U h L hdiff hLip (gibbsMeasure U) n
      have hs := malaCoupledChain_snd U h L hdiff hLip (gibbsMeasure U) hstationary n
      have hb := malaCoupledStep_cost_le U m h L hm hh h1 hsmall hdiff hsc hLip _ hs
      change malaL1Cost (malaCoupledStep U h (malaCoupledChain U h (gibbsMeasure U) n)) ≤ _
      have hc := add_le_add ih (le_refl (ENNReal.ofReal (malaRejectionConstant U L*h*Real.sqrt h)))
      exact hb.trans (by simpa only [Nat.cast_add, Nat.cast_one, add_mul, one_mul] using hc)

/-- The coupling distance is integrable, as a conclusion of the quantitative
extended-cost estimate rather than an additional moment hypothesis. -/
theorem malaCoupledChain_distance_integrable (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 < h) (h1 : h ≤ 1)
    (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U))
    (hstationary : malaOneStep U h (gibbsMeasure U) = gibbsMeasure U) (n : ℕ) :
    Integrable (fun p : H × H ↦ ‖p.1-p.2‖)
      (malaCoupledChain U h (gibbsMeasure U) n) := by
  have hd : Measurable (fun p : H × H ↦ ‖p.1-p.2‖) :=
    (measurable_fst.sub measurable_snd).norm
  refine ⟨hd.aestronglyMeasurable,
    (hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun p : H × H ↦ norm_nonneg (p.1-p.2))).2 ?_⟩
  exact lt_of_le_of_lt (malaCoupledChain_cost_le U m h L hm hh h1 hsmall hdiff hsc hLip
    hstationary n) (by finiteness)

/-- Ordinary expected distance between ULA and stationary MALA, with an
explicit finite constant depending only on the original potential. -/
theorem malaCoupledChain_distance_integral_le (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hh : 0 < h) (h1 : h ≤ 1)
    (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U))
    (hstationary : malaOneStep U h (gibbsMeasure U) = gibbsMeasure U) (n : ℕ) :
    (∫ p : H × H, ‖p.1-p.2‖ ∂malaCoupledChain U h (gibbsMeasure U) n) ≤
      (n : ℝ) * malaRejectionConstant U L * h * Real.sqrt h := by
  have hb := malaCoupledChain_cost_le U m h L hm hh h1 hsmall hdiff hsc hLip hstationary n
  have hC := malaRejectionConstant_nonneg U L
  have hrewrite : (n : ℝ≥0∞) * ENNReal.ofReal (malaRejectionConstant U L*h*Real.sqrt h) =
      ENNReal.ofReal ((n : ℝ)*malaRejectionConstant U L*h*Real.sqrt h) := by
    rw [show (n : ℝ)*malaRejectionConstant U L*h*Real.sqrt h =
      (n : ℝ)*(malaRejectionConstant U L*h*Real.sqrt h) by ring,
      ENNReal.ofReal_mul (Nat.cast_nonneg n)]
    simp
  rw [hrewrite] at hb
  apply (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp
  rw [ofReal_integral_eq_lintegral_ofReal
    (malaCoupledChain_distance_integrable U m h L hm hh h1 hsmall hdiff hsc hLip hstationary n)
    (Filter.Eventually.of_forall fun p : H × H ↦ norm_nonneg (p.1-p.2))]
  exact hb

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/GaussianProposalDensity.lean -/
section

set_option linter.style.header false

/-! # The actual Gaussian Euler proposal has its displayed Lebesgue density

Gaussian Fourier integration identifies the centered density and translation
identifies every proposal mean. The positive normalizer is defined by an actual
finite Gaussian integral and is independent of the current state. There is no
potential regularity assumption in the density theorem.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

/-- The real radial Gaussian integral used for normalization. -/
def radialGaussianIntegral (a : ℝ) : ℝ := ∫ z : H, Real.exp (-a * ‖z‖ ^ 2)

/-- A positive real density normalizer whenever the precision `a` is positive. -/
def radialGaussianNormalizer (a : ℝ) : ℝ := (radialGaussianIntegral (H := H) a)⁻¹

theorem radialGaussianIntegral_pos (a : ℝ) (ha : 0 < a) :
    0 < radialGaussianIntegral (H := H) a :=
  integral_exp_pos (integrable_exp_neg_mul_norm_sq a ha)

theorem radialGaussianNormalizer_pos (a : ℝ) (ha : 0 < a) :
    0 < radialGaussianNormalizer (H := H) a := inv_pos.mpr (radialGaussianIntegral_pos a ha)

/-- The normalized radial density with precision `a` and center `c`. -/
def radialGaussianDensity (a : ℝ) (c z : H) : ℝ≥0∞ :=
  ENNReal.ofReal (radialGaussianNormalizer (H := H) a * Real.exp (-a * ‖z - c‖ ^ 2))

theorem integrable_radialGaussianDensity_real (a : ℝ) (ha : 0 < a) (c : H) :
    Integrable (fun z : H ↦ radialGaussianNormalizer (H := H) a *
      Real.exp (-a * ‖z - c‖ ^ 2)) volume := by
  exact ((integrable_exp_neg_mul_norm_sq (H := H) a ha).comp_sub_right c).const_mul _

theorem integral_radialGaussianDensity_real (a : ℝ) (ha : 0 < a) (c : H) :
    (∫ z : H, radialGaussianNormalizer (H := H) a * Real.exp (-a * ‖z - c‖ ^ 2)) = 1 := by
  rw [integral_const_mul,
    integral_sub_right_eq_self (μ := volume) (fun z : H ↦ Real.exp (-a * ‖z‖ ^ 2)) c]
  exact inv_mul_cancel₀ (radialGaussianIntegral_pos a ha).ne'

/-- Normalization of the displayed density, including finiteness. -/
theorem radialGaussianDensity_isProbability (a : ℝ) (ha : 0 < a) (c : H) :
    IsProbabilityMeasure (volume.withDensity (radialGaussianDensity a c)) := by
  constructor
  rw [withDensity_apply _ MeasurableSet.univ, setLIntegral_univ]
  change (∫⁻ z : H, ENNReal.ofReal (radialGaussianNormalizer (H := H) a *
    Real.exp (-a * ‖z - c‖ ^ 2))) = 1
  rw [← ofReal_integral_eq_lintegral_ofReal
    (integrable_radialGaussianDensity_real a ha c)
    (ae_of_all _ fun z ↦ mul_nonneg (radialGaussianNormalizer_pos a ha).le (Real.exp_nonneg _)),
    integral_radialGaussianDensity_real a ha c, ENNReal.ofReal_one]

/-- The complex Gaussian normalization factor is the same actual real integral. -/
theorem integral_complex_radialGaussian (a : ℝ) (_ha : 0 < a) :
    (∫ z : H, Complex.exp (-(a : ℂ) * ‖z‖ ^ 2)) =
      (radialGaussianIntegral (H := H) a : ℂ) := by
  calc
    _ = ∫ z : H, (Real.exp (-a * ‖z‖ ^ 2) : ℂ) := by
      apply integral_congr_ae
      exact ae_of_all _ fun z ↦ by
        change Complex.exp (-(a : ℂ) * ‖z‖ ^ 2) = (Real.exp (-a * ‖z‖ ^ 2) : ℂ)
        rw [Complex.ofReal_exp]
        congr 1
        push_cast
        ring
    _ = _ := integral_ofReal

/-- The radial Gaussian Fourier integral, expressed using its real normalizer. -/
theorem integral_radialGaussian_character (a : ℝ) (ha : 0 < a) (t : H) :
    (∫ z : H, (Real.exp (-a * ‖z‖ ^ 2) : ℂ) *
      Complex.exp ((inner ℝ z t : ℝ) * Complex.I)) =
      (radialGaussianIntegral (H := H) a : ℂ) *
        Complex.exp (-(‖t‖ ^ 2 : ℝ) / (4 * (a : ℂ))) := by
  have h := GaussianFourier.integral_cexp_neg_mul_sq_norm_add
    (V := H) (b := (a : ℂ)) (by simpa) Complex.I t
  have hzero := GaussianFourier.integral_cexp_neg_mul_sq_norm
    (V := H) (b := (a : ℂ)) (by simpa using ha)
  rw [integral_complex_radialGaussian a ha] at hzero
  rw [← hzero] at h
  convert h using 1
  · apply integral_congr_ae
    exact ae_of_all _ fun z ↦ by
      change (Real.exp (-a * ‖z‖ ^ 2) : ℂ) *
        Complex.exp ((inner ℝ z t : ℝ) * Complex.I) =
          Complex.exp (-(a : ℂ) * ‖z‖ ^ 2 + Complex.I * (inner ℝ t z : ℝ))
      rw [Complex.ofReal_exp, ← Complex.exp_add]
      congr 1
      simp only [Complex.ofReal_mul, Complex.ofReal_neg, Complex.ofReal_pow,
        real_inner_comm t z]
      ring
  · congr 2
    rw [Complex.I_sq]
    push_cast
    ring

/-- Characteristic function of the displayed normalized radial Gaussian density. -/
theorem charFun_radialGaussianDensity (a : ℝ) (ha : 0 < a) (c t : H) :
    charFun (volume.withDensity (radialGaussianDensity a c)) t =
      Complex.exp (-(‖t‖ ^ 2 : ℝ) / (4 * (a : ℂ))) *
        Complex.exp ((inner ℝ c t : ℝ) * Complex.I) := by
  rw [charFun_apply]
  unfold radialGaussianDensity
  have hm : Measurable (fun z : H ↦ ENNReal.ofReal
      (radialGaussianNormalizer (H := H) a * Real.exp (-a * ‖z - c‖ ^ 2))) := by fun_prop
  rw [integral_withDensity_eq_integral_toReal_smul hm
    (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)]
  simp only [ENNReal.toReal_ofReal
    (mul_nonneg (radialGaussianNormalizer_pos a ha).le (Real.exp_nonneg _))]
  have htrans : (∫ z : H, (radialGaussianNormalizer (H := H) a *
      Real.exp (-a * ‖z - c‖ ^ 2)) • Complex.exp ((inner ℝ z t : ℝ) * Complex.I)) =
      (radialGaussianNormalizer (H := H) a : ℂ) *
        ((∫ z : H, (Real.exp (-a * ‖z‖ ^ 2) : ℂ) *
          Complex.exp ((inner ℝ z t : ℝ) * Complex.I)) *
          Complex.exp ((inner ℝ c t : ℝ) * Complex.I)) := by
    rw [← integral_add_right_eq_self (fun z : H ↦
      (radialGaussianNormalizer (H := H) a * Real.exp (-a * ‖z - c‖ ^ 2)) •
        Complex.exp ((inner ℝ z t : ℝ) * Complex.I)) c]
    simp only [add_sub_cancel_right, inner_add_left, Complex.ofReal_add,
      add_mul, Complex.exp_add, Complex.real_smul, Complex.ofReal_mul]
    calc
      _ = ∫ z : H, (radialGaussianNormalizer (H := H) a : ℂ) *
          (((Real.exp (-a * ‖z‖ ^ 2) : ℂ) * Complex.exp ((inner ℝ z t : ℝ) * Complex.I)) *
            Complex.exp ((inner ℝ c t : ℝ) * Complex.I)) := by
        apply integral_congr_ae
        exact ae_of_all _ fun z ↦ by ring
      _ = _ := by rw [integral_const_mul, integral_mul_const]
  rw [htrans, integral_radialGaussian_character a ha]
  rw [radialGaussianNormalizer, Complex.ofReal_inv,
    ← mul_assoc, ← mul_assoc, inv_mul_cancel₀ (Complex.ofReal_ne_zero.mpr
      (radialGaussianIntegral_pos a ha).ne'), one_mul]

/-- The Gaussian Euler normalizer; it is independent of the proposal center. -/
def gaussianProposalNormalizer (h : ℝ) : ℝ :=
  radialGaussianNormalizer (H := H) (1 / (4 * h))

/-- The exact real Gaussian Euler density, written with covariance `2h I`. -/
def gaussianProposalDensity (h : ℝ) (c y : H) : ℝ≥0∞ :=
  ENNReal.ofReal (gaussianProposalNormalizer (H := H) h *
    Real.exp (-‖y - c‖ ^ 2 / (4 * h)))

theorem gaussianProposalNormalizer_pos (h : ℝ) (hh : 0 < h) :
    0 < gaussianProposalNormalizer (H := H) h := radialGaussianNormalizer_pos _ (by positivity)

theorem radialGaussianDensity_eq_proposalDensity (h : ℝ) (c : H) :
    radialGaussianDensity (1 / (4 * h)) c = gaussianProposalDensity h c := by
  funext y
  unfold radialGaussianDensity gaussianProposalDensity gaussianProposalNormalizer
  congr 2
  congr 1
  ring

/-- The affine image of the actual standard Gaussian has precisely the
displayed normalized Lebesgue density. -/
theorem gaussian_proposal_density (h : ℝ) (hh : 0 < h) (c : H) :
    (stdGaussian H).map (fun ξ ↦ c + Real.sqrt (2 * h) • ξ) =
      volume.withDensity (gaussianProposalDensity h c) := by
  have ha : 0 < 1 / (4 * h) := by positivity
  have := radialGaussianDensity_isProbability (H := H) (1 / (4 * h)) ha c
  rw [← radialGaussianDensity_eq_proposalDensity]
  apply Measure.ext_of_charFun
  funext t
  rw [charFun_radialGaussianDensity _ ha c t]
  have hm : (stdGaussian H).map (fun ξ ↦ c + Real.sqrt (2 * h) • ξ) =
      ((stdGaussian H).map (fun ξ ↦ Real.sqrt (2 * h) • ξ)).map (fun z ↦ c + z) := by
    rw [Measure.map_map (by fun_prop) (by fun_prop)]
    rfl
  rw [hm, charFun_map_const_add, charFun_map_smul, charFun_stdGaussian]
  congr 2
  have hnorm : ‖Real.sqrt (2 * h) • t‖ ^ 2 = (2 * h) * ‖t‖ ^ 2 := by
    rw [norm_smul, mul_pow, Real.norm_eq_abs, sq_abs, Real.sq_sqrt (by positivity)]
  have hnormC : (‖Real.sqrt (2 * h) • t‖ : ℂ) ^ 2 =
      (2 * (h : ℂ)) * (‖t‖ : ℂ) ^ 2 := by exact_mod_cast hnorm
  rw [hnormC]
  push_cast
  field_simp

/-- Equivalent radial-density form, convenient for detailed balance. -/
theorem gaussian_proposal_radial_density (h : ℝ) (hh : 0 < h) (c : H) :
    (stdGaussian H).map (fun ξ ↦ c + Real.sqrt (2 * h) • ξ) =
      volume.withDensity (radialGaussianDensity (1 / (4 * h)) c) := by
  rw [radialGaussianDensity_eq_proposalDensity]
  exact gaussian_proposal_density h hh c

/-- The potential enters the radial-density equality only through the center. -/
theorem ula_proposal_radial_density (U : H → ℝ) (h : ℝ) (hh : 0 < h) (x : H) :
    (stdGaussian H).map (fun ξ ↦ x - h • gradient U x + Real.sqrt (2 * h) • ξ) =
      volume.withDensity (radialGaussianDensity (1 / (4 * h)) (x - h • gradient U x)) :=
  gaussian_proposal_radial_density h hh _

/-- In particular, the ULA proposal has the density used in the Metropolis
ratio. This equality needs no assumptions on `U` at the fixed starting state. -/
theorem ula_proposal_density (U : H → ℝ) (h : ℝ) (hh : 0 < h) (x : H) :
    (stdGaussian H).map (fun ξ ↦ x - h • gradient U x + Real.sqrt (2 * h) • ξ) =
      volume.withDensity (fun y ↦ ENNReal.ofReal (gaussianProposalNormalizer (H := H) h *
        Real.exp (-‖y - x + h • gradient U x‖ ^ 2 / (4 * h)))) := by
  rw [gaussian_proposal_density h hh]
  congr 1
  funext y
  unfold gaussianProposalDensity
  have heq : y - (x - h • gradient U x) = y - x + h • gradient U x := by abel
  rw [heq]

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/GaussianProposalPairDensity.lean -/
section

set_option linter.style.header false

/-! # Joint law of a state and its Gaussian Euler proposal

This is the product-measure transport step used to turn Metropolis acceptance
into a symmetric Lebesgue density on pairs of states.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

/-- The full current/proposal pair law has the pointwise Gaussian density.
Only measurability of its state-dependent center is required. -/
theorem gaussian_proposal_pair_density (μ : Measure H) (c : H → H)
    (hc : Measurable c) (h : ℝ) (hh : 0 < h) :
    (μ.prod (stdGaussian H)).map (fun z : H × H ↦
      (z.1, c z.1 + Real.sqrt (2 * h) • z.2)) =
      (μ.prod volume).withDensity (fun z : H × H ↦ gaussianProposalDensity h (c z.1) z.2) := by
  have hm : Measurable (fun z : H × H ↦
      (z.1, c z.1 + Real.sqrt (2 * h) • z.2)) := by fun_prop
  have hd : Measurable (fun z : H × H ↦ gaussianProposalDensity h (c z.1) z.2) := by
    unfold gaussianProposalDensity
    fun_prop
  apply Measure.ext
  intro s hs
  rw [Measure.map_apply hm hs, Measure.prod_apply (hm hs),
    withDensity_apply _ hs, ← lintegral_indicator hs _,
    lintegral_prod _ (hd.indicator hs).aemeasurable]
  apply lintegral_congr_ae
  exact ae_of_all _ fun x ↦ by
    have hxs : MeasurableSet ((Prod.mk x) ⁻¹' s) := measurable_prodMk_left hs
    have hi : (fun y : H ↦ s.indicator
        (fun z : H × H ↦ gaussianProposalDensity h (c z.1) z.2) (x, y)) =
        ((Prod.mk x) ⁻¹' s).indicator (gaussianProposalDensity h (c x)) := by
      funext y
      rfl
    dsimp only
    rw [hi, lintegral_indicator hxs,
      ← withDensity_apply (gaussianProposalDensity h (c x)) hxs,
      ← gaussian_proposal_density h hh (c x),
      Measure.map_apply (by fun_prop) hxs]
    rfl

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/MALAInvariance.lean -/
section

set_option linter.style.header false

/-! # Exact Gibbs invariance of the Metropolis approximation

The actual Gaussian proposal density gives a positive joint density. Its
Metropolis acceptance ratio makes the accepted flow symmetric. Thus the
normalized Gibbs measure is invariant, with no stationarity premise.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

/-- Current state and proposed state under the actual Gaussian innovation. -/
def malaProposalJoint (U : H → ℝ) (h : ℝ) (μ : Measure H) : Measure (H × H) :=
  (μ.prod (stdGaussian H)).map (fun p ↦ (p.1, malaProposal U h p.1 p.2))

/-- The strictly positive real joint density, with both constant normalizers
kept in the symmetric base measure. -/
def malaJointWeight (U : H → ℝ) (h : ℝ) (p : H × H) : ℝ :=
  Real.exp (-U p.1 - ‖p.2 - p.1 + h • gradient U p.1‖ ^ 2 / (4 * h))

/-- The reverse-to-forward density ratio is the displayed MALA ratio. -/
theorem malaJointWeight_ratio (U : H → ℝ) (h : ℝ) (p : H × H) :
    malaJointWeight U h p.swap / malaJointWeight U h p =
      Real.exp (malaLogRatio U h p.1 p.2) := by
  unfold malaJointWeight malaLogRatio
  rw [← Real.exp_sub]
  congr 1
  dsimp only [Prod.swap]
  ring

/-- The law-based step is exactly accepted and rejected flow of the proposal
pair. This identity retains rejection mass rather than renormalizing it. -/
theorem malaOneStep_eq_metropolisOutput (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U)) (μ : Measure H) :
    malaOneStep U h μ = metropolisOutput (malaProposalJoint U h μ)
      (fun p ↦ malaAcceptance U h p.1 p.2) := by
  let T : H × H → H × H := fun p ↦ (p.1, malaProposal U h p.1 p.2)
  let a : H × H → ℝ := fun p ↦ malaAcceptance U h p.1 p.2
  have hT : Measurable T := measurable_fst.prodMk (malaProposal_measurable U h L hLip)
  have ha : Measurable a := by
    have hU := hdiff.continuous
    have hg := hLip.continuous
    unfold a malaAcceptance malaLogRatio
    fun_prop
  have hacc := map_weighted_comp (μ.prod (stdGaussian H)) T hT
    (fun p ↦ ENNReal.ofReal (a p)) ha.ennreal_ofReal
  have hrej := map_weighted_comp (μ.prod (stdGaussian H)) T hT
    (fun p ↦ ENNReal.ofReal (1 - a p)) (measurable_const.sub ha).ennreal_ofReal
  change _ = (((μ.prod (stdGaussian H)).map T).withDensity
      (fun p ↦ ENNReal.ofReal (a p))).map Prod.snd +
    (((μ.prod (stdGaussian H)).map T).withDensity
      (fun p ↦ ENNReal.ofReal (1 - a p))).map Prod.fst
  rw [← hacc, ← hrej, Measure.map_map measurable_snd hT,
    Measure.map_map measurable_fst hT]
  rfl

/-- The actual proposal pair has a positive density against a symmetric base. -/
theorem malaProposalJoint_gibbs_density (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hh : 0 < h) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) :
    malaProposalJoint U h (gibbsMeasure U) =
      (((gibbsPartition U)⁻¹ * ENNReal.ofReal (gaussianProposalNormalizer (H := H) h)) •
        (volume.prod volume)).withDensity (fun p ↦ ENNReal.ofReal (malaJointWeight U h p)) := by
  have hg : Measurable (gradient U) := hLip.continuous.measurable
  have hU : Measurable U := hdiff.continuous.measurable
  have hc : Measurable (fun x ↦ x - h • gradient U x) :=
    measurable_id.sub (hg.const_smul h)
  have hw : Measurable (gibbsWeight U) := by unfold gibbsWeight; fun_prop
  have hq : Measurable (fun p : H × H ↦
      gaussianProposalDensity h (p.1 - h • gradient U p.1) p.2) := by
    unfold gaussianProposalDensity
    fun_prop
  have hp := gaussian_proposal_pair_density (gibbsMeasure U)
    (fun x ↦ x - h • gradient U x) hc h hh
  change malaProposalJoint U h (gibbsMeasure U) = _ at hp
  rw [hp, gibbsMeasure, Measure.prod_smul_left, prod_withDensity_left hw,
    withDensity_smul_measure]
  rw [← withDensity_mul _ (show Measurable (fun p : H × H ↦ gibbsWeight U p.1) from
    hw.comp measurable_fst) hq]
  have hd : (fun p : H × H ↦ gibbsWeight U p.1 *
      gaussianProposalDensity h (p.1 - h • gradient U p.1) p.2) =
      ENNReal.ofReal (gaussianProposalNormalizer (H := H) h) •
        (fun p ↦ ENNReal.ofReal (malaJointWeight U h p)) := by
    funext p
    change ENNReal.ofReal (Real.exp (-U p.1)) * ENNReal.ofReal
        (gaussianProposalNormalizer (H := H) h *
          Real.exp (-‖p.2 - (p.1 - h • gradient U p.1)‖ ^ 2 / (4 * h))) =
      ENNReal.ofReal (gaussianProposalNormalizer (H := H) h) *
        ENNReal.ofReal (malaJointWeight U h p)
    rw [← ENNReal.ofReal_mul (Real.exp_nonneg _),
      ← ENNReal.ofReal_mul (gaussianProposalNormalizer_pos h hh).le]
    congr 1
    unfold malaJointWeight
    have he : p.2 - (p.1 - h • gradient U p.1) = p.2 - p.1 + h • gradient U p.1 := by abel
    rw [he]
    calc
      _ = gaussianProposalNormalizer (H := H) h * (Real.exp (-U p.1) *
          Real.exp (-‖p.2 - p.1 + h • gradient U p.1‖ ^ 2 / (4 * h))) := by ring
      _ = _ := by
        rw [← Real.exp_add]
        congr 2
        ring
  change (gibbsPartition U)⁻¹ • (volume.prod volume).withDensity
    (fun p ↦ gibbsWeight U p.1 * gaussianProposalDensity h
      (p.1 - h • gradient U p.1) p.2) = _
  rw [hd, withDensity_smul _ (by
    unfold malaJointWeight
    fun_prop), smul_smul, withDensity_smul_measure]

/-- The exact MALA step preserves the explicitly normalized Gibbs law.
Only the source potential assumptions are used; no invariant-law input occurs. -/
theorem malaOneStep_gibbs_invariant (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hh : 0 < h) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) :
    malaOneStep U h (gibbsMeasure U) = gibbsMeasure U := by
  let base : Measure (H × H) :=
    ((gibbsPartition U)⁻¹ * ENNReal.ofReal (gaussianProposalNormalizer (H := H) h)) •
      (volume.prod volume)
  have hb : base.map Prod.swap = base := by
    dsimp [base]
    rw [Measure.map_smul _ measurable_swap.aemeasurable, Measure.prod_swap]
  have hw : Measurable (malaJointWeight U h) := by
    have hU := hdiff.continuous
    have hg := hLip.continuous
    unfold malaJointWeight
    fun_prop
  have hw0 : ∀ p, 0 < malaJointWeight U h p := fun _ ↦ Real.exp_pos _
  have ha : (fun p ↦ malaAcceptance U h p.1 p.2) =
      metropolisAcceptance (malaJointWeight U h) := by
    funext p
    unfold malaAcceptance metropolisAcceptance
    rw [malaJointWeight_ratio]
  have hd := malaProposalJoint_gibbs_density U h L hh hdiff hLip
  change malaProposalJoint U h (gibbsMeasure U) =
    base.withDensity (fun p ↦ ENNReal.ofReal (malaJointWeight U h p)) at hd
  rw [malaOneStep_eq_metropolisOutput U h L hdiff hLip, ha, hd,
    metropolisOutput_density_eq_initial base hb _ hw hw0, ← hd]
  unfold malaProposalJoint
  rw [Measure.map_map measurable_fst
    (measurable_fst.prodMk (malaProposal_measurable U h L hLip))]
  change ((gibbsMeasure U).prod (stdGaussian H)).map Prod.fst = _
  simpa using (Measure.map_fst_prod (μ := gibbsMeasure U) (ν := stdGaussian H))

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/LpCharacteristic.lean -/
section

set_option linter.style.header false

/-!
# Characteristic functions and Gaussian closedness in L²

At a fixed frequency, the characteristic function of a real random variable
is continuous in its L² class. The exponential is lifted by a Lipschitz map
vanishing at zero, and expectation is an L² inner product with the constant
one. Consequently centered Gaussian laws with their actual L² variances are
closed under arbitrary nontrivial-filter L² limits.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Filter
open scoped NNReal Topology

namespace ULA

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]

private def centeredCharacteristic (t x : ℝ) : ℂ := circleMap (-1) 1 (t * x)

private theorem centeredCharacteristic_lipschitz (t : ℝ) :
    LipschitzWith ‖t‖₊ (centeredCharacteristic t) := by
  have hmul : LipschitzWith ‖t‖₊ (fun x : ℝ ↦ t * x) := by
    apply LipschitzWith.of_dist_le_mul
    intro x y
    simp only [dist_eq_norm, ← mul_sub, norm_mul, coe_nnnorm]
    exact le_rfl
  have hunit : Real.nnabs (1 : ℝ) = 1 := by
    apply NNReal.eq
    norm_num
  change LipschitzWith ‖t‖₊ (fun x : ℝ ↦ circleMap (-1) 1 (t * x))
  simpa only [hunit, one_mul, Function.comp_def] using
    (lipschitzWith_circleMap (-1) 1).comp hmul

private theorem centeredCharacteristic_zero (t : ℝ) : centeredCharacteristic t 0 = 0 := by
  simp [centeredCharacteristic, circleMap]

private def characteristicLp (t : ℝ) (X : Lp ℝ 2 P) : Lp ℂ 2 P :=
  (centeredCharacteristic_lipschitz t).compLp (centeredCharacteristic_zero t) X +
    Lp.const 2 P 1

private theorem characteristicLp_coe (t : ℝ) (X : Lp ℝ 2 P) :
    characteristicLp P t X =ᵐ[P] fun ω ↦ Complex.exp (t * X ω * Complex.I) := by
  filter_upwards [Lp.coeFn_add
      ((centeredCharacteristic_lipschitz t).compLp (centeredCharacteristic_zero t) X)
      (Lp.const 2 P (1 : ℂ)),
    (centeredCharacteristic_lipschitz t).coeFn_compLp (centeredCharacteristic_zero t) X,
    Lp.coeFn_const (μ := P) (p := 2) (c := (1 : ℂ))] with ω hadd hcomp hone
  simp only [characteristicLp, hadd, Pi.add_apply, hcomp, hone, Function.comp_apply,
    Function.const_apply, centeredCharacteristic, circleMap, Complex.ofReal_one,
    one_mul, Complex.ofReal_mul]
  ring

private theorem charFun_map_eq_inner_characteristicLp (t : ℝ) (X : Lp ℝ 2 P) :
    charFun (P.map X) t = inner ℂ (Lp.const 2 P (1 : ℂ)) (characteristicLp P t X) := by
  rw [charFun_apply_real, integral_map (Lp.aestronglyMeasurable X).aemeasurable
    (by fun_prop), L2.inner_def]
  apply integral_congr_ae
  filter_upwards [Lp.coeFn_const (μ := P) (p := 2) (c := (1 : ℂ)),
    characteristicLp_coe P t X] with ω hone hchar
  simp [hchar, RCLike.inner_apply]

/-- The characteristic function at a fixed frequency depends continuously on
the real random variable in L². Its law is the actual pushforward measure. -/
theorem continuous_charFun_map_Lp (t : ℝ) :
    Continuous (fun X : Lp ℝ 2 P ↦ charFun (P.map X) t) := by
  have hc : Continuous (characteristicLp P t) :=
    ((centeredCharacteristic_lipschitz t).continuous_compLp
      (centeredCharacteristic_zero t)).add continuous_const
  have hi : Continuous (fun X : Lp ℝ 2 P ↦
      inner ℂ (Lp.const 2 P (1 : ℂ)) (characteristicLp P t X)) := continuous_const.inner hc
  simpa only [← charFun_map_eq_inner_characteristicLp] using hi

omit [IsProbabilityMeasure P] in
/-- The centered Gaussian characteristic function is continuous in the L²
norm supplying its variance. The nonnegative-real conversion is continuous. -/
theorem continuous_gaussianReal_charFun_Lp (t : ℝ) :
    Continuous (fun X : Lp ℝ 2 P ↦
      charFun (gaussianReal 0 ((‖X‖ ^ 2).toNNReal)) t) := by
  simp only [charFun_gaussianReal]
  fun_prop

/-- Centered Gaussian laws with their actual second moments are closed under
L² limits, for any nontrivial filter. Even eventual Gaussian laws suffice. -/
theorem hasLaw_gaussianReal_of_tendsto_Lp_eventually
    {ι : Type*} {l : Filter ι} [NeBot l] (X : ι → Lp ℝ 2 P) (Y : Lp ℝ 2 P)
    (hXY : Tendsto X l (𝓝 Y))
    (hGaussian : ∀ᶠ i in l, HasLaw (X i) (gaussianReal 0 ((‖X i‖ ^ 2).toNNReal)) P) :
    HasLaw Y (gaussianReal 0 ((‖Y‖ ^ 2).toNNReal)) P := by
  refine ⟨(Lp.aestronglyMeasurable Y).aemeasurable, Measure.ext_of_charFun ?_⟩
  funext t
  have hactual := ((continuous_charFun_map_Lp P t).tendsto Y).comp hXY
  have hgaussian := ((continuous_gaussianReal_charFun_Lp P t).tendsto Y).comp hXY
  have heq : (fun i ↦ charFun (P.map (X i)) t) =ᶠ[l]
      (fun i ↦ charFun (gaussianReal 0 ((‖X i‖ ^ 2).toNNReal)) t) := by
    filter_upwards [hGaussian] with i hi
    rw [hi.map_eq]
  exact tendsto_nhds_unique hactual (hgaussian.congr' heq.symm)

/-- The all-index version, convenient for finite-sum approximations to a
Gaussian Hilbert-space isometry. -/
theorem hasLaw_gaussianReal_of_tendsto_Lp
    {ι : Type*} {l : Filter ι} [NeBot l] (X : ι → Lp ℝ 2 P) (Y : Lp ℝ 2 P)
    (hXY : Tendsto X l (𝓝 Y))
    (hGaussian : ∀ i, HasLaw (X i) (gaussianReal 0 ((‖X i‖ ^ 2).toNNReal)) P) :
    HasLaw Y (gaussianReal 0 ((‖Y‖ ^ 2).toNNReal)) P :=
  hasLaw_gaussianReal_of_tendsto_Lp_eventually P X Y hXY (Eventually.of_forall hGaussian)

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/CouplingLimit.lean -/
section

set_option linter.style.header false

/-! # Equality of a limiting law and an asymptotically coupled fixed law

Characteristic tests are Lipschitz. Couplings whose expected distance tends to
zero force characteristic-function convergence to their fixed second marginal.
An actual `L²` limit supplies the same limiting characteristic function, so the
limiting law is exactly that marginal.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory ProbabilityTheory Filter
open scoped NNReal ENNReal Topology
namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H]

omit [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H] in
/-- At a fixed frequency the real-Hilbert characteristic test is Lipschitz
with constant the norm of that frequency. -/
theorem characteristicTest_norm_sub_le (t x y : H) :
    ‖Complex.exp ((inner ℝ x t : ℂ) * Complex.I) -
      Complex.exp ((inner ℝ y t : ℂ) * Complex.I)‖ ≤ ‖t‖ * ‖x - y‖ := by
  have hunit : Real.nnabs (1 : ℝ) = 1 := by apply NNReal.eq; norm_num
  have hc := (lipschitzWith_circleMap (0 : ℂ) 1).norm_sub_le (inner ℝ x t) (inner ℝ y t)
  rw [hunit, NNReal.coe_one, one_mul] at hc
  simp only [circleMap, Complex.ofReal_one, one_mul, zero_add] at hc
  calc
    _ ≤ |inner ℝ x t - inner ℝ y t| := hc
    _ = |inner ℝ (x - y) t| := by rw [inner_sub_left]
    _ ≤ ‖x - y‖ * ‖t‖ := abs_real_inner_le_norm _ _
    _ = _ := mul_comm _ _

/-- Any actual coupling controls the difference between its marginal
characteristic functions by its ordinary expected distance. -/
theorem charFun_marginals_norm_sub_le
    (ρ : Measure (H × H)) [IsProbabilityMeasure ρ]
    (hint : Integrable (fun p : H × H ↦ ‖p.1 - p.2‖) ρ) (t : H) :
    ‖charFun (ρ.map Prod.fst) t - charFun (ρ.map Prod.snd) t‖ ≤
      ‖t‖ * ∫ p : H × H, ‖p.1 - p.2‖ ∂ρ := by
  have hf : Integrable (fun p : H × H ↦
      Complex.exp ((inner ℝ p.1 t : ℂ) * Complex.I)) ρ :=
    Integrable.of_bound (by fun_prop) 1 (ae_of_all _ fun p ↦
      (Complex.norm_exp_ofReal_mul_I (inner ℝ p.1 t)).le)
  have hg : Integrable (fun p : H × H ↦
      Complex.exp ((inner ℝ p.2 t : ℂ) * Complex.I)) ρ :=
    Integrable.of_bound (by fun_prop) 1 (ae_of_all _ fun p ↦
      (Complex.norm_exp_ofReal_mul_I (inner ℝ p.2 t)).le)
  rw [charFun_apply, charFun_apply,
    integral_map measurable_fst.aemeasurable (by fun_prop),
    integral_map measurable_snd.aemeasurable (by fun_prop), ← integral_sub hf hg]
  calc
    _ ≤ ∫ p : H × H, ‖Complex.exp ((inner ℝ p.1 t : ℂ) * Complex.I) -
        Complex.exp ((inner ℝ p.2 t : ℂ) * Complex.I)‖ ∂ρ := norm_integral_le_integral_norm _
    _ ≤ ∫ p : H × H, ‖t‖ * ‖p.1 - p.2‖ ∂ρ :=
      integral_mono (hf.sub hg).norm (hint.const_mul ‖t‖)
        (fun p ↦ characteristicTest_norm_sub_le t p.1 p.2)
    _ = _ := integral_const_mul _ _

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]

omit [SecondCountableTopology H] in
/-- Characteristic functions of Hilbert-valued random variables are continuous
in their actual `L²` classes, at every fixed frequency. -/
theorem continuous_charFun_map_Lp_hilbert (t : H) :
    Continuous (fun X : Lp H 2 P ↦ charFun (P.map X) t) := by
  let L : H →L[ℝ] ℝ := innerSL ℝ t
  have heq (X : Lp H 2 P) :
      charFun (P.map X) t = charFun (P.map (L.compLp X)) (1 : ℝ) := by
    rw [charFun_map_eq_charFun_map_inner_one (Lp.aestronglyMeasurable X).aemeasurable t]
    congr 1
    apply Measure.map_congr
    filter_upwards [L.coeFn_compLp X] with ω hω
    simpa only [L, innerSL_apply_apply, real_inner_comm] using hω.symm
  have hc := (continuous_charFun_map_Lp P (1 : ℝ)).comp (L.compLpL 2 P).continuous
  convert hc using 1
  funext X
  exact heq X

variable [CompleteSpace H]

/-- If actual `L²` endpoint variables converge and their laws admit couplings
with a fixed probability law whose expected distances tend to zero, their
limit has exactly that fixed law. No density or optimal-transport premise is
needed. -/
theorem measure_map_Lp_eq_of_coupling_cost_tendsto
    {ι : Type*} {l : Filter ι} [NeBot l]
    (Xn : ι → Lp H 2 P) (X : Lp H 2 P)
    (π : Measure H) [IsProbabilityMeasure π]
    (ρ : ι → Measure (H × H)) [∀ i, IsProbabilityMeasure (ρ i)]
    (hX : Tendsto Xn l (𝓝 X))
    (hfst : ∀ i, (ρ i).map Prod.fst = P.map (Xn i))
    (hsnd : ∀ i, (ρ i).map Prod.snd = π)
    (hint : ∀ i, Integrable (fun p : H × H ↦ ‖p.1 - p.2‖) (ρ i))
    (hcost : Tendsto (fun i ↦ ∫ p : H × H, ‖p.1 - p.2‖ ∂ρ i) l (𝓝 0)) :
    P.map X = π := by
  apply Measure.ext_of_charFun
  funext t
  have hactual := ((continuous_charFun_map_Lp_hilbert P t).tendsto X).comp hX
  have hbound (i : ι) : ‖charFun (P.map (Xn i)) t - charFun π t‖ ≤
      ‖t‖ * ∫ p : H × H, ‖p.1 - p.2‖ ∂ρ i := by
    simpa only [hfst i, hsnd i] using charFun_marginals_norm_sub_le (ρ i) (hint i) t
  have hnorm : Tendsto (fun i ↦ ‖charFun (P.map (Xn i)) t - charFun π t‖) l (𝓝 0) := by
    apply squeeze_zero (fun _ ↦ norm_nonneg _) hbound
    simpa only [mul_zero] using hcost.const_mul ‖t‖
  have htarget : Tendsto (fun i ↦ charFun (P.map (Xn i)) t) l (𝓝 (charFun π t)) :=
    tendsto_iff_norm_sub_tendsto_zero.mpr hnorm
  exact tendsto_nhds_unique hactual htarget

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/GaussianInnovationVectors.lean -/
section

set_option linter.style.header false

/-! # Scalar Gaussian innovations determine the vector algorithm

Independence over iteration-coordinate pairs implies the full vector-valued
iid standard Gaussian path law. Grouping coordinates introduces no hypothesis.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
namespace ULA

variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
  (P : Measure Ω) [IsProbabilityMeasure P]

/-- The entire vector noise path law follows from independent scalar coordinates. -/
theorem gaussianInnovations_pathLaw (W : ℕ → Ω → EuclideanSpace ℝ ι)
    (hW : ∀ n, AEMeasurable (W n) P)
    (hcoord : ∀ n i, HasLaw (fun ω ↦ W n ω i) (gaussianReal 0 1) P)
    (hind : iIndepFun (fun p : ℕ × ι ↦ fun ω ↦ W p.1 ω p.2) P) :
    P.map (fun ω n ↦ W n ω) =
      Measure.infinitePi (fun _ : ℕ ↦ stdGaussian (EuclideanSpace ℝ ι)) := by
  let flat : Ω → (ℕ × ι → ℝ) := fun ω p ↦ W p.1 ω p.2
  have hflat : AEMeasurable flat P :=
    aemeasurable_pi_iff.mpr fun p ↦ (hcoord p.1 p.2).aemeasurable
  have hlaw : P.map flat = Measure.infinitePi (fun _ : ℕ × ι ↦ gaussianReal 0 1) := by
    have hp := hind.map_fun_eq_infinitePi_map₀' (fun p : ℕ × ι ↦ (hcoord p.1 p.2).aemeasurable)
    simpa only [(hcoord _ _).map_eq] using hp
  let pack : (ℕ → ι → ℝ) → ℕ → EuclideanSpace ℝ ι :=
    fun w n ↦ WithLp.toLp 2 (w n)
  have hpack : Measurable pack := by
    exact measurable_pi_iff.mpr fun n ↦
      (WithLp.measurable_toLp 2 _).comp (measurable_pi_apply n)
  have heq : (fun ω n ↦ W n ω) =
      pack ∘ (MeasurableEquiv.curry ℕ ι ℝ) ∘ flat := by rfl
  rw [heq, ← AEMeasurable.map_map_of_aemeasurable hpack.aemeasurable
      ((MeasurableEquiv.curry ℕ ι ℝ).measurable.aemeasurable.comp_aemeasurable hflat),
    ← AEMeasurable.map_map_of_aemeasurable
      (MeasurableEquiv.curry ℕ ι ℝ).measurable.aemeasurable hflat, hlaw,
    Measure.infinitePi_map_curry (fun (_ : ℕ) (_ : ι) ↦ gaussianReal 0 1)]
  change (Measure.infinitePi (fun _ : ℕ ↦ Measure.infinitePi
    (fun _ : ι ↦ gaussianReal 0 1))).map pack = _
  rw [Measure.infinitePi_map_pi]
  · simp only [Measure.infinitePi_eq_pi, map_pi_eq_stdGaussian]
  · intro n
    exact WithLp.measurable_toLp 2 _

/-- Each innovation vector has the actual standard multivariate Gaussian law. -/
theorem gaussianInnovations_vectorLaw (W : ℕ → Ω → EuclideanSpace ℝ ι)
    (hW : ∀ n, AEMeasurable (W n) P)
    (hcoord : ∀ n i, HasLaw (fun ω ↦ W n ω i) (gaussianReal 0 1) P)
    (hind : iIndepFun (fun p : ℕ × ι ↦ fun ω ↦ W p.1 ω p.2) P) (n : ℕ) :
    P.map (W n) = stdGaussian (EuclideanSpace ℝ ι) := by
  have hp := gaussianInnovations_pathLaw P W hW hcoord hind
  calc
    P.map (W n) = (P.map (fun ω k ↦ W k ω)).map (fun w ↦ w n) := by
      rw [AEMeasurable.map_map_of_aemeasurable
        (measurable_pi_apply n).aemeasurable (aemeasurable_pi_iff.mpr hW)]
      rfl
    _ = _ := by rw [hp, Measure.infinitePi_map_eval]

/-- The vector innovations are independent over time, as a theorem rather
than a separate Gaussian algorithm assumption. -/
theorem gaussianInnovations_vectorIndependent (W : ℕ → Ω → EuclideanSpace ℝ ι)
    (hW : ∀ n, AEMeasurable (W n) P)
    (hcoord : ∀ n i, HasLaw (fun ω ↦ W n ω i) (gaussianReal 0 1) P)
    (hind : iIndepFun (fun p : ℕ × ι ↦ fun ω ↦ W p.1 ω p.2) P) :
    iIndepFun W P := by
  rw [iIndepFun_iff_map_fun_eq_infinitePi_map₀' hW,
    gaussianInnovations_pathLaw P W hW hcoord hind]
  simp_rw [gaussianInnovations_vectorLaw P W hW hcoord hind]

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/GibbsStationarity.lean -/
section

set_option linter.style.header false

/-! # Gibbs stationarity of the actual additive-noise Langevin solution

The matching-noise Euler approximations converge in `L²`. Their actual iid
Gaussian recursion laws are coupled to the exactly stationary Metropolis
chain; the rejection error tends to zero on a refining uniform mesh. This
proves the law of the integral solution itself, without an assumed invariant
law, Itô formula, or forward-equation uniqueness.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology

namespace ULA

variable {Ω H : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H]
  (P : Measure Ω) [IsProbabilityMeasure P]

/-- Quotient representatives of the Hilbert-space Euler chain implement the
ordinary pointwise recursion almost everywhere. -/
theorem hilbert_lpChain_coe (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U)) (initial : Lp H 2 P)
    (W : ℕ → Lp H 2 P) (n : ℕ) :
    Hilbert.lpChain P U h hLip initial W n =ᵐ[P] fun ω ↦
      noiseDrivenChain (Hilbert.pointwiseUpdate U h) (initial ω) (fun k ↦ W k ω) n := by
  induction n with
  | zero => exact ae_of_all _ fun _ ↦ rfl
  | succ n ih =>
    filter_upwards [lpUlaUpdate_coe P U h hLip
      (Hilbert.lpChain P U h hLip initial W n) (W n), ih] with ω hup hprev
    simpa only [Hilbert.lpChain_succ, noiseDrivenChain_succ,
      Hilbert.pointwiseUpdate, hprev] using hup

/-- The proved iid realization theorem identifies the actual `L²` chain law
with iterations of the ordinary ULA transition. -/
theorem hilbert_lpChain_law_eq_ulaLawStep [FiniteDimensional ℝ H]
    (U : H → ℝ) (h : ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (initial : Lp H 2 P) (W : ℕ → Lp H 2 P)
    (hind : IndepFun initial (fun ω n ↦ W n ω) P)
    (hiid : iIndepFun (fun n ω ↦ W n ω) P)
    (hlaw : ∀ n, P.map (W n) = stdGaussian H) (n : ℕ) :
    P.map (Hilbert.lpChain P U h hLip initial W n) =
      (ulaLawStep U h)^[n] (P.map initial) := by
  rw [Measure.map_congr (hilbert_lpChain_coe P U h L hLip initial W n),
    noiseDrivenChain_law_eq_markovLaws P (Hilbert.pointwiseUpdate U h)
      (Hilbert.pointwiseUpdate_measurable U h L hLip)
      initial (fun n ω ↦ W n ω) (Lp.aestronglyMeasurable initial).aemeasurable
      (fun n ↦ (Lp.aestronglyMeasurable (W n)).aemeasurable)
      hind hiid (stdGaussian H) hlaw n]
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [markovLaws, ih, Function.iterate_succ_apply']
    rfl

/-- Exact-noise Banach Euler and the actual Hilbert `L²` Euler chain agree. -/
theorem additiveEulerChain_eq_hilbert_lpChain
    (U : H → ℝ) (h : ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (initial : Lp H 2 P) (B : ℝ → Lp H 2 P) (W : ℕ → Lp H 2 P)
    (hincrement : ∀ k : ℕ, B (((k + 1 : ℕ) : ℝ) * h) - B ((k : ℝ) * h) =
      Real.sqrt (2 * h) • W k) (n : ℕ) :
    additiveEulerChain (lpDrift P (gradient U) hLip) h initial B n =
      Hilbert.lpChain P U h hLip initial W n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [additiveEulerChain_succ, Hilbert.lpChain_succ, ih, hincrement n]
    rfl

section Brownian

variable {ι : Type*} [Fintype ι]

/-- The unshifted cumulative Brownian input has exactly the segment increments
used in the Euler normalization. -/
theorem brownianLangevinNoise_grid_increment
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (h : ℝ) (k : ℕ) :
    brownianLangevinNoise P B hB 0 (((k + 1 : ℕ) : ℝ) * h) -
      brownianLangevinNoise P B hB 0 ((k : ℝ) * h) =
      brownianLangevinNoise P B hB ((k : ℝ) * h) h := by
  unfold brownianLangevinNoise
  simp only [zero_add]
  rw [show (((k + 1 : ℕ) : ℝ) * h) = (k : ℝ) * h + h by push_cast; ring]
  module

/-- Matching-noise Euler for the cumulative Brownian input is the exact
already-defined normalized Brownian Euler chain. -/
theorem brownian_additiveEulerChain_eq_lpChain
    (U : EuclideanSpace ℝ ι → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (hh : 0 < h) (n : ℕ) :
    additiveEulerChain (lpDrift P (gradient U) hLip) h initial
      (brownianLangevinNoise P B hB 0) n =
      Hilbert.lpChain P U h hLip initial (Hilbert.brownianEulerNoise P B hB h) n := by
  apply additiveEulerChain_eq_hilbert_lpChain
  intro k
  rw [brownianLangevinNoise_grid_increment,
    Hilbert.brownianEulerNoise_endpoint P B hB h hh k]

/-- Scalar Gaussian coordinate laws and independence supply the vector-valued
iid law needed by the actual Markov recursion. -/
theorem brownianEulerNoise_vectorGaussian
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (h : ℝ) (hh : 0 < h)
    (hind : iIndepFun (fun p : ℕ × ι ↦ fun ω ↦
      Hilbert.brownianEulerNoise P B hB h p.1 ω p.2) P) :
    iIndepFun (fun n ω ↦ Hilbert.brownianEulerNoise P B hB h n ω) P ∧
      ∀ n, P.map (Hilbert.brownianEulerNoise P B hB h n) =
        stdGaussian (EuclideanSpace ℝ ι) := by
  have hW (n : ℕ) : AEMeasurable
      (Hilbert.brownianEulerNoise P B hB h n) P :=
    (Lp.aestronglyMeasurable _).aemeasurable
  have hc (n : ℕ) (i : ι) : HasLaw
      (fun ω ↦ Hilbert.brownianEulerNoise P B hB h n ω i) (gaussianReal 0 1) P :=
    Hilbert.sourceEulerNoise_coordinateLaw P B hB h hh n i
  exact ⟨gaussianInnovations_vectorIndependent P _ hW hc hind,
    gaussianInnovations_vectorLaw P _ hW hc hind⟩

/-- Every continuous `L²` integral solution driven by ordinary independent
Brownian Euler innovations preserves its initial Gibbs law. The two noise
independence premises describe only the supplied Brownian realization; they
are proved automatically on the canonical initial/Brownian product space.
There is no invariance, forward-equation, or moment hypothesis. -/
theorem lp_langevin_gibbs_stationary
    (U : EuclideanSpace ℝ ι → ℝ) (m : ℝ) (L : ℝ≥0) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (hinitial : P.map initial = gibbsMeasure U)
    (B : ι → ℝ≥0 → Ω → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) P)
    (hscalar : ∀ h : ℝ, 0 < h → iIndepFun (fun p : ℕ × ι ↦ fun ω ↦
      Hilbert.brownianEulerNoise P B hB h p.1 ω p.2) P)
    (hind : ∀ h : ℝ, 0 < h → IndepFun initial
      (fun ω n ↦ Hilbert.brownianEulerNoise P B hB h n ω) P)
    (Y : ℝ → Lp (EuclideanSpace ℝ ι) 2 P) (hY : Continuous Y)
    (T : ℝ) (hT : 0 ≤ T)
    (hYe : ∀ t ∈ Icc 0 T, Y t - initial =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) +
        brownianLangevinNoise P B hB 0 t) :
    P.map (Y T) = gibbsMeasure U := by
  by_cases hTzero : T = 0
  · subst T
    have hY0 : Y 0 = initial := by
      simpa only [intervalIntegral.integral_same, neg_zero,
        brownianLangevinNoise_zero, add_zero, sub_eq_zero] using hYe 0 ⟨le_rfl, le_rfl⟩
    rw [hY0, hinitial]
  have hTpos : 0 < T := lt_of_le_of_ne hT (Ne.symm hTzero)
  have hπ := isProbabilityMeasure_gibbsMeasure U m hm hdiff hsc
  have hmesh : Tendsto (fun n : ℕ ↦ T / ((n + 1 : ℕ) : ℝ)) atTop (𝓝 0) :=
    (tendsto_add_atTop_iff_nat 1).mpr (tendsto_const_div_atTop_nhds_zero_nat T)
  have hmL : 0 < m + (L : ℝ) := add_pos_of_pos_of_nonneg hm L.coe_nonneg
  have hsmallpos : 0 < min (1 : ℝ) (2 / (m + (L : ℝ))) := by positivity
  obtain ⟨N, hN⟩ := eventually_atTop.mp (hmesh.eventually (gt_mem_nhds hsmallpos))
  let step : ℕ → ℝ := fun n ↦ T / ((n + N + 1 : ℕ) : ℝ)
  have hstep (n : ℕ) : 0 < step n := by dsimp [step]; positivity
  have hsmall (n : ℕ) : step n ≤ min (1 : ℝ) (2 / (m + (L : ℝ))) :=
    (hN (n + N) (by omega)).le
  have h1 (n : ℕ) : step n ≤ 1 := (hsmall n).trans (min_le_left _ _)
  have hstable (n : ℕ) : step n ≤ 2 / (m + (L : ℝ)) :=
    (hsmall n).trans (min_le_right _ _)
  have hstationary (n : ℕ) : malaOneStep U (step n) (gibbsMeasure U) = gibbsMeasure U :=
    malaOneStep_gibbs_invariant U (step n) L (hstep n) hdiff hLip
  let Xn : ℕ → Lp (EuclideanSpace ℝ ι) 2 P := fun n ↦
    Hilbert.lpChain P U (step n) hLip initial
      (Hilbert.brownianEulerNoise P B hB (step n)) (n + N + 1)
  let ρ : ℕ → Measure (EuclideanSpace ℝ ι × EuclideanSpace ℝ ι) := fun n ↦
    malaCoupledChain U (step n) (gibbsMeasure U) (n + N + 1)
  have hρ (n : ℕ) : IsProbabilityMeasure (ρ n) :=
    malaCoupledChain_isProbability U (step n) L hdiff hLip (gibbsMeasure U) (n + N + 1)
  letI : ∀ n, IsProbabilityMeasure (ρ n) := hρ
  have hX : Tendsto Xn atTop (𝓝 (Y T)) := by
    have he := lp_langevin_integral_euler_tendsto P U L hLip initial
      (brownianLangevinNoise P B hB 0) Y (brownianLangevinNoise_zero P B hB 0)
      hY T hT hYe
    apply (he.comp (tendsto_add_atTop_nat N)).congr'
    exact Eventually.of_forall fun n ↦
      brownian_additiveEulerChain_eq_lpChain P U (step n) L hLip initial B hB
        (hstep n) (n + N + 1)
  have hfst (n : ℕ) : (ρ n).map Prod.fst = P.map (Xn n) := by
    obtain ⟨hiid, hlaw⟩ := brownianEulerNoise_vectorGaussian P B hB (step n) (hstep n)
      (hscalar (step n) (hstep n))
    dsimp only [ρ, Xn]
    rw [malaCoupledChain_fst U (step n) L hdiff hLip,
      hilbert_lpChain_law_eq_ulaLawStep P U (step n) L hLip initial
        (Hilbert.brownianEulerNoise P B hB (step n))
        (hind (step n) (hstep n)) hiid hlaw, hinitial]
  have hsnd (n : ℕ) : (ρ n).map Prod.snd = gibbsMeasure U :=
    malaCoupledChain_snd U (step n) L hdiff hLip (gibbsMeasure U)
      (hstationary n) (n + N + 1)
  have hint (n : ℕ) : Integrable (fun p : EuclideanSpace ℝ ι × EuclideanSpace ℝ ι ↦
      ‖p.1 - p.2‖) (ρ n) :=
    malaCoupledChain_distance_integrable U m (step n) L hm (hstep n) (h1 n)
      (hstable n) hdiff hsc hLip (hstationary n) (n + N + 1)
  have hbound (n : ℕ) :
      (∫ p : EuclideanSpace ℝ ι × EuclideanSpace ℝ ι, ‖p.1 - p.2‖ ∂ρ n) ≤
        (T * malaRejectionConstant U L) * Real.sqrt (step n) := by
    calc
      _ ≤ ((n + N + 1 : ℕ) : ℝ) * malaRejectionConstant U L * step n *
          Real.sqrt (step n) :=
        malaCoupledChain_distance_integral_le U m (step n) L hm (hstep n) (h1 n)
          (hstable n) hdiff hsc hLip (hstationary n) (n + N + 1)
      _ = _ := by dsimp [step]; field_simp
  have hstepzero : Tendsto step atTop (𝓝 0) := hmesh.comp (tendsto_add_atTop_nat N)
  have hcost : Tendsto (fun n ↦ ∫ p : EuclideanSpace ℝ ι × EuclideanSpace ℝ ι,
      ‖p.1 - p.2‖ ∂ρ n) atTop (𝓝 0) := by
    apply squeeze_zero (fun _ ↦ integral_nonneg fun _ ↦ norm_nonneg _) hbound
    simpa only [Function.comp_apply, Real.sqrt_zero, mul_zero] using
      ((Real.continuous_sqrt.tendsto 0).comp hstepzero).const_mul (T * malaRejectionConstant U L)
  exact measure_map_Lp_eq_of_coupling_cost_tendsto P Xn (Y T) (gibbsMeasure U) ρ
    hX hfst hsnd hint hcost

end Brownian
end ULA


end
end


/-! ## Included source: IPLA/ULAAdapter.lean -/
section

set_option linter.style.header false

/-! # IPLA adaptation of the shared ULA Brownian construction

The Langevin reference, stochastic laws, and Dalalyan estimate are implemented
in `UnadjustedLangevin`. This file only packages those facts in IPLA's block
coordinates and identifies them with the algorithm's Gaussian innovations.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped NNReal

namespace IPLA
open ULA ULA.Hilbert

section Algorithm

variable {S Ω : Type*} [MeasurableSpace S] [MeasurableSpace Ω]
  (Q : Measure S) [IsProbabilityMeasure Q]
  {N dθ dx : ℕ} {μ π : Measure (State N dθ dx)} [IsProbabilityMeasure μ]

local instance algorithmProductProbability (c : Coupling μ π) :
    IsProbabilityMeasure (initialExtension c Q) := initialExtension_isProbabilityMeasure c Q

/-- The concrete product realization satisfies every distributional field of
the actual IPLA algorithm. Standard Gaussian laws and all independence claims
are conclusions from the independent Brownian coordinate source. -/
theorem productGaussianInnovations (c : Coupling μ π) (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : State N dθ dx ↦ x) 2 π)
    (B : (Fin dθ ⊕ (Fin N × Fin dx)) → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (h : ℝ) (hh : 0 < h)
    (hpaths : iIndepFun (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * h.toNNReal) ω) Q) :
    GaussianInnovations (initialExtension c Q) (initialExtension_lpInitial c Q hc hπ)
      (productNoise Q c (sourceEulerNoise Q B hB h) (sourceEulerNoise_memLp Q B hB h)) where
  coordinateLaw := productEulerNoise_coordinateLaw Q c B hB h hh
  independent := productEulerNoise_independent Q c B hB h hh hpaths
  independentInitial := productEulerNoise_independentInitial Q c hc hπ B hB h

/-- The law produced by the Brownian product construction is exactly the law
of any supplied Gaussian IPLA implementation with the same initialization.
This bridge has no stationarity or reference-process hypothesis. -/
theorem laws_eq_productBrownianOutput
    (P : Measure Ω) [IsProbabilityMeasure P]
    (U : Joint dθ dx → ℝ) (γ : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (initial : Lp (State N dθ dx) 2 P) (noise : ℕ → Lp (State N dθ dx) 2 P)
    (hGaussian : GaussianInnovations P initial noise)
    (π : Measure (State N dθ dx)) (c : Coupling (P.map initial) π)
    (hc : couplingCost c.joint ≠ ⊤) (hπ : MemLp (fun x : State N dθ dx ↦ x) 2 π)
    (B : (Fin dθ ⊕ (Fin N × Fin dx)) → ℝ≥0 → S → ℝ)
    (hB : ∀ i, IsPreBrownianReal (B i) Q) (hh : 0 < γ / N)
    (hpaths : iIndepFun (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * (γ / N).toNNReal) ω) Q)
    (k : ℕ) :
    laws P U γ L hdiff hLip initial noise k =
      productOutputLaw Q (potential U) (γ / N) (P.map initial)
        (sourceEulerNoise Q B hB (γ / N)) k := by
  have : IsProbabilityMeasure (P.map initial) := inferInstance
  have : IsProbabilityMeasure (initialExtension c Q) := initialExtension_isProbabilityMeasure c Q
  have heq := laws_eq_of_initialLaw_eq P (initialExtension c Q) U γ L hdiff hLip
    initial noise (initialExtension_lpInitial c Q hc hπ)
      (productNoise Q c (sourceEulerNoise Q B hB (γ / N))
        (sourceEulerNoise_memLp Q B hB (γ / N)))
    hGaussian (productGaussianInnovations Q c hc hπ B hB (γ / N) hh hpaths)
      (initialExtension_lpInitial_law c Q hc hπ).symm k
  rw [heq, laws]
  exact product_chain_outputLaw Q c hc hπ (potential U) (γ / N) ((N : ℝ≥0) * L)
    (potential_gradient_lipschitz hdiff hLip) (sourceEulerNoise Q B hB (γ / N))
    (sourceEulerNoise_memLp Q B hB (γ / N)) k

/-- The actual IPLA law is precisely ULA for the rescaled lifted potential.
All vector Gaussian and independence facts follow from the displayed scalar
innovation specification of the algorithm. -/
theorem laws_eq_ulaLawStep
    (P : Measure Ω) [IsProbabilityMeasure P]
    (U : Joint dθ dx → ℝ) (γ : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hLip : LipschitzWith L (gradient U))
    (initial : Lp (State N dθ dx) 2 P) (noise : ℕ → Lp (State N dθ dx) 2 P)
    (hGaussian : GaussianInnovations P initial noise) (k : ℕ) :
    laws P U γ L hdiff hLip initial noise k =
      (ULA.ulaLawStep (potential U) (γ / N))^[k] (P.map initial) := by
  have hW : ∀ n, AEMeasurable (noise n) P :=
    fun n ↦ (Lp.aestronglyMeasurable (noise n)).aemeasurable
  exact ULA.hilbert_lpChain_law_eq_ulaLawStep P (potential U) (γ / N)
    ((N : ℝ≥0) * L) (potential_gradient_lipschitz hdiff hLip) initial noise
    hGaussian.independentInitial
    (ULA.gaussianInnovations_vectorIndependent P (fun n ω ↦ noise n ω)
      hW hGaussian.coordinateLaw hGaussian.independent)
    (ULA.gaussianInnovations_vectorLaw P (fun n ω ↦ noise n ω)
      hW hGaussian.coordinateLaw hGaussian.independent) k

end Algorithm
end IPLA


end
end


/-! ## Included source: UnadjustedLangevin/GaussianHilbert.lean -/
section

set_option linter.style.header false

/-! # An isonormal Gaussian source from an independent Gaussian product

The source measure is constructed explicitly as an infinite product of standard
real Gaussians. Its coordinate random variables form an orthonormal family in
L². Hilbert-space expansion then constructs random linear functionals, without
assuming that a Brownian probability space already exists.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology Classical lp

namespace ULA
namespace GaussianHilbert

variable {ι : Type*}

def source (ι : Type*) : Measure (ι → ℝ) :=
  Measure.infinitePi (fun _ : ι ↦ gaussianReal 0 1)

instance source_isProbabilityMeasure (ι : Type*) : IsProbabilityMeasure (source ι) := by
  unfold source
  infer_instance

theorem coordinate_hasLaw (i : ι) :
    HasLaw (fun ω : ι → ℝ ↦ ω i) (gaussianReal 0 1) (source ι) :=
  ⟨(measurable_pi_apply i).aemeasurable, Measure.infinitePi_map_eval _ i⟩

def coordinateLp (i : ι) : Lp ℝ 2 (source ι) :=
  ((coordinate_hasLaw i).memLp (memLp_id_gaussianReal (2 : ℝ≥0))).toLp (fun ω ↦ ω i)

theorem coordinateLp_coe (i : ι) :
    coordinateLp i =ᵐ[source ι] fun ω : ι → ℝ ↦ ω i :=
  ((coordinate_hasLaw i).memLp (memLp_id_gaussianReal (2 : ℝ≥0))).coeFn_toLp

theorem coordinates_independent :
    iIndepFun (fun i (ω : ι → ℝ) ↦ ω i) (source ι) :=
  iIndepFun_infinitePi (fun _ ↦ measurable_id)

theorem coordinate_mean (i : ι) : (∫ ω, ω i ∂source ι) = 0 := by
  exact ((coordinate_hasLaw i).integral_comp (f := id) measurable_id.aestronglyMeasurable).trans
    integral_id_gaussianReal

theorem coordinateLp_inner (i j : ι) :
    inner ℝ (coordinateLp i) (coordinateLp j) = if i = j then 1 else 0 := by
  classical
  rw [L2.inner_def]
  have heq : (fun ω ↦ inner ℝ (coordinateLp i ω) (coordinateLp j ω))
      =ᵐ[source ι] fun ω ↦ ω i * ω j := by
    filter_upwards [coordinateLp_coe i, coordinateLp_coe j] with ω hi hj
    simp [hi, hj, mul_comm]
  rw [integral_congr_ae heq]
  split_ifs with hij
  · subst j
    simpa only [← sq, Function.comp_apply, NNReal.coe_one] using
      ((coordinate_hasLaw i).integral_comp (f := fun x : ℝ ↦ x ^ 2) (by fun_prop)).trans
        (centered_gaussian_second_moment 1)
  · exact ((coordinates_independent.indepFun hij).integral_mul_eq_mul_integral
      (measurable_pi_apply i).aestronglyMeasurable
      (measurable_pi_apply j).aestronglyMeasurable).trans (by
        rw [coordinate_mean, coordinate_mean, zero_mul])

theorem coordinates_orthonormal : Orthonormal ℝ (@coordinateLp ι) := by
  classical
  rw [orthonormal_iff_ite]
  exact coordinateLp_inner

/-- Independent Gaussian coordinates synthesize every square-summable
coefficient family, by the Hilbert-space orthogonal-series theorem. -/
def synthesis : ℓ²(ι, ℝ) →ₗᵢ[ℝ] Lp ℝ 2 (source ι) :=
  coordinates_orthonormal.orthogonalFamily.linearIsometry

theorem synthesis_hasSum (a : ℓ²(ι, ℝ)) :
    HasSum (fun i ↦ a i • coordinateLp i) (synthesis a) := by
  exact coordinates_orthonormal.orthogonalFamily.hasSum_linearIsometry a

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The isonormal map constructed from a Hilbert basis and the explicit
Gaussian product source. It preserves all inner products. -/
def isonormal (b : HilbertBasis ι ℝ H) : H →ₗᵢ[ℝ] Lp ℝ 2 (source ι) :=
  synthesis.comp b.repr.toLinearIsometry

theorem isonormal_hasSum (b : HilbertBasis ι ℝ H) (x : H) :
    HasSum (fun i ↦ b.repr x i • coordinateLp i) (isonormal b x) :=
  synthesis_hasSum (b.repr x)

theorem integral_eq_inner_one (X : Lp ℝ 2 (source ι)) :
    (∫ ω, X ω ∂source ι) = inner ℝ (Lp.const 2 (source ι) 1) X := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [Lp.coeFn_const (p := 2) (source ι) (1 : ℝ)] with ω hω
  simp [hω]

theorem coordinateLp_mean (i : ι) : (∫ ω, coordinateLp i ω ∂source ι) = 0 := by
  rw [integral_congr_ae (coordinateLp_coe i)]
  exact coordinate_mean i

theorem synthesis_mean (a : ℓ²(ι, ℝ)) :
    (∫ ω, synthesis a ω ∂source ι) = 0 := by
  rw [integral_eq_inner_one]
  have hcont : Continuous (fun X : Lp ℝ 2 (source ι) ↦
      inner ℝ (Lp.const 2 (source ι) 1) X) := continuous_const.inner continuous_id
  have hlim := hcont.continuousAt.tendsto.comp (synthesis_hasSum a)
  have hzero : ∀ s : Finset ι,
      inner ℝ (Lp.const 2 (source ι) 1) (∑ i ∈ s, a i • coordinateLp i) = 0 := by
    intro s
    simp only [inner_sum, real_inner_smul_right, ← integral_eq_inner_one,
      coordinateLp_mean, mul_zero, Finset.sum_const_zero]
  have hz : Tendsto (fun s : Finset ι ↦
      inner ℝ (Lp.const 2 (source ι) 1) (∑ i ∈ s, a i • coordinateLp i))
      atTop (𝓝 0) := by simp only [hzero]; exact tendsto_const_nhds
  exact tendsto_nhds_unique hlim hz

theorem isonormal_mean (b : HilbertBasis ι ℝ H) (x : H) :
    (∫ ω, isonormal b x ω ∂source ι) = 0 :=
  synthesis_mean (b.repr x)

theorem variance_eq_norm_sq (X : Lp ℝ 2 (source ι))
    (hmean : (∫ ω, X ω ∂source ι) = 0) :
    Var[X; source ι] = ‖X‖ ^ 2 := by
  rw [variance_eq_integral (Lp.aestronglyMeasurable X).aemeasurable, hmean]
  simp only [sub_zero]
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  apply integral_congr_ae
  filter_upwards with ω
  simp [pow_two]

theorem partial_sum_coe (a : ι → ℝ) (s : Finset ι) :
    (∑ i ∈ s, a i • coordinateLp i) =ᵐ[source ι]
      fun ω : ι → ℝ ↦ ∑ i ∈ s, a i * ω i := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      filter_upwards [Lp.coeFn_zero ℝ 2 (source ι)] with ω hω
      simpa only [Finset.sum_empty, Pi.zero_apply] using hω
  | @insert i s his ih =>
      rw [Finset.sum_insert his]
      filter_upwards [Lp.coeFn_add (a i • coordinateLp i)
        (∑ j ∈ s, a j • coordinateLp j), Lp.coeFn_smul (a i) (coordinateLp i),
        coordinateLp_coe i, ih] with ω ha hs hi hsum
      simp only [ha, Pi.add_apply, hs, Pi.smul_apply, hi, hsum,
        Finset.sum_insert his, smul_eq_mul]

theorem partial_sum_hasGaussianLaw (a : ι → ℝ) (s : Finset ι) :
    HasGaussianLaw (∑ i ∈ s, a i • coordinateLp i : Lp ℝ 2 (source ι)) (source ι) := by
  classical
  have hi : iIndepFun (fun i : s ↦ fun ω : ι → ℝ ↦ a i * ω i) (source ι) :=
    (coordinates_independent.precomp Subtype.val_injective).comp
      (fun (i : s) (x : ℝ) ↦ a i * x) (by intro i; fun_prop)
  have hg : ∀ i : s, HasGaussianLaw (fun ω : ι → ℝ ↦ a i * ω i) (source ι) := by
    intro i
    exact ((coordinate_hasLaw (i : ι)).hasGaussianLaw).fun_smul (a i)
  have hsum := hi.hasGaussianLaw_fun_sum hg
  have heq : (fun ω : ι → ℝ ↦ ∑ i : s, a i * ω i) =
      (fun ω : ι → ℝ ↦ ∑ i ∈ s, a i * ω i) := by
    funext ω
    exact Finset.sum_coe_sort s (fun i : ι ↦ a i * ω i)
  rw [heq] at hsum
  exact hsum.congr (partial_sum_coe a s).symm

theorem partial_sum_mean (a : ι → ℝ) (s : Finset ι) :
    (∫ ω, (∑ i ∈ s, a i • coordinateLp i : Lp ℝ 2 (source ι)) ω ∂source ι) = 0 := by
  rw [integral_eq_inner_one]
  simp only [inner_sum, real_inner_smul_right, ← integral_eq_inner_one,
    coordinateLp_mean, mul_zero, Finset.sum_const_zero]

theorem partial_sum_hasLaw (a : ι → ℝ) (s : Finset ι) :
    HasLaw (∑ i ∈ s, a i • coordinateLp i : Lp ℝ 2 (source ι))
      (gaussianReal 0 (‖∑ i ∈ s, a i • coordinateLp i‖ ^ 2).toNNReal) (source ι) := by
  have hg := partial_sum_hasGaussianLaw a s
  refine ⟨hg.aemeasurable, ?_⟩
  rw [hg.map_eq_gaussianReal, partial_sum_mean,
    variance_eq_norm_sq _ (partial_sum_mean a s)]

/-- The orthogonal-series limit is genuinely Gaussian, with the variance
equal to the square of its Hilbert norm. This is proved by characteristic
function continuity, rather than postulated as a Gaussian-process input. -/
theorem synthesis_hasLaw (a : ℓ²(ι, ℝ)) :
    HasLaw (synthesis a) (gaussianReal 0 (‖a‖ ^ 2).toNNReal) (source ι) := by
  have h := hasLaw_gaussianReal_of_tendsto_Lp (source ι)
    (fun s : Finset ι ↦ ∑ i ∈ s, a i • coordinateLp i) (synthesis a)
    (synthesis_hasSum a) (partial_sum_hasLaw a)
  simpa only [LinearIsometry.norm_map] using h

theorem isonormal_hasLaw (b : HilbertBasis ι ℝ H) (x : H) :
    HasLaw (isonormal b x) (gaussianReal 0 (‖x‖ ^ 2).toNNReal) (source ι) := by
  change HasLaw (synthesis (b.repr x)) (gaussianReal 0 (‖x‖ ^ 2).toNNReal) (source ι)
  simpa only [LinearIsometryEquiv.norm_map] using synthesis_hasLaw (b.repr x)

theorem isonormal_hasGaussianLaw (b : HilbertBasis ι ℝ H) (x : H) :
    HasGaussianLaw (isonormal b x) (source ι) :=
  (isonormal_hasLaw b x).hasGaussianLaw

theorem isonormal_covariance (b : HilbertBasis ι ℝ H) (x y : H) :
    cov[isonormal b x, isonormal b y; source ι] = inner ℝ x y := by
  unfold covariance
  rw [isonormal_mean, isonormal_mean]
  simp only [sub_zero]
  rw [← (isonormal b).inner_map_map]
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards with ω
  simp [mul_comm]

end GaussianHilbert
end ULA


end
end


/-! ## Included source: UnadjustedLangevin/GaussianLinearProcess.lean -/
section

set_option linter.style.header false

/-!
# Gaussian processes from Gaussian linear maps into L²

A linear map into real L² whose every output has a Gaussian law produces a
Gaussian process along any family of vectors. A finite-dimensional linear
projection is an actual finite linear combination; its chosen L² representative
equals the corresponding scalar random variable almost everywhere.

Only linearity is needed on the source space. In particular this applies to
the Gaussian isometry on a real Hilbert space without extra hypotheses.
-/

noncomputable section
open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace ULA

variable {Ω H ι Time : Type*} [MeasurableSpace Ω]
  [AddCommMonoid H] [Module ℝ H] (P : Measure Ω)

/-- Finite collections of outputs of a Gaussian linear map are jointly
Gaussian, for the actual random-variable representatives of those outputs. -/
theorem hasGaussianLaw_pi_of_linearMap_Lp [Finite ι]
    (T : H →ₗ[ℝ] Lp ℝ 2 P) (hT : ∀ x, HasGaussianLaw (T x) P) (f : ι → H) :
    HasGaussianLaw (fun ω (i : ι) ↦ T (f i) ω) P := by
  classical
  letI := Fintype.ofFinite ι
  have hmeas : AEMeasurable (fun ω (i : ι) ↦ T (f i) ω) P :=
    aemeasurable_pi_iff.mpr fun i ↦ (Lp.aestronglyMeasurable (T (f i))).aemeasurable
  refine ⟨hmeas, isGaussian_of_isGaussian_map fun L ↦ ?_⟩
  let c : ι → ℝ := fun i ↦ L (fun j ↦ if i = j then 1 else 0)
  have hL (x : ι → ℝ) : L x = ∑ i, c i * x i := by
    change L.toLinearMap x = _
    rw [LinearMap.pi_apply_eq_sum_univ L.toLinearMap x]
    exact Finset.sum_congr rfl fun i _ ↦ mul_comm (x i) (c i)
  have hsum : T (∑ i, c i • f i) = ∑ i, c i • T (f i) := by
    simp only [map_sum, map_smul]
  have hprojection : T (∑ i, c i • f i) =ᵐ[P]
      fun ω ↦ L (fun i ↦ T (f i) ω) := by
    rw [hsum]
    have hscalar : ∀ᵐ ω ∂P, ∀ i, (c i • T (f i)) ω = c i * T (f i) ω :=
      ae_all_iff.mpr fun i ↦ Lp.coeFn_smul (c i) (T (f i))
    filter_upwards [Lp.coeFn_fun_finsetSum Finset.univ (fun i ↦ c i • T (f i)),
      hscalar] with ω hcoe hsmul
    rw [hcoe, hL]
    exact Finset.sum_congr rfl fun i _ ↦ hsmul i
  have hprojectedGaussian := (hT (∑ i, c i • f i)).congr hprojection
  rw [AEMeasurable.map_map_of_aemeasurable L.continuous.measurable.aemeasurable hmeas]
  exact hprojectedGaussian.isGaussian_map

/-- Any indexed family of vectors, mapped through a Gaussian linear map into
L², gives a Gaussian process. No continuity or countability of the index set
or of the vector family is required for its finite-dimensional laws. -/
theorem isGaussianProcess_of_linearMap_Lp
    (T : H →ₗ[ℝ] Lp ℝ 2 P) (hT : ∀ x, HasGaussianLaw (T x) P) (f : Time → H) :
    IsGaussianProcess (fun t ω ↦ T (f t) ω) P where
  hasGaussianLaw I := hasGaussianLaw_pi_of_linearMap_Lp P T hT (fun i : I ↦ f i)

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/CanonicalBrownian.lean -/
section

set_option linter.style.header false

/-! # A constructed Brownian source

The time indicators `1_(0,t]` live in the real Hilbert space L² of Lebesgue
measure. Their inner products are `min s t`. The isonormal Gaussian map
constructed from an independent Gaussian product therefore gives a concrete
centered Gaussian process with the Brownian covariance. No Brownian-existence
assumption is made in this construction.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped ENNReal NNReal

namespace ULA.CanonicalBrownian

abbrev TimeHilbert := Lp ℝ 2 (volume : Measure ℝ)

def timeIndicator (t : ℝ≥0) : TimeHilbert :=
  indicatorConstLp 2 measurableSet_Ioc
    (by simp only [Real.volume_Ioc, ne_eq, ENNReal.ofReal_ne_top, not_false_eq_true]) (1 : ℝ)
    (s := Ioc 0 (t : ℝ))

theorem timeIndicator_inner (s t : ℝ≥0) :
    inner ℝ (timeIndicator s) (timeIndicator t) = min (s : ℝ) (t : ℝ) := by
  have hi := L2.real_inner_indicatorConstLp_one_indicatorConstLp_one
    (μ := (volume : Measure ℝ))
    (s := Ioc 0 (s : ℝ)) (t := Ioc 0 (t : ℝ))
    measurableSet_Ioc measurableSet_Ioc
    (hμs := by simp [Real.volume_Ioc]) (hμt := by simp [Real.volume_Ioc])
  change inner ℝ (timeIndicator s) (timeIndicator t) = _ at hi
  rw [hi]
  simp only [Measure.real, Ioc_inter_Ioc, max_self, Real.volume_Ioc, sub_zero]
  rw [ENNReal.toReal_ofReal (le_min s.coe_nonneg t.coe_nonneg)]

def basisIndex : Set TimeHilbert :=
  Classical.choose (exists_hilbertBasis (𝕜 := ℝ) (E := TimeHilbert))

def basis : HilbertBasis basisIndex ℝ TimeHilbert :=
  Classical.choose (Classical.choose_spec
    (exists_hilbertBasis (𝕜 := ℝ) (E := TimeHilbert)))

abbrev Sample := basisIndex → ℝ

abbrev probability : Measure Sample := GaussianHilbert.source basisIndex

instance : IsProbabilityMeasure probability :=
  GaussianHilbert.source_isProbabilityMeasure basisIndex

def valueLp (t : ℝ≥0) : Lp ℝ 2 probability :=
  GaussianHilbert.isonormal basis (timeIndicator t)

/-- A particular strongly measurable representative at every time. -/
def process (t : ℝ≥0) : Sample → ℝ := valueLp t

theorem process_measurable (t : ℝ≥0) : Measurable (process t) :=
  (Lp.stronglyMeasurable (valueLp t)).measurable

theorem process_mean (t : ℝ≥0) : (∫ ω, process t ω ∂probability) = 0 :=
  GaussianHilbert.isonormal_mean basis (timeIndicator t)

theorem process_covariance (s t : ℝ≥0) :
    cov[process s, process t; probability] = min (s : ℝ) (t : ℝ) := by
  rw [process, process, valueLp, valueLp,
    GaussianHilbert.isonormal_covariance, timeIndicator_inner]

theorem isGaussianProcess : IsGaussianProcess process probability := by
  exact isGaussianProcess_of_linearMap_Lp probability
    (GaussianHilbert.isonormal basis).toLinearMap
    (GaussianHilbert.isonormal_hasGaussianLaw basis) timeIndicator

/-- Brownian finite-dimensional laws on the explicitly constructed source. -/
theorem isPreBrownian : IsPreBrownianReal process probability := by
  apply isGaussianProcess.isPreBrownianReal_of_covariance process_mean
  intro s t hst
  rw [process_covariance, min_eq_left (by exact_mod_cast hst)]

abbrev VectorSample (I : Type*) := I → Sample

def vectorProbability (I : Type*) : Measure (VectorSample I) :=
  Measure.infinitePi (fun _ : I ↦ probability)

instance (I : Type*) : IsProbabilityMeasure (vectorProbability I) := by
  unfold vectorProbability
  infer_instance

def coordinate {I : Type*} (i : I) (t : ℝ≥0) (ω : VectorSample I) : ℝ :=
  process t (ω i)

/-- Every vector coordinate has the constructed Brownian law. -/
theorem coordinate_isPreBrownian {I : Type*} (i : I) :
    IsPreBrownianReal (coordinate i) (vectorProbability I) where
  hasLaw s := (isPreBrownian.hasLaw s).comp
    (⟨(measurable_pi_apply i).aemeasurable,
      Measure.infinitePi_map_eval (fun _ : I ↦ probability) i⟩ :
      HasLaw (fun ω : VectorSample I ↦ ω i) probability (vectorProbability I))

/-- Entire coordinate paths are independent on the actual product source. -/
theorem coordinate_paths_independent (I : Type*) :
    iIndepFun (fun i (ω : VectorSample I) t ↦ coordinate i t ω)
      (vectorProbability I) := by
  exact iIndepFun_infinitePi (fun _ : I ↦
    measurable_pi_iff.mpr process_measurable)

/-- Restricting the independent coordinate paths to any time grid preserves
independence; this is the form required by the Gaussian Euler algorithm. -/
theorem coordinate_grid_paths_independent (I : Type*) (h : ℝ≥0) :
    iIndepFun (fun i (ω : VectorSample I) (n : ℕ) ↦
      coordinate i ((n : ℝ≥0) * h) ω) (vectorProbability I) := by
  exact (coordinate_paths_independent I).comp
    (fun _ p (n : ℕ) ↦ p ((n : ℝ≥0) * h))
    (fun _ ↦ measurable_pi_iff.mpr fun n ↦ measurable_pi_apply _)

end ULA.CanonicalBrownian


end
end


/-! ## Included source: UnadjustedLangevin/LangevinUniqueness.lean -/
section

set_option linter.style.header false

/-!
# Uniqueness and initial-state stability of the additive Langevin equation

Common additive noise cancels between two integral solutions. Their difference
is therefore differentiable even when the noise is only continuous. Grönwall
bounds its norm and proves uniqueness on every finite horizon, without a
small-time condition. Together with `LangevinIntegral.lean` this establishes
existence and uniqueness in the Banach space, including the actual `L²` drift.
No stationary-law or Gibbs-invariance assertion is made.
-/

noncomputable section

open MeasureTheory Set Filter
open scoped NNReal Topology

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]

/-- Two continuous solutions with the same additive input depend at most
exponentially on their initial values. Noise derivatives and a small-time
restriction are unnecessary. -/
theorem langevin_integral_stability
    (g : H → H) (L : ℝ≥0) (hLip : LipschitzWith L g)
    (x y : H) (B Y Z : ℝ → H) (hY : Continuous Y) (hZ : Continuous Z)
    (h : ℝ) (hh : 0 ≤ h)
    (hYe : ∀ t ∈ Icc 0 h, Y t - x = -(∫ s in 0..t, g (Y s)) + B t)
    (hZe : ∀ t ∈ Icc 0 h, Z t - y = -(∫ s in 0..t, g (Z s)) + B t) :
    ∀ t ∈ Icc 0 h, ‖Y t - Z t‖ ≤ ‖x - y‖ * Real.exp ((L : ℝ) * t) := by
  let D : ℝ → H := fun t ↦ Y t - Z t
  let F : ℝ → H := fun t ↦ (x - y) -
    ((∫ s in 0..t, g (Y s)) - ∫ s in 0..t, g (Z s))
  have hD : ∀ t ∈ Icc 0 h, D t = F t := by
    intro t ht
    have hy := hYe t ht
    have hz := hZe t ht
    dsimp [D, F]
    rw [sub_eq_iff_eq_add] at hy hz
    rw [hy, hz]
    abel
  have hcY : Continuous (fun s ↦ g (Y s)) := hLip.continuous.comp hY
  have hcZ : Continuous (fun s ↦ g (Z s)) := hLip.continuous.comp hZ
  have hderiv : ∀ t ∈ Ico 0 h,
      HasDerivWithinAt D (-(g (Y t) - g (Z t))) (Ici t) t := by
    intro t ht
    have hiY := intervalIntegral.integral_hasDerivAt_right
      (hcY.intervalIntegrable 0 t) (hcY.stronglyMeasurableAtFilter volume (𝓝 t)) hcY.continuousAt
    have hiZ := intervalIntegral.integral_hasDerivAt_right
      (hcZ.intervalIntegrable 0 t) (hcZ.stronglyMeasurableAtFilter volume (𝓝 t)) hcZ.continuousAt
    have hf : HasDerivAt F (-(g (Y t) - g (Z t))) t := by
      convert (hasDerivAt_const t (x - y)).sub (hiY.sub hiZ) using 1
      simp
    have hevent : D =ᶠ[𝓝[Ici t] t] F := by
      filter_upwards [self_mem_nhdsWithin,
        nhdsWithin_le_nhds (Iio_mem_nhds ht.2)] with s hst hsh
      exact hD s ⟨ht.1.trans hst, hsh.le⟩
    exact hf.hasDerivWithinAt.congr_of_eventuallyEq hevent (hD t ⟨ht.1, ht.2.le⟩)
  have hD0 : D 0 = x - y := by
    simpa only [F, intervalIntegral.integral_same, sub_self, sub_zero] using
      hD 0 ⟨le_rfl, hh⟩
  have hb (t : ℝ) (_ht : t ∈ Ico 0 h) :
      ‖-(g (Y t) - g (Z t))‖ ≤ (L : ℝ) * ‖D t‖ + 0 := by
    simpa only [norm_neg, D, add_zero] using hLip.norm_sub_le (Y t) (Z t)
  have hg := norm_le_gronwallBound_of_norm_deriv_right_le
    (f := D) (f' := fun t ↦ -(g (Y t) - g (Z t)))
    (δ := ‖x - y‖) (K := (L : ℝ)) (ε := 0)
    (hY.sub hZ).continuousOn hderiv (by rw [hD0]) hb
  intro t ht
  simpa only [D, gronwallBound_ε0, sub_zero] using hg t ht

/-- A continuous solution with a fixed initial state and additive input is
unique on the entire finite interval. -/
theorem langevin_integral_unique
    (g : H → H) (L : ℝ≥0) (hLip : LipschitzWith L g)
    (x : H) (B Y Z : ℝ → H) (hY : Continuous Y) (hZ : Continuous Z)
    (h : ℝ) (hh : 0 ≤ h)
    (hYe : ∀ t ∈ Icc 0 h, Y t - x = -(∫ s in 0..t, g (Y s)) + B t)
    (hZe : ∀ t ∈ Icc 0 h, Z t - x = -(∫ s in 0..t, g (Z s)) + B t) :
    EqOn Y Z (Icc 0 h) := by
  intro t ht
  have hb := langevin_integral_stability g L hLip x x B Y Z hY hZ h hh hYe hZe t ht
  simpa only [sub_self, norm_zero, zero_mul, norm_le_zero_iff, sub_eq_zero] using hb

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
  {K : Type*} [NormedAddCommGroup K] [InnerProductSpace ℝ K] [CompleteSpace K]

/-- Initial-state stability for the actual square-integrable gradient drift. -/
theorem lp_langevin_integral_stability
    (U : K → ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (initial₁ initial₂ : Lp K 2 P) (B Y Z : ℝ → Lp K 2 P)
    (hY : Continuous Y) (hZ : Continuous Z) (h : ℝ) (hh : 0 ≤ h)
    (hYe : ∀ t ∈ Icc 0 h, Y t - initial₁ =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) + B t)
    (hZe : ∀ t ∈ Icc 0 h, Z t - initial₂ =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Z s)) + B t) :
    ∀ t ∈ Icc 0 h,
      ‖Y t - Z t‖ ≤ ‖initial₁ - initial₂‖ * Real.exp ((L : ℝ) * t) :=
  langevin_integral_stability (lpDrift P (gradient U) hLip) L
    (lpDrift_lipschitz P (gradient U) hLip) initial₁ initial₂ B Y Z hY hZ h hh hYe hZe

/-- Uniqueness of the actual `L²` Langevin integral solution with common initial
state and noise, on any finite nonnegative time interval. -/
theorem lp_langevin_integral_unique
    (U : K → ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (initial : Lp K 2 P) (B Y Z : ℝ → Lp K 2 P)
    (hY : Continuous Y) (hZ : Continuous Z) (h : ℝ) (hh : 0 ≤ h)
    (hYe : ∀ t ∈ Icc 0 h, Y t - initial =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) + B t)
    (hZe : ∀ t ∈ Icc 0 h, Z t - initial =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Z s)) + B t) :
    EqOn Y Z (Icc 0 h) :=
  langevin_integral_unique (lpDrift P (gradient U) hLip) L
    (lpDrift_lipschitz P (gradient U) hLip) initial B Y Z hY hZ h hh hYe hZe

end ULA


end
