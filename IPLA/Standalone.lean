section

/-! Supporting-plane inequalities and strong gradient monotonicity.
See `StrongConvexity.tex` for the corresponding mathematical proof. -/

noncomputable section

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Convexity bounds each secant below by the directional derivative at its starting point. -/
lemma convex_first_order {f : H → ℝ} (hf : ConvexOn ℝ Set.univ f)
    (hdiff : Differentiable ℝ f) (x y : H) :
    f x + fderiv ℝ f x (y - x) ≤ f y := by
  let line : ℝ →ᵃ[ℝ] H := AffineMap.lineMap x y
  have hc : ConvexOn ℝ Set.univ (f ∘ line) := by
    simpa [line] using hf.comp_affineMap line
  have hl : HasDerivAt line (y - x) 0 := by
    change HasDerivAt (fun t : ℝ ↦ t • (y - x) + x) (y - x) 0
    simpa using
      ((hasDerivAt_id (0 : ℝ)).smul_const (y - x)).add_const x
  have hd : HasDerivAt (f ∘ line) (fderiv ℝ f x (y - x)) 0 := by
    exact (hdiff x).hasFDerivAt.comp_hasDerivAt_of_eq 0 hl (by simp [line])
  have hs := hc.le_slope_of_hasDerivAt (Set.mem_univ 0) (Set.mem_univ 1)
    (zero_lt_one : (0 : ℝ) < 1) hd
  simp only [slope_def_field, Function.comp_apply, line, AffineMap.lineMap_apply_one,
    AffineMap.lineMap_apply_zero, sub_zero, div_one] at hs
  linarith

/-- Strong convexity makes the gradient strongly monotone. -/
lemma strong_gradient_monotone [CompleteSpace H] {f : H → ℝ} {m : ℝ}
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f) (x y : H) :
    m * ‖x - y‖ ^ 2 ≤ inner ℝ (gradient f x - gradient f y) (x - y) := by
  let g : H → ℝ := fun v ↦ f v - m / 2 * ‖v‖ ^ 2
  have hc : ConvexOn ℝ Set.univ g := strongConvexOn_iff_convex.mp hsc
  have hg (v : H) : HasFDerivAt g
      (fderiv ℝ f v - (m / 2) • (2 • innerSL ℝ v)) v := by
    exact (hdiff v).hasFDerivAt.sub
      ((hasStrictFDerivAt_norm_sq v).hasFDerivAt.const_mul (m / 2))
  have hgd : Differentiable ℝ g := fun v ↦ (hg v).differentiableAt
  have hxy := convex_first_order hc hgd x y
  have hyx := convex_first_order hc hgd y x
  rw [(hg x).fderiv] at hxy
  rw [(hg y).fderiv] at hyx
  simp only [g, sub_apply, smul_apply,
    smul_eq_mul, innerSL_apply_apply, ← inner_gradient_left] at hxy hyx
  rw [inner_sub_left, inner_sub_right, inner_sub_right]
  rw [norm_sub_sq_real]
  simp only [inner_sub_right, real_inner_self_eq_norm_sq, two_smul,
    real_inner_comm] at hxy hyx ⊢
  nlinarith

/-- The supporting-plane inequality associated with `m`-strong convexity.
This shared form supplies both sharp ULA contraction and Gibbs tail bounds. -/
lemma strong_first_order [CompleteSpace H] {f : H → ℝ} {m : ℝ}
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f) (x y : H) :
    f x + inner ℝ (gradient f x) (y - x) + m / 2 * ‖y - x‖ ^ 2 ≤ f y := by
  let g : H → ℝ := fun v ↦ f v - m / 2 * ‖v‖ ^ 2
  have hc : ConvexOn ℝ Set.univ g := strongConvexOn_iff_convex.mp hsc
  have hg (v : H) : HasFDerivAt g
      (fderiv ℝ f v - (m / 2) • (2 • innerSL ℝ v)) v := by
    exact (hdiff v).hasFDerivAt.sub
      ((hasStrictFDerivAt_norm_sq v).hasFDerivAt.const_mul (m / 2))
  have hgd : Differentiable ℝ g := fun v ↦ (hg v).differentiableAt
  have hxy := convex_first_order hc hgd x y
  rw [(hg x).fderiv] at hxy
  simp only [g, sub_apply, smul_apply, smul_eq_mul, innerSL_apply_apply,
    ← inner_gradient_left, inner_sub_right, real_inner_self_eq_norm_sq,
    two_smul, add_apply] at hxy
  rw [norm_sub_sq_real]
  simp only [inner_sub_right, real_inner_comm] at hxy ⊢
  nlinarith

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/GradientStep.lean -/
section

/-! Squared and square-root bounds for a strongly monotone Lipschitz Euler step.
See `GradientStep.tex` for the corresponding mathematical proof. -/

open scoped NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Monotonicity and Lipschitz bounds control squared distance after one Euler step. -/
theorem gradient_step_sq_bound
    (x y gx gy : H) (m h : ℝ) (L : ℝ≥0) (hh : 0 ≤ h)
    (hmono : m * ‖x - y‖ ^ 2 ≤ inner ℝ (gx - gy) (x - y))
    (hLip : ‖gx - gy‖ ≤ (L : ℝ) * ‖x - y‖) :
    ‖(x - h • gx) - (y - h • gy)‖ ^ 2 ≤
      (1 - 2 * h * m + h ^ 2 * (L : ℝ) ^ 2) * ‖x - y‖ ^ 2 := by
  have hLipSq : ‖gx - gy‖ ^ 2 ≤ (L : ℝ) ^ 2 * ‖x - y‖ ^ 2 := by
    nlinarith [norm_nonneg (gx - gy), norm_nonneg (x - y), L.coe_nonneg]
  have hmonoScaled := mul_le_mul_of_nonneg_left hmono (show 0 ≤ 2 * h by positivity)
  have hLipScaled := mul_le_mul_of_nonneg_left hLipSq (sq_nonneg h)
  rw [show (x - h • gx) - (y - h • gy) = (x - y) - h • (gx - gy) by module,
    norm_sub_sq_real, real_inner_smul_right, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg hh, ← real_inner_comm (x - y) (gx - gy)]
  nlinarith

/-- One Euler step satisfies the usual square-root norm bound; the coefficient
need not be assumed nonnegative. -/
theorem gradient_step_contract
    (x y gx gy : H) (m h : ℝ) (L : ℝ≥0) (hh : 0 ≤ h)
    (hmono : m * ‖x - y‖ ^ 2 ≤ inner ℝ (gx - gy) (x - y))
    (hLip : ‖gx - gy‖ ≤ (L : ℝ) * ‖x - y‖) :
    ‖(x - h • gx) - (y - h • gy)‖ ≤
      Real.sqrt (1 - 2 * h * m + h ^ 2 * (L : ℝ) ^ 2) * ‖x - y‖ := by
  have hsq := gradient_step_sq_bound x y gx gy m h L hh hmono hLip
  have hbound := Real.le_sqrt_of_sq_le hsq
  rwa [Real.sqrt_mul' _ (sq_nonneg _), Real.sqrt_sq (norm_nonneg _)] at hbound

end ULA


end


/-! ## Included source: UnadjustedLangevin/ULAupdate.lean -/
section

/-! Shared-noise bounds for one step of the unadjusted Langevin algorithm.
See `ULAupdate.tex` for the corresponding mathematical proof. -/

noncomputable section

open scoped NNReal

/-- The Euclidean state space of dimension `d`. -/
abbrev E (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- One ULA step `x ↦ x - h ∇U(x) + √(2h) z`, with noise vector `z`. -/
def ulaUpdate {d : ℕ} (U : E d → ℝ) (h : ℝ) (x z : E d) : E d :=
  x - h • gradient U x + Real.sqrt (2 * h) • z

/-- Shared noise cancels from the difference of two ULA updates. -/
lemma ulaUpdate_sub {d : ℕ} (U : E d → ℝ) (h : ℝ) (x y z : E d) :
    ulaUpdate U h x z - ulaUpdate U h y z =
      (x - h • gradient U x) - (y - h • gradient U y) := by
  simp only [ulaUpdate, add_sub_add_right_eq_sub]

/--
Shared-noise norm bound for one ULA step with a differentiable,
`m`-strongly convex potential and `L`-Lipschitz gradient:

    ‖X' - Y'‖
      ≤ √(1 - 2hm + h²L²) ‖x - y‖.

This is the deterministic contraction lemma underlying the
standard synchronous-coupling Wasserstein argument.
The bound is strictly contractive when `h > 0` and `h * L² < 2m`.
-/
theorem ula_shared_noise_contract {d : ℕ} (U : E d → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U)
    (hsm : LipschitzWith L (gradient U))
    (hh : 0 ≤ h)
    (x y z : E d) :
    ‖ulaUpdate U h x z - ulaUpdate U h y z‖ ≤
      Real.sqrt (1 - 2 * h * m + h ^ 2 * (L : ℝ) ^ 2) * ‖x - y‖ := by
  rw [ulaUpdate_sub]
  exact ULA.gradient_step_contract x y (gradient U x) (gradient U y) m h L hh
    (ULA.strong_gradient_monotone hdiff hsc x y)
    (by simpa only [dist_eq_norm] using hsm.dist_le_mul x y)


end
end


/-! ## Included source: UnadjustedLangevin/SharpContraction.lean -/
section

/-!
# Dalalyan's sharp deterministic contraction

The Lipschitz-gradient and strong-convexity hypotheses imply a stronger
interpolation inequality than strong monotonicity alone. That inequality gives
the factors `1 - m*h` and `L*h - 1` in the two step-size regimes.
-/

noncomputable section

open scoped NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- A quadratic upper model and supporting planes imply cocoercivity.
The vector field need not be separately assumed to be a gradient: the two
model inequalities contain all the information needed by this proof. -/
theorem cocoercive_of_quadratic_models (f : H → ℝ) (g : H → H) (K : ℝ)
    (hK : 0 ≤ K)
    (hlower : ∀ x y, f x + inner ℝ (g x) (y - x) ≤ f y)
    (hupper : ∀ x y,
      f y ≤ f x + inner ℝ (g x) (y - x) + K / 2 * ‖y - x‖ ^ 2)
    (x y : H) :
    ‖g x - g y‖ ^ 2 ≤ K * inner ℝ (g x - g y) (x - y) := by
  have hbregman (a b : H) (t : ℝ) (ht : 0 ≤ t) :
      t * ‖g a - g b‖ ^ 2 - K / 2 * t ^ 2 * ‖g a - g b‖ ^ 2 ≤
        f a - f b - inner ℝ (g b) (a - b) := by
    let z := a - t • (g a - g b)
    have hl := hlower b z
    have hu := hupper a z
    have hz₁ : z - a = -t • (g a - g b) := by dsimp [z]; module
    have hz₂ : z - b = (a - b) - t • (g a - g b) := by dsimp [z]; module
    rw [hz₂, inner_sub_right, real_inner_smul_right] at hl
    rw [hz₁, real_inner_smul_right, norm_smul, Real.norm_eq_abs,
      abs_neg, abs_of_nonneg ht] at hu
    have hi : inner ℝ (g a) (g a - g b) - inner ℝ (g b) (g a - g b) =
        ‖g a - g b‖ ^ 2 := by
      rw [← inner_sub_left, real_inner_self_eq_norm_sq]
    nlinarith
  have hsum (t : ℝ) (ht : 0 ≤ t) :
      2 * t * ‖g x - g y‖ ^ 2 - K * t ^ 2 * ‖g x - g y‖ ^ 2 ≤
        inner ℝ (g x - g y) (x - y) := by
    have hxy := hbregman x y t ht
    have hyx := hbregman y x t ht
    rw [norm_sub_rev] at hyx
    rw [← neg_sub x y, inner_neg_right] at hyx
    rw [inner_sub_left]
    linarith
  rcases hK.eq_or_lt with hzero | hpos
  · subst K
    have h := hsum 1 (by norm_num)
    have hmono : 0 ≤ inner ℝ (g x - g y) (x - y) := by
      nlinarith [sq_nonneg ‖g x - g y‖]
    by_contra hn
    have hnpos : 0 < ‖g x - g y‖ ^ 2 := by
      simp only [zero_mul] at hn
      exact lt_of_not_ge hn
    have hh := hsum
      ((inner ℝ (g x - g y) (x - y) + 1) / (2 * ‖g x - g y‖ ^ 2))
      (by positivity)
    have heq : 2 * ((inner ℝ (g x - g y) (x - y) + 1) /
        (2 * ‖g x - g y‖ ^ 2)) * ‖g x - g y‖ ^ 2 =
        inner ℝ (g x - g y) (x - y) + 1 := by
      have hnorm : ‖g x - g y‖ ≠ 0 := by
        intro hz
        simp only [hz, zero_pow (by norm_num : 2 ≠ 0)] at hnpos
        linarith
      field_simp [hnorm]
    simp only [zero_mul, sub_zero] at hh
    rw [heq] at hh
    linarith
  · have h := hsum K⁻¹ (inv_nonneg.mpr hpos.le)
    have hmul := mul_le_mul_of_nonneg_left h hpos.le
    have hne : K ≠ 0 := ne_of_gt hpos
    field_simp at hmul
    nlinarith

/-- Strong convexity and a Lipschitz gradient give the strong-smooth
interpolation inequality, including the boundary case `m = L`. -/
theorem strong_smooth_gradient_interpolation [CompleteSpace H]
    (f : H → ℝ) (m : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f)
    (hLip : LipschitzWith L (gradient f)) (hmL : m ≤ (L : ℝ)) (x y : H) :
    m * (L : ℝ) * ‖x - y‖ ^ 2 + ‖gradient f x - gradient f y‖ ^ 2 ≤
      (m + (L : ℝ)) * inner ℝ (gradient f x - gradient f y) (x - y) := by
  let F : H → ℝ := fun v ↦ f v - m / 2 * ‖v‖ ^ 2
  let G : H → H := fun v ↦ gradient f v - m • v
  have hlower (a b : H) : F a + inner ℝ (G a) (b - a) ≤ F b := by
    have h := strong_first_order hdiff hsc a b
    dsimp [F, G]
    simp only [inner_sub_left, real_inner_smul_left, inner_sub_right,
      real_inner_self_eq_norm_sq] at h ⊢
    rw [norm_sub_sq_real, real_inner_comm a b] at h
    nlinarith
  have hupper (a b : H) :
      F b ≤ F a + inner ℝ (G a) (b - a) + ((L : ℝ) - m) / 2 * ‖b - a‖ ^ 2 := by
    have h := Analysis.smooth_upper_bound f L hdiff hLip a b
    dsimp [F, G]
    simp only [inner_sub_left, real_inner_smul_left, inner_sub_right,
      real_inner_self_eq_norm_sq] at h ⊢
    rw [norm_sub_sq_real]
    rw [norm_sub_sq_real, real_inner_comm a b] at h
    rw [real_inner_comm a b]
    nlinarith
  have hc := cocoercive_of_quadratic_models F G ((L : ℝ) - m)
    (sub_nonneg.mpr hmL) hlower hupper x y
  have hG : G x - G y = (gradient f x - gradient f y) - m • (x - y) := by
    dsimp [G]
    module
  rw [hG, norm_sub_sq_real] at hc
  simp only [inner_sub_left, real_inner_smul_left, real_inner_smul_right,
    norm_smul, Real.norm_eq_abs, mul_pow,
    sq_abs] at hc ⊢
  have hinner : inner ℝ x (x - y) - inner ℝ y (x - y) = ‖x - y‖ ^ 2 := by
    rw [← inner_sub_left, real_inner_self_eq_norm_sq]
  rw [hinner] at hc
  nlinarith

/-- The interpolation inequality places the gradient difference in a ball
centered at `(m+L)/2` times the point difference. -/
theorem gradient_difference_centered_bound
    (x y gx gy : H) (m L : ℝ) (hmL : m ≤ L)
    (hinterp : m * L * ‖x - y‖ ^ 2 + ‖gx - gy‖ ^ 2 ≤
      (m + L) * inner ℝ (gx - gy) (x - y)) :
    ‖(gx - gy) - ((m + L) / 2) • (x - y)‖ ≤
      ((L - m) / 2) * ‖x - y‖ := by
  have hrad : 0 ≤ (L - m) / 2 := by linarith
  apply (sq_le_sq₀ (norm_nonneg _)
    (mul_nonneg hrad (norm_nonneg _))).mp
  rw [norm_sub_sq_real, real_inner_smul_right, norm_smul,
    Real.norm_eq_abs, mul_pow, sq_abs, mul_pow]
  nlinarith

/-- A sharp Euler bound, written using the midpoint of the curvature interval.
Splitting the absolute value gives Dalalyan's two step-size regimes. -/
theorem gradient_step_centered_contract
    (x y gx gy : H) (m L h : ℝ) (hmL : m ≤ L) (hh : 0 ≤ h)
    (hinterp : m * L * ‖x - y‖ ^ 2 + ‖gx - gy‖ ^ 2 ≤
      (m + L) * inner ℝ (gx - gy) (x - y)) :
    ‖(x - h • gx) - (y - h • gy)‖ ≤
      (|1 - h * ((m + L) / 2)| + h * ((L - m) / 2)) * ‖x - y‖ := by
  have hc := gradient_difference_centered_bound x y gx gy m L hmL hinterp
  have heq : (x - h • gx) - (y - h • gy) =
      (1 - h * ((m + L) / 2)) • (x - y) +
        (-h) • ((gx - gy) - ((m + L) / 2) • (x - y)) := by module
  rw [heq]
  have htri := norm_add_le
    ((1 - h * ((m + L) / 2)) • (x - y))
    ((-h) • ((gx - gy) - ((m + L) / 2) • (x - y)))
  simp only [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg hh] at htri
  have hscaled := mul_le_mul_of_nonneg_left hc hh
  nlinarith

/-- Dalalyan's sharp factor `1-mh` for `h ≤ 2/(m+L)`. -/
theorem gradient_step_sharp_contract_small
    (x y gx gy : H) (m L h : ℝ) (hmL : m ≤ L) (hpos : 0 < m + L)
    (hh : 0 ≤ h) (hsmall : h ≤ 2 / (m + L))
    (hinterp : m * L * ‖x - y‖ ^ 2 + ‖gx - gy‖ ^ 2 ≤
      (m + L) * inner ℝ (gx - gy) (x - y)) :
    ‖(x - h • gx) - (y - h • gy)‖ ≤ (1 - m * h) * ‖x - y‖ := by
  have hc := gradient_step_centered_contract x y gx gy m L h hmL hh hinterp
  have hs : h * (m + L) ≤ 2 := (le_div_iff₀ hpos).mp hsmall
  rw [abs_of_nonneg (show 0 ≤ 1 - h * ((m + L) / 2) by nlinarith)] at hc
  convert hc using 1
  ring

/-- Dalalyan's sharp factor `Lh-1` for `h ≥ 2/(m+L)`. -/
theorem gradient_step_sharp_contract_large
    (x y gx gy : H) (m L h : ℝ) (hmL : m ≤ L) (hpos : 0 < m + L)
    (hh : 0 ≤ h) (hlarge : 2 / (m + L) ≤ h)
    (hinterp : m * L * ‖x - y‖ ^ 2 + ‖gx - gy‖ ^ 2 ≤
      (m + L) * inner ℝ (gx - gy) (x - y)) :
    ‖(x - h • gx) - (y - h • gy)‖ ≤ (L * h - 1) * ‖x - y‖ := by
  have hc := gradient_step_centered_contract x y gx gy m L h hmL hh hinterp
  have hs : 2 ≤ h * (m + L) := (div_le_iff₀ hpos).mp hlarge
  rw [abs_of_nonpos (show 1 - h * ((m + L) / 2) ≤ 0 by nlinarith)] at hc
  convert hc using 1
  ring

/-- Sharp gradient-step contraction derived entirely from the potential's
strong convexity and Lipschitz gradient, in the small-step regime. -/
theorem strong_smooth_gradient_step_contract [CompleteSpace H]
    (f : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f)
    (hLip : LipschitzWith L (gradient f)) (hmL : m ≤ (L : ℝ))
    (hpos : 0 < m + (L : ℝ)) (hh : 0 ≤ h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (x y : H) :
    ‖(x - h • gradient f x) - (y - h • gradient f y)‖ ≤
      (1 - m * h) * ‖x - y‖ := by
  exact gradient_step_sharp_contract_small x y (gradient f x) (gradient f y)
    m L h hmL hpos hh hsmall
    (strong_smooth_gradient_interpolation f m L hdiff hsc hLip hmL x y)

/-- The large-step branch of the sharp potential-based contraction. -/
theorem strong_smooth_gradient_step_contract_large [CompleteSpace H]
    (f : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f)
    (hLip : LipschitzWith L (gradient f)) (hmL : m ≤ (L : ℝ))
    (hpos : 0 < m + (L : ℝ)) (hh : 0 ≤ h) (hlarge : 2 / (m + (L : ℝ)) ≤ h)
    (x y : H) :
    ‖(x - h • gradient f x) - (y - h • gradient f y)‖ ≤
      ((L : ℝ) * h - 1) * ‖x - y‖ := by
  exact gradient_step_sharp_contract_large x y (gradient f x) (gradient f y)
    m L h hmL hpos hh hlarge
    (strong_smooth_gradient_interpolation f m L hdiff hsc hLip hmL x y)

/-- The two sharp branches can be expressed by the familiar maximum of the
absolute endpoint factors. -/
theorem strong_smooth_gradient_step_contract_max [CompleteSpace H]
    (f : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f)
    (hLip : LipschitzWith L (gradient f)) (hmL : m ≤ (L : ℝ))
    (hpos : 0 < m + (L : ℝ)) (hh : 0 ≤ h) (x y : H) :
    ‖(x - h • gradient f x) - (y - h • gradient f y)‖ ≤
      max |1 - m * h| |1 - (L : ℝ) * h| * ‖x - y‖ := by
  by_cases hs : h ≤ 2 / (m + (L : ℝ))
  · have hc := strong_smooth_gradient_step_contract f m h L hdiff hsc hLip
      hmL hpos hh hs x y
    exact hc.trans (mul_le_mul_of_nonneg_right
      ((le_abs_self _).trans (le_max_left _ _)) (norm_nonneg _))
  · have hc := strong_smooth_gradient_step_contract_large f m h L hdiff hsc hLip
      hmL hpos hh (le_of_lt (lt_of_not_ge hs)) x y
    have hfactor : (L : ℝ) * h - 1 ≤ |1 - (L : ℝ) * h| := by
      have ht := neg_le_abs (1 - (L : ℝ) * h)
      linarith
    exact hc.trans (mul_le_mul_of_nonneg_right
      (hfactor.trans (le_max_right _ _)) (norm_nonneg _))

/-- Shared Gaussian noise cancels, so one ULA step has the sharp small-step
factor `1-mh`. The statement holds for every vector of noise. -/
theorem ula_shared_noise_contract_sharp {d : ℕ}
    (f : E d → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f)
    (hLip : LipschitzWith L (gradient f)) (hmL : m ≤ (L : ℝ))
    (hpos : 0 < m + (L : ℝ)) (hh : 0 ≤ h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (x y z : E d) :
    ‖ulaUpdate f h x z - ulaUpdate f h y z‖ ≤ (1 - m * h) * ‖x - y‖ := by
  rw [ulaUpdate_sub]
  exact strong_smooth_gradient_step_contract f m h L hdiff hsc hLip
    hmL hpos hh hsmall x y

/-- The sharp large-step shared-noise factor is `Lh-1`. -/
theorem ula_shared_noise_contract_sharp_large {d : ℕ}
    (f : E d → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ f) (hsc : StrongConvexOn Set.univ m f)
    (hLip : LipschitzWith L (gradient f)) (hmL : m ≤ (L : ℝ))
    (hpos : 0 < m + (L : ℝ)) (hh : 0 ≤ h) (hlarge : 2 / (m + (L : ℝ)) ≤ h)
    (x y z : E d) :
    ‖ulaUpdate f h x z - ulaUpdate f h y z‖ ≤ ((L : ℝ) * h - 1) * ‖x - y‖ := by
  rw [ulaUpdate_sub]
  exact strong_smooth_gradient_step_contract_large f m h L hdiff hsc hLip
    hmL hpos hh hlarge x y

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/LocalError.lean -/
section

/-!
# The local Euler defect in Dalalyan's synchronous-coupling proof

All integrals below are Bochner integrals. The ambient Banach space can be
the space of square-integrable random variables: its norm then is the L² norm.
The estimates are derived from the integral equation, rather than assumed as
an error recurrence. Existence and stationarity of a solution are separate
probabilistic obligations, not assertions of this file.
-/

noncomputable section

open MeasureTheory
open scoped NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]

/-- The drift integral omitted by a single Euler step. -/
def localDefect (g : H → H) (Y : ℝ → H) (h : ℝ) : H :=
  ∫ t in 0..h, g (Y t) - g (Y 0)

/-- The local defect is the exact drift integral minus its Euler approximation. -/
theorem localDefect_eq_integral_sub (g : H → H) (Y : ℝ → H) (h : ℝ)
    (hInt : IntervalIntegrable (fun t ↦ g (Y t)) volume 0 h) :
    localDefect g Y h = (∫ t in 0..h, g (Y t)) - h • g (Y 0) := by
  unfold localDefect
  rw [intervalIntegral.integral_sub hInt intervalIntegrable_const]
  simp only [intervalIntegral.integral_const, sub_zero]

/-- The additive integral equation decomposes an exact step into an Euler step
with common noise and the explicitly defined local defect. -/
theorem localDefect_euler_identity (g : H → H) (Y B : ℝ → H) (h : ℝ)
    (hInt : IntervalIntegrable (fun t ↦ g (Y t)) volume 0 h)
    (heq : Y h - Y 0 = -(∫ t in 0..h, g (Y t)) + B h) :
    Y h = Y 0 - h • g (Y 0) + B h - localDefect g Y h := by
  rw [sub_eq_iff_eq_add] at heq
  rw [heq, localDefect_eq_integral_sub g Y h hInt]
  module

omit [NormedSpace ℝ H] [CompleteSpace H] in
/-- A continuous reference path supplies the integral's measurability and
integrability because its Lipschitz drift is continuous. -/
theorem localDefect_integrable {L : ℝ≥0} {g : H → H} (hLip : LipschitzWith L g)
    (Y : ℝ → H) (hY : Continuous Y) (h : ℝ) :
    IntervalIntegrable (fun t ↦ g (Y t)) volume 0 h :=
  (hLip.continuous.comp hY).intervalIntegrable 0 h

/-- The elementary square-root integral responsible for Dalalyan's `2/3`. -/
theorem integral_sqrt_zero (h : ℝ) (hh : 0 ≤ h) :
    (∫ t in 0..h, Real.sqrt t) = (2 / 3 : ℝ) * h * Real.sqrt h := by
  simp_rw [Real.sqrt_eq_rpow]
  rw [integral_rpow (Or.inl (by norm_num : (-1 : ℝ) < 1 / 2))]
  rw [Real.zero_rpow (by norm_num : (1 / 2 : ℝ) + 1 ≠ 0), sub_zero,
    Real.rpow_add_one' hh (by norm_num : (1 / 2 : ℝ) + 1 ≠ 0)]
  ring

omit [CompleteSpace H] in
/-- A bounded drift and a square-root noise bound control the increment. -/
theorem integral_equation_increment_bound
    (g : H → H) (Y B : ℝ → H) (h G N : ℝ) (_hh : 0 ≤ h)
    (hG : ∀ t ∈ Set.Icc 0 h, ‖g (Y t)‖ ≤ G)
    (hB : ∀ t ∈ Set.Icc 0 h, ‖B t‖ ≤ N * Real.sqrt t)
    (heq : ∀ t ∈ Set.Icc 0 h,
      Y t - Y 0 = -(∫ s in 0..t, g (Y s)) + B t)
    {t : ℝ} (ht : t ∈ Set.Icc 0 h) :
    ‖Y t - Y 0‖ ≤ t * G + N * Real.sqrt t := by
  have hdrift : ‖∫ s in 0..t, g (Y s)‖ ≤ G * t := by
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const
      (a := 0) (b := t) (C := G) (f := fun s ↦ g (Y s)) (fun s hs ↦ ?_)
    · simpa [abs_of_nonneg ht.1] using hb
    · rw [Set.uIoc_of_le ht.1] at hs
      exact hG s ⟨hs.1.le, hs.2.trans ht.2⟩
  rw [heq t ht]
  calc
    ‖-(∫ s in 0..t, g (Y s)) + B t‖ ≤
        ‖∫ s in 0..t, g (Y s)‖ + ‖B t‖ := by
      simpa only [norm_neg] using norm_add_le (-(∫ s in 0..t, g (Y s))) (B t)
    _ ≤ G * t + N * Real.sqrt t := add_le_add hdrift (hB t ht)
    _ = t * G + N * Real.sqrt t := by ring

omit [CompleteSpace H] in
/-- Integrating the Lipschitz increment estimate gives Dalalyan's local defect
bound, before replacing its two terms by a single numerical constant. -/
theorem localDefect_bound
    (g : H → H) (Y B : ℝ → H) (L : ℝ≥0) (h G N : ℝ)
    (hh : 0 ≤ h) (hLip : LipschitzWith L g)
    (hG : ∀ t ∈ Set.Icc 0 h, ‖g (Y t)‖ ≤ G)
    (hB : ∀ t ∈ Set.Icc 0 h, ‖B t‖ ≤ N * Real.sqrt t)
    (heq : ∀ t ∈ Set.Icc 0 h,
      Y t - Y 0 = -(∫ s in 0..t, g (Y s)) + B t) :
    ‖localDefect g Y h‖ ≤
      (L : ℝ) * (h ^ 2 * G / 2 + (2 / 3 : ℝ) * h * Real.sqrt h * N) := by
  have hbound (t : ℝ) (ht : t ∈ Set.Ioc 0 h) :
      ‖g (Y t) - g (Y 0)‖ ≤ (L : ℝ) * (t * G + N * Real.sqrt t) := by
    calc
      ‖g (Y t) - g (Y 0)‖ ≤ (L : ℝ) * ‖Y t - Y 0‖ := by
        simpa only [dist_eq_norm] using hLip.dist_le_mul (Y t) (Y 0)
      _ ≤ (L : ℝ) * (t * G + N * Real.sqrt t) :=
        mul_le_mul_of_nonneg_left
          (integral_equation_increment_bound g Y B h G N hh hG hB heq ⟨ht.1.le, ht.2⟩)
          L.coe_nonneg
  have hbint : IntervalIntegrable
      (fun t : ℝ ↦ (L : ℝ) * (t * G + N * Real.sqrt t)) volume 0 h :=
    (by fun_prop : Continuous
      (fun t : ℝ ↦ (L : ℝ) * (t * G + N * Real.sqrt t))).intervalIntegrable _ _
  unfold localDefect
  calc
    ‖∫ t in 0..h, g (Y t) - g (Y 0)‖ ≤
        ∫ t in 0..h, (L : ℝ) * (t * G + N * Real.sqrt t) :=
      intervalIntegral.norm_integral_le_of_norm_le hh
        (Filter.Eventually.of_forall hbound) hbint
    _ = (L : ℝ) * (h ^ 2 * G / 2 + (2 / 3 : ℝ) * h * Real.sqrt h * N) := by
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_add
          ((by fun_prop : Continuous (fun t : ℝ ↦ t * G)).intervalIntegrable 0 h)
          ((by fun_prop : Continuous (fun t : ℝ ↦ N * Real.sqrt t)).intervalIntegrable 0 h),
        intervalIntegral.integral_mul_const, intervalIntegral.integral_const_mul,
        integral_id, integral_sqrt_zero h hh]
      ring

/-- The corrected Dalalyan--Karagulyan numerical constant, as an exact rational. -/
theorem dalalyan_constant_bound : (7 / 6 : ℝ) * Real.sqrt 2 ≤ 33 / 20 := by
  have hs := Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)
  have hp := Real.sqrt_nonneg (2 : ℝ)
  nlinarith

/-- Specializing the drift and noise norms to the stationary L² moment values
gives the `1.65 L √(d h³)` local error used in the corrected proof. -/
theorem localDefect_dalalyan_bound
    (g : H → H) (Y B : ℝ → H) (L : ℝ≥0) (h d : ℝ)
    (hh : 0 ≤ h) (hd : 0 ≤ d) (hstep : (L : ℝ) * h ≤ 2)
    (hLip : LipschitzWith L g)
    (hG : ∀ t ∈ Set.Icc 0 h, ‖g (Y t)‖ ≤ Real.sqrt ((L : ℝ) * d))
    (hB : ∀ t ∈ Set.Icc 0 h, ‖B t‖ ≤ Real.sqrt (2 * d) * Real.sqrt t)
    (heq : ∀ t ∈ Set.Icc 0 h,
      Y t - Y 0 = -(∫ s in 0..t, g (Y s)) + B t) :
    ‖localDefect g Y h‖ ≤ (33 / 20 : ℝ) * (L : ℝ) * h * Real.sqrt (h * d) := by
  have hsmall : h * Real.sqrt ((L : ℝ) * d) ≤
      Real.sqrt 2 * Real.sqrt (h * d) := by
    apply (sq_le_sq₀ (by positivity) (by positivity)).mp
    rw [mul_pow, mul_pow, Real.sq_sqrt (mul_nonneg L.coe_nonneg hd),
      Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2), Real.sq_sqrt (mul_nonneg hh hd)]
    have hb := mul_le_mul_of_nonneg_right hstep (mul_nonneg hh hd)
    nlinarith
  have hnoise : h * Real.sqrt h * Real.sqrt (2 * d) =
      h * Real.sqrt 2 * Real.sqrt (h * d) := by
    rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 2), Real.sqrt_mul hh]
    ring
  calc
    ‖localDefect g Y h‖ ≤ (L : ℝ) *
        (h ^ 2 * Real.sqrt ((L : ℝ) * d) / 2 +
          (2 / 3 : ℝ) * h * Real.sqrt h * Real.sqrt (2 * d)) :=
      localDefect_bound g Y B L h (Real.sqrt ((L : ℝ) * d))
        (Real.sqrt (2 * d)) hh hLip hG hB heq
    _ ≤ (L : ℝ) * ((7 / 6 : ℝ) * Real.sqrt 2 * h * Real.sqrt (h * d)) := by
      have hb := mul_le_mul_of_nonneg_left hsmall (mul_nonneg hh L.coe_nonneg)
      rw [show (2 / 3 : ℝ) * h * Real.sqrt h * Real.sqrt (2 * d) =
        (2 / 3 : ℝ) * (h * Real.sqrt h * Real.sqrt (2 * d)) by ring, hnoise]
      nlinarith
    _ ≤ (33 / 20 : ℝ) * (L : ℝ) * h * Real.sqrt (h * d) := by
      have hb := mul_le_mul_of_nonneg_right dalalyan_constant_bound
        (show 0 ≤ (L : ℝ) * h * Real.sqrt (h * d) by positivity)
      nlinarith

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/Dynamics.lean -/
section

/-! # The actual noise-driven ULA chain

The noise is supplied explicitly. When it consists of independent standard
Gaussian vectors this definition is the unadjusted Langevin algorithm.
The algebraic coupling results apply to every common noise sequence.
-/

noncomputable section

open scoped NNReal

namespace ULA

/-- ULA iterates, with the initial condition and every noise vector visible. -/
def ulaChain {d : ℕ} (U : E d → ℝ) (h : ℝ) (initial : E d)
    (noise : ℕ → E d) : ℕ → E d
  | 0 => initial
  | n + 1 => ulaUpdate U h (ulaChain U h initial noise n) (noise n)

@[simp] theorem ulaChain_zero {d : ℕ} (U : E d → ℝ) (h : ℝ)
    (initial : E d) (noise : ℕ → E d) : ulaChain U h initial noise 0 = initial := rfl

@[simp] theorem ulaChain_succ {d : ℕ} (U : E d → ℝ) (h : ℝ)
    (initial : E d) (noise : ℕ → E d) (n : ℕ) :
    ulaChain U h initial noise (n + 1) =
      ulaUpdate U h (ulaChain U h initial noise n) (noise n) := rfl

/-- Measurable initial data and noises give measurable iterates. -/
theorem ulaChain_measurable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (U : E d → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial : Ω → E d) (noise : ℕ → Ω → E d)
    (hinitial : Measurable initial) (hnoise : ∀ n, Measurable (noise n)) (n : ℕ) :
    Measurable (fun ω ↦ ulaChain U h (initial ω) (fun k ↦ noise k ω) n) := by
  have hg : Measurable (gradient U) := hLip.continuous.measurable
  induction n with
  | zero => exact hinitial
  | succ n ih =>
      simp only [ulaChain_succ, ulaUpdate]
      exact (ih.sub ((hg.comp ih).const_smul h)).add
        ((hnoise n).const_smul (Real.sqrt (2 * h)))

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/LpDrift.lean -/
section

/-!
# Lifting the actual gradient to square-integrable random variables

The local-error theorem works in a Banach space. Here we construct its intended
L² drift from the potential's actual gradient. Centering the vector field before
using mathlib's `compLp` removes any need to assume `gradient U 0 = 0`.
-/

noncomputable section

open MeasureTheory
open scoped NNReal

namespace ULA

variable {Ω H : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup H] (P : Measure Ω) [IsFiniteMeasure P]

/-- Subtracting a fixed offset preserves a Lipschitz constant. -/
theorem centered_lipschitz {L : ℝ≥0} {g : H → H} (hLip : LipschitzWith L g) :
    LipschitzWith L (fun x ↦ g x - g 0) := by
  apply LipschitzWith.of_dist_le_mul
  intro x y
  simpa only [dist_eq_norm, sub_sub_sub_cancel_right] using hLip.dist_le_mul x y

/-- A Lipschitz vector field acts on L² random variables, including nonzero
constant offsets. The finite measure ensures that this offset lies in L². -/
def lpDrift (g : H → H) {L : ℝ≥0} (hLip : LipschitzWith L g)
    (X : Lp H 2 P) : Lp H 2 P :=
  (centered_lipschitz hLip).compLp (by simp) X + Lp.const 2 P (g 0)

/-- The L² drift represents pointwise application of the original vector field. -/
theorem lpDrift_coe (g : H → H) {L : ℝ≥0} (hLip : LipschitzWith L g)
    (X : Lp H 2 P) : lpDrift P g hLip X =ᵐ[P] fun ω ↦ g (X ω) := by
  unfold lpDrift
  filter_upwards [Lp.coeFn_add ((centered_lipschitz hLip).compLp (by simp) X)
      (Lp.const 2 P (g 0)),
    (centered_lipschitz hLip).coeFn_compLp (by simp) X,
    Lp.coeFn_const (μ := P) (p := 2) (c := g 0)] with ω hadd hcomp hconst
  simp only [hadd, hcomp, hconst, Function.comp_apply, Pi.add_apply, Function.const_apply]
  exact sub_add_cancel _ _

/-- Lipschitz composition preserves square integrability for finite measures. -/
theorem lpDrift_memLp (g : H → H) {L : ℝ≥0} (hLip : LipschitzWith L g)
    (X : Lp H 2 P) : MemLp (fun ω ↦ g (X ω)) 2 P :=
  (Lp.memLp (lpDrift P g hLip X)).ae_eq (lpDrift_coe P g hLip X)

/-- The actual vector field keeps its Lipschitz constant in L². -/
theorem lpDrift_lipschitz (g : H → H) {L : ℝ≥0} (hLip : LipschitzWith L g) :
    LipschitzWith L (lpDrift P g hLip) := by
  apply LipschitzWith.of_dist_le_mul
  intro X Y
  simp only [lpDrift, dist_eq_norm, add_sub_add_right_eq_sub]
  exact (centered_lipschitz hLip).norm_compLp_sub_le (by simp) X Y

variable [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The sharp small-step gradient contraction passes to actual random-variable
gradients in L², by integrating the pointwise norm bound. -/
theorem lpDrift_gradient_contract
    (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (hmL : m ≤ (L : ℝ))
    (hpos : 0 < m + (L : ℝ)) (hh : 0 ≤ h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (X Y : Lp H 2 P) :
    ‖(X - h • lpDrift P (gradient U) hLip X) -
      (Y - h • lpDrift P (gradient U) hLip Y)‖ ≤ (1 - m * h) * ‖X - Y‖ := by
  apply Lp.norm_le_mul_norm_of_ae_le_mul
  filter_upwards [Lp.coeFn_sub
      (X - h • lpDrift P (gradient U) hLip X)
      (Y - h • lpDrift P (gradient U) hLip Y),
    Lp.coeFn_sub X (h • lpDrift P (gradient U) hLip X),
    Lp.coeFn_sub Y (h • lpDrift P (gradient U) hLip Y),
    Lp.coeFn_smul h (lpDrift P (gradient U) hLip X),
    Lp.coeFn_smul h (lpDrift P (gradient U) hLip Y),
    lpDrift_coe P (gradient U) hLip X, lpDrift_coe P (gradient U) hLip Y,
    Lp.coeFn_sub X Y] with ω hsub hX hY hsX hsY hgX hgY hXY
  simp only [hsub, hX, hY, hsX, hsY, hgX, hgY, hXY, Pi.sub_apply, Pi.smul_apply]
  exact strong_smooth_gradient_step_contract U m h L hdiff hsc hLip hmL hpos hh hsmall
    (X ω) (Y ω)

/-- The second sharp step-size regime also passes to L². -/
theorem lpDrift_gradient_contract_large
    (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (hmL : m ≤ (L : ℝ))
    (hpos : 0 < m + (L : ℝ)) (hh : 0 ≤ h) (hlarge : 2 / (m + (L : ℝ)) ≤ h)
    (X Y : Lp H 2 P) :
    ‖(X - h • lpDrift P (gradient U) hLip X) -
      (Y - h • lpDrift P (gradient U) hLip Y)‖ ≤ ((L : ℝ) * h - 1) * ‖X - Y‖ := by
  apply Lp.norm_le_mul_norm_of_ae_le_mul
  filter_upwards [Lp.coeFn_sub
      (X - h • lpDrift P (gradient U) hLip X)
      (Y - h • lpDrift P (gradient U) hLip Y),
    Lp.coeFn_sub X (h • lpDrift P (gradient U) hLip X),
    Lp.coeFn_sub Y (h • lpDrift P (gradient U) hLip Y),
    Lp.coeFn_smul h (lpDrift P (gradient U) hLip X),
    Lp.coeFn_smul h (lpDrift P (gradient U) hLip Y),
    lpDrift_coe P (gradient U) hLip X, lpDrift_coe P (gradient U) hLip Y,
    Lp.coeFn_sub X Y] with ω hsub hX hY hsX hsY hgX hgY hXY
  simp only [hsub, hX, hY, hsX, hsY, hgX, hgY, hXY, Pi.sub_apply, Pi.smul_apply]
  exact strong_smooth_gradient_step_contract_large U m h L hdiff hsc hLip
    hmL hpos hh hlarge (X ω) (Y ω)

/-- Dalalyan's local defect theorem instantiated with the actual gradient in L². -/
theorem lpDrift_localDefect_bound
    (U : H → ℝ) (L : ℝ≥0) (h d : ℝ)
    (hLip : LipschitzWith L (gradient U)) (Y B : ℝ → Lp H 2 P)
    (hh : 0 ≤ h) (hd : 0 ≤ d) (hstep : (L : ℝ) * h ≤ 2)
    (hG : ∀ t ∈ Set.Icc 0 h, ‖lpDrift P (gradient U) hLip (Y t)‖ ≤
      Real.sqrt ((L : ℝ) * d))
    (hB : ∀ t ∈ Set.Icc 0 h, ‖B t‖ ≤ Real.sqrt (2 * d) * Real.sqrt t)
    (heq : ∀ t ∈ Set.Icc 0 h, Y t - Y 0 =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) + B t) :
    ‖localDefect (lpDrift P (gradient U) hLip) Y h‖ ≤
      (33 / 20 : ℝ) * (L : ℝ) * h * Real.sqrt (h * d) :=
  localDefect_dalalyan_bound (lpDrift P (gradient U) hLip) Y B L h d hh hd hstep
    (lpDrift_lipschitz P (gradient U) hLip) hG hB heq

omit [CompleteSpace H] in
/-- The L² norm of the lifted drift is the usual square-root score moment. -/
theorem lpDrift_norm_sq (g : H → H) {L : ℝ≥0} (hLip : LipschitzWith L g)
    (X : Lp H 2 P) :
    ‖lpDrift P g hLip X‖ ^ 2 = ∫ ω, ‖g (X ω)‖ ^ 2 ∂P := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  apply integral_congr_ae
  filter_upwards [lpDrift_coe P g hLip X] with ω hω
  rw [hω, real_inner_self_eq_norm_sq]

omit [CompleteSpace H] in
/-- A score second-moment bound supplies the norm assumption in the local-error
theorem, with the square root justified by the L² identity. -/
theorem lpDrift_norm_le_sqrt (g : H → H) {L : ℝ≥0} (hLip : LipschitzWith L g)
    (X : Lp H 2 P) (C : ℝ) (hmoment : (∫ ω, ‖g (X ω)‖ ^ 2 ∂P) ≤ C) :
    ‖lpDrift P g hLip X‖ ≤ Real.sqrt C := by
  exact Real.le_sqrt_of_sq_le ((lpDrift_norm_sq P g hLip X).trans_le hmoment)

/-- One ULA update as an operation on actual L² random variables. -/
def lpUlaUpdate (U : H → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (X Z : Lp H 2 P) : Lp H 2 P :=
  X - h • lpDrift P (gradient U) hLip X + Real.sqrt (2 * h) • Z

/-- The random-variable update agrees almost everywhere with the pointwise
ULA formula. -/
theorem lpUlaUpdate_coe (U : H → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (X Z : Lp H 2 P) :
    lpUlaUpdate P U h hLip X Z =ᵐ[P] fun ω ↦
      X ω - h • gradient U (X ω) + Real.sqrt (2 * h) • Z ω := by
  unfold lpUlaUpdate
  filter_upwards [Lp.coeFn_add (X - h • lpDrift P (gradient U) hLip X)
      (Real.sqrt (2 * h) • Z),
    Lp.coeFn_sub X (h • lpDrift P (gradient U) hLip X),
    Lp.coeFn_smul h (lpDrift P (gradient U) hLip X),
    Lp.coeFn_smul (Real.sqrt (2 * h)) Z,
    lpDrift_coe P (gradient U) hLip X] with ω ha hs hsm hn hg
  simp only [ha, hs, hsm, hn, hg, Pi.add_apply, Pi.sub_apply, Pi.smul_apply]

/-- The genuine noise-driven ULA chain in the L² space. -/
def lpUlaChain {d : ℕ} (U : E d → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (initial : Lp (E d) 2 P)
    (noise : ℕ → Lp (E d) 2 P) : ℕ → Lp (E d) 2 P
  | 0 => initial
  | n + 1 => lpUlaUpdate P U h hLip (lpUlaChain U h hLip initial noise n) (noise n)

@[simp] theorem lpUlaChain_zero {d : ℕ} (U : E d → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (initial : Lp (E d) 2 P)
    (noise : ℕ → Lp (E d) 2 P) : lpUlaChain P U h hLip initial noise 0 = initial := rfl

@[simp] theorem lpUlaChain_succ {d : ℕ} (U : E d → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (initial : Lp (E d) 2 P)
    (noise : ℕ → Lp (E d) 2 P) (n : ℕ) :
    lpUlaChain P U h hLip initial noise (n + 1) =
      lpUlaUpdate P U h hLip (lpUlaChain P U h hLip initial noise n) (noise n) := rfl

/-- Every L² iterate represents the original pointwise ULA chain almost
everywhere, so the lifting does not introduce a different algorithm. -/
theorem lpUlaChain_coe {d : ℕ} (U : E d → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (initial : Lp (E d) 2 P)
    (noise : ℕ → Lp (E d) 2 P) (n : ℕ) :
    lpUlaChain P U h hLip initial noise n =ᵐ[P] fun ω ↦
      ulaChain U h (initial ω) (fun k ↦ noise k ω) n := by
  induction n with
  | zero => exact Filter.Eventually.of_forall fun _ ↦ rfl
  | succ n ih =>
      filter_upwards [lpUlaUpdate_coe P U h hLip
        (lpUlaChain P U h hLip initial noise n) (noise n), ih] with ω hupdate hprev
      simpa only [lpUlaChain_succ, ulaChain_succ, ulaUpdate, hprev] using hupdate

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/Coupling.lean -/
section

/-!
# Couplings and the Wasserstein-2 upper bound

The pinned mathlib has no Wasserstein API. We define the usual infimum of
quadratic coupling costs here. The value lies in `ℝ≥0∞`, so a measure without
finite second moment cannot silently acquire distance zero by `toReal`.

This file proves the passage from an actual pair of random variables to a
transport bound, and the L² perturbation estimate used in synchronous coupling.
It does not assert existence or invariance of a Langevin diffusion.
-/

noncomputable section

open MeasureTheory
open scoped ENNReal NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [MeasurableSpace H]
  [BorelSpace H] [SecondCountableTopology H]

/-- A joint measure whose two marginals are the specified measures. -/
structure Coupling (μ ν : Measure H) where
  joint : Measure (H × H)
  fst : joint.map Prod.fst = μ
  snd : joint.map Prod.snd = ν

/-- The square root of the quadratic transport cost of a joint measure. -/
def couplingCost (γ : Measure (H × H)) : ℝ≥0∞ :=
  eLpNorm (fun p : H × H ↦ p.1 - p.2) 2 γ

/-- Wasserstein-2 as the infimum over every coupling, with infinite costs retained. -/
def wasserstein2 (μ ν : Measure H) : ℝ≥0∞ :=
  ⨅ c : Coupling μ ν, couplingCost c.joint

/-- The real-valued distance, used only after a finite-cost coupling has been
provided. Results below carry that finiteness obligation explicitly. -/
def wasserstein2Real (μ ν : Measure H) : ℝ := (wasserstein2 μ ν).toReal

omit [BorelSpace H] [SecondCountableTopology H] in
/-- Any particular coupling gives an upper bound on Wasserstein-2. -/
theorem wasserstein2_le_couplingCost {μ ν : Measure H} (c : Coupling μ ν) :
    wasserstein2 μ ν ≤ couplingCost c.joint :=
  iInf_le _ c

variable {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)

/-- A pair of random variables supplies a coupling of their laws. -/
def randomVariableCoupling (X Y : Ω → H) (hX : Measurable X) (hY : Measurable Y) :
    Coupling (P.map X) (P.map Y) where
  joint := P.map (fun ω ↦ (X ω, Y ω))
  fst := by
    rw [Measure.map_map measurable_fst (hX.prodMk hY)]
    rfl
  snd := by
    rw [Measure.map_map measurable_snd (hX.prodMk hY)]
    rfl

/-- The same construction for almost-everywhere measurable representatives. -/
def aeRandomVariableCoupling (X Y : Ω → H)
    (hX : AEMeasurable X P) (hY : AEMeasurable Y P) :
    Coupling (P.map X) (P.map Y) where
  joint := P.map (fun ω ↦ (X ω, Y ω))
  fst := by
    rw [AEMeasurable.map_map_of_aemeasurable measurable_fst.aemeasurable (hX.prodMk hY)]
    rfl
  snd := by
    rw [AEMeasurable.map_map_of_aemeasurable measurable_snd.aemeasurable (hX.prodMk hY)]
    rfl

/-- The transport cost of a random-variable coupling is its L² distance. -/
theorem randomVariableCoupling_cost (X Y : Ω → H)
    (hX : Measurable X) (hY : Measurable Y) :
    couplingCost (randomVariableCoupling P X Y hX hY).joint =
      eLpNorm (fun ω ↦ X ω - Y ω) 2 P := by
  unfold couplingCost randomVariableCoupling
  exact eLpNorm_map_measure
    (by fun_prop) (hX.prodMk hY).aemeasurable

/-- An actual coupling bounds the Wasserstein distance between the two laws. -/
theorem wasserstein2_le_random_cost (X Y : Ω → H)
    (hX : Measurable X) (hY : Measurable Y) :
    wasserstein2 (P.map X) (P.map Y) ≤ eLpNorm (fun ω ↦ X ω - Y ω) 2 P := by
  simpa only [randomVariableCoupling_cost] using
    wasserstein2_le_couplingCost (randomVariableCoupling P X Y hX hY)

/-- Almost-everywhere measurability suffices for the random-variable bound. -/
theorem wasserstein2_le_ae_random_cost (X Y : Ω → H)
    (hX : AEMeasurable X P) (hY : AEMeasurable Y P) :
    wasserstein2 (P.map X) (P.map Y) ≤ eLpNorm (fun ω ↦ X ω - Y ω) 2 P := by
  refine (wasserstein2_le_couplingCost (aeRandomVariableCoupling P X Y hX hY)).trans_eq ?_
  exact eLpNorm_map_measure (by fun_prop) (hX.prodMk hY)

/-- A finite L² coupling permits conversion to the usual real-valued bound. -/
theorem wasserstein2_le_random_cost_real (X Y : Ω → H)
    (hX : Measurable X) (hY : Measurable Y)
    (hXY : MemLp (fun ω ↦ X ω - Y ω) 2 P) :
    wasserstein2Real (P.map X) (P.map Y) ≤
      (eLpNorm (fun ω ↦ X ω - Y ω) 2 P).toReal :=
  ENNReal.toReal_mono hXY.eLpNorm_ne_top (wasserstein2_le_random_cost P X Y hX hY)

/-- L² random variables provide a finite transport bound equal to their Banach
space distance. This bridges the Bochner-integral local-error theorem to laws. -/
theorem wasserstein2_le_Lp_cost (X Y : Lp H 2 P) :
    wasserstein2 (P.map X) (P.map Y) ≤ ENNReal.ofReal ‖X - Y‖ := by
  have hcost : eLpNorm (fun ω ↦ X ω - Y ω) 2 P = eLpNorm (X - Y) 2 P :=
    (eLpNorm_congr_ae (Lp.coeFn_sub X Y)).symm
  rw [Lp.norm_def, ENNReal.ofReal_toReal (Lp.eLpNorm_ne_top (X - Y))]
  exact (wasserstein2_le_ae_random_cost P X Y
    (Lp.aestronglyMeasurable X).aemeasurable
    (Lp.aestronglyMeasurable Y).aemeasurable).trans_eq hcost

/-- The real-valued L²-to-Wasserstein bridge, with finiteness proved internally. -/
theorem wasserstein2_le_Lp_cost_real (X Y : Lp H 2 P) :
    wasserstein2Real (P.map X) (P.map Y) ≤ ‖X - Y‖ := by
  have hb := wasserstein2_le_Lp_cost P X Y
  have hr := ENNReal.toReal_mono ENNReal.ofReal_ne_top hb
  simpa only [wasserstein2Real, ENNReal.toReal_ofReal (norm_nonneg _)] using hr

omit [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H] in
/-- Pointwise contraction passes to L²; no probability independence is needed. -/
theorem eLpNorm_contraction (A D : Ω → H) (q : ℝ≥0)
    (hA : AEStronglyMeasurable A P)
    (hcontract : ∀ᵐ ω ∂P, ‖A ω‖ ≤ (q : ℝ) * ‖D ω‖) :
    eLpNorm A 2 P ≤ (q : ℝ≥0∞) * eLpNorm D 2 P := by
  simpa only [ENNReal.smul_def, smul_eq_mul] using
    eLpNorm_le_nnreal_smul_eLpNorm_of_ae_le_mul hA
      (hcontract.mono fun _ h ↦ by exact_mod_cast h) 2

omit [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H] in
/-- The actual synchronous-coupling error decomposes into a contracted term and
a discretization defect. Minkowski's inequality gives the one-step L² bound. -/
theorem synchronous_l2_bound (X Y X' Y' A V : Ω → H) (q : ℝ≥0)
    (hA : AEStronglyMeasurable A P)
    (hidentity : ∀ᵐ ω ∂P, X' ω - Y' ω = A ω - V ω)
    (hcontract : ∀ᵐ ω ∂P, ‖A ω‖ ≤ (q : ℝ) * ‖X ω - Y ω‖) :
    eLpNorm (fun ω ↦ X' ω - Y' ω) 2 P ≤
      (q : ℝ≥0∞) * eLpNorm (fun ω ↦ X ω - Y ω) 2 P + eLpNorm V 2 P := by
  rw [eLpNorm_congr_ae hidentity]
  exact (eLpNorm_sub_le (by norm_num : (1 : ℝ≥0∞) ≤ 2)).trans
    (add_le_add (eLpNorm_contraction P A (fun ω ↦ X ω - Y ω) q hA hcontract) le_rfl)

/-- The previous estimate is a genuine measure-level bound for the output laws. -/
theorem synchronous_wasserstein_bound (X Y X' Y' A V : Ω → H) (q : ℝ≥0)
    (hX' : Measurable X') (hY' : Measurable Y')
    (hA : AEStronglyMeasurable A P)
    (hidentity : ∀ᵐ ω ∂P, X' ω - Y' ω = A ω - V ω)
    (hcontract : ∀ᵐ ω ∂P, ‖A ω‖ ≤ (q : ℝ) * ‖X ω - Y ω‖) :
    wasserstein2 (P.map X') (P.map Y') ≤
      (q : ℝ≥0∞) * eLpNorm (fun ω ↦ X ω - Y ω) 2 P + eLpNorm V 2 P :=
  (wasserstein2_le_random_cost P X' Y' hX' hY').trans
    (synchronous_l2_bound P X Y X' Y' A V q hA hidentity hcontract)

/-- The finite-cost real-valued version of the synchronous L² estimate. -/
theorem synchronous_l2_bound_real (X Y X' Y' A V : Ω → H) (q : ℝ≥0)
    (hA : AEStronglyMeasurable A P)
    (hidentity : ∀ᵐ ω ∂P, X' ω - Y' ω = A ω - V ω)
    (hcontract : ∀ᵐ ω ∂P, ‖A ω‖ ≤ (q : ℝ) * ‖X ω - Y ω‖)
    (hXY : MemLp (fun ω ↦ X ω - Y ω) 2 P) (hV : MemLp V 2 P) :
    (eLpNorm (fun ω ↦ X' ω - Y' ω) 2 P).toReal ≤
      (q : ℝ) * (eLpNorm (fun ω ↦ X ω - Y ω) 2 P).toReal + (eLpNorm V 2 P).toReal := by
  have hprod : (q : ℝ≥0∞) * eLpNorm (fun ω ↦ X ω - Y ω) 2 P ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top hXY.eLpNorm_ne_top
  have hr := ENNReal.toReal_mono
    (ENNReal.add_ne_top.mpr ⟨hprod, hV.eLpNorm_ne_top⟩)
    (synchronous_l2_bound P X Y X' Y' A V q hA hidentity hcontract)
  simpa only [ENNReal.toReal_add hprod hV.eLpNorm_ne_top,
    ENNReal.toReal_mul, ENNReal.coe_toReal] using hr

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/InitialCoupling.lean -/
section

/-!
# Taking the infimum over initial couplings

An affine transport estimate that holds for every initial coupling passes to
the Wasserstein distance itself. No optimal coupling or attainment theorem is
required. The premise still explicitly requests the estimate for every
initial coupling; constructing a reference process for those couplings is a
separate probabilistic obligation.
-/

noncomputable section

open MeasureTheory
open scoped NNReal ENNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [MeasurableSpace H]

/-- An estimate uniform over all initial couplings passes to their infimum.
The finite coefficient permits multiplication to commute with the infimum,
including coefficient zero. -/
theorem wasserstein2_affine_bound_of_all_couplings
    (μ ν μ' ν' : Measure H) (a : ℝ≥0) (b : ℝ≥0∞)
    (hnonempty : Nonempty (Coupling μ ν))
    (hfamily : ∀ c : Coupling μ ν,
      wasserstein2 μ' ν' ≤ (a : ℝ≥0∞) * couplingCost c.joint + b) :
    wasserstein2 μ' ν' ≤ (a : ℝ≥0∞) * wasserstein2 μ ν + b := by
  let : Nonempty (Coupling μ ν) := hnonempty
  unfold wasserstein2
  rw [ENNReal.mul_iInf (fun h ↦ (ENNReal.coe_ne_top h).elim), ENNReal.iInf_add]
  exact le_iInf hfamily

/-- Finiteness of the transport infimum supplies at least one finite-cost
coupling, without asserting that any coupling attains the infimum. -/
theorem exists_finiteCost_coupling (μ ν : Measure H)
    (hfinite : wasserstein2 μ ν ≠ ⊤) :
    ∃ c : Coupling μ ν, couplingCost c.joint < ⊤ := by
  have hlt : wasserstein2 μ ν < ⊤ := lt_top_iff_ne_top.mpr hfinite
  exact iInf_lt_iff.mp hlt

/-- The real-valued transport endpoint, with finite initial distance.
The output distance is also finite, because the affine upper bound is finite. -/
theorem wasserstein2_affine_bound_real_of_all_couplings
    (μ ν μ' ν' : Measure H) (a b : ℝ≥0)
    (hfinite : wasserstein2 μ ν ≠ ⊤)
    (hfamily : ∀ c : Coupling μ ν,
      wasserstein2 μ' ν' ≤ (a : ℝ≥0∞) * couplingCost c.joint + (b : ℝ≥0∞)) :
    wasserstein2Real μ' ν' ≤ (a : ℝ) * wasserstein2Real μ ν + (b : ℝ) := by
  obtain ⟨c, _⟩ := exists_finiteCost_coupling μ ν hfinite
  have hb := wasserstein2_affine_bound_of_all_couplings μ ν μ' ν' a b ⟨c⟩ hfamily
  have hprod : (a : ℝ≥0∞) * wasserstein2 μ ν ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top hfinite
  have hsum : (a : ℝ≥0∞) * wasserstein2 μ ν + (b : ℝ≥0∞) ≠ ⊤ :=
    ENNReal.add_ne_top.mpr ⟨hprod, ENNReal.coe_ne_top⟩
  have hr := ENNReal.toReal_mono hsum hb
  simpa only [wasserstein2Real, ENNReal.toReal_add hprod ENNReal.coe_ne_top,
    ENNReal.toReal_mul, ENNReal.coe_toReal] using hr

/-- Real estimates for every finite-cost initial coupling suffice. This form
can be applied directly to finite-moment synchronous-coupling theorems.
Finiteness of the output is explicit so that `toReal` cannot hide infinity. -/
theorem wasserstein2_affine_bound_real_of_finite_couplings
    (μ ν μ' ν' : Measure H) (a b : ℝ≥0)
    (hfinite : wasserstein2 μ ν ≠ ⊤) (houtputfinite : wasserstein2 μ' ν' ≠ ⊤)
    (hfamily : ∀ c : Coupling μ ν, couplingCost c.joint ≠ ⊤ →
      wasserstein2Real μ' ν' ≤ (a : ℝ) * (couplingCost c.joint).toReal + (b : ℝ)) :
    wasserstein2Real μ' ν' ≤ (a : ℝ) * wasserstein2Real μ ν + (b : ℝ) := by
  have hlift (c : Coupling μ ν) (hc : couplingCost c.joint ≠ ⊤) :
      wasserstein2 μ' ν' ≤ (a : ℝ≥0∞) * couplingCost c.joint + (b : ℝ≥0∞) := by
    have h := ENNReal.ofReal_le_ofReal (hfamily c hc)
    simpa only [wasserstein2Real, ENNReal.ofReal_toReal houtputfinite,
      ENNReal.ofReal_add (mul_nonneg a.coe_nonneg ENNReal.toReal_nonneg) b.coe_nonneg,
      ENNReal.ofReal_mul a.coe_nonneg, ENNReal.ofReal_coe_nnreal,
      ENNReal.ofReal_toReal hc] using h
  apply wasserstein2_affine_bound_real_of_all_couplings μ ν μ' ν' a b hfinite
  intro c
  by_cases hc : couplingCost c.joint ≠ ⊤
  · exact hlift c hc
  · have hctop : couplingCost c.joint = ⊤ := not_ne_iff.mp hc
    by_cases ha : a = 0
    · obtain ⟨c₀, hc₀⟩ := exists_finiteCost_coupling μ ν hfinite
      have hb := hlift c₀ (ne_of_lt hc₀)
      simpa only [ha, ENNReal.coe_zero, zero_mul, zero_add] using hb
    · have hane : (a : ℝ≥0∞) ≠ 0 := by exact_mod_cast ha
      simp only [hctop, ENNReal.mul_top hane, top_add, le_top]

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/Recurrence.lean -/
section

/-! # The scalar final step of Dalalyan's synchronous-coupling argument

This file proves only the recurrence calculation. The stochastic one-step
inequality must be established separately; it is not hidden in a definition.
For a fixed positive step the bias remains positive as the number of steps grows.
-/

namespace ULA

open Filter
open scoped Topology

/-- Iterating an affine inequality gives the exact finite geometric sum. -/
theorem affine_recurrence_sum (e : ℕ → ℝ) (q b : ℝ) (hq : 0 ≤ q)
    (hstep : ∀ n, e (n + 1) ≤ q * e n + b) (n : ℕ) :
    e n ≤ q ^ n * e 0 + b * ∑ j ∈ Finset.range n, q ^ j := by
  induction n with
  | zero => simp
  | succ n ih =>
      have hmul := mul_le_mul_of_nonneg_left ih hq
      have hgeom := mul_geom_sum q n
      have hid : q * (∑ j ∈ Finset.range n, q ^ j) + 1 =
          (∑ j ∈ Finset.range n, q ^ j) + q ^ n := by nlinarith
      have hidb := congrArg (fun t : ℝ ↦ b * t) hid
      rw [Finset.sum_range_succ, pow_succ]
      nlinarith [hstep n, hidb]

/-- Closed form retaining the finite-horizon factor `1 - q^n`. -/
theorem affine_recurrence_exact (e : ℕ → ℝ) (q b : ℝ) (hq : 0 ≤ q)
    (hq1 : q < 1) (hstep : ∀ n, e (n + 1) ≤ q * e n + b) (n : ℕ) :
    e n ≤ q ^ n * e 0 + b * (1 - q ^ n) / (1 - q) := by
  have hs := affine_recurrence_sum e q b hq hstep n
  rw [geom_sum_eq (ne_of_lt hq1) n] at hs
  rw [show q ^ n - 1 = -(1 - q ^ n) by ring,
    show q - 1 = -(1 - q) by ring, neg_div_neg_eq, ← mul_div_assoc] at hs
  exact hs

/-- Dropping the finite-horizon correction gives the usual bias-floor bound. -/
theorem affine_recurrence_bound (e : ℕ → ℝ) (q b : ℝ) (hq : 0 ≤ q)
    (hq1 : q < 1) (hb : 0 ≤ b)
    (hstep : ∀ n, e (n + 1) ≤ q * e n + b) (n : ℕ) :
    e n ≤ q ^ n * e 0 + b / (1 - q) := by
  have h := affine_recurrence_exact e q b hq hq1 hstep n
  have hden : 0 < 1 - q := sub_pos.mpr hq1
  have hnum : b * (1 - q ^ n) ≤ b := by
    nlinarith [pow_nonneg hq n]
  exact h.trans (add_le_add_right ((div_le_div_iff_of_pos_right hden).mpr hnum) _)

/-- The upper envelope tends to the bias floor, not necessarily to zero. -/
theorem bias_envelope_tendsto (q b initial : ℝ) (hq : 0 ≤ q) (hq1 : q < 1) :
    Tendsto (fun n : ℕ ↦ q ^ n * initial + b / (1 - q)) atTop
      (𝓝 (b / (1 - q))) := by
  have hp := tendsto_pow_atTop_nhds_zero_of_lt_one hq hq1
  simpa using (hp.mul_const initial).add_const (b / (1 - q))

/-- Any requested accuracy above the bias floor is eventually attained. -/
theorem eventually_below_bias (e : ℕ → ℝ) (q b : ℝ) (hq : 0 ≤ q)
    (hq1 : q < 1) (hb : 0 ≤ b)
    (hstep : ∀ n, e (n + 1) ≤ q * e n + b)
    (ε : ℝ) (hε : b / (1 - q) < ε) :
    ∀ᶠ n in atTop, e n < ε := by
  have he := (bias_envelope_tendsto q b (e 0) hq hq1).eventually
    (gt_mem_nhds hε)
  filter_upwards [he] with n hn
  exact lt_of_le_of_lt (affine_recurrence_bound e q b hq hq1 hb hstep n) hn

end ULA


end


/-! ## Included source: UnadjustedLangevin/HilbertDalalyan.lean -/
section

-- This project does not prescribe Mathlib copyright headers.
set_option linter.style.header false

/-! # Dalalyan's argument from a stationary integral reference

Unlike the more general perturbation theorem, this module derives its local
error from an integral equation for the actual lifted gradient. The remaining
inputs are explicit: a stationary reference, its score moment bound, and its
square-root noise increment bound. `UnadjustedLangevin/CanonicalULA.lean`
constructs these inputs and proves the unconditional Gaussian ULA theorem.
-/

noncomputable section

open MeasureTheory
open scoped NNReal

namespace ULA.Hilbert

open ULA

variable {Ω H : Type*} [MeasurableSpace Ω]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
  [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H]
  (P : Measure Ω) [IsProbabilityMeasure P] (d : ℕ)

/-- ULA in a Hilbert-space presentation, using the actual-gradient L² update.
The reference moment bounds provide its effective dimension parameter. -/
def lpChain (U : H → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (initial : Lp H 2 P)
    (noise : ℕ → Lp H 2 P) : ℕ → Lp H 2 P
  | 0 => initial
  | n + 1 => lpUlaUpdate P U h hLip (lpChain U h hLip initial noise n) (noise n)

omit [MeasurableSpace H] [BorelSpace H] [SecondCountableTopology H] in
@[simp] theorem lpChain_succ (U : H → ℝ) (h : ℝ) {L : ℝ≥0}
    (hLip : LipschitzWith L (gradient U)) (initial : Lp H 2 P)
    (noise : ℕ → Lp H 2 P) (n : ℕ) :
    lpChain P U h hLip initial noise (n + 1) =
      lpUlaUpdate P U h hLip (lpChain P U h hLip initial noise n) (noise n) := rfl

/-- Exactly the continuous-reference inputs to Dalalyan's coupling argument.
All norms are L² norms, so `scoreBound` and `noiseBound` are moment bounds.
`noise` is not asserted to be Gaussian by this structure. -/
structure L2Reference (U : H → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U)) (noise : ℕ → Lp (H) 2 P)
    (π : Measure (H)) where
  segment : ℕ → ℝ → Lp (H) 2 P
  increment : ℕ → ℝ → Lp (H) 2 P
  continuous : ∀ n, Continuous (segment n)
  join : ∀ n, segment n h = segment (n + 1) 0
  noiseEndpoint : ∀ n, increment n h = Real.sqrt (2 * h) • noise n
  stationary : ∀ n, P.map (segment n 0) = π
  integralEquation : ∀ n t, t ∈ Set.Icc 0 h →
    segment n t - segment n 0 =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (segment n s)) + increment n t
  scoreBound : ∀ n t, t ∈ Set.Icc 0 h →
    ‖lpDrift P (gradient U) hLip (segment n t)‖ ≤ Real.sqrt ((L : ℝ) * d)
  noiseBound : ∀ n t, t ∈ Set.Icc 0 h →
    ‖increment n t‖ ≤ Real.sqrt (2 * (d : ℝ)) * Real.sqrt t

/-- The complete error calculation from the displayed continuous-reference
inputs, including the local defect estimate and the transport-cost bridge. -/
theorem l2_reference_bound
    (U : H → ℝ) (h : ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (initial : Lp (H) 2 P) (noise : ℕ → Lp (H) 2 P) (π : Measure (H))
    (ref : L2Reference P d U h L hLip noise π)
    (hh : 0 ≤ h) (hstep : (L : ℝ) * h ≤ 2) (q : ℝ) (hq : 0 ≤ q) (hq1 : q < 1)
    (hcontract : ∀ X Y : Lp (H) 2 P,
      ‖(X - h • lpDrift P (gradient U) hLip X) -
        (Y - h • lpDrift P (gradient U) hLip Y)‖ ≤ q * ‖X - Y‖) (n : ℕ) :
    wasserstein2Real (P.map (lpChain P U h hLip initial noise n)) π ≤
      q ^ n * ‖initial - ref.segment 0 0‖ +
        ((33 / 20 : ℝ) * (L : ℝ) * h * Real.sqrt (h * d)) / (1 - q) := by
  let g := lpDrift P (gradient U) hLip
  let X := lpChain P U h hLip initial noise
  let b := (33 / 20 : ℝ) * (L : ℝ) * h * Real.sqrt (h * d)
  let D (k : ℕ) := localDefect g (ref.segment k) h
  have hb : 0 ≤ b := by dsimp [b]; positivity
  have hD (k : ℕ) : ‖D k‖ ≤ b :=
    lpDrift_localDefect_bound P U L h d hLip (ref.segment k) (ref.increment k)
      hh (by positivity) hstep (ref.scoreBound k) (ref.noiseBound k) (ref.integralEquation k)
  have hreference (k : ℕ) :
      ref.segment (k + 1) 0 = ref.segment k 0 - h • g (ref.segment k 0) +
        Real.sqrt (2 * h) • noise k - D k := by
    have hi : IntervalIntegrable (fun t ↦ g (ref.segment k t)) volume 0 h :=
      ((lpDrift_lipschitz P (gradient U) hLip).continuous.comp
        (ref.continuous k)).intervalIntegrable 0 h
    have he := localDefect_euler_identity g (ref.segment k) (ref.increment k) h hi
      (ref.integralEquation k h ⟨hh, le_rfl⟩)
    rw [ref.join k, ref.noiseEndpoint k] at he
    exact he
  have hrec (k : ℕ) :
      ‖X (k + 1) - ref.segment (k + 1) 0‖ ≤ q * ‖X k - ref.segment k 0‖ + b := by
    change ‖lpChain P U h hLip initial noise (k + 1) - ref.segment (k + 1) 0‖ ≤ _
    rw [lpChain_succ, hreference k]
    have hid :
        (X k - h • g (X k) + Real.sqrt (2 * h) • noise k) -
          (ref.segment k 0 - h • g (ref.segment k 0) +
            Real.sqrt (2 * h) • noise k - D k) =
        ((X k - h • g (X k)) - (ref.segment k 0 - h • g (ref.segment k 0))) + D k := by
      module
    change ‖(X k - h • g (X k) + Real.sqrt (2 * h) • noise k) - _‖ ≤ _
    rw [hid]
    exact (norm_add_le _ _).trans (add_le_add (hcontract (X k) (ref.segment k 0)) (hD k))
  have hw := wasserstein2_le_Lp_cost_real P (X n) (ref.segment n 0)
  rw [ref.stationary n] at hw
  exact hw.trans (affine_recurrence_bound (fun k ↦ ‖X k - ref.segment k 0‖)
    q b hq hq1 hb hrec n)

/-- Dalalyan's small-step branch with the corrected coefficient `1.65`,
derived from potential assumptions and the explicit integral reference. -/
theorem dalalyan_small_step_of_integral_reference
    (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (hm : 0 < m) (hmL : m ≤ (L : ℝ))
    (hh : 0 < h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (initial : Lp (H) 2 P) (noise : ℕ → Lp (H) 2 P) (π : Measure (H))
    (ref : L2Reference P d U h L hLip noise π) (n : ℕ) :
    wasserstein2Real (P.map (lpChain P U h hLip initial noise n)) π ≤
      (1 - m * h) ^ n * ‖initial - ref.segment 0 0‖ +
        (33 / 20 : ℝ) * ((L : ℝ) / m) * Real.sqrt (h * d) := by
  have hpos : 0 < m + (L : ℝ) := by positivity
  have hproduct : h * (m + (L : ℝ)) ≤ 2 := (le_div_iff₀ hpos).mp hsmall
  have hmh : m * h ≤ 1 := by
    nlinarith [mul_nonneg hh.le (sub_nonneg.mpr hmL)]
  have hstep : (L : ℝ) * h ≤ 2 := by nlinarith [mul_pos hm hh]
  have hq : 0 ≤ 1 - m * h := by linarith
  have hq1 : 1 - m * h < 1 := by nlinarith [mul_pos hm hh]
  have hb := l2_reference_bound P d U h L hLip initial noise π ref hh.le hstep
    (1 - m * h) hq hq1
    (lpDrift_gradient_contract P U m h L hdiff hsc hLip hmL hpos hh.le hsmall) n
  have hid :
      ((33 / 20 : ℝ) * (L : ℝ) * h * Real.sqrt (h * d)) / (1 - (1 - m * h)) =
        (33 / 20 : ℝ) * ((L : ℝ) / m) * Real.sqrt (h * d) := by
    field_simp
    ring
  rwa [hid] at hb

/-- Dalalyan's large-step branch; the denominator is positive under `hL < 2`. -/
theorem dalalyan_large_step_of_integral_reference
    (U : H → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (hm : 0 < m) (hmL : m ≤ (L : ℝ))
    (hh : 0 < h) (hlarge : 2 / (m + (L : ℝ)) ≤ h) (hstep : (L : ℝ) * h < 2)
    (initial : Lp (H) 2 P) (noise : ℕ → Lp (H) 2 P) (π : Measure (H))
    (ref : L2Reference P d U h L hLip noise π) (n : ℕ) :
    wasserstein2Real (P.map (lpChain P U h hLip initial noise n)) π ≤
      ((L : ℝ) * h - 1) ^ n * ‖initial - ref.segment 0 0‖ +
        ((33 / 20 : ℝ) * (L : ℝ) * h / (2 - (L : ℝ) * h)) * Real.sqrt (h * d) := by
  have hpos : 0 < m + (L : ℝ) := by positivity
  have hproduct : 2 ≤ h * (m + (L : ℝ)) := (div_le_iff₀ hpos).mp hlarge
  have hq : 0 ≤ (L : ℝ) * h - 1 := by
    nlinarith [mul_nonneg hh.le (sub_nonneg.mpr hmL)]
  have hq1 : (L : ℝ) * h - 1 < 1 := by linarith
  have hb := l2_reference_bound P d U h L hLip initial noise π ref hh.le hstep.le
    ((L : ℝ) * h - 1) hq hq1
    (lpDrift_gradient_contract_large P U m h L hdiff hsc hLip hmL hpos hh.le hlarge) n
  have hid :
      ((33 / 20 : ℝ) * (L : ℝ) * h * Real.sqrt (h * d)) / (1 - ((L : ℝ) * h - 1)) =
        ((33 / 20 : ℝ) * (L : ℝ) * h / (2 - (L : ℝ) * h)) * Real.sqrt (h * d) := by
    ring
  rwa [hid] at hb

end ULA.Hilbert


end
