/-! ## Included source: UnadjustedLangevin/BrownianSegmentsGlobal.lean -/
section

set_option linter.style.header false

/-! # Constructed Brownian segments equal the global integral solution

Only the deterministic integral equation, the algebraic Brownian increment
cocycle, and finite-horizon uniqueness enter this file. No stationarity or
independence assertion is assumed in these identities.
-/

noncomputable section
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
open MeasureTheory ProbabilityTheory Set
open scoped NNReal
namespace ULA
variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
  (P : Measure Ω)

/-- The additive Brownian input has the exact algebraic increment cocycle. -/
theorem brownianLangevinNoise_increment
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P) (a t : ℝ) :
    brownianLangevinNoise P W hW 0 (a + t) - brownianLangevinNoise P W hW 0 a =
      brownianLangevinNoise P W hW a t := by
  unfold brownianLangevinNoise
  simp only [zero_add]
  module

variable [IsProbabilityMeasure P]

/-- Shifting a global integral solution by time `a` gives the actual segment
integral equation driven by the Brownian increments starting at `a`. -/
theorem lp_brownian_integral_shift
    (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (Y : ℝ → Lp (EuclideanSpace ℝ ι) 2 P) (hY : Continuous Y)
    (T : ℝ)
    (hYe : ∀ t ∈ Icc 0 T, Y t - initial =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) +
        brownianLangevinNoise P W hW 0 t)
    (a h : ℝ) (ha : 0 ≤ a) (hh : 0 ≤ h) (hah : a + h ≤ T) :
    ∀ t ∈ Icc 0 h, Y (a + t) - Y a =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y (a + s))) +
        brownianLangevinNoise P W hW a t := by
  intro t ht
  have hai : a ∈ Icc 0 T := ⟨ha, by linarith⟩
  have hati : a + t ∈ Icc 0 T := ⟨by linarith [ht.1], by linarith [ht.2]⟩
  have hinc := langevin_integral_increment (lpDrift P (gradient U) hLip) L
    (lpDrift_lipschitz P (gradient U) hLip) initial
    (brownianLangevinNoise P W hW 0) Y hY T hYe a (a + t) hai hati
  have hi : (∫ s in a..a + t, lpDrift P (gradient U) hLip (Y s)) =
      ∫ s in 0..t, lpDrift P (gradient U) hLip (Y (a + s)) := by
    simpa only [add_zero] using (intervalIntegral.integral_comp_add_left
      (f := fun s ↦ lpDrift P (gradient U) hLip (Y s)) (a := 0) (b := t) a).symm
  rw [hi, brownianLangevinNoise_increment] at hinc
  exact hinc

namespace Hilbert

/-- An actual segment selected by Picard equals the restriction of any global
solution with the matching knot, independently of the choice used in existence. -/
theorem brownianSegmentFrom_eq_global
    (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial initialAt : Lp (EuclideanSpace ℝ ι) 2 P)
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (Y : ℝ → Lp (EuclideanSpace ℝ ι) 2 P) (hY : Continuous Y)
    (T : ℝ)
    (hYe : ∀ t ∈ Icc 0 T, Y t - initial =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) +
        brownianLangevinNoise P W hW 0 t)
    (h : ℝ) (hh : 0 ≤ h) (n : ℕ)
    (hstart : initialAt = Y ((n : ℝ) * h))
    (hend : ((n : ℝ) + 1) * h ≤ T) :
    EqOn (brownianSegmentFrom P U L hLip W hW h hh n initialAt)
      (fun t ↦ Y ((n : ℝ) * h + t)) (Icc 0 h) := by
  have hs := brownianSegmentFrom_spec P U L hLip W hW h hh n initialAt
  have he := lp_brownian_integral_shift P U L hLip initial W hW Y hY T hYe
    ((n : ℝ) * h) h (mul_nonneg (Nat.cast_nonneg _) hh) hh
    (by nlinarith)
  apply lp_langevin_integral_unique P U L hLip initialAt
    (brownianLangevinNoise P W hW ((n : ℝ) * h)) _ _ hs.1
    (hY.comp (continuous_const.add continuous_id)) h hh hs.2.2.1
  intro t ht
  rw [hstart]
  exact he t ht

/-- Every recursively constructed knot agrees with the global solution at its
absolute grid time, as soon as that time lies within the global horizon. -/
theorem brownianKnots_eq_global
    (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (Y : ℝ → Lp (EuclideanSpace ℝ ι) 2 P) (hY : Continuous Y)
    (T : ℝ) (hT : 0 ≤ T)
    (hYe : ∀ t ∈ Icc 0 T, Y t - initial =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) +
        brownianLangevinNoise P W hW 0 t)
    (h : ℝ) (hh : 0 ≤ h) (n : ℕ) (hn : (n : ℝ) * h ≤ T) :
    brownianKnots P U L hLip W hW h hh initial n = Y ((n : ℝ) * h) := by
  have hY0 : Y 0 = initial := by
    have he := hYe 0 ⟨le_rfl, hT⟩
    simpa only [intervalIntegral.integral_same, neg_zero, brownianLangevinNoise_zero,
      add_zero, sub_eq_zero] using he
  induction n with
  | zero => simpa only [brownianKnots, Nat.cast_zero, zero_mul] using hY0.symm
  | succ n ih =>
    have hprev : (n : ℝ) * h ≤ T := by
      push_cast at hn
      nlinarith
    have hstart := ih hprev
    have he := brownianSegmentFrom_eq_global P U L hLip initial
      (brownianKnots P U L hLip W hW h hh initial n) W hW Y hY T hYe h hh n hstart
      (by exact_mod_cast hn)
    have heh := he (x := h) ⟨hh, le_rfl⟩
    change brownianSegmentFrom P U L hLip W hW h hh n
      (brownianKnots P U L hLip W hW h hh initial n) h = _
    simpa only [Nat.cast_add, Nat.cast_one, add_mul, one_mul] using heh

/-- The actual reference segment at local time `t` is the global Langevin
solution at absolute time `n*h+t`. No law or stationarity premise occurs. -/
theorem brownianSegments_eq_global
    (U : EuclideanSpace ℝ ι → ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (W : ι → ℝ≥0 → Ω → ℝ) (hW : ∀ i, IsPreBrownianReal (W i) P)
    (Y : ℝ → Lp (EuclideanSpace ℝ ι) 2 P) (hY : Continuous Y)
    (T : ℝ) (hT : 0 ≤ T)
    (hYe : ∀ t ∈ Icc 0 T, Y t - initial =
      -(∫ s in 0..t, lpDrift P (gradient U) hLip (Y s)) +
        brownianLangevinNoise P W hW 0 t)
    (h : ℝ) (hh : 0 ≤ h) (n : ℕ) (hend : ((n : ℝ) + 1) * h ≤ T) :
    EqOn (brownianSegments P U L hLip W hW h hh initial n)
      (fun t ↦ Y ((n : ℝ) * h + t)) (Icc 0 h) := by
  have hkn := brownianKnots_eq_global P U L hLip initial W hW Y hY T hT hYe h hh n
    (by nlinarith)
  exact brownianSegmentFrom_eq_global P U L hLip initial
    (brownianKnots P U L hLip W hW h hh initial n) W hW Y hY T hYe h hh n hkn hend

end Hilbert
end ULA


end
end


/-! ## Included source: UnadjustedLangevin/CanonicalULA.lean -/
section

set_option linter.style.header false

/-! # ULA from the potential assumptions and the actual Gaussian algorithm

An explicit independent Brownian source supplies the continuous reference.
Gibbs stationarity is proved by refining the exactly invariant Metropolis
approximation. Initial couplings, moments, Gaussian innovations, and output-law
identification are derived rather than supplied as reference obligations.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal
namespace ULA.Hilbert
open ULA

variable {S ι : Type*} [MeasurableSpace S] [Fintype ι]
  (Q : Measure S) [IsProbabilityMeasure Q]

/-- The Brownian realization has the ordinary iterated Gaussian ULA law.
This is independent of the coupling used to realize the initialization. -/
theorem productBrownianOutput_eq_ulaLawStep
    {μ π : Measure (EuclideanSpace ℝ ι)} [IsProbabilityMeasure μ]
    (c : Coupling μ π) (hc : couplingCost c.joint ≠ ⊤)
    (hπ : MemLp (fun x : EuclideanSpace ℝ ι ↦ x) 2 π)
    (U : EuclideanSpace ℝ ι → ℝ) (h : ℝ) (L : ℝ≥0)
    (hLip : LipschitzWith L (gradient U))
    (B : ι → ℝ≥0 → S → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) Q)
    (hh : 0 < h)
    (hpaths : iIndepFun (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * h.toNNReal) ω) Q)
    (k : ℕ) :
    productOutputLaw Q U h μ (sourceEulerNoise Q B hB h) k =
      (ulaLawStep U h)^[k] μ := by
  have := initialExtension_isProbabilityMeasure c Q
  let W := productNoise Q c (sourceEulerNoise Q B hB h) (sourceEulerNoise_memLp Q B hB h)
  have hW : ∀ n, AEMeasurable (W n) (initialExtension c Q) :=
    fun n ↦ (Lp.aestronglyMeasurable (W n)).aemeasurable
  have hcoord := productEulerNoise_coordinateLaw Q c B hB h hh
  have hind := productEulerNoise_independent Q c B hB h hh hpaths
  rw [← product_chain_outputLaw Q c hc hπ U h L hLip
    (sourceEulerNoise Q B hB h) (sourceEulerNoise_memLp Q B hB h) k]
  rw [hilbert_lpChain_law_eq_ulaLawStep (initialExtension c Q) U h L hLip
    (initialExtension_lpInitial c Q hc hπ) W
    (productEulerNoise_independentInitial Q c hc hπ B hB h)
    (gaussianInnovations_vectorIndependent (initialExtension c Q) (fun n ω ↦ W n ω) hW hcoord hind)
    (gaussianInnovations_vectorLaw (initialExtension c Q) (fun n ω ↦ W n ω) hW hcoord hind),
    initialExtension_lpInitial_law]

/-- Independent Brownian coordinates and an independent initialization derive
every field of the reference. In particular Gibbs stationarity is a conclusion. -/
def productReference_of_independent_brownian
    {μ : Measure (EuclideanSpace ℝ ι)} [IsProbabilityMeasure μ]
    (U : EuclideanSpace ℝ ι → ℝ) (m : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (B : ι → ℝ≥0 → S → ℝ) (hB : ∀ i, IsPreBrownianReal (B i) Q)
    (hpaths : ∀ r : ℝ, 0 < r → iIndepFun
      (fun i ω (n : ℕ) ↦ B i ((n : ℝ≥0) * r.toNNReal) ω) Q)
    (h : ℝ) (hh : 0 < h) :
    ProductReference Q (Fintype.card ι) U h L hLip μ (gibbsMeasure U)
      (productGibbsMemLp U m hm hdiff hsc)
      (sourceEulerNoise Q B hB h) (sourceEulerNoise_memLp Q B hB h) := by
  apply productReference_of_constructed_brownian Q U m L hm hdiff hsc hLip B hB h hh
  intro c _hc n t ht
  have := initialExtension_isProbabilityMeasure c Q
  let P := initialExtension c Q
  let X := initialExtension_lpReference c Q (productGibbsMemLp U m hm hdiff hsc)
  let W := fun i t (p : (EuclideanSpace ℝ ι × EuclideanSpace ℝ ι) × S) ↦ B i t p.2
  have hW : ∀ i, IsPreBrownianReal (W i) P := productPreBrownian Q c B hB
  let T := ((n : ℝ) + 1) * h
  have hT : 0 ≤ T := mul_nonneg (by positivity) hh.le
  obtain ⟨Y, hY, _hY0, hYe, _⟩ := exists_lp_langevin_integral_of_brownian
    P U L hLip X W hW 0 T le_rfl hT
  have heq := brownianSegments_eq_global P U L hLip X W hW Y hY T hT hYe
    h hh.le n le_rfl
  change P.map (brownianSegments P U L hLip W hW h hh.le X n t) = _
  rw [heq ht]
  have hscalar : ∀ r : ℝ, 0 < r → iIndepFun
      (fun p : ℕ × ι ↦ fun ω ↦ brownianEulerNoise P W hW r p.1 ω p.2) P := by
    intro r hr
    have hs := productEulerNoise_independent Q c B hB r hr (hpaths r hr)
    simpa only [productNoise_eq_brownianEulerNoise] using hs
  have hind : ∀ r : ℝ, 0 < r → IndepFun X
      (fun ω k ↦ brownianEulerNoise P W hW r k ω) P := by
    intro r _hr
    have hs := productEulerNoise_independentReference Q c
      (productGibbsMemLp U m hm hdiff hsc) B hB r
    simpa only [productNoise_eq_brownianEulerNoise] using hs
  have hinitial : P.map X = gibbsMeasure U :=
    initialExtension_lpReference_law c Q (productGibbsMemLp U m hm hdiff hsc)
  have hs : 0 ≤ (n : ℝ) * h + t :=
    add_nonneg (mul_nonneg (Nat.cast_nonneg _) hh.le) ht.1
  have hsT : (n : ℝ) * h + t ≤ T := by dsimp [T]; nlinarith [ht.2]
  exact lp_langevin_gibbs_stationary P U m L hm hdiff hsc hLip X hinitial
    W hW hscalar hind Y hY ((n : ℝ) * h + t) hs
    (fun s hs ↦ hYe s ⟨hs.1, hs.2.trans hsT⟩)

/-- The explicit Brownian noise source used by the unconditional theorem. -/
abbrev canonicalEulerNoise (h : ℝ) : ℕ → CanonicalBrownian.VectorSample ι →
    EuclideanSpace ℝ ι :=
  sourceEulerNoise (CanonicalBrownian.vectorProbability ι)
    CanonicalBrownian.coordinate CanonicalBrownian.coordinate_isPreBrownian h

/-- Every reference field, including its stationary law, is derived from the
original potential assumptions on an explicit probability space. -/
def canonicalProductReference
    {μ : Measure (EuclideanSpace ℝ ι)} [IsProbabilityMeasure μ]
    (U : EuclideanSpace ℝ ι → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (hh : 0 < h) :
    ProductReference (CanonicalBrownian.vectorProbability ι) (Fintype.card ι)
      U h L hLip μ (gibbsMeasure U) (productGibbsMemLp U m hm hdiff hsc)
      (canonicalEulerNoise h) (sourceEulerNoise_memLp
        (CanonicalBrownian.vectorProbability ι) CanonicalBrownian.coordinate
        CanonicalBrownian.coordinate_isPreBrownian h) :=
  productReference_of_independent_brownian (CanonicalBrownian.vectorProbability ι)
    U m L hm hdiff hsc hLip CanonicalBrownian.coordinate
    CanonicalBrownian.coordinate_isPreBrownian
    (fun r _ ↦ CanonicalBrownian.coordinate_grid_paths_independent ι r.toNNReal) h hh

/-- Exact identification of the explicitly constructed source with ordinary
Gaussian ULA, for every finite-second-moment initial law. -/
theorem canonicalOutput_eq_ulaLawStep
    (U : EuclideanSpace ℝ ι → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (hh : 0 < h) (μ : Measure (EuclideanSpace ℝ ι)) [IsProbabilityMeasure μ]
    (hfinite : wasserstein2 μ (gibbsMeasure U) ≠ ⊤) (k : ℕ) :
    productOutputLaw (CanonicalBrownian.vectorProbability ι) U h μ
      (canonicalEulerNoise h) k = (ulaLawStep U h)^[k] μ := by
  obtain ⟨c, hc⟩ := exists_finiteCost_coupling μ (gibbsMeasure U) hfinite
  exact productBrownianOutput_eq_ulaLawStep (CanonicalBrownian.vectorProbability ι)
    c (ne_of_lt hc) (productGibbsMemLp U m hm hdiff hsc) U h L hLip
    CanonicalBrownian.coordinate CanonicalBrownian.coordinate_isPreBrownian hh
    (CanonicalBrownian.coordinate_grid_paths_independent ι h.toNNReal) k

/-- Output second moments and finite transport are conclusions, not additional
inputs needed to interpret the real Wasserstein bound. -/
theorem dalalyan_output_finite
    (U : EuclideanSpace ℝ ι → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (hh : 0 < h) (μ : Measure (EuclideanSpace ℝ ι)) [IsProbabilityMeasure μ]
    (hfinite : wasserstein2 μ (gibbsMeasure U) ≠ ⊤) (k : ℕ) :
    wasserstein2 ((ulaLawStep U h)^[k] μ) (gibbsMeasure U) ≠ ⊤ := by
  have hf := (canonicalProductReference U m h L hm hdiff hsc hLip hh
    (μ := μ)).output_finite (CanonicalBrownian.vectorProbability ι) hfinite k
  rwa [canonicalOutput_eq_ulaLawStep U m h L hm hdiff hsc hLip hh μ hfinite k] at hf

/-- Dalalyan's strongly convex ULA theorem, with all stochastic reference
obligations proved. The only analytic assumptions concern the potential itself. -/
theorem dalalyan [Nonempty ι]
    (U : EuclideanSpace ℝ ι → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (hh : 0 < h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (μ : Measure (EuclideanSpace ℝ ι)) [IsProbabilityMeasure μ]
    (hfinite : wasserstein2 μ (gibbsMeasure U) ≠ ⊤) (k : ℕ) :
    wasserstein2Real ((ulaLawStep U h)^[k] μ) (gibbsMeasure U) ≤
      (1 - m * h) ^ k * wasserstein2Real μ (gibbsMeasure U) +
        (33 / 20 : ℝ) * ((L : ℝ) / m) * Real.sqrt (h * (Fintype.card ι : ℝ)) := by
  have hb := dalalyan_small_step_of_product_reference
    (CanonicalBrownian.vectorProbability ι) (Fintype.card ι) U m h L hdiff hsc hLip
    hm (strongConvex_le_lipschitz hdiff hsc hLip) hh hsmall
    (productGibbsMemLp U m hm hdiff hsc) (canonicalEulerNoise h)
    (sourceEulerNoise_memLp (CanonicalBrownian.vectorProbability ι)
      CanonicalBrownian.coordinate CanonicalBrownian.coordinate_isPreBrownian h)
    hfinite (canonicalProductReference U m h L hm hdiff hsc hLip hh) k
  rwa [canonicalOutput_eq_ulaLawStep U m h L hm hdiff hsc hLip hh μ hfinite k] at hb

/-- The other stable step-size branch of Dalalyan, with the same fully derived
reference and the exact initial Wasserstein distance. -/
theorem dalalyan_large_step [Nonempty ι]
    (U : EuclideanSpace ℝ ι → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (hh : 0 < h) (hlarge : 2 / (m + (L : ℝ)) ≤ h) (hstep : (L : ℝ) * h < 2)
    (μ : Measure (EuclideanSpace ℝ ι)) [IsProbabilityMeasure μ]
    (hfinite : wasserstein2 μ (gibbsMeasure U) ≠ ⊤) (k : ℕ) :
    wasserstein2Real ((ulaLawStep U h)^[k] μ) (gibbsMeasure U) ≤
      ((L : ℝ) * h - 1) ^ k * wasserstein2Real μ (gibbsMeasure U) +
        ((33 / 20 : ℝ) * (L : ℝ) * h / (2 - (L : ℝ) * h)) *
          Real.sqrt (h * (Fintype.card ι : ℝ)) := by
  have hb := dalalyan_large_step_of_product_reference
    (CanonicalBrownian.vectorProbability ι) (Fintype.card ι) U m h L hdiff hsc hLip
    hm (strongConvex_le_lipschitz hdiff hsc hLip) hh hlarge hstep
    (productGibbsMemLp U m hm hdiff hsc) (canonicalEulerNoise h)
    (sourceEulerNoise_memLp (CanonicalBrownian.vectorProbability ι)
      CanonicalBrownian.coordinate CanonicalBrownian.coordinate_isPreBrownian h)
    hfinite (canonicalProductReference U m h L hm hdiff hsc hLip hh) k
  rwa [canonicalOutput_eq_ulaLawStep U m h L hm hdiff hsc hLip hh μ hfinite k] at hb

end ULA.Hilbert


end
end


/-! ## Included source: UnadjustedLangevin/GaussianULA.lean -/
section

set_option linter.style.header false

/-! # Dalalyan for the actual Gaussian ULA recursion

All scalar Gaussian laws and all coordinate/time independence are used to
identify the actual `L²` chain law. The initial second moment comes from its
`L²` representation; the Gibbs moment comes from strong convexity. Their
independent product proves finite initial Wasserstein distance. No reference,
stationarity, normalization, or extra potential regularity is assumed.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace ULA.Hilbert
open ULA

variable {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι] [Nonempty ι]
  (P : Measure Ω) [IsProbabilityMeasure P]

private theorem initialLaw_probability (initial : Lp (EuclideanSpace ℝ ι) 2 P) :
    IsProbabilityMeasure (P.map initial) := by
  constructor
  rw [Measure.map_apply_of_aemeasurable (Lp.aestronglyMeasurable initial).aemeasurable
    MeasurableSet.univ, Set.preimage_univ, measure_univ]

/-- Finite initial quadratic transport follows from the actual initialization
and the original strongly convex potential assumptions. -/
theorem gaussianULA_initial_transport_finite
    (U : EuclideanSpace ℝ ι → ℝ) (m : ℝ) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (initial : Lp (EuclideanSpace ℝ ι) 2 P) :
    wasserstein2 (P.map initial) (gibbsMeasure U) ≠ ⊤ := by
  have := initialLaw_probability P initial
  have := isProbabilityMeasure_gibbsMeasure U m hm hdiff hsc
  have hμ : MemLp (fun x : EuclideanSpace ℝ ι ↦ x) 2 (P.map initial) :=
    (memLp_map_measure_iff (by fun_prop)
      (Lp.aestronglyMeasurable initial).aemeasurable).mpr (Lp.memLp initial)
  exact wasserstein2_ne_top_of_memLp (P.map initial) (gibbsMeasure U) hμ
    (memLp_id_gibbsMeasure U m hm hdiff hsc)

/-- Dalalyan's small-step theorem for the actual Gaussian ULA implementation.
Only the displayed potential/step assumptions and the algorithm's ordinary
Gaussian laws and independence assumptions are inputs. -/
theorem dalalyan_of_gaussian_innovations
    (U : EuclideanSpace ℝ ι → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (hh : 0 < h) (hsmall : h ≤ 2 / (m + (L : ℝ)))
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (noise : ℕ → Lp (EuclideanSpace ℝ ι) 2 P)
    (hcoord : ∀ n i, HasLaw (fun ω ↦ noise n ω i) (gaussianReal 0 1) P)
    (hind : iIndepFun (fun p : ℕ × ι ↦ fun ω ↦ noise p.1 ω p.2) P)
    (hindinitial : IndepFun initial (fun ω n ↦ noise n ω) P) (k : ℕ) :
    wasserstein2Real (P.map (lpChain P U h hLip initial noise k)) (gibbsMeasure U) ≤
      (1 - m * h) ^ k * wasserstein2Real (P.map initial) (gibbsMeasure U) +
        (33 / 20 : ℝ) * ((L : ℝ) / m) * Real.sqrt (h * (Fintype.card ι : ℝ)) := by
  have := initialLaw_probability P initial
  have hW (n : ℕ) : AEMeasurable (noise n) P :=
    (Lp.aestronglyMeasurable _).aemeasurable
  rw [hilbert_lpChain_law_eq_ulaLawStep P U h L hLip initial noise hindinitial
    (gaussianInnovations_vectorIndependent P (fun n ω ↦ noise n ω) hW hcoord hind)
    (gaussianInnovations_vectorLaw P (fun n ω ↦ noise n ω) hW hcoord hind)]
  exact dalalyan U m h L hm hdiff hsc hLip hh hsmall (P.map initial)
    (gaussianULA_initial_transport_finite P U m hm hdiff hsc initial) k

/-- Dalalyan's other stable step-size branch for the same actual Gaussian
implementation, with all reference obligations already proved. -/
theorem dalalyan_large_step_of_gaussian_innovations
    (U : EuclideanSpace ℝ ι → ℝ) (m h : ℝ) (L : ℝ≥0)
    (hm : 0 < m) (hdiff : Differentiable ℝ U)
    (hsc : StrongConvexOn Set.univ m U) (hLip : LipschitzWith L (gradient U))
    (hh : 0 < h) (hlarge : 2 / (m + (L : ℝ)) ≤ h) (hstep : (L : ℝ) * h < 2)
    (initial : Lp (EuclideanSpace ℝ ι) 2 P)
    (noise : ℕ → Lp (EuclideanSpace ℝ ι) 2 P)
    (hcoord : ∀ n i, HasLaw (fun ω ↦ noise n ω i) (gaussianReal 0 1) P)
    (hind : iIndepFun (fun p : ℕ × ι ↦ fun ω ↦ noise p.1 ω p.2) P)
    (hindinitial : IndepFun initial (fun ω n ↦ noise n ω) P) (k : ℕ) :
    wasserstein2Real (P.map (lpChain P U h hLip initial noise k)) (gibbsMeasure U) ≤
      ((L : ℝ) * h - 1) ^ k * wasserstein2Real (P.map initial) (gibbsMeasure U) +
        ((33 / 20 : ℝ) * (L : ℝ) * h / (2 - (L : ℝ) * h)) *
          Real.sqrt (h * (Fintype.card ι : ℝ)) := by
  have := initialLaw_probability P initial
  have hW (n : ℕ) : AEMeasurable (noise n) P :=
    (Lp.aestronglyMeasurable _).aemeasurable
  rw [hilbert_lpChain_law_eq_ulaLawStep P U h L hLip initial noise hindinitial
    (gaussianInnovations_vectorIndependent P (fun n ω ↦ noise n ω) hW hcoord hind)
    (gaussianInnovations_vectorLaw P (fun n ω ↦ noise n ω) hW hcoord hind)]
  exact dalalyan_large_step U m h L hm hdiff hsc hLip hh hlarge hstep (P.map initial)
    (gaussianULA_initial_transport_finite P U m hm hdiff hsc initial) k

end ULA.Hilbert


end
end


/-! ## Included source: UnadjustedLangevin/Generator.lean -/
section

set_option linter.style.header false

/-! # Infinitesimal Gibbs invariance by integration of the Langevin generator

The identity is proved for compactly supported `C²` test functions by ordinary
integration by parts. Only the first derivative of the potential occurs. In
particular, Lipschitz continuity of its gradient suffices; there is no Hessian
assumption on the potential. Infinitesimal invariance and invariance of a
diffusion semigroup are distinct assertions.
-/

noncomputable section
open MeasureTheory
open scoped ENNReal NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

/-- The contribution of a direction to the overdamped Langevin generator. -/
def directionalGenerator (U φ : H → ℝ) (v x : H) : ℝ :=
  fderiv ℝ (fun z ↦ fderiv ℝ φ z v) x v -
    inner ℝ (gradient U x) v * fderiv ℝ φ x v

/-- The generator `∆φ - ⟪∇U,∇φ⟫`, expressed using the standard orthonormal basis. -/
def langevinGenerator (U φ : H → ℝ) (x : H) : ℝ :=
  ∑ i : Fin (Module.finrank ℝ H),
    directionalGenerator U φ (stdOrthonormalBasis ℝ H i) x

/-- Conversion from the normalized Gibbs integral to its weighted Lebesgue integral. -/
theorem integral_gibbs_eq_weighted (U : H → ℝ) (hdiff : Differentiable ℝ U)
    (f : H → ℝ) :
    (∫ x, f x ∂gibbsMeasure U) = (gibbsPartition U)⁻¹.toReal *
      (∫ x, Real.exp (-U x) * f x ∂volume) := by
  rw [gibbsMeasure, integral_smul_measure]
  unfold gibbsWeight
  have hw : Measurable (fun x ↦ ENNReal.ofReal (Real.exp (-U x))) := by
    have hUc := hdiff.continuous
    fun_prop
  rw [integral_withDensity_eq_integral_toReal_smul hw
    (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)]
  simp only [ENNReal.toReal_ofReal (Real.exp_nonneg _), smul_eq_mul]

/-- Continuous compactly supported functions are genuinely integrable under
Gibbs normalization. This rules out use of the total-integral default value. -/
theorem integrable_gibbs_of_continuous_hasCompactSupport
    (U : H → ℝ) (hdiff : Differentiable ℝ U) (f : H → ℝ)
    (hf : Continuous f) (hc : HasCompactSupport f) :
    Integrable f (gibbsMeasure U) := by
  have hw : Measurable (gibbsWeight U) := by
    exact (Real.continuous_exp.comp hdiff.continuous.neg).measurable.ennreal_ofReal
  have hi : Integrable f (volume.withDensity (gibbsWeight U)) := by
    apply (integrable_withDensity_iff_integrable_smul' hw
      (ae_of_all _ fun _ ↦ ENNReal.ofReal_lt_top)).mpr
    have hcw : Continuous (fun x ↦ Real.exp (-U x)) :=
      Real.continuous_exp.comp hdiff.continuous.neg
    simp only [gibbsWeight, ENNReal.toReal_ofReal (Real.exp_nonneg _), smul_eq_mul]
    exact (hcw.mul hf).integrable_of_hasCompactSupport hc.mul_left
  exact hi.smul_measure
    (ENNReal.inv_ne_top.mpr (ne_of_gt (gibbsPartition_pos U hdiff)))

omit [MeasurableSpace H] [BorelSpace H] in
/-- The Gibbs weight requires only one derivative of the potential. -/
theorem fderiv_exp_neg_apply (U : H → ℝ) (hdiff : Differentiable ℝ U) (x v : H) :
    fderiv ℝ (fun z ↦ Real.exp (-U z)) x v =
      -Real.exp (-U x) * inner ℝ (gradient U x) v := by
  have hd : HasFDerivAt (fun z ↦ Real.exp (-U z))
      (Real.exp (-U x) • (-fderiv ℝ U x)) x :=
    (hdiff x).hasFDerivAt.neg.exp
  rw [hd.fderiv]
  simp [inner_gradient_left]

/-- Weighted directional integration by parts, with all integrability conditions
derived from compact support of the test function. -/
theorem integral_weighted_directionalGenerator_eq_zero
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hc : HasCompactSupport φ) (v : H) :
    (∫ x, Real.exp (-U x) * directionalGenerator U φ v x ∂volume) = 0 := by
  let g : H → ℝ := fun x ↦ fderiv ℝ φ x v
  have hg : ContDiff ℝ 1 g :=
    (hφ.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const
  have hgc : HasCompactSupport g := hc.fderiv_apply ℝ v
  have hgd : Continuous (fun x ↦ fderiv ℝ g x v) :=
    (hg.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hw : Continuous (fun x ↦ Real.exp (-U x)) :=
    Real.continuous_exp.comp hdiff.continuous.neg
  have hs : Continuous (fun x ↦ -Real.exp (-U x) * inner ℝ (gradient U x) v) :=
    hw.neg.mul (hLip.continuous.inner continuous_const)
  have hi₁ : Integrable (fun x ↦ fderiv ℝ (fun z ↦ Real.exp (-U z)) x v * g x)
      volume := by
    simp_rw [fderiv_exp_neg_apply U hdiff]
    exact (hs.mul hg.continuous).integrable_of_hasCompactSupport hgc.mul_left
  have hi₂ : Integrable (fun x ↦ Real.exp (-U x) * fderiv ℝ g x v) volume :=
    (hw.mul hgd).integrable_of_hasCompactSupport (hgc.fderiv_apply ℝ v).mul_left
  have hi₃ : Integrable (fun x ↦ Real.exp (-U x) * g x) volume :=
    (hw.mul hg.continuous).integrable_of_hasCompactSupport hgc.mul_left
  have hibp := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable hi₁ hi₂ hi₃
    (fun x _ ↦ (hdiff x).neg.exp) (fun x _ ↦ hg.differentiable (by norm_num) x)
  have hi₄ : Integrable (fun x ↦ Real.exp (-U x) *
      (inner ℝ (gradient U x) v * g x)) volume :=
    (hw.mul ((hLip.continuous.inner continuous_const).mul hg.continuous))
      |>.integrable_of_hasCompactSupport hgc.mul_left.mul_left
  simp_rw [fderiv_exp_neg_apply U hdiff] at hibp
  change (∫ x, Real.exp (-U x) *
    (fderiv ℝ g x v - inner ℝ (gradient U x) v * g x) ∂volume) = 0
  simp_rw [mul_sub]
  rw [integral_sub hi₂ hi₄]
  have heq : (fun x ↦ -Real.exp (-U x) * inner ℝ (gradient U x) v * g x) =
      (fun x ↦ -(Real.exp (-U x) * (inner ℝ (gradient U x) v * g x))) := by
    funext x
    ring
  rw [heq, integral_neg, neg_neg] at hibp
  exact sub_eq_zero.mpr hibp

/-- Every compactly supported `C²` test has zero directional generator integral
under the normalized Gibbs measure. -/
theorem integral_directionalGenerator_gibbs_eq_zero
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hc : HasCompactSupport φ) (v : H) :
    (∫ x, directionalGenerator U φ v x ∂gibbsMeasure U) = 0 := by
  rw [integral_gibbs_eq_weighted U hdiff,
    integral_weighted_directionalGenerator_eq_zero U L hdiff hLip φ hφ hc v,
    mul_zero]

omit [MeasurableSpace H] [BorelSpace H] in
/-- The directional generator is continuous under first-order regularity of `U`. -/
theorem continuous_directionalGenerator
    (U : H → ℝ) (L : ℝ≥0) (hLip : LipschitzWith L (gradient U))
    (φ : H → ℝ) (hφ : ContDiff ℝ 2 φ) (v : H) :
    Continuous (directionalGenerator U φ v) := by
  have hg : ContDiff ℝ 1 (fun x ↦ fderiv ℝ φ x v) :=
    (hφ.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const
  exact ((hg.continuous_fderiv (by norm_num)).clm_apply continuous_const).sub
    ((hLip.continuous.inner continuous_const).mul hg.continuous)

omit [MeasurableSpace H] [BorelSpace H] in
/-- Taking a generator preserves compact support of a test function. -/
theorem hasCompactSupport_directionalGenerator (U φ : H → ℝ)
    (hc : HasCompactSupport φ) (v : H) :
    HasCompactSupport (directionalGenerator U φ v) :=
  ((hc.fderiv_apply ℝ v).fderiv_apply ℝ v).sub (hc.fderiv_apply ℝ v).mul_left

/-- Absolute integrability of each directional generator under Gibbs measure. -/
theorem integrable_directionalGenerator_gibbsMeasure
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hc : HasCompactSupport φ) (v : H) :
    Integrable (directionalGenerator U φ v) (gibbsMeasure U) :=
  integrable_gibbs_of_continuous_hasCompactSupport U hdiff _
    (continuous_directionalGenerator U L hLip φ hφ v)
    (hasCompactSupport_directionalGenerator U φ hc v)

/-- Absolute integrability of the entire Langevin generator under Gibbs measure. -/
theorem integrable_langevinGenerator_gibbsMeasure
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hc : HasCompactSupport φ) :
    Integrable (langevinGenerator U φ) (gibbsMeasure U) := by
  exact integrable_finsetSum Finset.univ (fun _ _ ↦
    integrable_directionalGenerator_gibbsMeasure U L hdiff hLip φ hφ hc _)

/-- The full finite-dimensional generator has zero weighted Lebesgue integral. -/
theorem integral_weighted_langevinGenerator_eq_zero
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hc : HasCompactSupport φ) :
    (∫ x, Real.exp (-U x) * langevinGenerator U φ x ∂volume) = 0 := by
  have hi (v : H) : Integrable
      (fun x ↦ Real.exp (-U x) * directionalGenerator U φ v x) volume :=
    ((Real.continuous_exp.comp hdiff.continuous.neg).mul
      (continuous_directionalGenerator U L hLip φ hφ v))
        |>.integrable_of_hasCompactSupport
          (hasCompactSupport_directionalGenerator U φ hc v).mul_left
  simp_rw [langevinGenerator, Finset.mul_sum]
  rw [integral_finsetSum Finset.univ (fun i _ ↦ hi _)]
  simp only [integral_weighted_directionalGenerator_eq_zero U L hdiff hLip φ hφ hc,
    Finset.sum_const_zero]

/-- Gibbs infinitesimal invariance: `∫ (∆φ - ⟪∇U,∇φ⟫) dπ = 0`. -/
theorem integral_langevinGenerator_gibbs_eq_zero
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hc : HasCompactSupport φ) :
    (∫ x, langevinGenerator U φ x ∂gibbsMeasure U) = 0 := by
  rw [integral_gibbs_eq_weighted U hdiff,
    integral_weighted_langevinGenerator_eq_zero U L hdiff hLip φ hφ hc, mul_zero]

omit [MeasurableSpace H] [BorelSpace H] in
/-- Exact correspondence between the basis definition and the usual Laplacian
minus the gradient drift; no second derivative of `U` occurs. -/
theorem langevinGenerator_eq_laplacian_sub_inner (U φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (x : H) :
    langevinGenerator U φ x =
      Laplacian.laplacian φ x - inner ℝ (gradient U x) (gradient φ x) := by
  have hd : Differentiable ℝ (fderiv ℝ φ) :=
    (hφ.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num)
  have hsecond (v : H) : fderiv ℝ (fun z ↦ fderiv ℝ φ z v) x v =
      iteratedFDeriv ℝ 2 φ x ![v, v] := by
    rw [fderiv_clm_apply (hd x) (differentiableAt_const v)]
    simp [iteratedFDeriv_two_apply, ContinuousLinearMap.flip_apply]
  unfold langevinGenerator directionalGenerator
  simp_rw [hsecond, Finset.sum_sub_distrib, ← inner_gradient_left]
  rw [InnerProductSpace.laplacian_eq_iteratedFDeriv_stdOrthonormalBasis]
  congr 1
  simpa only [real_inner_comm (gradient φ x)] using
    (stdOrthonormalBasis ℝ H).sum_inner_mul_inner (gradient U x) (gradient φ x)

/-- The standard mathematical generator formula has zero Gibbs integral. -/
theorem integral_laplacian_sub_gradient_gibbs_eq_zero
    (U : H → ℝ) (L : ℝ≥0) (hdiff : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hc : HasCompactSupport φ) :
    (∫ x, Laplacian.laplacian φ x - inner ℝ (gradient U x) (gradient φ x)
      ∂gibbsMeasure U) = 0 := by
  simp_rw [← langevinGenerator_eq_laplacian_sub_inner U φ hφ]
  exact integral_langevinGenerator_gibbs_eq_zero U L hdiff hLip φ hφ hc

end ULA


end
