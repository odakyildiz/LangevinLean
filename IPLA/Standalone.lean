/-! ## Included source: UnadjustedLangevin/Degenerate.lean -/
section

set_option linter.style.header false

/-! # Quadratic transport on singleton spaces

A product coupling proves that any two probability measures on a singleton
have zero Wasserstein distance. This shared result includes the zero-dimensional
Euclidean case.
-/

noncomputable section
open MeasureTheory
open scoped ENNReal NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [MeasurableSpace H] [Subsingleton H]

/-- Every coupling on a singleton has quadratic cost zero. -/
theorem couplingCost_eq_zero_of_subsingleton (ν : Measure (H × H)) :
    couplingCost ν = 0 := by
  have h : (fun p : H × H ↦ p.1 - p.2) = fun _ ↦ (0 : H) := by
    funext p
    exact sub_eq_zero.mpr (Subsingleton.elim _ _)
  simp [couplingCost, h]

/-- Probability measures on a singleton have Wasserstein distance zero, as
witnessed by their product coupling. -/
theorem wasserstein2_eq_zero_of_subsingleton (μ π : Measure H)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure π] :
    wasserstein2 μ π = 0 := by
  let c : Coupling μ π :=
    { joint := μ.prod π
      fst := by simp
      snd := by simp }
  refine le_antisymm ?_ (by simp)
  simpa only [couplingCost_eq_zero_of_subsingleton] using
    wasserstein2_le_couplingCost c

/-- The corresponding real-valued Wasserstein distance is also zero. -/
theorem wasserstein2Real_eq_zero_of_subsingleton (μ π : Measure H)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure π] :
    wasserstein2Real μ π = 0 := by
  simp [wasserstein2Real, wasserstein2_eq_zero_of_subsingleton]

end ULA



end
end


/-! ## Included source: IPLA/Degenerate.lean -/
section

set_option linter.style.header false

/-! # Zero-dimensional parameter and particle spaces

The Euclidean space indexed by the empty type is a singleton. Its quadratic
transport distance and every parameter error are zero. These elementary facts
permit the public theorem to include dimension zero without extra analytic
assumptions.
-/

noncomputable section
open MeasureTheory
open scoped ENNReal NNReal

namespace IPLA

/-- There is no parameter error when the parameter dimension is zero. This
holds for every latent dimension and every measure. -/
theorem parameterRMS_zero_dimension {N dx : ℕ} (ν : Measure (State N 0 dx))
    (θStar : EuclideanSpace ℝ (Fin 0)) :
    Real.sqrt (∫ z, ‖parameterCLM z - θStar‖ ^ 2 ∂ν) = 0 := by
  have h : (fun z : State N 0 dx ↦ ‖parameterCLM z - θStar‖ ^ 2) = fun _ ↦ (0 : ℝ) := by
    funext z
    rw [Subsingleton.elim (parameterCLM z) θStar, sub_self, norm_zero, zero_pow two_ne_zero]
  rw [h]
  simp

/-- The complete displayed error bound in the zero-dimensional state. No
regularity of a potential, noise law, or initialization is needed here. -/
theorem zero_dimensions_bound {N : ℕ}
    (μ π ν : Measure (State N 0 0)) [IsProbabilityMeasure μ] [IsProbabilityMeasure π]
    (m γ : ℝ) (L : ℝ≥0) (θStar : EuclideanSpace ℝ (Fin 0)) (k : ℕ) :
    Real.sqrt (∫ z, ‖parameterCLM z - θStar‖ ^ 2 ∂ν) ≤
      Real.sqrt (2 * (0 : ℝ) / ((N : ℝ) * m)) +
        (1 - m * γ) ^ k * ULA.wasserstein2Real μ π +
        (33 / 20 : ℝ) * ((L : ℝ) / m) *
          Real.sqrt ((0 : ℝ) + (0 : ℝ) / (N : ℝ)) * Real.sqrt γ := by
  simp [parameterRMS_zero_dimension, ULA.wasserstein2Real_eq_zero_of_subsingleton]

end IPLA


end
end


/-! ## Included source: UnadjustedLangevin/GeneratorDirichlet.lean -/
section

set_option linter.style.header false

/-! # Gibbs Dirichlet identity, generator symmetry, and dissipativity

Ordinary integration by parts proves the Dirichlet identity for compactly
supported `C²` test functions. The potential needs only one derivative and a
Lipschitz gradient. No Hessian, diffusion invariance, or PDE uniqueness is used.
-/

noncomputable section
open MeasureTheory
open scoped ENNReal NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

omit [MeasurableSpace H] [BorelSpace H] in
/-- Differentiating a weighted test requires only one derivative of `U`. -/
theorem fderiv_exp_neg_mul_apply (U φ : H → ℝ)
    (hU : Differentiable ℝ U) (hφ : Differentiable ℝ φ) (x v : H) :
    fderiv ℝ (fun z ↦ Real.exp (-U z) * φ z) x v =
      Real.exp (-U x) * (fderiv ℝ φ x v - inner ℝ (gradient U x) v * φ x) := by
  have hd : HasFDerivAt (fun z ↦ Real.exp (-U z) * φ z)
      (Real.exp (-U x) • fderiv ℝ φ x +
        (φ x) • (Real.exp (-U x) • (-fderiv ℝ U x))) x := by
    exact ((hU x).hasFDerivAt.neg.exp).mul ((hφ x).hasFDerivAt)
  rw [hd.fderiv]
  simp only [add_apply, smul_apply, neg_apply, smul_eq_mul, ← inner_gradient_left]
  ring

/-- Weighted directional Dirichlet integration by parts. -/
theorem integral_weighted_directional_dirichlet
    (U : H → ℝ) (L : ℝ≥0) (hU : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ ψ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hψ : ContDiff ℝ 2 ψ)
    (hcφ : HasCompactSupport φ) (hcψ : HasCompactSupport ψ) (v : H) :
    (∫ x, Real.exp (-U x) * (φ x * directionalGenerator U ψ v x) ∂volume) =
      -(∫ x, Real.exp (-U x) * (fderiv ℝ φ x v * fderiv ℝ ψ x v) ∂volume) := by
  let a : H → ℝ := fun x ↦ Real.exp (-U x) * φ x
  let g : H → ℝ := fun x ↦ fderiv ℝ ψ x v
  have hφd : Differentiable ℝ φ := hφ.differentiable (by norm_num)
  have hg : ContDiff ℝ 1 g :=
    (hψ.fderiv_right (m := 1) (by norm_num)).clm_apply contDiff_const
  have hw : Continuous (fun x ↦ Real.exp (-U x)) :=
    Real.continuous_exp.comp hU.continuous.neg
  have hDφ : Continuous (fun x ↦ fderiv ℝ φ x v) :=
    (hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hDg : Continuous (fun x ↦ fderiv ℝ g x v) :=
    (hg.continuous_fderiv (by norm_num)).clm_apply continuous_const
  have hca : HasCompactSupport a := hcφ.mul_left
  have hcg : HasCompactSupport g := hcψ.fderiv_apply ℝ v
  have hDa : Continuous (fun x ↦ fderiv ℝ a x v) := by
    change Continuous (fun x ↦ fderiv ℝ (fun z ↦ Real.exp (-U z) * φ z) x v)
    simp_rw [fderiv_exp_neg_mul_apply U φ hU hφd]
    exact hw.mul (hDφ.sub ((hLip.continuous.inner continuous_const).mul hφ.continuous))
  have hia'g : Integrable (fun x ↦ fderiv ℝ a x v * g x) volume :=
    (hDa.mul hg.continuous).integrable_of_hasCompactSupport hcg.mul_left
  have hiag' : Integrable (fun x ↦ a x * fderiv ℝ g x v) volume :=
    ((hw.mul hφ.continuous).mul hDg).integrable_of_hasCompactSupport hca.mul_right
  have hiag : Integrable (fun x ↦ a x * g x) volume :=
    ((hw.mul hφ.continuous).mul hg.continuous).integrable_of_hasCompactSupport hca.mul_right
  have hibp := integral_mul_fderiv_eq_neg_fderiv_mul_of_integrable hia'g hiag' hiag
    (fun x _ ↦ ((hU x).neg.exp).mul (hφd x))
    (fun x _ ↦ hg.differentiable (by norm_num) x)
  have hiL : Integrable
      (fun x ↦ Real.exp (-U x) * (φ x * directionalGenerator U ψ v x)) volume :=
    (hw.mul (hφ.continuous.mul (continuous_directionalGenerator U L hLip ψ hψ v)))
      |>.integrable_of_hasCompactSupport hcφ.mul_right.mul_left
  have hiD : Integrable
      (fun x ↦ Real.exp (-U x) * (fderiv ℝ φ x v * g x)) volume :=
    (hw.mul (hDφ.mul hg.continuous))
      |>.integrable_of_hasCompactSupport hcg.mul_left.mul_left
  have hsum : (∫ x, Real.exp (-U x) * (φ x * directionalGenerator U ψ v x) +
      Real.exp (-U x) * (fderiv ℝ φ x v * g x) ∂volume) = 0 := by
    calc
      _ = ∫ x, a x * fderiv ℝ g x v + fderiv ℝ a x v * g x ∂volume := by
        apply integral_congr_ae
        exact ae_of_all _ fun x ↦ by
          dsimp [a, g, directionalGenerator]
          rw [fderiv_exp_neg_mul_apply U φ hU hφd]
          ring
      _ = (∫ x, a x * fderiv ℝ g x v ∂volume) +
          ∫ x, fderiv ℝ a x v * g x ∂volume := integral_add hiag' hia'g
      _ = 0 := by rw [hibp]; ring
  rw [integral_add hiL hiD] at hsum
  exact eq_neg_iff_add_eq_zero.mpr hsum

/-- Directional Gibbs Dirichlet identity, with normalization handled explicitly. -/
theorem integral_directionalGenerator_dirichlet_gibbs
    (U : H → ℝ) (L : ℝ≥0) (hU : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ ψ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hψ : ContDiff ℝ 2 ψ)
    (hcφ : HasCompactSupport φ) (hcψ : HasCompactSupport ψ) (v : H) :
    (∫ x, φ x * directionalGenerator U ψ v x ∂gibbsMeasure U) =
      -(∫ x, fderiv ℝ φ x v * fderiv ℝ ψ x v ∂gibbsMeasure U) := by
  rw [integral_gibbs_eq_weighted U hU, integral_gibbs_eq_weighted U hU,
    integral_weighted_directional_dirichlet U L hU hLip φ ψ hφ hψ hcφ hcψ v,
    mul_neg]

/-- Absolute integrability of the Dirichlet energy pairing. -/
theorem integrable_gradient_inner_gibbsMeasure
    (U : H → ℝ) (hU : Differentiable ℝ U) (φ ψ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hψ : ContDiff ℝ 2 ψ)
    (hcφ : HasCompactSupport φ) :
    Integrable (fun x ↦ inner ℝ (gradient φ x) (gradient ψ x)) (gibbsMeasure U) := by
  let e := stdOrthonormalBasis ℝ H
  have hi (v : H) : Integrable (fun x ↦ fderiv ℝ φ x v * fderiv ℝ ψ x v)
      (gibbsMeasure U) :=
    integrable_gibbs_of_continuous_hasCompactSupport U hU _
      (((hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const).mul
        ((hψ.continuous_fderiv (by norm_num)).clm_apply continuous_const))
      (hcφ.fderiv_apply ℝ v).mul_right
  have heq : (fun x ↦ inner ℝ (gradient φ x) (gradient ψ x)) =
      (fun x ↦ ∑ i : Fin (Module.finrank ℝ H), fderiv ℝ φ x (e i) *
        fderiv ℝ ψ x (e i)) := by
    funext x
    simp only [← inner_gradient_left]
    symm
    simpa only [real_inner_comm (gradient ψ x)] using
      e.sum_inner_mul_inner (gradient φ x) (gradient ψ x)
  rw [heq]
  exact integrable_finsetSum Finset.univ (fun i _ ↦ hi (e i))

/-- Absolute integrability of a compact test times the full generator. -/
theorem integrable_test_mul_langevinGenerator_gibbsMeasure
    (U : H → ℝ) (L : ℝ≥0) (hU : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ ψ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hψ : ContDiff ℝ 2 ψ)
    (hcφ : HasCompactSupport φ) :
    Integrable (fun x ↦ φ x * langevinGenerator U ψ x) (gibbsMeasure U) := by
  have hi (v : H) : Integrable (fun x ↦ φ x * directionalGenerator U ψ v x)
      (gibbsMeasure U) :=
    integrable_gibbs_of_continuous_hasCompactSupport U hU _
      (hφ.continuous.mul (continuous_directionalGenerator U L hLip ψ hψ v))
      hcφ.mul_right
  simp only [langevinGenerator, Finset.mul_sum]
  exact integrable_finsetSum Finset.univ (fun i _ ↦ hi _)

/-- The Gibbs Dirichlet identity `∫ φ Lψ dπ = -∫ ⟪∇φ,∇ψ⟫ dπ`. -/
theorem integral_langevinGenerator_dirichlet_gibbs
    (U : H → ℝ) (L : ℝ≥0) (hU : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ ψ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hψ : ContDiff ℝ 2 ψ)
    (hcφ : HasCompactSupport φ) (hcψ : HasCompactSupport ψ) :
    (∫ x, φ x * langevinGenerator U ψ x ∂gibbsMeasure U) =
      -(∫ x, inner ℝ (gradient φ x) (gradient ψ x) ∂gibbsMeasure U) := by
  let e := stdOrthonormalBasis ℝ H
  have hiL (v : H) : Integrable (fun x ↦ φ x * directionalGenerator U ψ v x)
      (gibbsMeasure U) :=
    integrable_gibbs_of_continuous_hasCompactSupport U hU _
      (hφ.continuous.mul (continuous_directionalGenerator U L hLip ψ hψ v))
      hcφ.mul_right
  have hiD (v : H) : Integrable (fun x ↦ fderiv ℝ φ x v * fderiv ℝ ψ x v)
      (gibbsMeasure U) :=
    integrable_gibbs_of_continuous_hasCompactSupport U hU _
      (((hφ.continuous_fderiv (by norm_num)).clm_apply continuous_const).mul
        ((hψ.continuous_fderiv (by norm_num)).clm_apply continuous_const))
      (hcφ.fderiv_apply ℝ v).mul_right
  simp_rw [langevinGenerator, Finset.mul_sum]
  rw [integral_finsetSum Finset.univ (fun i _ ↦ hiL _)]
  simp_rw [integral_directionalGenerator_dirichlet_gibbs U L hU hLip φ ψ hφ hψ hcφ hcψ]
  rw [Finset.sum_neg_distrib, ← integral_finsetSum Finset.univ (fun i _ ↦ hiD (e i))]
  congr 1
  apply integral_congr_ae
  exact ae_of_all _ fun x ↦ by
    simp only [← inner_gradient_left]
    simpa only [real_inner_comm (gradient ψ x)] using
      e.sum_inner_mul_inner (gradient φ x) (gradient ψ x)

/-- The Langevin generator is symmetric on compactly supported `C²` tests. -/
theorem integral_langevinGenerator_symmetric_gibbs
    (U : H → ℝ) (L : ℝ≥0) (hU : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ ψ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hψ : ContDiff ℝ 2 ψ)
    (hcφ : HasCompactSupport φ) (hcψ : HasCompactSupport ψ) :
    (∫ x, φ x * langevinGenerator U ψ x ∂gibbsMeasure U) =
      ∫ x, ψ x * langevinGenerator U φ x ∂gibbsMeasure U := by
  rw [integral_langevinGenerator_dirichlet_gibbs U L hU hLip φ ψ hφ hψ hcφ hcψ,
    integral_langevinGenerator_dirichlet_gibbs U L hU hLip ψ φ hψ hφ hcψ hcφ]
  congr 1
  exact integral_congr_ae (ae_of_all _ fun x ↦ real_inner_comm _ _)

/-- The Dirichlet energy is exactly the negative generator quadratic form. -/
theorem integral_langevinGenerator_self_gibbs
    (U : H → ℝ) (L : ℝ≥0) (hU : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hcφ : HasCompactSupport φ) :
    (∫ x, φ x * langevinGenerator U φ x ∂gibbsMeasure U) =
      -(∫ x, ‖gradient φ x‖ ^ 2 ∂gibbsMeasure U) := by
  simpa only [real_inner_self_eq_norm_sq] using
    integral_langevinGenerator_dirichlet_gibbs U L hU hLip φ φ hφ hφ hcφ hcφ

/-- Dissipativity of the Langevin generator under the Gibbs measure. -/
theorem integral_langevinGenerator_dissipative_gibbs
    (U : H → ℝ) (L : ℝ≥0) (hU : Differentiable ℝ U)
    (hLip : LipschitzWith L (gradient U)) (φ : H → ℝ)
    (hφ : ContDiff ℝ 2 φ) (hcφ : HasCompactSupport φ) :
    (∫ x, φ x * langevinGenerator U φ x ∂gibbsMeasure U) ≤ 0 := by
  rw [integral_langevinGenerator_self_gibbs U L hU hLip φ hφ hcφ]
  exact neg_nonpos.mpr (integral_nonneg fun x ↦ sq_nonneg _)

end ULA


end
end


/-! ## Included source: UnadjustedLangevin/FokkerPlanck.lean -/
section

set_option linter.style.header false

/-! # The weak Fokker–Planck equation and the remaining stationarity bridge

The constant Gibbs curve satisfies the integrated weak Fokker–Planck equation
for every compactly supported `C²` test function. Normalization, all spatial
integrability, the finite second moment, and the generator identity are derived
from strong convexity and Lipschitz continuity of the gradient.

`WeakFokkerPlanckUnique` is deliberately an explicit, separate analytic
proposition. The final theorem in this file is conditional on that proposition
and on the actual diffusion laws satisfying the weak equation. Neither is
claimed to follow merely from the definition of an integral-equation solution.
Thus this file does not replace Gibbs invariance with an equivalent hidden
assumption, nor does it claim that generator integration alone proves it.
-/

noncomputable section
open MeasureTheory Set
open scoped NNReal

namespace ULA

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  [FiniteDimensional ℝ H] [MeasurableSpace H] [BorelSpace H]

/-- Probability-valued weak solutions of the Langevin Fokker–Planck equation
on a finite interval. The moment and integrability conditions are included
explicitly, so all integrals in the equation have their ordinary meaning. -/
structure IsWeakFokkerPlanckSolution (U : H → ℝ) (ρ : ℝ → Measure H)
    (T : ℝ) : Prop where
  probability : ∀ t ∈ Icc 0 T, IsProbabilityMeasure (ρ t)
  secondMoment : ∀ t ∈ Icc 0 T, Integrable (fun x : H ↦ ‖x‖ ^ 2) (ρ t)
  testIntegrable : ∀ (φ : H → ℝ), ContDiff ℝ 2 φ → HasCompactSupport φ →
    ∀ t ∈ Icc 0 T, Integrable φ (ρ t)
  testContinuous : ∀ (φ : H → ℝ), ContDiff ℝ 2 φ → HasCompactSupport φ →
    ContinuousOn (fun t ↦ ∫ x, φ x ∂ρ t) (Icc 0 T)
  generatorIntegrable : ∀ (φ : H → ℝ), ContDiff ℝ 2 φ → HasCompactSupport φ →
    ∀ t ∈ Icc 0 T, Integrable (langevinGenerator U φ) (ρ t)
  timeIntegrable : ∀ (φ : H → ℝ), ContDiff ℝ 2 φ → HasCompactSupport φ →
    IntervalIntegrable (fun s ↦ ∫ x, langevinGenerator U φ x ∂ρ s) volume 0 T
  equation : ∀ (φ : H → ℝ), ContDiff ℝ 2 φ → HasCompactSupport φ →
    ∀ t ∈ Icc 0 T,
      (∫ x, φ x ∂ρ t) = (∫ x, φ x ∂ρ 0) +
        ∫ s in 0..t, ∫ x, langevinGenerator U φ x ∂ρ s

/-- The constant Gibbs curve is a weak Fokker–Planck solution. Every condition
is proved from the potential assumptions; no stationary diffusion is assumed. -/
theorem constant_gibbs_isWeakFokkerPlanckSolution
    (U : H → ℝ) (m : ℝ) (L : ℝ≥0) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (T : ℝ) :
    IsWeakFokkerPlanckSolution U (fun _ ↦ gibbsMeasure U) T := by
  constructor
  · intro t ht
    exact isProbabilityMeasure_gibbsMeasure U m hm hdiff hsc
  · intro t ht
    exact integrable_norm_sq_gibbsMeasure U m hm hdiff hsc
  · intro φ hφ hc t ht
    exact integrable_gibbs_of_continuous_hasCompactSupport U hdiff φ hφ.continuous hc
  · intro φ hφ hc
    exact continuousOn_const
  · intro φ hφ hc t ht
    exact integrable_langevinGenerator_gibbsMeasure U L hdiff hLip φ hφ hc
  · intro φ hφ hc
    simp only [integral_langevinGenerator_gibbs_eq_zero U L hdiff hLip φ hφ hc]
    exact intervalIntegrable_const
  · intro φ hφ hc t ht
    simp only [integral_langevinGenerator_gibbs_eq_zero U L hdiff hLip φ hφ hc,
      intervalIntegral.integral_zero, add_zero]

/-- The still separate analytic uniqueness assertion for the weak equation.
This is not declared as an axiom or an instance and is not proved in this file. -/
def WeakFokkerPlanckUnique (U : H → ℝ) (T : ℝ) : Prop :=
  ∀ (ρ η : ℝ → Measure H),
    IsWeakFokkerPlanckSolution U ρ T → IsWeakFokkerPlanckSolution U η T →
    ρ 0 = η 0 → ∀ t ∈ Icc 0 T, ρ t = η t

/-- Conditional stationarity bridge. To apply this to a constructed Langevin
process, one must separately prove the weak equation for its laws (the Dynkin
or Itô step) and uniqueness of the stated weak Fokker–Planck class. Both premises
are visible here. The constant Gibbs solution itself is proved internally. -/
theorem gibbs_stationary_of_weakFokkerPlanckUniqueness
    (U : H → ℝ) (m : ℝ) (L : ℝ≥0) (hm : 0 < m)
    (hdiff : Differentiable ℝ U) (hsc : StrongConvexOn Set.univ m U)
    (hLip : LipschitzWith L (gradient U)) (T : ℝ)
    (hunique : WeakFokkerPlanckUnique U T)
    (ρ : ℝ → Measure H) (hρ : IsWeakFokkerPlanckSolution U ρ T)
    (hρ0 : ρ 0 = gibbsMeasure U) :
    ∀ t ∈ Icc 0 T, ρ t = gibbsMeasure U := by
  exact hunique ρ (fun _ ↦ gibbsMeasure U) hρ
    (constant_gibbs_isWeakFokkerPlanckSolution U m L hm hdiff hsc hLip T) hρ0

end ULA


end
end


/-! ## Included source: IPLA/Theorem.lean -/
section

set_option linter.style.header false

/-! # Theorem 1 from the original joint-potential assumptions

The shared Gaussian ULA theorem is applied directly to the lifted IPLA chain.
ULA supplies the initial transport bound, constructs the Langevin reference,
and proves Gibbs stationarity; none of those proofs is repeated here.
The IPLA concentration theorem proves the sharp parameter-marginal bound.
Neither result is supplied as an additional hypothesis here.
The observation `y` is fixed. Both strong convexity and gradient smoothness
are assumptions on the same joint potential `U y`, whose coordinates are `(θ,x)`.
No separate convexity or smoothness of a coordinate block is assumed.
The complete standalone version is `IPLA/Standalone.lean`.
-/

noncomputable section
open MeasureTheory
open scoped NNReal ENNReal
namespace IPLA

/-- For fixed observations `y`, write `U y (pair θ x) = -log p_θ(x,y)`.
The general-dimension counterpart of equation (34), with independent
parameter dimension `dθ` and latent dimension `dx`, for the actual Gaussian
IPLA recursion and its defined Gibbs target. Every hypothesis
is displayed here or is one of the Gaussian-law and independence fields of
`GaussianInnovations`, whose definition is included in the standalone file.
Normalization, all finite transport moments, a stationary Langevin reference,
and the equilibrium parameter concentration are derived in the proof. -/
private theorem nonempty_dimension_bound
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (N dθ dx : ℕ) [Nonempty (Fin dθ ⊕ (Fin N × Fin dx))] (hN : 0 < N)
    {Data : Type*} (U : Data → Joint dθ dx → ℝ) (y : Data)
    (m γ : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ (U y)) (hsc : StrongConvexOn Set.univ m (U y))
    (hLip : LipschitzWith L (gradient (U y)))
    (hm : 0 < m)
    (hγ : 0 < γ) (hsmall : γ ≤ 2 / (m + (L : ℝ)))
    (θStar : EuclideanSpace ℝ (Fin dθ)) (hMaximizer : IsMarginalMaximizer (U y) θStar)
    (initial : Lp (State N dθ dx) 2 P) (noise : ℕ → Lp (State N dθ dx) 2 P)
    (hGaussian : GaussianInnovations P initial noise)
    (k : ℕ) :
    Real.sqrt (∫ z, ‖parameterCLM z - θStar‖ ^ 2
      ∂(laws P (U y) γ L hdiff hLip initial noise k)) ≤
      Real.sqrt (2 * (dθ : ℝ) / ((N : ℝ) * m)) +
        (1 - m * γ) ^ k * ULA.wasserstein2Real (P.map initial) (gibbsTarget (U y)) +
        (33 / 20 : ℝ) * ((L : ℝ) / m) *
          Real.sqrt ((dx : ℝ) + (dθ : ℝ) / (N : ℝ)) * Real.sqrt γ := by
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have : IsProbabilityMeasure (@gibbsTarget N dθ dx (U y)) :=
    gibbsTarget_isProbability hN (U y) m hm hdiff hsc
  have hfinite := ULA.Hilbert.gaussianULA_initial_transport_finite P
    (@potential N dθ dx (U y)) ((N : ℝ) * m) (mul_pos hn hm)
    (potential_differentiable hdiff) (potential_strongConvex hsc) initial
  have hs : γ / (N : ℝ) ≤
      2 / ((N : ℝ) * m + (((N : ℝ≥0) * L : ℝ≥0) : ℝ)) := by
    simpa using (scaled_step_iff N hN m (L : ℝ) γ).mpr hsmall
  have htransport := ULA.Hilbert.dalalyan_of_gaussian_innovations P
    (@potential N dθ dx (U y))
    ((N : ℝ) * m) (γ / N) ((N : ℝ≥0) * L) (mul_pos hn hm)
    (potential_differentiable hdiff) (potential_strongConvex hsc)
    (potential_gradient_lipschitz hdiff hLip) (div_pos hγ hn) hs
    initial noise hGaussian.coordinateLaw hGaussian.independent
    hGaussian.independentInitial k
  change ULA.wasserstein2Real (laws P (U y) γ L hdiff hLip initial noise k)
    (ULA.gibbsMeasure (potential (U y))) ≤ _ at htransport
  have houtput := ULA.Hilbert.dalalyan_output_finite (@potential N dθ dx (U y))
    ((N : ℝ) * m) (γ / N) ((N : ℝ≥0) * L) (mul_pos hn hm)
    (potential_differentiable hdiff) (potential_strongConvex hsc)
    (potential_gradient_lipschitz hdiff hLip) (div_pos hγ hn)
    (P.map initial) hfinite k
  have hlaw := laws_eq_ulaLawStep P (U y) γ L hdiff hLip initial noise hGaussian k
  rw [← hlaw] at houtput
  rw [← gibbsTarget_eq_gibbsMeasure (U y)] at htransport houtput
  have hfactor : (N : ℝ) * m * (γ / N) = m * γ := by field_simp
  simp only [Fintype.card_sum, Fintype.card_prod, Fintype.card_fin, NNReal.coe_mul,
    NNReal.coe_natCast, hfactor] at htransport
  rw [scaled_bias_eq N dθ dx hN m (L : ℝ) γ hγ.le] at htransport
  have hconcentration := gibbsTarget_parameter_concentration hN (U y) m hm hdiff hsc
    θStar hMaximizer
  have hprojected := projectedRMSReal_le_wasserstein2Real_add
    (@parameterCLM N dθ dx) norm_parameterCLM_le_one θStar
    (Real.sqrt (2 * (dθ : ℝ) / ((N : ℝ) * m))) (Real.sqrt_nonneg _)
    houtput hconcentration
  have hmoment := projectedRMS_ne_top (@parameterCLM N dθ dx) norm_parameterCLM_le_one
    θStar _ houtput hconcentration
  rw [projectedRMSReal_eq_sqrt_integral _ _ _ hmoment] at hprojected
  linarith


/-- Strongly convex IPLA for independent, arbitrary parameter and latent
dimensions. All stationary-reference and concentration inputs are derived.
The zero-dimensional cases are included without extra assumptions. -/
theorem theorem1
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (N dθ dx : ℕ) (hN : 0 < N)
    {Data : Type*} (U : Data → Joint dθ dx → ℝ) (y : Data)
    (m γ : ℝ) (L : ℝ≥0)
    (hdiff : Differentiable ℝ (U y)) (hsc : StrongConvexOn Set.univ m (U y))
    (hLip : LipschitzWith L (gradient (U y)))
    (hm : 0 < m)
    (hγ : 0 < γ) (hsmall : γ ≤ 2 / (m + (L : ℝ)))
    (θStar : EuclideanSpace ℝ (Fin dθ)) (hMaximizer : IsMarginalMaximizer (U y) θStar)
    (initial : Lp (State N dθ dx) 2 P) (noise : ℕ → Lp (State N dθ dx) 2 P)
    (hGaussian : GaussianInnovations P initial noise)
    (k : ℕ) :
    Real.sqrt (∫ z, ‖parameterCLM z - θStar‖ ^ 2
      ∂(laws P (U y) γ L hdiff hLip initial noise k)) ≤
      Real.sqrt (2 * (dθ : ℝ) / ((N : ℝ) * m)) +
        (1 - m * γ) ^ k * ULA.wasserstein2Real (P.map initial) (gibbsTarget (U y)) +
        (33 / 20 : ℝ) * ((L : ℝ) / m) *
          Real.sqrt ((dx : ℝ) + (dθ : ℝ) / (N : ℝ)) * Real.sqrt γ := by
  classical
  by_cases hindex : Nonempty (Fin dθ ⊕ (Fin N × Fin dx))
  · let : Nonempty (Fin dθ ⊕ (Fin N × Fin dx)) := hindex
    exact nonempty_dimension_bound P N dθ dx hN U y m γ L hdiff hsc hLip hm
      hγ hsmall θStar hMaximizer initial noise hGaussian k
  · have hθ : dθ = 0 := Nat.eq_zero_of_not_pos (fun hp ↦ hindex ⟨Sum.inl ⟨0, hp⟩⟩)
    have hx : dx = 0 := Nat.eq_zero_of_not_pos
      (fun hp ↦ hindex ⟨Sum.inr (⟨0, hN⟩, ⟨0, hp⟩)⟩)
    subst dθ
    subst dx
    have : IsProbabilityMeasure (@gibbsTarget N 0 0 (U y)) :=
      gibbsTarget_isProbability hN (U y) m hm hdiff hsc
    simpa only [Nat.cast_zero] using zero_dimensions_bound (P.map initial) (gibbsTarget (U y))
      (laws P (U y) γ L hdiff hLip initial noise k) m γ L θStar k

end IPLA


end
